<Project Sdk="Microsoft.NET.Sdk">

  <!-- تَعريفات الأَدوار السَبعَة: مِلَفّات ظاهِرَة في المُستودَع
       (تُقرَأ وتُحَرَّر ويَظهَر فَرقُها في الـ diff) ومَضمونَة في
       التَّجميع عِندَ النَّشر — فَلا مَسار أَساس يَختَلِف بَين المُضيفين.
       المُبَرِّر كامِلاً في RoleDefinitionLoader. -->
  <ItemGroup>
    <EmbeddedResource Include="Definitions\**\*.json" />
  </ItemGroup>

  <!-- مَعجَم حالات الاعتِماد مُحال إلى تَعريف واحِد مُشتَرَك مَع
       عُدَّة المَظهَر. والمَكتَبَة وَرَقَة بِلا مَرجِع، فَلا يَتَسَرَّب
       شَيء إلى هذه العُدَّة عَبرَها. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\core\ACommerce.Platform.Flows\ACommerce.Platform.Flows.csproj" />
  </ItemGroup>

  <!-- (‏2026-11-13، الموجَة ١٣ W13-6·١٧ — ‏ADR-051 §٢١) مُعجَمُ وَحَداتِ العَدّ: مِترُ الدَورِ قيمَةٌ مِنه أَو «none»، ومُصادِقُه
       (RoleMeterValidator) يَسأَلُه عِندَ الإقلاعِ لِيُمَيِّزَ «لَيسَت وَحدَةً» مِن «وَحدَةٌ لَيسَت حُضورَ دَور». والمَكتَبَةُ المُشارُ
       إلَيها بِلا إحالَةِ مَشروعٍ واحِدَة، فَلا حَلقَة. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\core\ACommerce.Platform.Shared\ACommerce.Platform.Shared.csproj" />
  </ItemGroup>

</Project>
