<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <!-- مولّد JasperFx المصدريّ يشحن داخل حزمة Marten، ولا بُدّ أن يعمل في
         التجميعة التي تُعرَّف فيها Subscription وإلّا فلا مُصرِّف وقت تشغيل لها. -->
    <PackageReference Include="Marten" />
    <!-- كاتالوجُ باقات المَنَصَّة بَياناتٌ لا كود — نَفسُ اصطِلاح
         `*.role.json` و`*.theme.json` و`*.flow.json` حَرفاً: مُضَمَّنٌ
         لا مَنسوخٌ إلى المُخرَج، فَلا انزِياحَ في مَسارِ التَشغيل بَينَ
         الاختِبار والخادِم، ولا مَصدَرا حَقيقَةٍ يَنجَرِفان. -->
    <EmbeddedResource Include="Definitions\**\*.json" />
    <!-- دَورَة الاعتِماد ومَعجَم حالاتِها — نَفس التَعريف الواحِد الَّذي
         تُحيل إلَيه عُدَّتا الأَدوار والمَظهَر. لا نُسخَة ثالِثَة. -->
    <ProjectReference Include="..\..\..\core\ACommerce.Platform.Flows\ACommerce.Platform.Flows.csproj" />
    <!-- يَومُ انتِهاءِ الباقَةِ آخِرُ ذلكَ اليَومِ بِساعَةِ المَنَصَّة (قَرارُ المالِك د51) — الدالَّةُ في العُدَّةِ الَّتي تَحمِلُ
         المِنطَقَة (`CultureTime.EndOfDayUtc`)، لا نُسخَةَ ثانِيَةً لِـ«Asia/Riyadh» هُنا. -->
    <ProjectReference Include="..\..\Culture\ACommerce.Kit.Culture.Core\ACommerce.Kit.Culture.Core.csproj" />
  </ItemGroup>
</Project>
