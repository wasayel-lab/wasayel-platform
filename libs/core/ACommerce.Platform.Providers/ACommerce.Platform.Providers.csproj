<Project Sdk="Microsoft.NET.Sdk">

  <!-- تَعريفاتُ المُزَوِّدين: مِلَفّات ظاهِرَة في المُستودَع (تُقرَأ
       وتُحَرَّر ويَظهَر فَرقُها في الـ diff) ومَضمونَة في التَّجميع
       عِندَ النَّشر — فَلا مَسارَ أَساسٍ يَختَلِف بَينَ المُضيفَين.
       المُبَرِّرُ كامِلاً في ProviderDefinitionLoader، وهُوَ حَرفاً
       مُبَرِّرُ RoleDefinitionLoader. -->
  <ItemGroup>
    <EmbeddedResource Include="Definitions\**\*.json" />
  </ItemGroup>

  <!-- إحالَةٌ واحِدَة: عَقدُ وَثيقَةِ تَعريفِ المُستَأجِر
       (ITenantDefinitionDocument) — لِتَرِثَ وَثيقَةُ الرَبطِ مَكانيكا
       TenantDefinitionService القائِمَة بَدَل أُنبوبٍ رابِع
       (القاعِدَة ٨). ولا تُحيلُ هذِه المَكتَبَةُ عُدَّةً واحِدَة:
       مَعجَمُ القُدُراتِ أَسماءٌ نَصِّيَّةٌ لا أَنواع. -->
  <ItemGroup>
    <ProjectReference Include="..\ACommerce.Platform.Flows\ACommerce.Platform.Flows.csproj" />
  </ItemGroup>

</Project>
