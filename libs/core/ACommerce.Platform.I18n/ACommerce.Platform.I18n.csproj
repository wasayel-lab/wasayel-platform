<Project Sdk="Microsoft.NET.Sdk">

  <!-- ═══════════════════════════════════════════════════════════════════
       مَنفَذ النَصّ — مَشروعٌ **وَرَقيّ**: صِفر `ProjectReference`.

       ولِماذا مَشروعٌ سادِس بَدَل حَقنِ `L` في الوِدجات: `L` كانَ يَعيش
       في `ACommerce.Templates.Customer.Marketplace`، وهو المَشروعُ
       الَّذي **يُرجِعُ إلى** الوِدجات والعُدَد. فَحَقنُه فيها يَقلِب
       سَهمَ الاعتِماد. وهذا المَشروعُ يَنزِل بِالهَدَف بَدَل أَن
       يَقلِبَ السَهم — ‏ADR-001، الخِيار (أ).

       والقاعِدَة ١ («لا تَجريدَ قَبلَ مُستَهلِكِه، وثَلاثَةٌ قَبلَ
       الاستِخراج») مُستَوفاةٌ **بِالقِياس لا بِالنِيَّة**: أَربَعَةُ
       مُستَهلِكين يَومَ الإنشاء — ‏`ACommerce.Widgets`،
       `ACommerce.Templates.Shared`، `ACommerce.Kit.Maps.Web`،
       و`ACommerce.Kit.Auth.Providers.Smtp` — ومَعَهُم القالِبُ نَفسُه.

       و`FrameworkReference` لا `ProjectReference`: ‏`L` يَقرَأ كوكي
       اللُغَة مِن `IHttpContextAccessor` ويُرجِع `MarkupString`،
       وكِلاهُما في الإطار المُشتَرَك. فَالمَشروعُ وَرَقيٌّ بِمَعنى
       «لا يُرجِع إلى شَيءٍ في هذا المُستَودَع».
       ═══════════════════════════════════════════════════════════════ -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- قَوامِيس نُصوص الواجِهَة (‏docs/I18N.md). مَوارِد مُضَمَّنَة لا
       مُحتَوىً ثابِتاً: تُقرَأ في الخادِم، ولا يَجوز أَن يَتَعَلَّق
       وُجودُها بِنَسخِ مُخرَجات ولا بِمَسار قُرص. وإضافَة لُغَة =
       إسقاط مِلَفّ هُنا؛ الـ wildcard يَلتَقِطُه بِلا تَعديل. -->
  <ItemGroup>
    <EmbeddedResource Include="Locales\*.json" />
  </ItemGroup>

</Project>
