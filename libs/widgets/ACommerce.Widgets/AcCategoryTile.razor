@namespace ACommerce.Widgets

@*
    AcCategoryTile — أيقونة دائريّة بخلفيّة مُظلَّلة + تسمية أسفلها.

    بنية مطابقة لـ ashare-category-item في عشير القديم:
      <button>
        <span .ac-tile-icon />   ← دائرة بلون ‍currentColor بشفافيّة 12%
        <span .ac-tile-label />
      </button>

    CSS_CLASSES: ac-tile, ac-tile-icon, ac-tile-label, ac-tile-selected
*@

@{
    // لا إيموجي مُلَوَّن — نُحَوِّل أَيّ إيموجي (مِن DB) إلى أَيقونَة خَطِّيَّة
    // SVG عَبر AcIconMap. الأَسماء النَّصِّيَّة ("home") تَمُرّ كَما هي.
    var iconName = ACommerce.Widgets.AcIconMap.Resolve(Icon, "tag");

    RenderFragment iconInner = @<text>
        <span class="ac-tile-icon" aria-hidden="true">
            <AcIcon Name="@iconName" Size="24" />
        </span>
        <span class="ac-tile-label">@Label</span>
    </text>;
}

@if (!string.IsNullOrEmpty(Href))
{
    <a class="ac-tile @(Selected ? "ac-tile-selected" : "") @(Class ?? "")"
       href="@Href" aria-pressed="@Selected">@iconInner</a>
}
else
{
    <button type="button"
            class="ac-tile @(Selected ? "ac-tile-selected" : "") @(Class ?? "")"
            @onclick="OnClickInternal" aria-pressed="@Selected">@iconInner</button>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "tag";
    [Parameter] public bool Selected { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Class { get; set; }

    private Task OnClickInternal() => OnClick.InvokeAsync();
}
