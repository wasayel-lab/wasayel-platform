@namespace ACommerce.Widgets

@*
    AcAvatar — صورة بروفايل دائريّة بـ fallback ذكيّ:
      1. ImageUrl موجود + IUrlAllowlist يُجيزه ⇒ <img>
      2. وإلّا initials (حتى حرفَين) فوق gradient مُشتقّ من Name (hash-based).
      3. لا Name ⇒ glyph عامّ "?".

    Size = القطر بالـ px. Default 40.
    CSS_CLASSES: ac-avatar, ac-avatar-img, ac-avatar-initials
*@

<div class="ac-avatar @(ExtraClass ?? "")"
     style="width:@(Size)px; height:@(Size)px;@(IsImage ? "" : $" {_background}")"
     role="img" aria-label="@(Name ?? FallbackAriaLabel)">
    @if (IsImage)
    {
        <img class="ac-avatar-img" src="@ImageUrl" alt="@(Name ?? "")" loading="lazy" />
    }
    else
    {
        <span class="ac-avatar-initials" style="font-size:@(Size * 0.4)px;">@Initials</span>
    }
</div>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public int Size { get; set; } = 40;
    [Parameter] public string? ExtraClass { get; set; }
    [Parameter] public string FallbackAriaLabel { get; set; } = "Avatar";

    private bool IsImage => !string.IsNullOrWhiteSpace(ImageUrl);

    private string Initials
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Name)) return "?";
            var parts = Name.Trim().Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 1)
                return parts[0].Length > 0
                    ? parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant()
                    : "?";
            return ($"{parts[0][0]}{parts[1][0]}").ToUpperInvariant();
        }
    }

    /// <summary>
    /// gradient مُشتقّ من hash بسيط للاسم. نَفس الاسم ⇒ نَفس اللون دائماً
    /// (المستخدم يَتعرّف على المراسل بلونه عبر التَطبيق). 8 أزواج محدَّدة
    /// كلّها دافئة + متوسّطة الإشباع لِتَلائم أيّ ثيم.
    ///
    /// <para><b>و«دائماً» تَشمَل ما بَعدَ إعادَة التَشغيل</b>: كانَت هُنا
    /// <c>string.GetHashCode()</c> وبَذرَتُها تَتَبَدَّل مَع كُلّ عَمَلِيَّة
    /// في dotnet — فَلَونُ الشَخص نَفسِه يَتَغَيَّر بَعدَ كُلّ إقلاع، وهو
    /// نَقضُ الوَعد المَكتوب في هذا التَعليق. كُشِفَ بِالقِياس: لَقطَتان
    /// لِنَفس الصَفحَة قَبلَ الإقلاع وبَعدَه اختَلَفَتا في هذا السَطر
    /// وَحدَه. والبَديل <c>FNV-1a</c> صَريحَة، وهي <b>نَفسُ العِلاج ونَفسُ
    /// الدالَّة</b> المَكتوبَة لِنَفس السَبَب في
    /// <c>ACommerce.Kit.Auth.NafathNames</c>.</para>
    /// </summary>
    /// <summary>
    /// <para><b>لَونٌ حَقيقيّ تَحتَ التَدَرُّج، ولَيسَ تَدَرُّجاً وَحدَه.</b>
    /// كانَ السَطرُ يَكتُب <c>background: linear-gradient(…)</c> — والاختِصار
    /// يُصَفِّر <c>background-color</c> إلى شَفّاف. فَكُلُّ قارِئٍ يَسأَل
    /// «ما لَونُ خَلفِيَّةِ هذا النَصّ؟» — قارِئُ الشاشَة، وأَداةُ
    /// التَبايُن، والمُتَصَفِّح حينَ يَعجِز عَن رَسم التَدَرُّج — يَرِث
    /// أَبيَضَ الصَفحَة، فَيَقَع أَبيَضُ الحُروف على أَبيَض. مَقيس:
    /// الطَبَقَة السادِسَة على <c>/{slug}/me</c> أَعطَت «‏«—» نِسبَة ‏1.00».
    /// </para>
    ///
    /// <para><b>والقياسُ حينَ صَدَقَ كَشَفَ ما تَحتَه</b>: ثَلاثَةٌ مِن
    /// الأَلوان الثَمانِيَة (‏teal، وemerald، وyellow) كانَت تَحمِل حُروفاً
    /// بَيضاءَ بِنِسبَةٍ دونَ ‏3 — عَطَبٌ حَقيقيّ كانَ التَدَرُّجُ
    /// يَستُرُه عَن الأَداةِ لا عَن العَين. فَعُتِّمَت الثَمانِيَة كُلُّها
    /// إلى ‏58% مِن قيمَتِها (‏نَفسُ الأَلوان، أَعمَق)، وأَدنى نِسبَةٍ
    /// بَعدَ ذلك ‏5.2 — أَي فَوقَ عَتَبَة النَصّ الكَبير (‏3) وفَوقَ
    /// عَتَبَة النَصّ العاديّ (‏4.5) مَعاً.</para>
    /// </summary>
    private string _background
    {
        get
        {
            var (from, to) = _palette[(int)(Fnv1a(Name ?? "") % (uint)_palette.Length)];
            return $"background-color:{from}; background-image:linear-gradient(135deg, {from}, {to});";
        }
    }

    /// <summary>‏FNV-1a ‏32-بِت فَوق بايتات UTF-8 — ثابِتَة عَبر
    /// العَمَلِيّات والمِنَصّات، بِخِلاف تَجزِئَة الإطار.</summary>
    private static uint Fnv1a(string s)
    {
        var h = 2166136261u;
        foreach (var b in System.Text.Encoding.UTF8.GetBytes(s))
        {
            h ^= b;
            h *= 16777619u;
        }
        return h;
    }

    /// <summary>
    /// <para>ثَمانِيَةُ أَزواج — نَفسُ العائِلات اللَونِيَّة الَّتي
    /// كانَت، مُعَتَّمَةً إلى ‏58% لِيَقرَأ الأَبيَضُ فَوقَها. واللَونُ
    /// الأَوَّل هُوَ <c>background-color</c> المَقيس.</para>
    ///
    /// <para>الأَصلُ قَبلَ التَعتيم، بِالتَرتيب نَفسِه:
    /// ‏6366f1→8b5cf6، ‏14b8a6→0ea5e9، ‏f59e0b→ef4444، ‏10b981→84cc16،
    /// ‏ec4899→8b5cf6، ‏0891b2→2563eb، ‏eab308→f97316، ‏7c3aed→db2777.</para>
    /// </summary>
    private static readonly (string From, string To)[] _palette =
    {
        ("#393b8c", "#51358f"), // indigo-violet
        ("#0c6b60", "#086087"), // teal-cyan
        ("#8e5c06", "#8b2727"), // amber-red
        ("#096b4b", "#4d760d"), // emerald-lime
        ("#892a59", "#51358f"), // pink-violet
        ("#055467", "#153988"), // cyan-blue
        ("#886805", "#90430d"), // yellow-orange
        ("#48228a", "#7f1745"), // violet-pink
    };
}
