@namespace ACommerce.Widgets

@*
    AcAvatar — صورة بروفايل دائريّة بـ fallback ذكيّ:
      1. ImageUrl موجود + IUrlAllowlist يُجيزه ⇒ <img>
      2. وإلّا initials (حتى حرفَين) فوق gradient مُشتقّ من Name (hash-based).
      3. لا Name ⇒ glyph عامّ "?".

    Size = القطر بالـ px. Default 40.
    CSS_CLASSES: ac-avatar, ac-avatar-img, ac-avatar-initials
*@

<div class="ac-avatar @(ExtraClass ?? "")"
     style="width:@(Size)px; height:@(Size)px;@(IsImage ? "" : $" background:{_gradient};")"
     role="img" aria-label="@(Name ?? FallbackAriaLabel)">
    @if (IsImage)
    {
        <img class="ac-avatar-img" src="@ImageUrl" alt="@(Name ?? "")" loading="lazy" />
    }
    else
    {
        <span class="ac-avatar-initials" style="font-size:@(Size * 0.4)px;">@Initials</span>
    }
</div>

@code {
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public int Size { get; set; } = 40;
    [Parameter] public string? ExtraClass { get; set; }
    [Parameter] public string FallbackAriaLabel { get; set; } = "Avatar";

    private bool IsImage => !string.IsNullOrWhiteSpace(ImageUrl);

    private string Initials
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Name)) return "?";
            var parts = Name.Trim().Split(' ', 2, StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 1)
                return parts[0].Length > 0
                    ? parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant()
                    : "?";
            return ($"{parts[0][0]}{parts[1][0]}").ToUpperInvariant();
        }
    }

    /// <summary>
    /// gradient مُشتقّ من hash ثابت للاسم. نَفس الاسم ⇒ نَفس اللون دائماً
    /// (المستخدم يَتعرّف على المراسل بلونه عبر التَطبيق).
    ///
    /// <para><b>ولِماذا FNV-1a لا <c>string.GetHashCode()</c></b>: تَجزئَة
    /// السَلاسِل في .NET Core <b>عَشوائِيَّة لِكُلّ عَمَلِيَّة</b>، فَكانَ
    /// اللَونُ يَتَبَدَّل مَعَ كُلّ إقلاع — نَقيضَ ما يَعِدُ بِه السَطرُ
    /// أَعلاه حَرفاً. مَقيس (‏2026-08-16): نَفسُ الاسم أَعطى الفَهارِس
    /// ‏6 ثُمَّ 5 ثُمَّ 0 في ثَلاث عَمَلِيّات. ولَيسَ هذا تَجميلاً: ما
    /// دامَ اللَونُ يَتَقَلَّب، لا يُمكِن أَن تُقارَن شاشَةٌ فيها
    /// أَفاتار بِلَقطَةٍ سابِقَة — أَي أَنّ التَكافُؤَ الصِفريّ
    /// مُستَحيلٌ بِالبِنيَة على أَربَع شاشات.</para>
    /// </summary>
    private string _gradient => _palette[StableIndex(Name ?? "") % _palette.Length];

    /// <summary>‏FNV-1a فَوقَ وَحَدات UTF-16 — ثابِتَة عَبرَ العَمَلِيّات
    /// وعَبرَ الأَجهِزَة، وهذا كُلُّ المَطلوب مِنها.</summary>
    private static int StableIndex(string s)
    {
        unchecked
        {
            uint h = 2166136261;
            foreach (var c in s) { h ^= c; h *= 16777619; }
            return (int)(h & 0x7FFFFFFF);
        }
    }

    /// <summary>
    /// ثَمانِيَةُ أَزواج. الأَربَعَةُ المُستَبدَلَة (‏2026-08-16) كانَت
    /// <b>دونَ 3:1</b> لِنَصٍّ أَبيَض في أَسوَأ نُقطَةٍ مِن التَدَرُّج
    /// (‏1.92…2.49)، وصارَت ‏4.92…5.47 — أَي تَبلُغُ ‏4.5 عِندَ كُلّ
    /// مَقاس.
    ///
    /// <para><b>ولِماذا العَتَبَتان</b>: مَقاسُ الخَطّ هُنا
    /// <c>Size × 0.4</c>، فَأَصغَرُ أَفاتار (‏<c>Size=40</c> في
    /// <c>ChatRoom</c>) يُعطي ‏16px — <b>نَصٌّ عادِيٌّ لا كَبير</b>
    /// مَهما ثَقُلَ وَزنُه — فَعَتَبَتُه ‏4.5؛ وما فَوقَه
    /// (‏48/56/64 ⇐ 19.2/22.4/25.6px) نَصٌّ كَبير عَتَبَتُه ‏3.</para>
    ///
    /// <para><b>ودَينٌ مُعلَنٌ لا يُكتَم</b>: الأَربَعَةُ الَّتي لَم
    /// تُمَسّ تَبلُغ ‏3:1 فَتَسلَم عِندَ ‏Size ≥ 48، وثَلاثَةٌ مِنها
    /// دونَ ‏4.5 (‏إندِغو ‏4.23، ‏cyan-blue ‏3.68، ‏pink-violet ‏3.53)
    /// فَتَسقُط عِندَ <c>Size=40</c> وَحدَه. أُبقِيَت بِقَرار مالِك
    /// مُعلَن — والقَرارُ كانَ على العَتَبَة ‏3، ثُمَّ قيسَ أَنّ
    /// ‏`ChatRoom` يَقَع تَحتَ ‏4.5. مُثَبَّتٌ بِالرَقَم في
    /// <c>AcAvatarPaletteTests</c> كَي لا يَصيرَ سَهواً.</para>
    /// </summary>
    private static readonly string[] _palette =
    {
        "linear-gradient(135deg, #6366f1, #8b5cf6)", // إندِغو-بنفسجيّ
        "linear-gradient(135deg, #0f766e, #0369a1)", // teal-cyan   (كانَ #14b8a6/#0ea5e9 — 2.49)
        "linear-gradient(135deg, #b45309, #b91c1c)", // عنبر-أحمر   (كانَ #f59e0b/#ef4444 — 2.15)
        "linear-gradient(135deg, #047857, #4d7c0f)", // emerald-lime (كانَ #10b981/#84cc16 — 1.98)
        "linear-gradient(135deg, #ec4899, #8b5cf6)", // pink-violet
        "linear-gradient(135deg, #0891b2, #2563eb)", // cyan-blue
        "linear-gradient(135deg, #a16207, #c2410c)", // yellow-orange (كانَ #eab308/#f97316 — 1.92)
        "linear-gradient(135deg, #7c3aed, #db2777)", // violet-pink
    };
}
