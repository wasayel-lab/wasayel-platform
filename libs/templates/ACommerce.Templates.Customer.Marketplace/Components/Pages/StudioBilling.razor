@page "/studio/billing"
@inject Services.Incubator.StudioAuth Auth
@inject Services.Incubator.StudioTierService TierSvc
@using ACommerce.Templates.Customer.Marketplace.Services.Incubator
@using ACommerce.Kit.Subscriptions
@inject L L

@*
    صَفحَة الباقات والاستِهلاك.

    **ولا تَبيع** (‏2026-08-30): الدَرَجَةُ بِسِعرٍ لا تُمنَح ذاتِيّاً،
    فَلا يُرسَم لَها زِرّ — نَفسُ ما فَعَلَته `Plans.razor` بِـ
    `PlanPurchasePolicy.Visible` بَعدَ ‏ADR-003، ولِنَفسِ السَبَبِ حَرفاً:
    مَدخَلٌ يَرُدُّ «لَيسَ بَعد» لَيسَ مَدخَلاً (القاعِدَة ١٢). والشاشَةُ
    والنُقطَةُ يَقرَآنِ **الدالَّةَ نَفسَها** (`StudioTierPurchase`)،
    فَلا تَعرِض الشاشَةُ ما تَرُدُّه النُقطَة.

    وانحِرافٌ واحِدٌ عَن `Visible` يُقالُ ولا يُبتلَع: **دَرَجَةُ
    المُستَخدِمِ الحالِيَّةُ تُرسَم ولَو لَم تُبَع** — فَهي بَيانُ حالٍ
    لا عَرضُ بَيع، وزِرُّها مُعَطَّلٌ كَما كان. وبِدونِها تَصير الشَبَكَةُ
    فارِغَةً تَماماً، فَتُرى الصَفحَةُ مَكسورَةً لا صادِقَة.
*@

<StudioShell Title="@(L["studio.billing.head_title"])" Active="">
    <ChildContent>
        <div class="studio-page-head">
            <h1>@L.Markup("studio.billing.title")</h1>
            <p>@L.Markup("studio.billing.subtitle")</p>
        </div>

        @* رَمزُ الخَرقِ يَصير جُملَةً مَقروءَة. **ولا يُبلَغ بِنَقرَةٍ
           عادِيَّة** — الدَرَجَةُ المَدفوعَةُ لا يُرسَم لَها زِرّ —
           لكِنّ طَلَباً مُباشِراً يُرَدُّ بِرِسالَةٍ لا بِصَمت. نَفسُ
           شَكلِ `Plans.razor.ErrorMessage`. *@
        @if (ErrorMessage is not null)
        {
            @* اللَونانِ رَمزانِ لا حَرفِيّان — الطَبَقَةُ ١ تُحمِرُّ عَلى
               أَيّ لَونٍ مَكتوبٍ في السَطر. *@
            <div class="st-card" style="border:1px solid var(--st-danger);color:var(--st-danger-text);margin-bottom:18px;">
                @ErrorMessage
            </div>
        }

        @if (currentTier is not null)
        {
            <div class="st-card" style="background:var(--st-primary-50);border:1px solid var(--st-primary);margin-bottom:18px;">
                @((MarkupString)"\n                ")@L.Markup("studio.billing.current") <strong>@TierCatalog.For(currentTier).LabelAr</strong>
                @if (user is not null)
                {
                    var l = TierCatalog.For(currentTier);
                    <span style="color:var(--st-muted);font-size:13px;display:block;margin-top:6px;">
                        @((MarkupString)"\n                        ")@L.Markup("studio.billing.consumed")
                        @user.AnalysesUsed / @l.AnalysesPerMonth @L.Markup("studio.billing.unit_analyses") ·
                        @user.RefinesUsed / @l.RefinesPerMonth @L.Markup("studio.billing.unit_refines") ·
                        @user.StoresBuilt / @l.StoresMax @L.Markup("studio.billing.unit_apps")@((MarkupString)"\n                    ")
                    </span>
                }
            </div>
        }

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;">
            @foreach (var t in TierCatalog.All.Values.Where(Shown))
            {
                var isCurrent = t.Tier == currentTier;
                <div class="st-card"
                     style="@(isCurrent ? "border:2px solid var(--st-primary);" : "")">
                    <div style="font-size:13px;color:var(--st-muted);font-weight:700;letter-spacing:.04em;">
                        @t.LabelAr
                    </div>
                    <div style="font-size:28px;font-weight:800;margin:4px 0 14px;">
                        @* الوَحدَة مِن `Money.Unit()` لا مِن قيمَة المِفتاح
                           (‏docs/I18N.md §٢-ب). والمِفتاح «{0} / شَهر»
                           فَيَبقى المُخرَج «ر.س / شَهر» حَرفاً بِحَرف. *@
                        @t.MonthlyPriceSar <span style="font-size:13px;color:var(--st-muted);font-weight:400;">@((MarkupString)L.Format("studio.billing.per_month", Money.Unit()))</span>
                    </div>
                    <ul style="margin:0 0 16px;padding-inline-start:18px;font-size:14px;line-height:1.9;color:var(--st-ink-700);">
                        <li>@t.AnalysesPerMonth @L.Markup("studio.billing.per_analyses")</li>
                        <li>@t.RefinesPerMonth @L.Markup("studio.billing.per_refines")</li>
                        <li>@t.StoresMax @L.Markup("studio.billing.per_apps")</li>
                        @if (t.AllowExport)        { <li>@L.Markup("studio.billing.export")</li> }
                        @* «أَنماط مُخَصَّصَة» سُحِبَت مِن البَيع: لا مَسار
                           يَختار فيه المُستَخدِم نَمَط تَطبيقِه أَصلاً — النَمَط
                           تَستَنبِطُه قَواعِد PatternMatcher مِن إجابات الاكتِشاف
                           ويَبنيه ‏/studio/s/{id}/build بِلا حَقل نَمَط. تَعود
                           حينَ يوجَد المَسار، لا قَبلَه. *@
                    </ul>
                    @if (isCurrent)
                    {
                        <button class="st-btn st-btn-ghost st-btn-block" disabled>@L.Markup("studio.billing.current_plan")</button>
                    }
                    else
                    {
                        <form method="post" action="@($"/studio/billing/select?tier={t.Tier}")">
                            <button type="submit" class="st-btn st-btn-primary st-btn-block">
                                @((MarkupString)"\n                                ")@L.Markup("studio.billing.choose")@((MarkupString)"\n                            ")
                            </button>
                        </form>
                    }
                </div>
            }
        </div>

        <p style="margin-top:18px;color:var(--st-muted);font-size:12px;text-align:center;">
            @((MarkupString)"\n            ")@L.Markup("studio.billing.note")@((MarkupString)"\n        ")
        </p>
    </ChildContent>
</StudioShell>

@code {
    StudioUser? user;
    string? currentTier;

    [SupplyParameterFromQuery] public string? Err { get; set; }

    /// <summary>رَمزُ الخَرقِ مِن <c>PlanPurchasePolicy</c> — نَفسُ
    /// المَعجَمِ المُغلَقِ الَّذي تَقرَؤُه <c>Plans.razor</c>، فَلا
    /// مَعجَمَ ثانٍ يَنجَرِف.</summary>
    string? ErrorMessage => Err switch
    {
        PlanPurchasePolicy.PaidUnavailable => L["studio.billing.err_paid_unavailable"],
        PlanPurchasePolicy.PlanNotFound    => L["studio.billing.err_tier"],
        _ => null
    };

    /// <summary>تُرسَم إن كانَت تُمنَح ذاتِيّاً، أَو كانَت دَرَجَةَ
    /// المُستَخدِمِ الحالِيَّة (بَيانُ حالٍ لا عَرضُ بَيع).</summary>
    bool Shown(TierLimits t)
        => StudioTierPurchase.IsSelfGrantable(t.Tier) || t.Tier == currentTier;

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        user = await TierSvc.GetUserAsync(Auth.UserId!.Value);
        currentTier = user?.Tier ?? "spark";
    }
}
