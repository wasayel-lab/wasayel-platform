@page "/{slug}/me/edit"
@page "/{slug}/r/{role}/me/edit"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Accounts
@inject AuthSession Auth
@inject ACommerce.Templates.Customer.Marketplace.Services.DynamicAttributesService DynAttrs
@inject L L

<div class="acs-page">
@if (!Auth.IsAuthenticated)
{
    <AcEmptyState IconName="user"
                  Title="@(L["profile.login.title"])"
                  Message="@(L["profile.login.message"])"
                  ActionLabel="@(L["auth.action.login"])"
                  ActionHref="@AuthSession.LinkFor(Slug, Role, $"login?returnUrl=/{Slug}/me/edit")" />
}
else if (user is null || tenant is null)
{
    <AcLoadingState Message="@(L["common.state.loading"])" />
}
else
{
    <h1 class="acm-wizard-title">@L.Markup("profile.page.title")</h1>

    <form method="post" action="@($"/{Slug}/me/save")" enctype="multipart/form-data">
        @* عُد إلى نَفس صَفحَة الدَّور الَّتي دَخَلنا مِنها. *@
        <input type="hidden" name="returnUrl" value="@AuthSession.LinkFor(Slug, Role, "me")" />

        <AcCard>
            <ChildContent>
                <h3 style="margin-top:0;">@L.Markup("profile.section.basic")</h3>

                @* صورَة المَلَفّ الشَخصيّ — تُرفَع عَبر IFileStorage. *@
                <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px;">
                    @if (!string.IsNullOrEmpty(user.AvatarUrl))
                    {
                        <img src="@user.AvatarUrl" alt="@(L["profile.avatar.alt"])"
                             style="width:64px;height:64px;border-radius:50%;object-fit:cover;" />
                    }
                    else
                    {
                        <AcAvatar Name="@user.FullName" Size="64" />
                    }
                    <div style="flex:1;">
                        <label style="font-size:13px;color:var(--ac-text-muted);display:block;margin-bottom:4px;">
                            @((MarkupString)"\n                            ")@L.Markup("profile.avatar.label")@((MarkupString)"\n                        ")
                        </label>
                        <input type="file" name="avatar" accept="image/png,image/jpeg,image/webp" class="ac-input" />
                    </div>
                </div>

                <AcField Label="@(L["profile.field.full_name"])" Required="true">
                    <input type="text" name="fullName" value="@user.FullName"
                           required maxlength="60" class="ac-input" />
                </AcField>

                <AcField Label="@(L["profile.field.phone"])">
                    <input type="text" value="@user.Phone" readonly
                           class="ac-input" style="background:var(--ac-bg-alt);direction:ltr;" />
                </AcField>

                @if (!string.IsNullOrEmpty(user.NationalId))
                {
                    <AcField Label="@(L["profile.field.national_id"])">
                        <input type="text" value="@user.NationalId" readonly
                               class="ac-input" style="background:var(--ac-bg-alt);direction:ltr;" />
                    </AcField>
                }
            </ChildContent>
        </AcCard>

        @* الدَور النَّشِط — مُختار الأَدوار يَظهَر فَقَط عِندَ الدُّخول
           بِلا دَور في الـ URL (مَثَلاً مِن /{slug}/me/edit مُباشَرَة).
           إذا دَخَلَ المُستَخدِم مِن /r/{role}/me/edit فالدَور مَعروف
           وَنُثَبِّتُه ضِمنياً — لا داعِيَ لِسؤالِه مَرَّةً أُخرى. *@
        @* الدَورُ الإداريُّ لا يُعرَضُ هُنا — نَفسُ تَصفِيَةِ
           `RolePicker.razor` ونَفسُ السِياسَةِ الَّتي تَرُدُّ
           `POST /{slug}/me/save`. وكانَ يُعرَضُ لِكُلِّ عُضو، فَيَرفَعُ
           نَفسَه بِنَقرَة (‏ADR-028). *@
        @{
            var selectableRoles = ACommerce.Templates.Customer.Marketplace.Gates
                .SelfGrantPolicy.SelfGrantable(tenant.Roles)
                .OrderBy(r => r.SortOrder).ToList();
        }
        @if (selectableRoles.Count > 0 && string.IsNullOrEmpty(Role))
        {
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("profile.section.role")</h3>
                    <div class="acm-radio-cards">
                        @foreach (var r in selectableRoles)
                        {
                            <label class="acm-radio-card">
                                <input type="radio" name="activeRole" value="@r.Slug"
                                       checked="@(user.ActiveRole == r.Slug || (string.IsNullOrEmpty(user.ActiveRole) && r.IsDefault))" />
                                <span class="acm-radio-card-body">
                                    <strong><AcIcon Name="@ACommerce.Widgets.AcIconMap.Resolve(r.Icon, "user")" Size="16" /> @r.Label</strong>
                                    @if (!string.IsNullOrEmpty(r.Description))
                                    {
                                        <span>@r.Description</span>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                </ChildContent>
            </AcCard>
        }
        else if (!string.IsNullOrEmpty(Role) &&
                 !ACommerce.Templates.Customer.Marketplace.Gates.SelfGrantPolicy.IsAdminSlug(Role))
        {
            @* الدَور مَفروض مِن الـ URL — مَرِّرْه بِـ hidden field
               حَتَّى يَستَقبِله /me/save كَ activeRole بِلا تَغيير.
               **وإن كانَ إداريّاً لا يُمَرَّر**: النُقطَةُ تَرُدُّه،
               فَتَمريرُه كانَ يُفشِلُ حِفظَ اسمِ الإداريِّ نَفسِه. وبِلا
               الحَقلِ يَبقى `ActiveRole` كَما هُوَ — وهُوَ المَطلوب. *@
            <input type="hidden" name="activeRole" value="@Role" />
        }

        @* خَصائِص البروفايل العامّ — مَرتَبِطَة بِـ ProfileScopeId
           sentinel. مُشتَرَكَة بَين كُلّ الأَدوار. *@
        @if (dynFields is { Count: > 0 })
        {
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("profile.section.extra")</h3>
                    @foreach (var f in dynFields)
                    {
                        <AcField Label="@f.Label" Required="@f.IsRequired">
                            @RenderDynInput(f, "attr_", user.AttributesJson)
                        </AcField>
                    }
                </ChildContent>
            </AcCard>
        }

        @* خَصائِص بروفايل خاصَّة بِكُلّ دَور — تُعرَض كَ <details> قابِلَة
           لِلطَيّ. كُلّ قِسم لَه prefix فَريد role_{roleSlug}_attr_{code}
           حَتَّى يَستَطيع POST handler فَصلُها وَتَخزينها في
           user.RoleAttributesJson[roleSlug][code]. *@
        @* خَصائِص دَور: لَو دَخَلنا مِن /r/{role}/me/edit نَعرِض حُقول
           هذا الدَّور فَقَط بِلا طَيّ (لا داعِيَ، فالسِّياق صَريح)؛
           وإلَّا نَعرِض كُلّ الأَدوار كَأَقسام قابِلَة لِلطَيّ. *@
        @{
            var visibleRoles = string.IsNullOrEmpty(Role)
                ? roleFields
                : roleFields.Where(r => r.Slug == Role).ToList();
        }
        @foreach (var (rslug, rlabel, ricon, fields) in visibleRoles)
        {
            if (fields.Count == 0) continue;
            var roleValues = user.RoleAttributesJson.TryGetValue(rslug, out var rv)
                ? rv : new Dictionary<string, string>();
            var isActive = user.ActiveRole == rslug || rslug == Role;
            var forceOpen = !string.IsNullOrEmpty(Role);
            <AcCard>
                <ChildContent>
                    @if (forceOpen)
                    {
                        <h3 style="margin-top:0;"><AcIcon Name="@ACommerce.Widgets.AcIconMap.Resolve(ricon, "user")" Size="18" /> @L.Markup("profile.role.data_of") @rlabel</h3>
                        @foreach (var f in fields)
                        {
                            <AcField Label="@f.Label" Required="@f.IsRequired">
                                @RenderDynInput(f, $"role_{rslug}_attr_", roleValues)
                            </AcField>
                        }
                    }
                    else
                    {
                        <details open="@isActive">
                            <summary style="cursor:pointer;font-weight:700;list-style:none;">
                                <AcIcon Name="@ACommerce.Widgets.AcIconMap.Resolve(ricon, "user")" Size="16" /> @L.Markup("profile.role.data_of") @rlabel
                                @if (isActive)
                                {
                                    <span class="ac-chip ac-chip-sm" style="margin-inline-start:6px;">@L.Markup("profile.role.active_chip")</span>
                                }
                            </summary>
                            <div style="margin-top:12px;">
                                @foreach (var f in fields)
                                {
                                    <AcField Label="@f.Label" Required="@(f.IsRequired && isActive)">
                                        @RenderDynInput(f, $"role_{rslug}_attr_", roleValues)
                                    </AcField>
                                }
                            </div>
                        </details>
                    }
                </ChildContent>
            </AcCard>
        }

        <div style="display:flex;gap:8px;margin-top:16px;">
            <a class="ac-btn ac-btn-ghost" href="@AuthSession.LinkFor(Slug, Role, $"me")">@L.Markup("profile.action.cancel")</a>
            <button type="submit" class="ac-btn ac-btn-primary ac-btn-lg ac-btn-block">
                <AcIcon Name="check" Size="18" /> @L.Markup("profile.action.save")@((MarkupString)"\n            ")
            </button>
        </div>
    </form>
}
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    User? user;
    Tenant? tenant;
    IReadOnlyList<ACommerce.Templates.Customer.Marketplace.Services.DynField>? dynFields;
    List<(string Slug, string Label, string Icon,
          IReadOnlyList<ACommerce.Templates.Customer.Marketplace.Services.DynField> Fields)> roleFields = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsAuthenticated) return;
        tenant = await Tenants.FindAsync(Slug);
        user = await Accounts.ProfileAsync(Slug, Auth.UserId!.Value);
        dynFields = await DynAttrs.GetForProfileAsync(Slug);

        if (tenant is not null)
        {
            foreach (var r in tenant.Roles.OrderBy(r => r.SortOrder))
            {
                // ادمِج حُقول الكاتالوج (Role.Fields، built-in) مَع أَيّ حُقول
                // ديناميكِيَّة أَضافَها المُصَمِّم تَحت scope الدَور. الكاتالوج
                // يَسبِق لِأَنَّه مَصدَر التَّعريف الأَوَّليّ.
                var catalogFields = r.Fields.Select(f =>
                    new ACommerce.Templates.Customer.Marketplace.Services.DynField(
                        Code: f.Code,
                        Label: f.Label,
                        Type: ParseDynType(f.Type),
                        IsRequired: f.IsRequired,
                        DefaultValue: null,
                        Options: f.Options.Select(o =>
                            new ACommerce.Templates.Customer.Marketplace.Services.DynOption(
                                Value: o.Value, Label: o.Label)).ToList()
                    )).ToList();
                var dynamicFields = await DynAttrs.GetForRoleProfileAsync(Slug, r.Slug);
                var combined = catalogFields
                    .Concat(dynamicFields.Where(d => !catalogFields.Any(c => c.Code == d.Code)))
                    .ToList();
                roleFields.Add((r.Slug, r.Label, r.Icon ?? "", combined));
            }
        }
    }

    static ACommerce.Templates.Customer.Marketplace.Services.DynFieldType ParseDynType(string s)
        => s switch
        {
            "Number"       => ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Number,
            "LongText"     => ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.LongText,
            "Boolean"      => ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Boolean,
            "SingleSelect" => ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.SingleSelect,
            "MultiSelect"  => ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.MultiSelect,
            "Date"         => ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Date,
            _              => ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Text
        };

    RenderFragment RenderDynInput(
        ACommerce.Templates.Customer.Marketplace.Services.DynField f,
        string prefix,
        Dictionary<string, string> currentValues) => @<text>
        @{
            var name = prefix + f.Code;
            var def = currentValues.TryGetValue(f.Code, out var raw) ? raw : f.DefaultValue;
        }
        @switch (f.Type)
        {
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Number:
                <input type="number" name="@name" class="ac-input"
                       required="@f.IsRequired" value="@def" inputmode="numeric" />
                break;
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.LongText:
                <textarea name="@name" rows="3" class="ac-input"
                          required="@f.IsRequired" style="resize:vertical;font-family:inherit;">@def</textarea>
                break;
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Boolean:
                <label style="display:inline-flex;align-items:center;gap:8px;">
                    <input type="checkbox" name="@name" value="true" checked="@(def == "True" || def == "true")" />
                    <span>@L.Markup("common.option.yes")</span>
                </label>
                break;
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.SingleSelect:
                <select name="@name" class="ac-input" required="@f.IsRequired">
                    <option value="">@L.Markup("common.option.choose")</option>
                    @foreach (var o in f.Options)
                    {
                        <option value="@o.Value" selected="@(def == o.Value)">@o.Label</option>
                    }
                </select>
                break;
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Date:
                <input type="date" name="@name" class="ac-input" required="@f.IsRequired" value="@def" />
                break;
            default:
                <input type="text" name="@name" class="ac-input" required="@f.IsRequired"
                       value="@def" maxlength="200" />
                break;
        }
    </text>;
}
