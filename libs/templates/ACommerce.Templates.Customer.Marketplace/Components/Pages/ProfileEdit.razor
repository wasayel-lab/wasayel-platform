@page "/{slug}/me/edit"
@inject IDocumentStore Store
@inject AuthSession Auth
@inject ACommerce.Templates.Customer.Marketplace.Services.DynamicAttributesService DynAttrs

<div class="acs-page">
@if (!Auth.IsAuthenticated)
{
    <AcEmptyState IconName="user"
                  Title="تَحتاج تَسجيل دُخول"
                  Message="سَجِّل دُخولك لِتَعديل بَياناتك."
                  ActionLabel="تَسجيل دُخول"
                  ActionHref="@($"/{Slug}/login?returnUrl=/{Slug}/me/edit")" />
}
else if (user is null || tenant is null)
{
    <AcLoadingState Message="جارٍ التَحميل…" />
}
else
{
    <h1 class="acm-wizard-title">تَعديل المَلَفّ الشَخصيّ</h1>

    <form method="post" action="@($"/{Slug}/me/save")">

        <AcCard>
            <ChildContent>
                <h3 style="margin-top:0;">المَعلومات الأَساسِيَّة</h3>

                <AcField Label="الاسم الكامِل" Required="true">
                    <input type="text" name="fullName" value="@user.FullName"
                           required maxlength="60" class="ac-input" />
                </AcField>

                <AcField Label="الهاتف">
                    <input type="text" value="@user.Phone" readonly
                           class="ac-input" style="background:var(--ac-bg-alt);direction:ltr;" />
                </AcField>

                @if (!string.IsNullOrEmpty(user.NationalId))
                {
                    <AcField Label="رَقم الهُويَّة">
                        <input type="text" value="@user.NationalId" readonly
                               class="ac-input" style="background:var(--ac-bg-alt);direction:ltr;" />
                    </AcField>
                }
            </ChildContent>
        </AcCard>

        @* الدَور النَّشِط — يَظهَر فَقَط لَو المَتجَر يُعَرِّف أَدواراً
           (مَثَلاً إنجيز: rider/driver). مَتجَر بِلا أَدوار يَتَجاوَز كامِل
           هذا القِسم وَيَستَخدِم البروفايل العامّ فَقَط. *@
        @if (tenant.Roles.Count > 0)
        {
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">الدَور</h3>
                    <div class="acm-radio-cards">
                        @foreach (var r in tenant.Roles.OrderBy(r => r.SortOrder))
                        {
                            <label class="acm-radio-card">
                                <input type="radio" name="activeRole" value="@r.Slug"
                                       checked="@(user.ActiveRole == r.Slug || (string.IsNullOrEmpty(user.ActiveRole) && r.IsDefault))" />
                                <span class="acm-radio-card-body">
                                    <strong>@(r.Icon ?? "👤") @r.Label</strong>
                                    @if (!string.IsNullOrEmpty(r.Description))
                                    {
                                        <span>@r.Description</span>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                </ChildContent>
            </AcCard>
        }

        @* خَصائِص البروفايل العامّ — مَرتَبِطَة بِـ ProfileScopeId
           sentinel. مُشتَرَكَة بَين كُلّ الأَدوار. *@
        @if (dynFields is { Count: > 0 })
        {
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">مَعلومات إضافِيَّة</h3>
                    @foreach (var f in dynFields)
                    {
                        <AcField Label="@f.Label" Required="@f.IsRequired">
                            @RenderDynInput(f, "attr_", user.AttributesJson)
                        </AcField>
                    }
                </ChildContent>
            </AcCard>
        }

        @* خَصائِص بروفايل خاصَّة بِكُلّ دَور — تُعرَض كَ <details> قابِلَة
           لِلطَيّ. كُلّ قِسم لَه prefix فَريد role_{roleSlug}_attr_{code}
           حَتَّى يَستَطيع POST handler فَصلُها وَتَخزينها في
           user.RoleAttributesJson[roleSlug][code]. *@
        @foreach (var (rslug, rlabel, ricon, fields) in roleFields)
        {
            if (fields.Count == 0) continue;
            var roleValues = user.RoleAttributesJson.TryGetValue(rslug, out var rv)
                ? rv : new Dictionary<string, string>();
            var isActive = user.ActiveRole == rslug;
            <AcCard>
                <ChildContent>
                    <details open="@isActive">
                        <summary style="cursor:pointer;font-weight:700;list-style:none;">
                            @ricon بَيانات دَور @rlabel
                            @if (isActive)
                            {
                                <span class="ac-chip ac-chip-sm" style="margin-inline-start:6px;">نَشِط</span>
                            }
                        </summary>
                        <div style="margin-top:12px;">
                            @foreach (var f in fields)
                            {
                                <AcField Label="@f.Label" Required="@(f.IsRequired && isActive)">
                                    @RenderDynInput(f, $"role_{rslug}_attr_", roleValues)
                                </AcField>
                            }
                        </div>
                    </details>
                </ChildContent>
            </AcCard>
        }

        <div style="display:flex;gap:8px;margin-top:16px;">
            <a class="ac-btn ac-btn-ghost" href="@($"/{Slug}/me")">إلغاء</a>
            <button type="submit" class="ac-btn ac-btn-primary ac-btn-lg ac-btn-block">
                <AcIcon Name="check" Size="18" /> حِفظ التَعديلات
            </button>
        </div>
    </form>
}
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    User? user;
    Tenant? tenant;
    IReadOnlyList<ACommerce.Templates.Customer.Marketplace.Services.DynField>? dynFields;
    List<(string Slug, string Label, string Icon,
          IReadOnlyList<ACommerce.Templates.Customer.Marketplace.Services.DynField> Fields)> roleFields = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsAuthenticated) return;
        await using var g = Store.QuerySession();
        tenant = await g.LoadAsync<Tenant>(Slug);
        await using var s = Store.QuerySession(Slug);
        user = await s.LoadAsync<User>(Auth.UserId!.Value);
        dynFields = await DynAttrs.GetForProfileAsync(Slug);

        if (tenant is not null)
        {
            foreach (var r in tenant.Roles.OrderBy(r => r.SortOrder))
            {
                var fields = await DynAttrs.GetForRoleProfileAsync(Slug, r.Slug);
                roleFields.Add((r.Slug, r.Label, r.Icon ?? "👤", fields));
            }
        }
    }

    RenderFragment RenderDynInput(
        ACommerce.Templates.Customer.Marketplace.Services.DynField f,
        string prefix,
        Dictionary<string, string> currentValues) => @<text>
        @{
            var name = prefix + f.Code;
            var def = currentValues.TryGetValue(f.Code, out var raw) ? raw : f.DefaultValue;
        }
        @switch (f.Type)
        {
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Number:
                <input type="number" name="@name" class="ac-input"
                       required="@f.IsRequired" value="@def" inputmode="numeric" />
                break;
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.LongText:
                <textarea name="@name" rows="3" class="ac-input"
                          required="@f.IsRequired" style="resize:vertical;font-family:inherit;">@def</textarea>
                break;
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Boolean:
                <label style="display:inline-flex;align-items:center;gap:8px;">
                    <input type="checkbox" name="@name" value="true" checked="@(def == "True" || def == "true")" />
                    <span>نَعَم</span>
                </label>
                break;
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.SingleSelect:
                <select name="@name" class="ac-input" required="@f.IsRequired">
                    <option value="">— اختَر —</option>
                    @foreach (var o in f.Options)
                    {
                        <option value="@o.Value" selected="@(def == o.Value)">@o.Label</option>
                    }
                </select>
                break;
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Date:
                <input type="date" name="@name" class="ac-input" required="@f.IsRequired" value="@def" />
                break;
            default:
                <input type="text" name="@name" class="ac-input" required="@f.IsRequired"
                       value="@def" maxlength="200" />
                break;
        }
    </text>;
}
