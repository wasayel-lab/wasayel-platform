@page "/{slug}/me/delete"
@page "/{slug}/r/{role}/me/delete"
@inject AuthSession Auth
@inject IHttpContextAccessor HttpCtx
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Accounts
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.UserDataQueries Data
@inject L L

@*
    حَذفُ الحِسابِ داخِلَ التَطبيق — شَرطُ المَتجَر ‏5.1.1(v).

    **ولِماذا شاشَةٌ وسيطَةٌ لا زِرٌّ في «حِسابي»**: الحَذفُ لا رُجوعَ
    فيه، والزِرُّ المُجاوِرُ لِزِرِّ الخُروجِ يُضغَطُ سَهواً. والشاشَةُ
    تَحمِلُ ما لا يَحمِلُه زِرّ: **ما يُحذَفُ وما يَبقى ولِماذا** —
    وحَذفٌ يُخفي ما يُبقيه يَعِدُ بِما لا يَفي.

    **والنَصُّ كُلُّه مِن القامُوس** (القاعِدَة ١١): صِفرُ حَرفِيَّةٍ
    عَرَبِيَّةٍ في هذا المِلَفّ.
*@

<div class="acs-page">
    <h1 class="acm-wizard-title">@L.Markup("account.delete.title")</h1>

    @if (!Auth.IsAuthenticated)
    {
        <AcEmptyState IconName="user"
                      Title="@(L["me.login.title"])"
                      Message="@(L["me.login.message"])"
                      ActionLabel="@(L["auth.action.login"])"
                      ActionHref="@AuthSession.LinkFor(Slug, Role, $"login")" />
    }
    else
    {
        @* ‏(‏2026-10-29، د52) رَمزُ الصَفقَةِ الجارِيَةِ لا يُقرَأُ «لَم تُطابِق الكَلِمَة» — بِطاقَتُه أَدناه تَقولُ ما يَفعَلُه، وتُرسَمُ ما دامَت لَه صَفقَةٌ جارِيَة. *@
        @if (!string.IsNullOrEmpty(Err) && Err != ACommerce.Kit.Auth.AccountDeletion.OpenDeal && Err != ACommerce.Kit.Auth.AccountDeletion.OpenTrip)
        {
            <AcCard>
                <ChildContent>
                    <p style="color:var(--ac-danger-ink);margin:0;">@L.Markup("account.delete.mismatch")</p>
                </ChildContent>
            </AcCard>
        }

        <AcCard>
            <ChildContent>
                <p>@L.Markup("account.delete.lead")</p>

                <h3>@L.Markup("account.delete.removed_title")</h3>
                <p>@L.Markup("account.delete.removed_items")</p>

                <h3>@L.Markup("account.delete.retained_title")</h3>
                <p>@L.Markup("account.delete.retained_note")</p>

                <p style="color:var(--ac-danger-ink);font-weight:600;">@L.Markup("account.delete.irreversible")</p>
            </ChildContent>
        </AcCard>

        @* ‏(‏2026-10-29، قَرارُ المالِك د52 (١) «أ») صَفقَةٌ جارِيَةٌ تَمنَعُ الحَذف: تُرسَمُ خُطوَتُه التالِيَةُ لا استِمارَةٌ تَرُدُّها النُقطَة (القاعِدَة ١٢). *@
        @if (openDeals > 0)
        {
            <AcCard>
                <ChildContent>
                    <p style="color:var(--ac-danger-ink);">@L.Markup("account.delete.open_deal")</p>
                    <div style="display:flex;gap:8px;margin-top:12px;">
                        <a class="ac-btn ac-btn-primary" href="@AuthSession.LinkFor(Slug, Role, $"deals")">@L.Markup("account.delete.open_deal_action")</a>
                        <a class="ac-btn ac-btn-ghost" href="@AuthSession.LinkFor(Slug, Role, $"me")">@L.Markup("account.delete.cancel")</a>
                    </div>
                </ChildContent>
            </AcCard>
        }
        else if (openTrips.Count > 0)
        {
            @* ‏(‏2026-10-30، الموجَة ١٢ F2 · ٣ — F2B-1) رِحلَةٌ جارِيَةٌ تَمنَعُ الحَذفَ كَالصَفقَة (`open_trip`): يُرسَمُ رابِطُ صَفحَةِ إعلانِها — حَيثُ استِمارَتا الإنهاءِ
               والإلغاء — لا استِمارَةٌ تَرُدُّها النُقطَة (القاعِدَة ١٢). والصَفقَةُ قَبلَها: البابُ يَرُدُّ بِأَوَّلِ خَرق. *@
            <AcCard>
                <ChildContent>
                    <p style="color:var(--ac-danger-ink);">@L.Markup("account.delete.open_trip")</p>
                    <div style="display:flex;gap:8px;margin-top:12px;">
                        <a class="ac-btn ac-btn-primary" href="@AuthSession.LinkFor(Slug, Role, $"listings/{openTrips[0].Id}")">@L.Markup("account.delete.open_trip_action")</a>
                        <a class="ac-btn ac-btn-ghost" href="@AuthSession.LinkFor(Slug, Role, $"me")">@L.Markup("account.delete.cancel")</a>
                    </div>
                </ChildContent>
            </AcCard>
        }
        else
        {
        @* ‏(‏2026-10-30، تَدقيقُ الموجَة ١١ G-7، قَرارُ «أ» F2·٧) ثَمَنٌ نَقدِيٌّ يَرُدُّه البائِعُ عَن طَلَبٍ أُلغِيَ: تَحذيرٌ لا مَنع — لا كاتِبَ لِـ«رُدَّ» فَمَنعٌ بِه لا يُرفَع.
           كُلُّ صَفقَةٍ بِبائِعِها وسِلعَتِها ومَبلَغِها، والتَأكيدُ أَدناه هُوَ الإقرار. *@
        @if (owedCash.Count > 0)
        {
            <AcCard>
                <ChildContent>
                    <h3>@L.Markup("account.delete.cash_refund_title")</h3>
                    <p style="color:var(--ac-danger-ink);">@L.Markup("account.delete.cash_refund_lead")</p>
                    <ul style="margin:0;padding-inline-start:20px;">
                        @foreach (var d in owedCash)
                        {
                            <li>@L.Format("account.delete.cash_refund_row", string.IsNullOrWhiteSpace(d.CounterpartyName) ? L["account.delete.cash_refund_vendor"] : d.CounterpartyName, d.ListingTitle, d.AmountSar)</li>
                        }
                    </ul>
                </ChildContent>
            </AcCard>
        }
        <AcCard>
            <ChildContent>
                <form method="post" action="@($"/{Slug}/me/delete/confirm")" style="margin:0;">
                    <label for="confirm">@L.Markup("account.delete.confirm_label")</label>
                    <input id="confirm" name="confirm" type="text" class="ac-input"
                           autocomplete="off"
                           placeholder="@(L["account.delete.confirm_word"])" />

                    <div style="display:flex;gap:8px;margin-top:12px;">
                        <button type="submit" class="ac-btn ac-btn-danger">@L.Markup("account.delete.submit")@((MarkupString)"\n                        ")
                        </button>
                        <a class="ac-btn ac-btn-ghost"
                           href="@AuthSession.LinkFor(Slug, Role, $"me")">@L.Markup("account.delete.cancel")</a>
                    </div>
                </form>
            </ChildContent>
        </AcCard>
        }
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }

    /// <summary>رَمزُ الرَفضِ العائِدُ مِن النُقطَة — مِن مَعجَمِ
    /// <c>AccountDeletion.All</c> المُغلَق.</summary>
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }

    /// <summary>صَفَقاتُه الجارِيَة — <c>AccountQueries.OpenDealsAsync</c>، سُؤالُ النُقطَةِ بِعَينِه.</summary>
    int openDeals;

    /// <summary>رِحلاتُه الجارِيَة — <c>UserDataQueries.OpenTripsAsync</c>، سُؤالُ النُقطَةِ بِعَينِه (‏2026-10-30، F2B-1).</summary>
    IReadOnlyList<ACommerce.Kit.Offers.ListingMatch> openTrips = Array.Empty<ACommerce.Kit.Offers.ListingMatch>();

    /// <summary>صَفَقاتُه المُلغاةُ الَّتي يَرُدُّ فيها البائِعُ ثَمَناً نَقدِيّاً — <c>AccountErasure.CashRefundsOwed</c> (G-7).</summary>
    IReadOnlyList<ACommerce.Templates.Customer.Marketplace.Services.Deals.Deal> owedCash = Array.Empty<ACommerce.Templates.Customer.Marketplace.Services.Deals.Deal>();

    protected override async Task OnInitializedAsync()
    {
        if (HttpCtx.HttpContext is { } ctx) { Auth.SetTenant(Slug); Auth.Load(ctx, Slug); }
        if (!Auth.IsAuthenticated || Auth.UserId is null) return;
        openDeals = await Accounts.OpenDealsAsync(Slug, Auth.UserId.Value);
        openTrips = await Data.OpenTripsAsync(Slug, Auth.UserId.Value);
        owedCash = await Data.CashRefundsOwedAsync(Slug, Auth.UserId.Value);
    }
}
