@page "/{slug}/chats"
@page "/{slug}/r/{role}/chats"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Accounts
@inject ACommerce.Kit.Culture.ICultureContext Culture
@inject AuthSession Auth
@inject L L

<div class="acs-page">
@if (!Auth.IsAuthenticated)
{
    <AcEmptyState IconName="message"
                  Title="@L["chats.gate.need_login"]"
                  Message="@L["chats.gate.need_login_hint"]"
                  ActionLabel="@L["auth.action.login"]"
                  ActionHref="@AuthSession.LinkFor(Slug, Role, $"login?returnUrl=/{Slug}/chats")" />
}
else
{
    <h1 class="acm-wizard-title">@L.Markup("chats.list.title")</h1>

    @if (convs is null)
    {
        <AcLoadingState Message="@L["common.state.loading"]" />
    }
    else if (convs.Count == 0)
    {
        <AcEmptyState Title="@L["chats.list.empty_title"]"
                      Message="@L["chats.list.empty_hint"]"
                      IconName="message"
                      ActionLabel="@L["chats.list.empty_action"]"
                      ActionHref="@AuthSession.LinkFor(Slug, Role, "explore")" />
    }
    else
    {
        <ul style="list-style:none;padding:0;margin:0;">
            @foreach (var c in convs)
            {
                var iAmOwner = c.OwnerId == Auth.UserId;
                var partnerName = iAmOwner ? c.PartnerName : c.OwnerName;
                var partnerId = iAmOwner ? c.PartnerId : c.OwnerId;
                var partnerAvatar = avatars.TryGetValue(partnerId, out var a) ? a : null;
                var unread = iAmOwner ? c.OwnerUnread : c.PartnerUnread;
                <li style="border-bottom:1px solid var(--ac-border);">
                    <a href="@AuthSession.LinkFor(Slug, Role, $"chats/{c.Id}")"
                       style="display:flex;gap:12px;align-items:center;padding:14px 8px;
                              text-decoration:none;color:var(--ac-text);">
                        @if (!string.IsNullOrEmpty(partnerAvatar))
                        {
                            <img src="@partnerAvatar" alt="@partnerName"
                                 style="width:48px;height:48px;border-radius:50%;object-fit:cover;flex:0 0 auto;" />
                        }
                        else
                        {
                            <AcAvatar Name="@partnerName" Size="48" />
                        }
                        <div style="flex:1;min-width:0;">
                            <div style="display:flex;justify-content:space-between;align-items:baseline;">
                                <strong style="font-size:15px;">@partnerName</strong>
                                <span class="ac-muted" style="font-size:11px;">@FormatWhen(c.LastAt)</span>
                            </div>
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-top:4px;">
                                <span class="ac-muted" style="font-size:13px;white-space:nowrap;
                                       overflow:hidden;text-overflow:ellipsis;max-width:200px;">
                                    @(c.LastMessage ?? c.Subject ?? "—")
                                </span>
                                @if (c.ExpiresAt.HasValue && !c.IsExpired)
                                {
                                    <span class="ac-chip ac-chip-sm"
                                          style="background:color-mix(in srgb, var(--ac-primary) 12%, transparent);">@((MarkupString)"\n                                        ")@L.Markup("chats.list.temporary")@((MarkupString)"\n                                    ")
                                    </span>
                                }
                                else if (c.IsExpired)
                                {
                                    <span class="ac-chip ac-chip-sm" style="opacity:.6;">@L.Markup("chats.list.expired")</span>
                                }
                                @if (unread > 0)
                                {
                                    <AcBadge Variant="primary" Text="@unread.ToString()" />
                                }
                            </div>
                        </div>
                    </a>
                </li>
            }
        </ul>
    }
}
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    List<Conversation>? convs;

    /// <summary>
    /// تَنسيق وَقت آخِر رِسالَة بِأُسلوب تَطبيقات المُحادَثات: السَّاعَة
    /// لِليَوم نَفسه، "أَمس" لِلأَمس، اسم اليَوم في الأُسبوع الحالي،
    /// التَّاريخ القَصير ما عَدا ذلك.
    /// </summary>
    // (‏2026-10-25، مُراجَعَةُ تَيّارِ W8-7 الجَولَة ١): كُلُّ فَرعٍ يُنَسِّقُ بِـ`FormatTime` مِن اللَحظَةِ المُخَزَّنَة — فَلَحظَةٌ لَم تُضبَط نَصٌّ فارِغٌ
    // لا «0001/01/01» — والتاريخُ المَحَلِّيُّ لِلمُقارَنَةِ وَحدَها؛ وكُلُّ مَضبوطٍ بايتاً ما كانَ (`DisplayTimeAbsentTests`).
    string FormatWhen(DateTime at)
    {
        var atDate  = Culture.InZone(at).Date;
        var nowDate = Culture.NowInZone.Date;
        if (atDate == nowDate)                  return Culture.FormatTime(at, "HH:mm");
        if (atDate == nowDate.AddDays(-1))      return L["chats.time.yesterday"];
        if ((nowDate - atDate).TotalDays < 7)   return ACommerce.Kit.Culture.CultureTime.FormatTime(at, "dddd", Culture.TimeZone, new System.Globalization.CultureInfo("ar"));
        if (atDate.Year == nowDate.Year)        return Culture.FormatTime(at, "dd/MM");
        return Culture.FormatTime(at, "yyyy/MM/dd");
    }

    Dictionary<Guid, string?> avatars = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsAuthenticated) return;
        // المُحادَثات وصُوَرُ أَطرافِها — استِعلامان في جَلسَةٍ واحِدَة،
        // انتَقَلا مَعاً إلى AccountQueries.ConversationsAsync.
        var chats = await Accounts.ConversationsAsync(Slug, Auth.UserId!.Value);
        convs   = chats.Conversations.ToList();
        avatars = chats.PartnerAvatars.ToDictionary(kv => kv.Key, kv => kv.Value);
    }
}
