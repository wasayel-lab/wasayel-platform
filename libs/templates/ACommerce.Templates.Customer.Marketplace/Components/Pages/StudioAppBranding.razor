@page "/studio/apps/{slug}/branding"
@inject Services.Incubator.StudioAuth Auth
@inject Services.Queries.TenantDirectory Tenants
@inject IServiceProvider Sp
@inject L L
@using ACommerce.Kit.Auth
@using ACommerce.Kit.Tenants
@using ACommerce.Templates.Customer.Marketplace.Services.Incubator

@*
    تَحرير الهُويَّة البَصَريَّة لِتَطبيق العَميل داخِل studio.
    اِسم، شِعار، مَدينَة، لَون، **وقَناة الدُخول**.

    ═══ ‏2026-08-30 — «الـ AuthChannel يُدار مِن مَكان آخَر» ═══════════
    كانَ هذا السَطرُ هُنا، وكانَ صادِقاً وصفاً وكاذِباً أَثَراً:
    «مَكانٌ آخَر» هُوَ `/admin`، أَي **المالِكُ بِيَدِه**. فَعَميلٌ
    يَبني مَتجَرَه بِنَفسِه كانَ يَرى قَناتَه في `StudioApp.razor`
    ولا يَملِكُ تَبديلَها — وإن كانَت غَيرَ مُهَيَّأَةٍ في هذِه
    النُسخَة (وهي الحالُ حينَ يُشَغَّلُ المُستَضيفُ بِالبَريدِ وَحدَه،
    `docs/DEPLOY.md` §٢·ب) فَبابُ مَتجَرِه مُغلَقٌ ولا سَبيلَ لَه.
    الحَقلُ الآنَ هُنا، **ولا يَعرِضُ إلّا المُهَيَّأَ فِعلاً**:
    زِرٌّ لِقَناةٍ غَيرِ مُسَجَّلَةٍ يُعيدُ إنتاجَ العَطَبِ مِن داخِلِ
    الإصلاح، لِأَنّ `AuthChannels.NormalizeOrDefault` تَقبَلُ القيمَةَ
    وتَكتُبُها (القاعِدَة ١٢: لا مَدخَلَ يَقودُ إلى رَفض).
*@

<StudioShell Title="@($"{L["studio.app_branding.title"]} {tenant?.Name ?? Slug}")" Active="home">
    <TopBarActions>
        <a class="st-btn st-btn-ghost" href="@($"/studio/apps/{Slug}")">← @L.Markup("studio.app_nav.settings")</a>
    </TopBarActions>
    <ChildContent>
        @if (tenant is null)
        {
            <div class="st-card">@L.Markup("studio.app.not_found")</div>
        }
        else
        {
            <div class="studio-page-head">
                <h1>@L.Markup("studio.app_branding.heading")</h1>
                <p>@L.Markup("studio.app_branding.intro")</p>
            </div>

            @if (Saved == "1")  { <div class="st-chip st-chip-success" style="margin-bottom:14px;">@L.Markup("studio.app.saved") <AcIcon Name="check" Size="16" /></div> }
            @* رَمزا الخَطَأ صارا مِن مُعجَم TenantConfigCodes المُغلَق —
               كانا name/color هُنا و‏name_required/color_invalid في
               الإدارَة لِنَفس المَعنى. *@
            @if (Err == "name_required") { <div class="st-chip st-chip-danger"  style="margin-bottom:14px;">@L.Markup("studio.app_branding.err_name")</div> }
            @if (Err == "color_invalid") { <div class="st-chip st-chip-danger"  style="margin-bottom:14px;">@L.Markup("studio.app_branding.err_color")</div> }

            <form method="post" action="@($"/studio/apps/{Slug}/branding/save")" class="st-card">
                <div class="st-field">
                    <label class="st-label">@L.Markup("studio.app_branding.field_name")</label>
                    <input class="st-input" name="name" required maxlength="60" value="@tenant.Name" />
                </div>
                <div class="st-field">
                    <label class="st-label">@L.Markup("studio.app_branding.field_tagline")</label>
                    <input class="st-input" name="tagline" maxlength="120" value="@tenant.TagLine" />
                </div>
                <div class="st-field">
                    <label class="st-label">@L.Markup("studio.app_branding.field_city")</label>
                    <input class="st-input" name="city" maxlength="40" value="@tenant.City" />
                </div>
                <div class="st-field">
                    <label class="st-label">@L.Markup("studio.app_branding.field_color")</label>
                    <div style="display:flex;align-items:center;gap:14px;">
                        <span style="width:60px;height:60px;border-radius:14px;display:grid;place-items:center;
                                     background:@tenant.BrandColor;color:#fff;font-size:28px;font-weight:800;">
                            @(tenant.Name.FirstOrDefault())
                        </span>
                        <input class="st-input" type="color" name="color" required
                               value="@tenant.BrandColor"
                               style="height:60px;padding:4px;width:120px;flex:0;" />
                        <code style="color:var(--st-muted);font-size:13px;direction:ltr;">@tenant.BrandColor</code>
                    </div>
                </div>

                @* قَناةُ الدُخول — نَفسُ أَزرارِ صَفحَةِ الإدارَة
                   (‏`acm-radio-card*` في `site.css`)، **إلّا أَنَّها
                   تُبنى مِن المَعروضِ لا مِن الثَلاثَةِ دائِماً**. *@
                @{
                    var offered = TenantAuthChannelDoor.OfferedIn(Sp);
                    var chosen  = TenantAuthChannelDoor.Choose(tenant.AuthChannel, offered);
                }
                <div class="st-field">
                    <label class="st-label">@L.Markup("studio.app_branding.section_auth")</label>
                    @if (offered.Count == 0)
                    {
                        @* لا قَناةَ مُهَيَّأَة — يُقالُ صَراحَةً ولا
                           يُعرَضُ زِرٌّ يَبني باباً مُغلَقاً. *@
                        <div class="st-chip st-chip-danger" style="width:100%;justify-content:center;">
                            @L.Markup("studio.app_branding.no_channel")
                        </div>
                    }
                    else
                    {
                        <div class="acm-radio-cards">
                            @foreach (var c in offered)
                            {
                                <label class="acm-radio-card">
                                    <input type="radio" name="channel" value="@c" checked="@(c == chosen)" />
                                    <span class="acm-radio-card-body">
                                        <strong><AcIcon Name="@IconFor(c)" Size="16" /> @L.Markup(LabelKey(c))</strong>
                                        <span>@L.Markup(HintKey(c))</span>
                                    </span>
                                </label>
                            }
                        </div>
                    }
                </div>

                <button type="submit" class="st-btn st-btn-primary">@L.Markup("studio.app_branding.save")</button>
            </form>
        }
    </ChildContent>
</StudioShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery] public string? Saved { get; set; }
    [SupplyParameterFromQuery] public string? Err   { get; set; }
    Tenant? tenant;

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is not null && tenant.OwnerUserId != Auth.UserId!.Value) tenant = null;
    }

    // المَفاتيحُ حَرفِيَّةٌ عَمداً — تُقرَأُ بِـgrep وتُقابَلُ
    // بِالقامُوس، ومِفتاحٌ مُرَكَّبٌ بِالتَفسير يَختَفي عَن كُلّ
    // فاحِص. ونَظائِرُها في الإدارَة `admin.tenant_branding.auth_*`.
    static string LabelKey(string channel) => channel switch
    {
        AuthChannels.Nafath => "studio.app_branding.auth_nafath",
        AuthChannels.Email  => "studio.app_branding.auth_email",
        _                   => "studio.app_branding.auth_phone"
    };

    static string HintKey(string channel) => channel switch
    {
        AuthChannels.Nafath => "studio.app_branding.auth_nafath_hint",
        AuthChannels.Email  => "studio.app_branding.auth_email_hint",
        _                   => "studio.app_branding.auth_phone_hint"
    };

    static string IconFor(string channel) => channel switch
    {
        AuthChannels.Nafath => "key",
        AuthChannels.Email  => "mail",
        _                   => "phone"
    };
}
