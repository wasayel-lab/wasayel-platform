@page "/billing/paddle/return"
@inject L L

@*
    صَفحَةُ العَودَة — **قِراءَةٌ خالِصَة، ولا تُمَدِّد شَيئاً**
    (‏ADR-009).

    والسَبَبُ نَفسُ سَبَبِ جارَتِها في مَسارِ PayPal حَرفاً: مِفتاحُ
    مَرَّة-واحِدَةٍ عِندَنا `event_id` مِن رِسالَةٍ **مُوَقَّعَة**.
    وصَفحَةُ عَودَةٍ تُمَدِّد لَيسَ لَها مِفتاحٌ يَرتَطِمُ بِه، فَيَقَعُ
    **تَمديدانِ لِدَفعَةٍ واحِدَة**. وأَشَدُّ مِن ذلك هُنا: عُنوانُ
    هذِه الصَفحَةِ يَفتَحُه **أَيُّ زائِر** — فَتَمديدٌ مِنها هَدِيَّةٌ
    لِمَن يَعرِفُ الرابِط.

    **والعَودَةُ لَيسَت إثباتاً على أَيّ حال**: قَد تَنجَحُ الدَفعَةُ
    ويُغلَق المُتَصَفِّحُ قَبلَ العَودَة، وقَد يَعودُ الزائِرُ بِلا
    دَفع. فَما تَقولُه هذِه الصَفحَةُ «تَمَّ استِلامُ دَفعَتِك» ثُمَّ
    «جارٍ التَأكيد» — لا «مُدِّدَت باقَتُك».

    ولا حارِسَ جَلسَةٍ هُنا: يَبلُغُها الدافِعُ قادِماً مِن نافِذَةِ
    Paddle، وقَد لا يَملِك جَلسَةً عِندَنا أَصلاً. وما تَعرِضُه
    **مَرجِعُه ولا شَيءَ آخَر** — لا مَبلَغَ ولا مَتجَرَ ولا حالَة.
*@

<div class="studio-root">
    <div class="auth-wrap">
        <div class="auth-card">
            <h1 style="margin:0 0 10px;font-size:20px;">@L.Markup("billing.paddle.return_title")</h1>
            <p style="margin:0 0 12px;line-height:1.8;">@L.Markup("billing.paddle.return_body")</p>
            @if (!string.IsNullOrWhiteSpace(Reference))
            {
                <p style="margin:0 0 12px;font-size:12px;word-break:break-all;">
                    @L.Markup("billing.paddle.return_reference") @Reference
                </p>
            }
            <a class="st-btn st-btn-primary" href="/studio">@L.Markup("billing.paypal.back_studio")</a>
        </div>
    </div>
</div>

@code {
    /// <summary>مَرجِعُنا كَما وَضَعناهُ في رابِطِ الدَفع —
    /// <b>ولا يُقرَأ <c>_ptxn</c> الَّذي تَفرِضُه Paddle</b>: اسمُ
    /// مُتَغَيِّرٍ عِندَ طَرَفٍ ثالِثٍ لَيسَ عَقداً تُبنى عَلَيه
    /// صَفحَة.</summary>
    [SupplyParameterFromQuery(Name = ACommerce.Kit.Payments.Providers.Paddle.PaddleTransactionPolicy.ReferenceQueryKey)]
    public string? Reference { get; set; }
}
