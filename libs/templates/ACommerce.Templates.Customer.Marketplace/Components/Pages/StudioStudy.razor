@page "/studio/s/{id:guid}"
@inject Services.Incubator.StudioAuth Auth
@inject Services.Queries.StudioQueries Studio
@inject ACommerce.Kit.Culture.ICultureContext Culture
@inject Services.Queries.TenantDirectory Tenants
@inject L L
@using ACommerce.Templates.Customer.Marketplace.Services.Incubator
@using ACommerce.Kit.Tenants
@using System.Text.Json

@*
    عرض دراسة الجدوى داخل لوحة العميل (تصميم studio احترافي). يُحدّث
    تلقائياً كل 4 ثوانٍ أثناء التحليل عبر meta refresh.

    ‏(‏2026-11-07، الموجَة ١٣ W13-1·٥ — ADR-049 §٢؛ يُلحَقُ ولا يُعادُ حَرفٌ فَوقَه) صارَت صَفحَةَ **قِراءَةٍ فَقَط** لِدِراسَةٍ قَديمَةٍ لِصاحِبِها: لا تَحديثَ تِلقائيّ
    (لا تَحليلَ يَجري مِن الاستوديو)، ولا استِمارَةَ إعادَةٍ ولا تَحسينٍ ولا تَقييمٍ ولا بِناء — والتَصديرانِ (PDF، Excel) قِراءَةٌ لِبَياناتِه. لا يَبلُغُها
    إلّا شَريطُ «مَبنيّ عَلى فِكرَة» في `StudioApp`، وتَقرَأُ الجَلسَةَ مِن `StudioQueries` لا مِن خِدمَةِ التَحليل.
*@

<StudioShell Title="@L["admin.study.heading"]" Active="home">
    <TopBarActions>
        <a class="st-btn st-btn-ghost" href="/studio">← @L.Markup("studio.study.back_dashboard")</a>
        @if (session?.Status == IncubatorStatus.Completed)
        {
            <a class="st-btn st-btn-light" href="@($"/studio/s/{Id}/print")" target="_blank"
               style="margin-inline-start:8px;"><AcIcon Name="file" Size="16" /> PDF</a>
            <a class="st-btn st-btn-light" href="@($"/studio/s/{Id}/export.xlsx")"
               style="margin-inline-start:8px;"><AcIcon Name="bar-chart" Size="16" /> Excel</a>
        }
    </TopBarActions>
    <ChildContent>
        <UpgradePrompt Reason="@Upgrade" CurrentTier="@(currentTier ?? "spark")" RenewsOn="@renewsOn" />

        @if (session is null)
        {
            <div class="st-card">@L.Markup("studio.study.not_found")</div>
        }
        else if (session.Status == IncubatorStatus.Analyzing)
        {
            <div class="st-card" style="text-align:center;padding:48px;">
                <div style="font-size:52px;margin-bottom:10px;"><AcIcon Name="clock" Size="48" /></div>
                <h2 style="margin:0 0 6px;">@L.Markup("admin.study.analyzing_title")</h2>
                <p style="color:var(--st-muted);margin:0;">@((MarkupString)"\n                    ")@L.Markup("studio.study.analyzing_hint")@((MarkupString)"\n                ")
                </p>
            </div>
        }
        else if (session.Status == IncubatorStatus.Failed)
        {
            <div class="st-card">
                <div class="st-chip st-chip-danger" style="margin-bottom:12px;">@L.Markup("studio.study.failed_title")</div>
                <p style="margin:0 0 16px;color:var(--st-ink-700);">@session.AnalysisError</p>
            </div>
        }
        else if (root is null)
        {
            <div class="st-card">@L.Markup("studio.study.no_analysis")</div>
        }
        else
        {
            var r = root.Value;

            <div class="studio-page-head">
                <h1>@L.Markup("admin.study.heading")</h1>
                <p>@(string.IsNullOrEmpty(session.ProjectDescription) ? "" : Truncate(session.ProjectDescription, 120))</p>
            </div>

            @if (r.TryGetProperty("summary", out var sum))
            {
                <div class="studio-stats">
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("study.section.market_size")</div>
                        <div class="studio-stat-value" style="font-size:20px;">@Str(sum,"marketSizeSar")</div>
                    </div>
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.study.stat_customers")</div>
                        <div class="studio-stat-value" style="font-size:20px;">@Str(sum,"estimatedCustomersYear1")</div>
                    </div>
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.study.stat_investment")</div>
                        <div class="studio-stat-value" style="font-size:20px;">@Str(sum,"requiredInvestmentSar")</div>
                    </div>
                </div>
                <div class="st-card" style="margin-top:16px;">
                    <strong>@L.Markup("study.field.verdict")@((MarkupString)" ") </strong>@Str(sum, "verdict")
                </div>
            }

            @Obj(L["study.section.market_size"], "marketSizing", r, ("tam","TAM"),("sam","SAM"),("som","SOM"),("reasoning",L["study.field.reasoning"]))
            @Obj(L["study.section.revenue_model"], "revenueModel", r, ("model",L["study.field.model"]),("pricingSar",L["study.field.pricing"]),("unitEconomics",L["study.field.unit_economics"]))
            @Obj(L["study.section.cost_structure"], "costStructure", r, ("launchSar",L["study.field.launch"]),("monthlyOpsSar",L["studio.print.field_monthly_ops"]),("cacSar","CAC"),("ltvSar","LTV"))
            @Obj(L["study.section.financial"], "financialProjection", r, ("year1RevenueSar",L["studio.print.field_year1_revenue"]),("breakEvenMonths",L["studio.print.field_breakeven"]),("scenario",L["study.field.scenario"]))

            @Arr(L["study.section.segments"], "customerSegments", r, "name", "description")
            @Arr(L["study.section.competitors"], "competitors", r, "name", "gap")

            @if (r.TryGetProperty("risks", out var risks) && risks.ValueKind == JsonValueKind.Array)
            {
                <div class="st-section-title"><AcIcon Name="alert-circle" Size="18" /> @L.Markup("studio.study.heatmap_title")</div>
                var risksList = risks.EnumerateArray().ToList();
                <div class="risk-heatmap">
                    <div class="risk-heatmap-ylabel">@L.Markup("studio.study.heatmap_y")</div>
                    <div>
                        <div class="risk-heatmap-grid">
                            @* 3x3: rows = likelihood (high أَوَّلاً)، cols = impact (low أَوَّلاً) *@
                            @for (var li = 2; li >= 0; li--)
                            {
                                @for (var im = 0; im < 3; im++)
                                {
                                    var lik = LevelName(li); var imp = LevelName(im);
                                    var cls = $"risk-cell-l{Initial(imp)}-l{Initial(lik)}";
                                    <div class="risk-heatmap-cell @cls">
                                        @foreach (var risk in risksList
                                            .Where(rk => Level(Str(rk,"likelihood")) == li
                                                      && Level(Str(rk,"impact")) == im))
                                        {
                                            var cat = Str(risk, "category").ToLowerInvariant();
                                            var dotCls = "risk-dot-" + (CategoryClass(cat));
                                            <span class="risk-dot @dotCls"
                                                  title="@($"{Str(risk,"title")} · {Str(risk,"mitigation")}")">
                                                @(risksList.IndexOf(risk) + 1)
                                            </span>
                                        }
                                    </div>
                                }
                            }
                        </div>
                        <div class="risk-heatmap-axis">
                            <span>@L.Markup("studio.study.impact_low")</span><span>@L.Markup("studio.study.impact_medium")</span><span>@L.Markup("studio.study.impact_high")</span>
                        </div>
                        <div class="risk-heatmap-xlabel">@L.Markup("studio.study.heatmap_x")</div>
                    </div>
                </div>
                <div class="risk-legend">
                    <span class="risk-legend-item"><span class="risk-legend-swatch risk-dot-market"></span>@L.Markup("studio.study.cat_market")</span>
                    <span class="risk-legend-item"><span class="risk-legend-swatch risk-dot-operational"></span>@L.Markup("studio.study.cat_operational")</span>
                    <span class="risk-legend-item"><span class="risk-legend-swatch risk-dot-financial"></span>@L.Markup("studio.study.cat_financial")</span>
                    <span class="risk-legend-item"><span class="risk-legend-swatch risk-dot-regulatory"></span>@L.Markup("studio.study.cat_regulatory")</span>
                </div>

                <div class="st-section-title" style="margin-top:18px;">@L.Markup("studio.study.risk_details")</div>
                <div class="studio-list">
                    @for (var i = 0; i < risksList.Count; i++)
                    {
                        var risk = risksList[i];
                        <div class="st-card">
                            <div style="display:flex;justify-content:space-between;gap:8px;align-items:start;">
                                <strong>
                                    <span class="risk-dot @($"risk-dot-{CategoryClass(Str(risk,"category").ToLowerInvariant())}")"
                                          style="width:22px;height:22px;font-size:11px;display:inline-grid;vertical-align:middle;">
                                        @(i + 1)
                                    </span>
                                    @Str(risk,"title")
                                </strong>
                                <span class="st-chip">@Str(risk,"category")</span>
                            </div>
                            <p style="margin:8px 0 0;font-size:14px;color:var(--st-muted);">@((MarkupString)"\n                                ")@L.Markup("study.field.impact") @Str(risk,"impact") · @L.Markup("study.field.likelihood") @Str(risk,"likelihood")<br/>
                                <strong>@L.Markup("study.field.mitigation")</strong> @Str(risk,"mitigation")
                            </p>
                        </div>
                    }
                </div>
            }

            @if (r.TryGetProperty("lessonsFromFailures", out var lessons) && lessons.ValueKind == JsonValueKind.Array)
            {
                <div class="st-section-title"><AcIcon Name="bar-chart" Size="18" /> @L.Markup("study.section.lessons")</div>
                <div class="st-card">
                    <ul style="margin:0;padding-inline-start:18px;line-height:2;font-size:14px;">
                        @foreach (var l in lessons.EnumerateArray()) { <li>@l.GetString()</li> }
                    </ul>
                </div>
            }

            @if (r.TryGetProperty("roadmap", out var roadmap) && roadmap.ValueKind == JsonValueKind.Array)
            {
                <div class="st-section-title"><AcIcon Name="map" Size="18" /> @L.Markup("study.section.roadmap")</div>
                <div class="studio-list">
                    @foreach (var ph in roadmap.EnumerateArray())
                    {
                        <div class="studio-list-row" style="cursor:default;">
                            <span class="st-chip">@Str(ph,"durationWeeks") @L.Markup("study.unit.weeks")</span>
                            <div class="studio-list-body">
                                <strong>@Str(ph,"phase")</strong>
                                <span>@Str(ph,"goal")</span>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (builtTenant is not null)
            {
                <div class="st-card" style="margin-top:20px;border:1px solid var(--st-success);background:#dcfce7;">
                    <h3 style="margin:0 0 6px;"><AcIcon Name="check-circle" Size="24" /> @L.Markup("studio.study.build_title")</h3>
                    <p style="margin:0 0 14px;font-size:14px;">
                        <strong>@builtTenant.Name</strong> · /@builtTenant.Slug
                    </p>
                    <a class="st-btn st-btn-primary" href="@($"/studio/apps/{builtTenant.Slug}")">@((MarkupString)"\n                        ")@L.Markup("studio.study.open_app")@((MarkupString)"\n                    ")
                    </a>
                </div>
            }
            <div class="st-card" style="margin-top:16px;background:var(--st-line-soft);border:0;font-size:13px;color:var(--st-muted);">
                @Disclaimer
            </div>
        }
    </ChildContent>
</StudioShell>

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery]                     public string? Upgrade  { get; set; }
    [Microsoft.AspNetCore.Components.Inject] Services.Incubator.StudioTierService TierSvc { get; set; } = default!;
    string? currentTier;
    string? renewsOn;   // ‏(2026-10-29، د15) مَوعِدُ تَجَدُّدِ الحِصَّةِ بِساعَةِ الطَلَب، أَو null

    // مُستَوى مِن نَصّ low/medium/high → فِهرِس 0/1/2.
    static int Level(string s) => s.ToLowerInvariant() switch
    {
        "low" or "منخفض" or "مُنخَفِض" => 0,
        "high" or "عالي" or "عالٍ"      => 2,
        _ => 1
    };
    static string LevelName(int i) => i switch { 0 => "low", 2 => "high", _ => "medium" };
    static string Initial(string s) => s[..1]; // l/m/h

    static string CategoryClass(string cat) => cat switch
    {
        var c when c.Contains("market") || c.Contains("سوق")    => "market",
        var c when c.Contains("oper")   || c.Contains("تشغيل")  => "operational",
        var c when c.Contains("fin")    || c.Contains("مالي")   => "financial",
        var c when c.Contains("reg")    || c.Contains("تنظيم")  => "regulatory",
        _ => "other"
    };

    IncubatorSession? session;
    JsonElement? root;
    Tenant? builtTenant;

    // ‏لَيسَت `const`: القيمَة مِن `L` المَحقون scoped، والثابِتُ يُحسَب
    // ‏وَقتَ التَرجَمَة. المُستَهلِكُ لا يَتَغَيَّر.
    string Disclaimer =>
        L["studio.study.disclaimer"];

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        session = await Studio.LoadStudyAsync(Id);
        if (session is not null && session.OwnerUserId != Auth.UserId!.Value) { session = null; return; }
        if (session?.AnalysisJson is not null)
        {
            try { root = JsonDocument.Parse(session.AnalysisJson).RootElement.Clone(); }
            catch { root = null; }
        }
        if (session is { Status: IncubatorStatus.Completed })
        {
            // هَل أُنشِئ تَطبيق مِن هذه الجَلسَة سابِقاً؟ — سُؤالٌ عَن
            // سِجِلّ المُستَأجِرين، فَجَوابُه عِندَ TenantDirectory.
            builtTenant = await Tenants.FindBySourceAnalysisAsync(Id);
        }
        var u = await TierSvc.GetUserAsync(Auth.UserId!.Value);
        currentTier = u?.Tier ?? "spark";
        renewsOn = u is not null && Services.Incubator.StudioLimitNextStep.RenewsAt(u.PeriodStart, DateTime.UtcNow) is { } at
            ? Culture.FormatTime(at, "yyyy-MM-dd") : null;
    }

    static string Str(JsonElement e, string p)
        => e.TryGetProperty(p, out var v)
            ? (v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : v.ToString())
            : "—";

    static string Truncate(string s, int n) => s.Length <= n ? s : s[..n] + "…";

    RenderFragment Obj(string title, string key, JsonElement r,
        params (string prop, string label)[] fields) => builder =>
    {
        if (!r.TryGetProperty(key, out var obj) || obj.ValueKind != JsonValueKind.Object) return;
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "st-section-title");
        builder.AddContent(seq++, title);
        builder.CloseElement();
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "st-card");
        foreach (var (prop, label) in fields)
        {
            builder.OpenElement(seq++, "p");
            builder.AddAttribute(seq++, "style", "margin:4px 0;font-size:14px;");
            builder.OpenElement(seq++, "strong");
            builder.AddContent(seq++, label + ": ");
            builder.CloseElement();
            builder.AddContent(seq++, Str(obj, prop));
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    RenderFragment Arr(string title, string key, JsonElement r,
        string titleProp, string bodyProp) => builder =>
    {
        if (!r.TryGetProperty(key, out var arr) || arr.ValueKind != JsonValueKind.Array) return;
        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "st-section-title");
        builder.AddContent(seq++, title);
        builder.CloseElement();
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "studio-list");
        foreach (var item in arr.EnumerateArray())
        {
            var captured = item;
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "st-card");
            builder.OpenElement(seq++, "strong");
            builder.AddContent(seq++, Str(captured, titleProp));
            builder.CloseElement();
            builder.OpenElement(seq++, "p");
            builder.AddAttribute(seq++, "style", "margin:6px 0 0;font-size:14px;color:var(--st-muted);");
            builder.AddContent(seq++, Str(captured, bodyProp));
            builder.CloseElement();
            builder.CloseElement();
        }
        builder.CloseElement();
    };
}
