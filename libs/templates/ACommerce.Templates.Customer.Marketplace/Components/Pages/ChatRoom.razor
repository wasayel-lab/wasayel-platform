@page "/{slug}/chats/{conversationId:guid}"
@page "/{slug}/r/{role}/chats/{conversationId:guid}"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Account
@inject ACommerce.Kit.Culture.ICultureContext Culture
@inject AuthSession Auth
@inject L L

<div class="acs-page acs-chat-page">
@if (!Auth.IsAuthenticated)
{
    <AcEmptyState IconName="message"
                  Title="@L["chats.room.need_login"]"
                  ActionLabel="@L["auth.action.login"]"
                  ActionHref="@AuthSession.LinkFor(Slug, Role, $"login")" />
}
else if (conv is null)
{
    <AcLoadingState Message="@L["common.state.loading"]" />
}
else
{
    var iAmOwner = conv.OwnerId == Auth.UserId;
    var partnerName = iAmOwner ? conv.PartnerName : conv.OwnerName;

    <div class="acs-chat-header" style="display:flex;align-items:center;gap:12px;padding-bottom:12px;
                border-bottom:1px solid var(--ac-border);margin-bottom:12px;">
        <a href="@AuthSession.LinkFor(Slug, Role, $"chats")"
           style="display:inline-flex;text-decoration:none;color:var(--ac-text);">
            <AcIcon Name="arrow-right" Size="24" />
        </a>
        <AcAvatar Name="@partnerName" Size="40" />
        <strong>@partnerName</strong>
    </div>

    <div class="acs-chat-messages">
        @if (messages.Count == 0)
        {
            <p class="ac-muted" style="text-align:center;padding:32px 0;">@((MarkupString)"\n                ")@L.Markup("chats.room.empty")@((MarkupString)"\n            ")
            </p>
        }
        else
        {
            DateTime? lastDay = null;
            foreach (var m in messages)
            {
                var local = Culture.InZone(m.SentAt);
                if (lastDay is null || lastDay.Value.Date != local.Date)
                {
                    lastDay = local;
                    <div style="text-align:center;margin:12px 0 8px;">
                        <span style="background:var(--ac-bg-alt);color:var(--ac-text-muted);
                                     padding:3px 12px;border-radius:999px;font-size:11px;">
                            @FormatDay(m.SentAt)
                        </span>
                    </div>
                }
                var mine = m.SenderId == Auth.UserId;
                <AcChatBubble Body="@m.Body" Time="@Culture.FormatTime(m.SentAt, "HH:mm")" Mine="@mine" />
            }
        }
    </div>

    @if (conv.ExpiresAt.HasValue && !conv.IsExpired)
    {
        <p style="display:flex;align-items:center;justify-content:center;gap:6px;
                  font-size:12px;color:var(--ac-text-muted);margin:8px 0;">
            <AcIcon Name="clock" Size="14" /> @L.Markup("chats.room.temp_until") @Culture.FormatTime(conv.ExpiresAt.Value, "yyyy-MM-dd HH:mm")
        </p>
    }

    @if (partnerGone)
    {
        @* ‏(‏2026-10-30، الموجَة ١٢ F2 · ٥) الطَرَفُ الآخَرُ غائِبٌ أَو أَغلَقَ حِسابَه (`AccountErasure.PartnerGone`) — بابُ الإرسالِ يَرُدُّه، فَلا تُرسَمُ استِمارَةٌ يَرُدُّها. *@
        <div style="text-align:center;padding:16px;background:var(--ac-bg-alt);
                    border-radius:var(--ac-radius-md);color:var(--ac-text-muted);">@L.Markup("chats.room.partner_gone")</div>
    }
    else if (conv.IsExpired)
    {
        <div style="text-align:center;padding:16px;background:var(--ac-bg-alt);
                    border-radius:var(--ac-radius-md);color:var(--ac-text-muted);">@((MarkupString)"\n            ")@L.Markup("chats.room.expired")@((MarkupString)"\n        ")
        </div>
    }
    else
    {
        <form method="post" action="@($"/{Slug}/chats/{ConversationId}/send")" class="acs-chat-composer">
            <input type="text" name="body" class="ac-input"
                   style="flex:1;padding:10px;border:1px solid var(--ac-border);border-radius:var(--ac-radius-sm);"
                   placeholder="@L["chats.room.input_placeholder"]" required autofocus />
            <button type="submit"
                    style="padding:10px 18px;background:var(--ac-primary);color:var(--ac-on-primary);border:0;
                           border-radius:var(--ac-radius-sm);cursor:pointer;font-weight:600;
                           display:inline-flex;align-items:center;gap:6px;">
                <AcIcon Name="send" Size="16" />
                <span>@L.Markup("chats.room.send")</span>
            </button>
        </form>
    }
}
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [Parameter] public Guid ConversationId { get; set; }
    Conversation? conv;
    List<Message> messages = new();
    bool partnerGone;

    // غَير ساكِنَة: القيَم صارَت في المَعجَم، والساكِنَة لا تَبلُغ `L`.
    // (‏2026-10-25، مُراجَعَةُ تَيّارِ W8-7 الجَولَة ١): تَأخُذُ اللَحظَةَ المُخَزَّنَةَ لا ساعَتَها المَحَلِّيَّة، وتُنَسِّقُ بِـ`FormatTime` — فَلَحظَةٌ لَم تُضبَط
    // نَصٌّ فارِغٌ لا «0001/01/01». والتاريخُ المَحَلِّيُّ لِلمُقارَنَةِ وَحدَها، وكُلُّ مَضبوطٍ بايتاً ما كانَ (`DisplayTimeAbsentTests`).
    string FormatDay(DateTime sentUtc)
    {
        var day   = Culture.InZone(sentUtc).Date;
        var today = Culture.NowInZone.Date;
        if (day == today)               return L["chats.room.day_today"];
        if (day == today.AddDays(-1))   return L["chats.room.day_yesterday"];
        if ((today - day).TotalDays < 7) return ACommerce.Kit.Culture.CultureTime.FormatTime(sentUtc, "dddd", Culture.TimeZone, new System.Globalization.CultureInfo("ar"));
        return Culture.FormatTime(sentUtc, "yyyy/MM/dd");
    }


    /// <summary>
    /// <para><b>قِراءَةٌ خالِصَة.</b> كانَت هذِه الدالَّةُ تُصَفِّر عَدّاد
    /// غَير المَقروء وتُودِع — أَي أَنّ <b>طَلَبَ عَرضٍ كانَ يُبَدِّل
    /// حالَة</b>، فَيَرفَعُها الزاحِفُ والجالِبُ المُسبَق وأَداةُ التَحَقُّق
    /// نَفسُها. ونُقِلَ ذلك إلى أَمرٍ صَريح:
    /// <c>POST /{slug}/chats/{id}/read</c> يُطلِقُه العَميلُ <b>بَعدَ</b>
    /// التَصيير (‏<c>realtime-nav.js</c>)، فَيَقَع داخِلَ مُعامَلَةِ نُقطَةٍ
    /// مَحروسَةٍ بِـ<c>RequireAuthApi</c> لا خارِجَها.</para>
    ///
    /// <para><b>والعُضوِيَّةُ بَقِيَت هُنا</b> — تُمَرَّر دالَّةً نَقِيَّة
    /// إلى الخِدمَة، فَالقَرارُ حَيثُ تَعيش هُوِيَّةُ صاحِب الجَلسَة.</para>
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsAuthenticated) return;
        var room = await Account.ChatRoomAsync(Slug, ConversationId,
            c => c.OwnerId == Auth.UserId || c.PartnerId == Auth.UserId);
        conv     = room.Conversation;
        messages = room.Messages.ToList();
        // سُؤالُ بابِ الإرسالِ بِعَينِه عَلى الطَرَفِ الآخَر — يُقرَأُ حِسابُه حينَ تُرسَمُ الغُرفَةُ لِطَرَفٍ فيها.
        if (conv is not null)
            partnerGone = ACommerce.Templates.Customer.Marketplace.Services.Identity.AccountErasure.PartnerGone(
                await Account.ProfileAsync(Slug, conv.OwnerId == Auth.UserId ? conv.PartnerId : conv.OwnerId));
    }
}
