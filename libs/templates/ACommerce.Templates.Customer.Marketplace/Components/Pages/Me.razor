@page "/{slug}/me"
@page "/{slug}/r/{role}/me"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Accounts
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantPlanService PlanSvc
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantProviderService Providers
@inject ITenantContext Tenant
@inject AuthSession Auth
@inject NavigationManager Nav
@inject IServiceProvider Sp
@inject L L

@*
    صَفحة "حِسابي". تَتَّبع بُنية Me.razor مِن القالَب القَديم
    (avatar card + stats + action grid + sign-out).
*@

<div class="acs-page acs-profile-page">
    <h1 class="acm-wizard-title">@L.Markup("shell.nav.account")</h1>

    @if (!Auth.IsAuthenticated)
    {
        <AcEmptyState IconName="user"
                      Title="@(L["me.login.title"])"
                      Message="@(L["me.login.message"])"
                      ActionLabel="@(L["auth.action.login"])"
                      ActionHref="@AuthSession.LinkFor(Slug, Role, $"login")" />
    }
    else
    {
        <AcCard>
            <ChildContent>
                <div class="acm-details-owner">
                    @if (!string.IsNullOrEmpty(me?.AvatarUrl))
                    {
                        <img src="@me!.AvatarUrl" alt="@(Auth.UserName)"
                             style="width:56px;height:56px;border-radius:50%;object-fit:cover;" />
                    }
                    else
                    {
                        <AcAvatar Name="@(Auth.UserName ?? L["me.profile.unknown_mark"])" Size="56" />
                    }
                    <div class="acm-details-owner-info" style="flex:1;">
                        <h3 style="margin:0;">@(Auth.UserName ?? L["me.profile.new_member"])</h3>
                        <span style="color:var(--ac-text-muted);font-size:13px;">
                            @(string.IsNullOrEmpty(me?.Phone) ? L.Format("me.profile.user_id", Auth.UserId?.ToString()![..8]) : me!.Phone)
                        </span>
                    </div>
                    <a class="ac-btn ac-btn-outline-primary" href="@AuthSession.LinkFor(Slug, Role, $"me/edit")">@L.Markup("me.profile.edit")</a>
                </div>
            </ChildContent>
        </AcCard>

        @* ‏(‏2026-10-28، قَرارُ المالِك د27 «ج») «وَسائِلُ الدُخول» — أَضِف بَريدَك / أَضِف جَوّالَك: وَسيلَةٌ ثانِيَةٌ تُثبَتُ بِرَمزٍ يَصِلُها فَتُربَطُ
           بِهذا الحِسابِ نَفسِه، ولا دَمجَ تِلقائِيّ. تُرسَمُ الاستِمارَةُ لِنَوعٍ لا وَسيلَةَ مِنه في الحِسابِ وقَناتُه مُسَجَّلَة (القاعِدَة ١٢: لا بابَ لا يُرسِل)،
           والرابِطُ يَحمِلُ مُعَرِّفَ المُحاوَلَةِ لا الوَسيلَة — والصَفحَةُ تَقرَؤُها مِن المُحاوَلَةِ الحَيَّة (`AccountContacts.Pending`). *@
        @if (contactShown)
        {
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("me.contact.title")</h3>
                    @if (ContactErrKey is { } errKey)
                    {
                        <AcAlert Variant="warning" Message="@L[errKey]" />
                    }
                    @if (Contact == "linked")
                    {
                        <AcAlert Variant="success" Message="@L["me.contact.linked"]" />
                    }
                    @if (pending is { } p)
                    {
                        <p style="color:var(--ac-text-muted);font-size:13px;">@L.Format("me.contact.code_sent", p.Value)</p>
                        <form method="post" action="@($"/{Slug}/me/contact/verify")">
                            <input type="hidden" name="attempt" value="@Attempt" />
                            <AcField Label="@L["me.contact.code_label"]" Required="true">
                                <input name="code" required class="ac-input" dir="ltr" inputmode="numeric" autocomplete="one-time-code" />
                            </AcField>
                            <AcButton Type="submit" Variant="primary" Block="true" Text="@L["me.contact.confirm"]" />
                        </form>
                    }
                    else
                    {
                        @if (offerEmail)
                        {
                            <form method="post" action="@($"/{Slug}/me/contact/start")" style="margin-bottom:12px;">
                                <input type="hidden" name="kind" value="@ACommerce.Kit.Auth.ContactLink.Email" />
                                <p style="color:var(--ac-text-muted);font-size:13px;margin:0 0 6px;">@L.Markup("me.contact.email_hint")</p>
                                <input name="value" type="email" required class="ac-input" dir="ltr" autocomplete="email" />
                                <AcButton Type="submit" Variant="outline-primary" Block="true" Text="@L["me.contact.add_email"]" />
                            </form>
                        }
                        @if (offerPhone)
                        {
                            <form method="post" action="@($"/{Slug}/me/contact/start")">
                                <input type="hidden" name="kind" value="@ACommerce.Kit.Auth.ContactLink.Phone" />
                                <p style="color:var(--ac-text-muted);font-size:13px;margin:0 0 6px;">@L.Markup("me.contact.phone_hint")</p>
                                <input name="value" type="tel" required class="ac-input" dir="ltr" autocomplete="tel" />
                                <AcButton Type="submit" Variant="outline-primary" Block="true" Text="@L["me.contact.add_phone"]" />
                            </form>
                        }
                    }
                </ChildContent>
            </AcCard>
        }

        @* بِطاقَة الدَور النَّشِط — تَظهَر فَقَط في النَّمَط القَديم (بِلا /r/).
           داخِل PWA دَور مُحَدَّد، الدَور هو التَّطبيق نَفسه فَلا يُعرَض
           لا الدَور ولا زِرّ التَبديل. *@
        @if (activeRole is not null && string.IsNullOrEmpty(Role))
        {
            <AcCard>
                <ChildContent>
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span><AcIcon Name="@ACommerce.Widgets.AcIconMap.Resolve(activeRole.Icon, "user")" Size="28" /></span>
                            <div>
                                <strong style="font-size:14px;">@activeRole.Label</strong>
                                <span style="display:block;color:var(--ac-text-muted);font-size:11px;">@L.Markup("me.role.active_label")</span>
                            </div>
                        </div>
                        @if (tenantRoles.Count > 1)
                        {
                            <a class="ac-btn ac-btn-ghost ac-btn-sm" href="@AuthSession.LinkFor(Slug, Role, $"me/role")">
                                <AcIcon Name="settings" Size="14" /> @L.Markup("me.role.switch")@((MarkupString)"\n                            ")
                            </a>
                        }
                    </div>
                </ChildContent>
            </AcCard>
        }

        <div class="acm-home-grid acm-stats-grid" style="margin-top:12px;">
            <a class="acm-stat-tile" href="@AuthSession.LinkFor(Slug, Role, $"favorites")">
                <strong>@favoritesCount</strong>
                <span>@L.Markup("me.stat.favorites")</span>
            </a>
            <a class="acm-stat-tile" href="@AuthSession.LinkFor(Slug, Role, $"chats")">
                <strong>@conversationsCount</strong>
                <span>@L.Markup("me.stat.chats")</span>
            </a>
            <a class="acm-stat-tile" href="@AuthSession.LinkFor(Slug, Role, $"notifications")">
                <strong>@notificationsCount</strong>
                <span>@L.Markup("me.stat.notifications")</span>
            </a>
        </div>

        <div class="acm-home-actions" style="margin-top:12px;">
            @if (canManage)
            {
                <AcActionCard Label="@(L["me.action.manage_store"])" IconName="settings" Variant="primary" Href="@AuthSession.LinkFor(Slug, Role, $"manage")" />
            }
            @* «إعلاناتي» — والمَدخَلُ هُنا لَيسَ تَزييناً بَل شَرطَ
               وُجود (القاعِدَة ١٢). التَبويبُ في الشِلّ يَظهَر لِأَدوارٍ
               بِعَينِها (‏`RiderNav`، `VendorNav`)، ومُستَأجِرٌ **بِلا
               أَدوار** يَقَع على `DefaultTabs` ولا `me/listings` فيها —
               مَقيس: صِفر رابِط في `/theme-demo`. فَكانَت «إعلاناتي»
               وشاشَةُ تَحريرِها كودًا حَيّاً لا يَبلُغُه أَحَد في
               نِصف المُستَأجِرين. وصَفحَةُ «حِسابي» هي **المَوضِع
               المُعلَن** لِلزائِد عَن خَمسَة تَبويبات
               (‏`MainLayout` §الشَريط السُفليّ). *@
            <AcActionCard Label="@(L["me.action.my_listings"])" IconName="package"      Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"me/listings")" />
            @* «الباقات» حينَ يَعرِضُ رَفُّها شَيئاً (‏2026-10-25، W8-7 — lens-dead-doors-5): كانَت تُرسَمُ في كُلِّ مَتجَر، ومَتجَرُ الاستوديو
               يولَدُ بِلا باقَةٍ فَتَفتَحُ عَلى «لا توجَد باقات بَعد». الشَرطُ `PlanShelf.ShownAsync` — ما تَرسُمُه الصَفحَةُ بِعَينِه. والفَراغانِ
               المُصَرَّحُ بِهِما يُعيدانِ ما كانَ بَينَ البِطاقاتِ بايتاً (حُدودُ كُتلَةِ `@if` تُسقِطُ فَراغَ النَصِّ حَولَها). *@
            @if (plansShown)
            {
            @((MarkupString)"\n            ")<AcActionCard Label="@(L["me.action.plans"])"      IconName="package"       Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"plans")" />
            }
            @((MarkupString)"\n            ")<AcActionCard Label="@(L["me.action.favorites"])" IconName="heart"         Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"favorites")" />
            <AcActionCard Label="@(L["me.action.chats"])"   IconName="message"       Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"chats")" />
            <AcActionCard Label="@(L["me.action.notifications"])"     IconName="bell"          Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"notifications")" />
            <AcActionCard Label="@(L["me.action.deals"])"        IconName="receipt"       Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"deals")" />
            <AcActionCard Label="@(L["me.action.support"])" IconName="alert-circle"  Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"support")" />
            <AcActionCard Label="@(L["me.action.legal"])" IconName="info"     Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"legal")" />
        </div>

        @* المَدخَلُ نِصفُ الميزَة لا مُهِمَّةٌ تالِيَة (القاعِدَة ١٢):
           شاشَةُ حَذفِ الحِسابِ مَبنِيَّةٌ ونُقطَتُها تَعمَل، وبِلا هذا
           السَطرِ **غَيرُ مَوجودَة** — وشَرطُ المَتجَر ‏5.1.1(v) يوجِبُ
           أَن يَبلُغَها المُستَخدِمُ بِالنَقر داخِلَ التَطبيق، لا أَن
           يُراسِلَ الدَعم. *@
        <div style="margin-top:16px;">
            <a class="ac-btn ac-btn-ghost" style="width:100%;color:var(--ac-danger-ink);"
               href="@AuthSession.LinkFor(Slug, Role, $"me/delete")">
                <AcIcon Name="trash" Size="18" /> @L.Markup("account.delete.entry")@((MarkupString)"\n            ")
            </a>
        </div>

        <div style="margin-top:8px;">
            <form method="post" action="@($"/{Slug}/auth/logout")" style="margin:0;">
                <button type="submit" class="ac-btn ac-btn-ghost"
                        style="color:var(--ac-danger-ink);width:100%;">
                    <AcIcon Name="log-out" Size="18" /> @L.Markup("auth.action.logout")@((MarkupString)"\n                ")
                </button>
            </form>
        </div>

        @* ‏(‏2026-10-28، قَرارُ المالِك د28) «اخرج من كل الأجهزة» — يَرفَعُ إصدارَ الجَلسَةِ فَيَسقُطُ كُلُّ رَمزٍ صَدَرَ لِهذا الحِساب، وزِرُّ الخُروجِ
           أَعلاه يَبقى لِهذا الجِهازِ وَحدَه. *@
        <div style="margin-top:8px;">
            <form method="post" action="@($"/{Slug}/me/sessions/revoke")" style="margin:0;">
                <button type="submit" class="ac-btn ac-btn-ghost" style="width:100%;">
                    <AcIcon Name="log-out" Size="18" /> @L.Markup("auth.action.logout_everywhere")
                </button>
            </form>
            <p style="margin:4px 0 0;text-align:center;color:var(--ac-text-muted);font-size:12px;">@L.Markup("auth.logout_everywhere.hint")</p>
        </div>

        <div style="margin-top:24px;text-align:center;color:var(--ac-text-muted);font-size:12px;">
            @(loadedTenant?.Name) · platform-v1
        </div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [SupplyParameterFromQuery(Name = "contact")] public string? Contact { get; set; }
    [SupplyParameterFromQuery(Name = "attempt")] public string? Attempt { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }

    // ‏(د27) وَسائِلُ الدُخول — مَن تُعرَضُ لَه الاستِمارَة، والمُحاوَلَةُ الحَيَّة، ورَمزُ الرَدِّ مِن المَعجَمِ المُغلَقِ وَحدَه (رَمزٌ مَجهولٌ لا يُطبَعُ خاماً).
    bool offerEmail;
    bool offerPhone;
    (ACommerce.Kit.Auth.Server.AuthHandlers.AuthKind Kind, string Subject, string Value)? pending;
    string? ContactErrKey => Err is { } code && ACommerce.Templates.Customer.Marketplace.Services.AccountContacts.Codes.Contains(code)
        ? $"me.contact.err_{code}" : null;
    bool contactShown => pending is not null || offerEmail || offerPhone || ContactErrKey is not null || Contact == "linked";

    Tenant? loadedTenant;
    User? me;
    int favoritesCount;
    int conversationsCount;
    int notificationsCount;
    ACommerce.Kit.Roles.Role? activeRole;
    List<ACommerce.Kit.Roles.Role> tenantRoles = new();
    bool canManage;
    /// <summary>صَفحَةُ الباقاتِ تَعرِضُ باقَةً واحِدَةً عَلى الأَقَلّ (‏<c>PlanShelf.ShownAsync</c>) — شَرطُ بِطاقَتِها (‏2026-10-25، W8-7).</summary>
    bool plansShown;


    protected override async Task OnParametersSetAsync()
    {
        loadedTenant = await Tenants.FindAsync(Slug);
        if (loadedTenant is not null) tenantRoles = loadedTenant.Roles;

        if (!Auth.IsAuthenticated || Auth.UserId is null) return;

        // الوَثيقَةُ وثَلاثَةُ العَدّادات — جَلسَةٌ واحِدَة كَما كانَت،
        // انتَقَلَت إلى AccountQueries.SummaryAsync.
        var summary          = await Accounts.SummaryAsync(Slug, Auth.UserId.Value);
        me                   = summary.Me;
        favoritesCount       = summary.Favorites;
        conversationsCount   = summary.Conversations;
        notificationsCount   = summary.UnreadNotifications;
        plansShown = (await ACommerce.Templates.Customer.Marketplace.Services.PlanShelf.ShownAsync(PlanSvc, Providers, Slug)).Count > 0;
        if (me is not null && me.DeletedAt is null)
        {
            offerEmail = string.IsNullOrEmpty(me.Email) && Sp.GetService(typeof(ACommerce.Kit.Auth.IEmailOtpChannel)) is not null;
            offerPhone = string.IsNullOrEmpty(me.Phone) && Sp.GetService(typeof(ACommerce.Kit.Auth.IOtpChannel)) is not null;
        }
        if (Contact == "verify")
            pending = ACommerce.Templates.Customer.Marketplace.Services.AccountContacts.Pending(Slug, Attempt, Auth.UserId.Value);

        if (tenantRoles.Count > 0)
        {
            if (me is not null && !string.IsNullOrEmpty(me.ActiveRole))
                activeRole = tenantRoles.FirstOrDefault(r => r.Slug == (Role ?? me.ActiveRole));
            canManage = ACommerce.Kit.Roles.RolePermissions.Has(
                tenantRoles, Role ?? me?.ActiveRole, "tenant.manage");
        }
    }
}
