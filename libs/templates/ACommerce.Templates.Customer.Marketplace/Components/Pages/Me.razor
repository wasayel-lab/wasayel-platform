@page "/{slug}/me"
@page "/{slug}/r/{role}/me"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Accounts
@inject ITenantContext Tenant
@inject AuthSession Auth
@inject NavigationManager Nav
@inject L L

@*
    صَفحة "حِسابي". تَتَّبع بُنية Me.razor مِن القالَب القَديم
    (avatar card + stats + action grid + sign-out).
*@

<div class="acs-page acs-profile-page">
    <h1 class="acm-wizard-title">@L.Markup("shell.nav.account")</h1>

    @if (!Auth.IsAuthenticated)
    {
        <AcEmptyState IconName="user"
                      Title="@(L["me.login.title"])"
                      Message="@(L["me.login.message"])"
                      ActionLabel="@(L["auth.action.login"])"
                      ActionHref="@AuthSession.LinkFor(Slug, Role, $"login")" />
    }
    else
    {
        <AcCard>
            <ChildContent>
                <div class="acm-details-owner">
                    @if (!string.IsNullOrEmpty(me?.AvatarUrl))
                    {
                        <img src="@me!.AvatarUrl" alt="@(Auth.UserName)"
                             style="width:56px;height:56px;border-radius:50%;object-fit:cover;" />
                    }
                    else
                    {
                        <AcAvatar Name="@(Auth.UserName ?? L["me.profile.unknown_mark"])" Size="56" />
                    }
                    <div class="acm-details-owner-info" style="flex:1;">
                        <h3 style="margin:0;">@(Auth.UserName ?? L["me.profile.new_member"])</h3>
                        <span style="color:var(--ac-text-muted);font-size:13px;">
                            @(string.IsNullOrEmpty(me?.Phone) ? L.Format("me.profile.user_id", Auth.UserId?.ToString()![..8]) : me!.Phone)
                        </span>
                    </div>
                    <a class="ac-btn ac-btn-outline-primary" href="@AuthSession.LinkFor(Slug, Role, $"me/edit")">@L.Markup("me.profile.edit")</a>
                </div>
            </ChildContent>
        </AcCard>

        @* بِطاقَة الدَور النَّشِط — تَظهَر فَقَط في النَّمَط القَديم (بِلا /r/).
           داخِل PWA دَور مُحَدَّد، الدَور هو التَّطبيق نَفسه فَلا يُعرَض
           لا الدَور ولا زِرّ التَبديل. *@
        @if (activeRole is not null && string.IsNullOrEmpty(Role))
        {
            <AcCard>
                <ChildContent>
                    <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span><AcIcon Name="@ACommerce.Widgets.AcIconMap.Resolve(activeRole.Icon, "user")" Size="28" /></span>
                            <div>
                                <strong style="font-size:14px;">@activeRole.Label</strong>
                                <span style="display:block;color:var(--ac-text-muted);font-size:11px;">@L.Markup("me.role.active_label")</span>
                            </div>
                        </div>
                        @if (tenantRoles.Count > 1)
                        {
                            <a class="ac-btn ac-btn-ghost ac-btn-sm" href="@AuthSession.LinkFor(Slug, Role, $"me/role")">
                                <AcIcon Name="settings" Size="14" /> @L.Markup("me.role.switch")@((MarkupString)"\n                            ")
                            </a>
                        }
                    </div>
                </ChildContent>
            </AcCard>
        }

        <div class="acm-home-grid acm-stats-grid" style="margin-top:12px;">
            <a class="acm-stat-tile" href="@AuthSession.LinkFor(Slug, Role, $"favorites")">
                <strong>@favoritesCount</strong>
                <span>@L.Markup("me.stat.favorites")</span>
            </a>
            <a class="acm-stat-tile" href="@AuthSession.LinkFor(Slug, Role, $"chats")">
                <strong>@conversationsCount</strong>
                <span>@L.Markup("me.stat.chats")</span>
            </a>
            <a class="acm-stat-tile" href="@AuthSession.LinkFor(Slug, Role, $"notifications")">
                <strong>@notificationsCount</strong>
                <span>@L.Markup("me.stat.notifications")</span>
            </a>
        </div>

        <div class="acm-home-actions" style="margin-top:12px;">
            @if (canManage)
            {
                <AcActionCard Label="@(L["me.action.manage_store"])" IconName="settings" Variant="primary" Href="@AuthSession.LinkFor(Slug, Role, $"manage")" />
            }
            @* «إعلاناتي» — والمَدخَلُ هُنا لَيسَ تَزييناً بَل شَرطَ
               وُجود (القاعِدَة ١٢). التَبويبُ في الشِلّ يَظهَر لِأَدوارٍ
               بِعَينِها (‏`RiderNav`، `VendorNav`)، ومُستَأجِرٌ **بِلا
               أَدوار** يَقَع على `DefaultTabs` ولا `me/listings` فيها —
               مَقيس: صِفر رابِط في `/theme-demo`. فَكانَت «إعلاناتي»
               وشاشَةُ تَحريرِها كودًا حَيّاً لا يَبلُغُه أَحَد في
               نِصف المُستَأجِرين. وصَفحَةُ «حِسابي» هي **المَوضِع
               المُعلَن** لِلزائِد عَن خَمسَة تَبويبات
               (‏`MainLayout` §الشَريط السُفليّ). *@
            <AcActionCard Label="@(L["me.action.my_listings"])" IconName="package"      Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"me/listings")" />
            <AcActionCard Label="@(L["me.action.plans"])"      IconName="package"       Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"plans")" />
            <AcActionCard Label="@(L["me.action.favorites"])" IconName="heart"         Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"favorites")" />
            <AcActionCard Label="@(L["me.action.chats"])"   IconName="message"       Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"chats")" />
            <AcActionCard Label="@(L["me.action.notifications"])"     IconName="bell"          Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"notifications")" />
            <AcActionCard Label="@(L["me.action.deals"])"        IconName="receipt"       Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"deals")" />
            <AcActionCard Label="@(L["me.action.support"])" IconName="alert-circle"  Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"support")" />
            <AcActionCard Label="@(L["me.action.legal"])" IconName="info"     Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"legal")" />
        </div>

        <div style="margin-top:16px;">
            <form method="post" action="@($"/{Slug}/auth/logout")" style="margin:0;">
                <button type="submit" class="ac-btn ac-btn-ghost"
                        style="color:var(--ac-danger);width:100%;">
                    <AcIcon Name="log-out" Size="18" /> @L.Markup("auth.action.logout")@((MarkupString)"\n                ")
                </button>
            </form>
        </div>

        <div style="margin-top:24px;text-align:center;color:var(--ac-text-muted);font-size:12px;">
            @(loadedTenant?.Name) · platform-v1
        </div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }

    Tenant? loadedTenant;
    User? me;
    int favoritesCount;
    int conversationsCount;
    int notificationsCount;
    ACommerce.Kit.Roles.Role? activeRole;
    List<ACommerce.Kit.Roles.Role> tenantRoles = new();
    bool canManage;

    protected override async Task OnParametersSetAsync()
    {
        loadedTenant = await Tenants.FindAsync(Slug);
        if (loadedTenant is not null) tenantRoles = loadedTenant.Roles;

        if (!Auth.IsAuthenticated || Auth.UserId is null) return;

        // الوَثيقَةُ وثَلاثَةُ العَدّادات — جَلسَةٌ واحِدَة كَما كانَت،
        // انتَقَلَت إلى AccountQueries.SummaryAsync.
        var summary          = await Accounts.SummaryAsync(Slug, Auth.UserId.Value);
        me                   = summary.Me;
        favoritesCount       = summary.Favorites;
        conversationsCount   = summary.Conversations;
        notificationsCount   = summary.UnreadNotifications;

        if (tenantRoles.Count > 0)
        {
            if (me is not null && !string.IsNullOrEmpty(me.ActiveRole))
                activeRole = tenantRoles.FirstOrDefault(r => r.Slug == (Role ?? me.ActiveRole));
            canManage = ACommerce.Kit.Roles.RolePermissions.Has(
                tenantRoles, Role ?? me?.ActiveRole, "tenant.manage");
        }
    }
}
