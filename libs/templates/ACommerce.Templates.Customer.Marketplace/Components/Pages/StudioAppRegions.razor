@page "/studio/apps/{slug}/regions"
@inject Services.Incubator.StudioAuth Auth
@inject Services.Queries.TenantDirectory Tenants
@inject Services.Queries.TenantAdminQueries TenantAdmin
@inject L L
@using ACommerce.Kit.Tenants
@using ACommerce.Platform.Shared

@*
    تَحرير المُدُن والأَحياء — صيغَة: كُلّ سَطر مَدينَة، اختياريّاً
    تَتبَعها " > حَيّ١، حَيّ٢ ..". يُخزَّن في DiscoveryRegions كَ
    شَجَرَة مُسطَّحَة (Level 1 = مَدينَة، Level 2 = حَيّ).
*@

<StudioShell Title="@($"{L["studio.app_regions.title"]} {tenant?.Name ?? Slug}")" Active="home">
    <TopBarActions>
        <a class="st-btn st-btn-ghost" href="@($"/studio/apps/{Slug}")">← @L.Markup("studio.app_nav.settings")</a>
    </TopBarActions>
    <ChildContent>
        @if (tenant is null)
        {
            <div class="st-card">@L.Markup("studio.app.not_found")</div>
        }
        else
        {
            <div class="studio-page-head">
                <h1>@L.Markup("studio.app_regions.heading")</h1>
                <p>@L.Markup("studio.app_regions.intro")</p>
            </div>

            @if (Saved == "1")     { <div class="st-chip st-chip-success" style="margin-bottom:14px;"><AcIcon Name="check" Size="14" /> @L.Markup("studio.app.saved")</div> }
            @if (Err == "empty")   { <div class="st-chip st-chip-danger"  style="margin-bottom:14px;">@L.Markup("studio.app_regions.err_empty")</div> }
            @if (Err == "bad_format")  { <div class="st-chip st-chip-danger"  style="margin-bottom:14px;">@L.Markup("studio.app_regions.err_format")</div> }

            <form method="post" action="@($"/studio/apps/{Slug}/regions/save")" id="regions-form" class="st-card">
                <p style="color:var(--st-muted);font-size:13px;margin:0 0 14px;">@((MarkupString)"\n                    ")@L.Markup("studio.app_regions.hint_before") Enter @L.Markup("studio.app_regions.hint_after")@((MarkupString)"\n                ")
                </p>

                <div class="ac-editor" id="cities-editor">
                    @foreach (var (city, kids) in citiesWithKids)
                    {
                        <div class="ac-editor-row" data-city-row>
                            <div class="ac-editor-row-head">
                                <input class="ac-input ac-city-name" placeholder="@L["studio.app_regions.city_placeholder"]" value="@city" />
                                <button type="button" class="ac-icon-btn" data-remove-city aria-label="@L["studio.app_regions.remove_city"]"><AcIcon Name="x" Size="16" /></button>
                            </div>
                            <div>
                                <span class="ac-chip-input-label">@L.Markup("studio.app_regions.districts_label")</span>
                                <div class="ac-chip-input" data-districts>
                                    @foreach (var d in kids)
                                    {
                                        <span class="ac-chip-tag"><span class="t">@d</span><button type="button" aria-label="حَذف">×</button></span>
                                    }
                                    <input class="ac-chip-entry" placeholder="أَضِف حَيّاً ثُمَّ Enter" />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <button type="button" class="ac-add-row-btn" id="add-city" style="margin-top:12px;">
                    <AcIcon Name="plus" Size="16" /> @L.Markup("studio.app_regions.add_city")@((MarkupString)"\n                ")
                </button>

                <textarea name="regions" id="regions-hidden" hidden>@regionsText</textarea>

                <button type="submit" class="st-btn st-btn-primary" style="margin-top:16px;">@L.Markup("studio.app_regions.save")</button>
            </form>

            <template id="city-row-tpl">
                <div class="ac-editor-row" data-city-row>
                    <div class="ac-editor-row-head">
                        <input class="ac-input ac-city-name" placeholder="اسم المَدينَة" />
                        <button type="button" class="ac-icon-btn" data-remove-city aria-label="@L["studio.app_regions.remove_city"]"><AcIcon Name="x" Size="16" /></button>
                    </div>
                    <div>
                        <span class="ac-chip-input-label">@L.Markup("studio.app_regions.districts_label")</span>
                        <div class="ac-chip-input" data-districts>
                            <input class="ac-chip-entry" placeholder="أَضِف حَيّاً ثُمَّ Enter" />
                        </div>
                    </div>
                </div>
            </template>
        }
    </ChildContent>
</StudioShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery] public string? Saved { get; set; }
    [SupplyParameterFromQuery] public string? Err   { get; set; }
    Tenant? tenant;
    string regionsText = "";
    int lineCount;
    List<(string City, List<string> Districts)> citiesWithKids = new();

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is not null && tenant.OwnerUserId != Auth.UserId!.Value) { tenant = null; return; }
        if (tenant is null) return;

        // اِجلِب الـ DiscoveryRegions مِن tenant scope وحَوِّلها لِنَصّ.
        var records = (await TenantAdmin.ImportedAsync(Slug, new[] { "DiscoveryRegions" })).ToList();

        var cities = records.Where(r => GetInt(r, "Level") == 1)
            .OrderBy(r => GetInt(r, "SortOrder")).ToList();
        var lines = new List<string>();
        foreach (var c in cities)
        {
            var cityId = GetGuid(c, "Id");
            var name = GetStr(c, "Name");
            var districts = records
                .Where(r => GetInt(r, "Level") == 2 && GetGuid(r, "ParentId") == cityId)
                .OrderBy(r => GetInt(r, "SortOrder"))
                .Select(r => GetStr(r, "Name"))
                .Where(s => !string.IsNullOrEmpty(s)).ToList();
            lines.Add(districts.Count > 0 ? $"{name} > {string.Join("، ", districts)}" : name);
            citiesWithKids.Add((name, districts));
        }
        regionsText = string.Join("\n", lines);
        lineCount = lines.Count;
    }

    static string GetStr(ImportedRecord r, string k)
        => r.Data.TryGetValue(k, out var v) ? v?.ToString() ?? "" : "";
    static int GetInt(ImportedRecord r, string k)
        => r.Data.TryGetValue(k, out var v) && int.TryParse(v?.ToString(), out var i) ? i : 0;
    static Guid GetGuid(ImportedRecord r, string k)
        => r.Data.TryGetValue(k, out var v) && Guid.TryParse(v?.ToString(), out var g) ? g : Guid.Empty;
}
