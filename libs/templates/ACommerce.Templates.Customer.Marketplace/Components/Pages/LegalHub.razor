@page "/{slug}/legal"
@page "/{slug}/r/{role}/legal"
@page "/{slug}/legal/{section}"
@page "/{slug}/r/{role}/legal/{section}"
@inject L L

@*
    قِسم قانونيّ مُوَحَّد — Terms / Privacy / Returns. مَنقولَة مِن
    Order.V2 /legal hub. كُلّ قِسم صَفحَة فَرعِيَّة بِنَفس الـ URL.

    النُصوص مِن القامُوس. والفُروع الثَلاثَة **حَصرِيَّة**: الطَلَب
    الواحِد لا يُصَيِّر إلّا واحِداً، فَبُرهانُها ثَلاث صَفَحات في
    الأَساس لا واحِدَة (‏scripts/capture-appearance.sh).
*@

<div class="acs-page">
    <h1 class="acm-wizard-title">@L.Markup("legal.hub.title")</h1>

    <div style="display:flex;gap:6px;margin-bottom:16px;flex-wrap:wrap;">
        <a class="ac-chip @(Section == "terms" || Section == "" ? "ac-chip-active" : "")"
           href="@AuthSession.LinkFor(Slug, Role, "legal/terms")">@L.Markup("legal.hub.tab_terms")</a>
        <a class="ac-chip @(Section == "privacy" ? "ac-chip-active" : "")"
           href="@AuthSession.LinkFor(Slug, Role, "legal/privacy")">@L.Markup("legal.hub.tab_privacy")</a>
        <a class="ac-chip @(Section == "returns" ? "ac-chip-active" : "")"
           href="@AuthSession.LinkFor(Slug, Role, "legal/returns")">@L.Markup("legal.hub.tab_returns")</a>
        @* التَبويبانِ الجَديدانِ يَظهَرانِ **حينَ يُملَآن لا قَبلَه**
           (القاعِدَة ١٢): تَبويبٌ يَعرِضُ نائِباً لِزائِرٍ أَسوَأُ مِن
           غِيابِه، ومَدخَلٌ يُجيبُ بِـ«قَريباً» لَيسَ مَدخَلاً.
           و`L.IsPlaceholder` هُوَ نَفسُ القَرارِ الَّذي يَقيسُه
           `ComplianceInspector` — فَما يُخفى هُنا يَظهَرُ أَحمَرَ في
           لَوحَةِ الامتِثال، ولا يَختَفي مِن العَينَين مَعاً. *@
        @if (!L.IsPlaceholder("legal.merchant.identity"))
        {
            <a class="ac-chip @(Section == "merchant" ? "ac-chip-active" : "")"
               href="@AuthSession.LinkFor(Slug, Role, "legal/merchant")">@L.Markup("legal.hub.tab_merchant")</a>
        }
        @if (!L.IsPlaceholder("legal.delay.body"))
        {
            <a class="ac-chip @(Section == "delay" ? "ac-chip-active" : "")"
               href="@AuthSession.LinkFor(Slug, Role, "legal/delay")">@L.Markup("legal.hub.tab_delay")</a>
        }
    </div>

    <AcCard>
        <ChildContent>
            @if (Section == "privacy")
            {
                <h2>@L.Markup("legal.privacy.title")</h2>
                <p>@L.Markup("legal.privacy.intro")</p>
                <ul>
                    <li>@L.Markup("legal.privacy.item_identity")</li>
                    <li>@L.Markup("legal.privacy.item_addresses")</li>
                    <li>@L.Markup("legal.privacy.item_history")</li>
                </ul>
                <p>@L.Markup("legal.privacy.no_selling")</p>
                <p>@L.Markup("legal.privacy.deletion")</p>
            }
            else if (Section == "merchant" && !L.IsPlaceholder("legal.merchant.identity"))
            {
                <h2>@L.Markup("legal.merchant.title")</h2>
                <ul>
                    <li>@L.Markup("legal.merchant.identity")</li>
                    <li>@L.Markup("legal.merchant.contact")</li>
                    <li>@L.Markup("legal.merchant.registration")</li>
                    @if (!L.IsPlaceholder("legal.merchant.licence_authority"))
                    {
                        <li>@L.Markup("legal.merchant.licence_authority")</li>
                    }
                    @if (!L.IsPlaceholder("legal.merchant.licence_title"))
                    {
                        <li>@L.Markup("legal.merchant.licence_title")</li>
                    }
                </ul>
            }
            else if (Section == "delay" && !L.IsPlaceholder("legal.delay.body"))
            {
                <h2>@L.Markup("legal.delay.title")</h2>
                <p>@L.Markup("legal.delay.body")</p>
            }
            else if (Section == "returns")
            {
                <h2>@L.Markup("legal.returns.title")</h2>
                <ul>
                    <li>@L.Markup("legal.returns.item_goods")</li>
                    <li>@L.Markup("legal.returns.item_services")</li>
                    <li>@L.Markup("legal.returns.item_ads")</li>
                </ul>
                <p>@L.Markup("legal.returns.how")</p>
            }
            else
            {
                <h2>@L.Markup("legal.terms.title")</h2>
                <p>@L.Markup("legal.terms.intro")</p>
                <ol>
                    <li>@L.Markup("legal.terms.item_lawful")</li>
                    <li>@L.Markup("legal.terms.item_accuracy")</li>
                    <li>@L.Markup("legal.terms.item_commission")</li>
                    <li>@L.Markup("legal.terms.item_disputes")</li>
                </ol>
                <p>@L.Markup("legal.terms.violations")</p>
            }
        </ChildContent>
    </AcCard>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [Parameter] public string Section { get; set; } = "";
}
