@page "/{slug}/vendor/{vendorId:guid}"
@page "/{slug}/r/{role}/vendor/{vendorId:guid}"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.StorefrontQueries Storefront
@inject AuthSession Auth
@inject IHttpContextAccessor HttpCtx
@inject L L
@using ACommerce.Kit.Reviews

@*
    صَفحَة بائِع — تَجرِبَة Order.V2 المَنقولَة. اِسم/صورَة + تَقييم
    مُتَوَسِّط + إعلانات البائِع + CTA لِلتَّواصُل والمُتابَعَة.
*@

<div class="acs-page">
    @if (vendor is null)
    {
        <AcEmptyState IconName="info" Title="@L["vendors.profile.not_found"]" />
    }
    else
    {
        <AcCard>
            <ChildContent>
                <div style="display:flex;gap:12px;align-items:center;">
                    <div style="width:64px;height:64px;border-radius:50%;background:var(--ac-primary);color:var(--ac-on-primary);
                                display:grid;place-items:center;font-size:24px;font-weight:700;">
                        @(string.IsNullOrEmpty(vendor.FullName) ? "?" : vendor.FullName[0].ToString())
                    </div>
                    <div style="flex:1;">
                        <h2 style="margin:0;">@vendor.FullName</h2>
                        @if (avgRating > 0)
                        {
                            <div style="color:var(--ac-rating);font-size:14px;">
                                @for (var i = 0; i < (int)Math.Round(avgRating); i++)
                                {
                                    <AcIcon Name="star" Size="14" Filled="true" />
                                }<span style="color:var(--ac-text-muted);">
                                    @avgRating.ToString("0.0") (@reviewCount @L.Markup("vendors.profile.rating_unit")@((MarkupString)"\n                                ")
                                </span>
                            </div>
                        }
                        else
                        {
                            <span style="color:var(--ac-text-muted);font-size:13px;">@L.Markup("vendors.profile.no_ratings")</span>
                        }
                    </div>
                </div>
            </ChildContent>
        </AcCard>

        @if (Auth.IsAuthenticated && vendor.Id != Auth.UserId)
        {
            <form method="post" action="@($"/{Slug}/vendor/{VendorId}/chat")" style="margin:0 0 12px;">
                <AcButton Type="submit" Variant="primary" Block="true" Text="@L["vendors.profile.contact"]" />
            </form>
        }

        <AcSectionHeader Title="@($"{L["vendors.profile.listings_prefix"]} {vendor.FullName} ({listings.Count})")" />
        @if (listings.Count == 0)
        {
            <AcEmptyState IconName="package" Title="@L["vendors.profile.empty_title"]"
                          Message="@L["vendors.profile.empty_msg"]"
                          ActionLabel="@L["shell.nav.explore"]"
                          ActionHref="@AuthSession.LinkFor(Slug, Role, "explore")" />
        }
        else
        {
            <div class="acm-cat-list">
                @foreach (var l in listings)
                {
                    <a href="@AuthSession.LinkFor(Slug, Role, $"listings/{l.Id}")" class="acm-cat-row"
                       style="text-decoration:none;color:inherit;">
                        <div style="flex:1;">
                            <strong>@l.Title</strong>
                            <span style="color:var(--ac-text-muted);font-size:12px;display:block;">
                                @* الفَراغُ الذَيليّ صَريح: كانَ مُلتَصِقاً بِـ«ر.س» في عُقدَةٍ
                                   واحِدَة فَنَجا، ولَمّا خَرَجَت العُملَةُ إلى المُنَسِّق صارَ
                                   الفَراغُ وَحدَه حافَّةً فَحُذِف. (الفَخُّ الأَوَّل.) *@
                                @((MarkupString)ACommerce.Kit.Culture.Money.Format(l.Price))@((MarkupString)"\n                            ")
                            </span>
                        </div>
                        <AcIcon Name="chevron-left" Size="16" />
                    </a>
                }
            </div>
        }

        @if (reviews.Count > 0)
        {
            <AcSectionHeader Title="@L["vendors.profile.reviews_title"]" />
            <div class="acm-cat-list">
                @foreach (var r in reviews.Take(10))
                {
                    <AcCard>
                        <ChildContent>
                            <div style="display:flex;justify-content:space-between;align-items:start;">
                                <strong>@r.AuthorName</strong>
                                <span style="color:var(--ac-rating);">
                                    @for (var i = 0; i < r.Rating; i++)
                                    {
                                        <AcIcon Name="star" Size="14" Filled="true" />
                                    }
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(r.Body))
                            {
                                <p style="margin:6px 0 0;font-size:14px;">@r.Body</p>
                            }
                            <span style="color:var(--ac-text-muted);font-size:11px;">@r.At.ToString("yyyy-MM-dd")</span>
                        </ChildContent>
                    </AcCard>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [Parameter] public Guid VendorId { get; set; }

    User? vendor;
    List<Listing> listings = new();
    List<Review> reviews = new();
    double avgRating;
    int reviewCount;

    protected override async Task OnInitializedAsync()
    {
        if (HttpCtx.HttpContext is { } ctx) { Auth.SetTenant(Slug); Auth.Load(ctx, Slug); }
        var page = await Storefront.VendorAsync(Slug, VendorId);
        vendor = page.Vendor;
        if (vendor is null) return;
        listings = page.Listings.ToList();
        reviews  = page.Reviews.ToList();
        reviewCount = reviews.Count;
        if (reviewCount > 0) avgRating = reviews.Average(r => r.Rating);
    }
}
