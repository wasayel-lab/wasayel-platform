@page "/{slug}/me/area"
@page "/{slug}/r/{role}/me/area"
@inject IDocumentStore Store
@inject AuthSession Auth

@*
    ضَبط مَنطِقَة عَمَل السائِق — نُقطَة المَركَز + نِصف قُطر بِالكيلومِترات.
    تَفلتَر feed المَشاوير لِيَعرِض فَقَط الطَّلَبات الَّتي تَقَع ضِمن
    النِطاق. مَفيدَة في إنجيز وَتَطبيقات الشَحن المُشابِهَة لِمَنع
    عَرض مَشاوير في مَدينَة أُخرى.
*@

<div class="acs-page">
    <a class="ac-btn ac-btn-ghost ac-btn-sm" href="@($"/{Slug}")">
        <AcIcon Name="arrow-right" Size="16" /> الرُجوع
    </a>

    <h1 class="acm-wizard-title">مَنطِقَة عَمَلي</h1>
    <p style="color:var(--ac-text-muted);font-size:14px;margin:0 0 16px;">
        حَدِّد مَركَزَ المَنطِقَة + نِصف القُطر، وَ سَتَرَى فَقَط المَشاوير
        ضِمن هذا النِطاق. اِترُك نِصف القُطر صِفراً لِرُؤيَة كُلّ المَشاوير.
    </p>

    @if (Saved == "1") { <AcAlert Variant="success" Message="تَمّ الحِفظ." /> }

    @if (user is null)
    {
        <AcEmptyState IconName="user" Title="تَحتاج تَسجيل دُخول"
                      ActionLabel="تَسجيل دُخول" ActionHref="@AuthSession.LinkFor(Slug, Role, $"login")" />
    }
    else
    {
        <form method="post" action="@($"/{Slug}/me/area/save")">
            <AcCard>
                <ChildContent>
                    <AcLocationInput Name="anchor"
                                     Label="مَركَز مَنطِقَة العَمَل"
                                     InitialLat="@(user.HasAnchor ? user.AnchorLat : (double?)null)"
                                     InitialLng="@(user.HasAnchor ? user.AnchorLng : (double?)null)" />

                    <AcField Label="نِصف القُطر (كم)">
                        <input type="number" name="radius" min="0" max="500" step="1"
                               class="ac-input" inputmode="numeric"
                               value="@user.RadiusKm" placeholder="مَثَلاً 15" />
                    </AcField>
                </ChildContent>
            </AcCard>

            <button type="submit" class="ac-btn ac-btn-primary ac-btn-lg ac-btn-block" style="margin-top:16px;">
                <AcIcon Name="check" Size="18" /> حِفظ المَنطِقَة
            </button>
        </form>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }
    User? user;

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsAuthenticated) return;
        await using var s = Store.QuerySession(Slug);
        user = await s.LoadAsync<User>(Auth.UserId!.Value);
    }
}
