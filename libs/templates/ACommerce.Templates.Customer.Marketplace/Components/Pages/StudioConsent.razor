@page "/studio/consent"
@inject Services.Incubator.StudioAuth Auth
@inject Marten.IDocumentStore Store
@using ACommerce.Templates.Customer.Marketplace.Services.Incubator

@*
    صَفحَة قَبول الشُروط — تَظهَر قَبل أَوَّل تَحليل. POST يَحفَظ
    ConsentRecord بِالنُسخَة الحاليَّة. لا يُمكِن المُتابَعَة بِدونها.
*@

<div class="studio-root">
    @{ Auth.Load(); }
    @if (!Auth.IsAuthenticated)
    {
        <script>location.replace('/studio/auth');</script>
    }
    else if (alreadyConsented)
    {
        <script>location.replace('@(ReturnUrl ?? "/studio")');</script>
    }
    else
    {
        <div class="auth-wrap">
            <div class="auth-card" style="max-width:560px;">
                <div class="auth-logo"><div class="auth-logo-mark"><AcIcon Name="file" Size="24" /></div></div>
                <h1 class="auth-title">الشُروط والأَحكام</h1>
                <p class="auth-sub">إصدار @ConsentPolicy.CurrentVersion</p>

                <div style="background:var(--st-line-soft);border-radius:12px;padding:16px 18px;
                            font-size:14px;line-height:1.9;color:var(--st-ink-700);
                            max-height:280px;overflow-y:auto;text-align:start;">
                    <p><strong>١. مُحتَوى مُولَّد آلِيّاً.</strong> الدِراسات يُولِّدها نَموذَج ذَكاء اصطِناعيّ بِناءً على بيانات السوق المُتاحَة. قَد تَحتَوي عَلى تَخمينات.</p>
                    <p><strong>٢. مَسؤوليَّة القَرار.</strong> أَنتَ المَسؤول الوَحيد عَن أَيّ قَرار استِثماريّ أَو تَشغيليّ تَبنيه عَلى التَّحليل. المَنصَّة لَيسَت بَديلاً عَن مَشورَة قانونيَّة/مُحاسَبيَّة.</p>
                    <p><strong>٣. الخُصوصِيَّة.</strong> نَحفَظ بَياناتِكَ (هاتِف، أَفكار، تَحاليل) لِاستِخدامِها في تَحسين الخِدمَة. لا نُشارِكها مَع أَطراف ثالِثَة.</p>
                    <p><strong>٤. الباقات.</strong> الباقات لَها حُدود شَهريَّة. تُعاد كُلّ ٣٠ يَوم. الدَّفع مُسَجَّل كَ نِيَّة فَقَط في هذه المَرحَلَة (لا يَتِم تَحصيل).</p>
                    <p><strong>٥. التَّحديثات.</strong> قَد نُحَدِّث الشُروط. التَّحديث يَتَطَلَّب قَبولاً جَديداً. التَّحاليل القَديمَة تَبقى صالِحَة ٦ أَشهُر.</p>
                </div>

                <form method="post" action="/studio/consent/accept">
                    <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/studio")" />
                    <label style="display:flex;align-items:flex-start;gap:8px;margin:18px 0 14px;font-size:14px;">
                        <input type="checkbox" required style="margin-top:3px;flex-shrink:0;" />
                        <span>قَرَأت ووافَقت عَلى الشُروط والأَحكام أَعلاه.</span>
                    </label>
                    <button type="submit" class="st-btn st-btn-primary st-btn-block st-btn-lg">
                        قَبول ومُتابَعَة
                    </button>
                </form>

                <p style="text-align:center;margin-top:14px;">
                    <a href="/studio/logout" style="color:var(--st-muted);font-size:13px;text-decoration:none;">
                        رَفض وَخُروج
                    </a>
                </p>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    bool alreadyConsented;

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        await using var qs = Store.QuerySession(
            ACommerce.Templates.Customer.Marketplace.Services.Incubator.StudioAuth.Tenant);
        var existing = await qs.Query<ConsentRecord>()
            .Where(c => c.UserId == Auth.UserId!.Value && c.Version == ConsentPolicy.CurrentVersion)
            .ToListAsync();
        alreadyConsented = existing.Count > 0;
    }
}
