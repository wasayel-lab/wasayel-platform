@page "/studio/consent"
@inject Services.Incubator.StudioAuth Auth
@inject Services.Queries.StudioQueries Studio
@using ACommerce.Templates.Customer.Marketplace.Services.Incubator
@inject L L

@*
    صَفحَة قَبول الشُروط — تَظهَر قَبل أَوَّل تَحليل. POST يَحفَظ
    ConsentRecord بِالنُسخَة الحاليَّة. لا يُمكِن المُتابَعَة بِدونها.
*@

<div class="studio-root">
    @{ Auth.Load(); }
    @if (!Auth.IsAuthenticated)
    {
        <script>location.replace('/studio/auth');</script>
    }
    else if (alreadyConsented)
    {
        <script>location.replace('@(ReturnUrl ?? "/studio")');</script>
    }
    else
    {
        <div class="auth-wrap">
            <div class="auth-card" style="max-width:560px;">
                <div class="auth-logo"><div class="auth-logo-mark"><AcIcon Name="file" Size="24" /></div></div>
                <h1 class="auth-title">@L.Markup("studio.consent.title")</h1>
                <p class="auth-sub">@L.Markup("studio.consent.version") @ConsentPolicy.CurrentVersion</p>

                <div style="background:var(--st-line-soft);border-radius:12px;padding:16px 18px;
                            font-size:14px;line-height:1.9;color:var(--st-ink-700);
                            max-height:280px;overflow-y:auto;text-align:start;">
                    <p><strong>@L.Markup("studio.consent.item1_title")</strong> @L.Markup("studio.consent.item1_body")</p>
                    <p><strong>@L.Markup("studio.consent.item2_title")</strong> @L.Markup("studio.consent.item2_body")</p>
                    <p><strong>@L.Markup("studio.consent.item3_title")</strong> @L.Markup("studio.consent.item3_body")</p>
                    <p><strong>@L.Markup("studio.consent.item4_title")</strong> @L.Markup("studio.consent.item4_body")</p>
                    <p><strong>@L.Markup("studio.consent.item5_title")</strong> @L.Markup("studio.consent.item5_body")</p>
                </div>

                <form method="post" action="/studio/consent/accept">
                    <input type="hidden" name="returnUrl" value="@(ReturnUrl ?? "/studio")" />
                    <label style="display:flex;align-items:flex-start;gap:8px;margin:18px 0 14px;font-size:14px;">
                        <input type="checkbox" required style="margin-top:3px;flex-shrink:0;" />
                        <span>@L.Markup("studio.consent.checkbox")</span>
                    </label>
                    <button type="submit" class="st-btn st-btn-primary st-btn-block st-btn-lg">
                        @((MarkupString)"\n                        ")@L.Markup("studio.consent.accept")@((MarkupString)"\n                    ")
                    </button>
                </form>

                <p style="text-align:center;margin-top:14px;">
                    <a href="/studio/logout" style="color:var(--st-muted);font-size:13px;text-decoration:none;">
                        @((MarkupString)"\n                        ")@L.Markup("studio.consent.reject")@((MarkupString)"\n                    ")
                    </a>
                </p>
            </div>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    bool alreadyConsented;

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        alreadyConsented = await Studio.HasConsentedAsync(
            Auth.UserId!.Value, ConsentPolicy.CurrentVersion);
    }
}
