@page "/{slug}/me/searches"
@page "/{slug}/r/{role}/me/searches"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Accounts
@inject AuthSession Auth
@inject L L

@*
    إدارَة البَحوث المَحفوظَة لِلمُستَخدِم — السائِق (إنجيز) يَستَخدِمها
    لِيَصِله إشعار عَلى مَشاوير في مَدينَة/سِعر مُحَدَّدَين، الباحِث عَن
    سَكَن (عَشير) لِيُنبَّه عَلى إعلانات سَكَن جَديدَة بِخَصائِص مُعَيَّنَة.
*@

<div class="acs-page">
    <h1 class="acm-wizard-title">@L.Markup("searches.page.title")</h1>

    @if (Saved == "1") { <AcAlert Variant="success" Message="@(L["searches.saved.ok"])" /> }

    @if (!Auth.IsAuthenticated)
    {
        <AcEmptyState IconName="user" Title="@(L["searches.login.title"])"
                      ActionLabel="@(L["auth.action.login"])"
                      ActionHref="@AuthSession.LinkFor(Slug, Role, $"login?returnUrl=/{Slug}/me/searches")" />
    }
    else if (searches is null)
    {
        <AcLoadingState />
    }
    else
    {
        <AcCard>
            <ChildContent>
                <h3 style="margin-top:0;">@L.Markup("searches.new.heading")</h3>
                <p style="color:var(--ac-text-muted);font-size:13px;margin:0 0 12px;">
                    @((MarkupString)"\n                    ")@L.Markup("searches.new.note")@((MarkupString)"\n                ")
                </p>
                <form method="post" action="@($"/{Slug}/searches/save")">
                    <AcField Label="@(L["searches.field.label"])" Required="true">
                        <input type="text" name="label" required maxlength="80"
                               class="ac-input" placeholder="مَشاوير حَدّة" />
                    </AcField>
                    @if (tenant is not null && tenant.Categories.Count > 0)
                    {
                        <AcField Label="@(L["searches.field.category"])">
                            <select name="category" class="ac-input">
                                <option value="">@L.Markup("searches.option.all_categories")</option>
                                @foreach (var c in tenant.Categories.OrderBy(c => c.SortOrder))
                                {
                                    <option value="@c.Slug">@c.Label</option>
                                }
                            </select>
                        </AcField>
                    }
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                        <AcField Label="@(L["searches.field.city"])">
                            <input type="text" name="city" maxlength="40" class="ac-input" />
                        </AcField>
                        <AcField Label="@(L["searches.field.district"])">
                            <input type="text" name="district" maxlength="60" class="ac-input" />
                        </AcField>
                    </div>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                        <AcField Label="@(L["searches.field.min_price"])">
                            <input type="number" name="min" min="0" class="ac-input" />
                        </AcField>
                        <AcField Label="@(L["searches.field.max_price"])">
                            <input type="number" name="max" min="0" class="ac-input" />
                        </AcField>
                    </div>
                    <button type="submit" class="ac-btn ac-btn-primary ac-btn-block" style="margin-top:8px;">
                        <AcIcon Name="check" Size="16" /> @L.Markup("searches.action.save")@((MarkupString)"\n                    ")
                    </button>
                </form>
            </ChildContent>
        </AcCard>

        @if (searches.Count == 0)
        {
            <p style="color:var(--ac-text-muted);text-align:center;padding:24px;">
                @((MarkupString)"\n                ")@L.Markup("searches.list.empty")@((MarkupString)"\n            ")
            </p>
        }
        else
        {
            <div class="ac-offer-list" style="margin-top:16px;">
                @foreach (var ss in searches)
                {
                    <div class="ac-offer">
                        <div style="display:flex;justify-content:space-between;align-items:center;">
                            <div>
                                <strong>@ss.Label</strong>
                                @if (!ss.IsEnabled)
                                {
                                    <span class="ac-chip ac-chip-sm" style="opacity:.6;margin-inline-start:6px;">@L.Markup("searches.chip.disabled")</span>
                                }
                            </div>
                            <div style="display:flex;gap:6px;">
                                <form method="post" action="@($"/{Slug}/searches/{ss.Id}/toggle")" style="margin:0;">
                                    <button type="submit" class="ac-btn ac-btn-ghost ac-btn-sm">
                                        @(ss.IsEnabled ? L["searches.action.pause"] : L["searches.action.resume"])
                                    </button>
                                </form>
                                <form method="post" action="@($"/{Slug}/searches/{ss.Id}/delete")" style="margin:0;">
                                    <button type="submit" class="ac-btn ac-btn-ghost ac-btn-sm">
                                        <AcIcon Name="x" Size="14" />
                                    </button>
                                </form>
                            </div>
                        </div>
                        <p style="margin:6px 0 0;font-size:13px;color:var(--ac-text-muted);">@ss.Summary()</p>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }
    Tenant? tenant;
    IReadOnlyList<ACommerce.Kit.SavedSearches.SavedSearch>? searches;

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsAuthenticated) return;
        tenant   = await Tenants.FindAsync(Slug);
        searches = await Accounts.SavedSearchesAsync(Slug, Auth.UserId!.Value);
    }
}
