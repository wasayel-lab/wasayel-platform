@page "/studio/apps/{slug}/roles"
@inject Services.Incubator.StudioAuth Auth
@inject Services.Queries.TenantDirectory Tenants
@inject L L
@using ACommerce.Kit.Tenants
@using ACommerce.Kit.Roles

@*
    تَحرير الأَدوار — checklist مِن RoleCatalog الثابِت. كُلّ دَور
    = تَطبيق فَرعيّ. الـ default يُستَخدَم لِلمُستَخدِم الجَديد.
*@

<StudioShell Title="@($"{L["studio.app_roles.title"]} {tenant?.Name ?? Slug}")" Active="home">
    <TopBarActions>
        <a class="st-btn st-btn-ghost" href="@($"/studio/apps/{Slug}")">← @L.Markup("studio.app_nav.settings")</a>
    </TopBarActions>
    <ChildContent>
        @if (tenant is null)
        {
            <div class="st-card">@L.Markup("studio.app.not_found")</div>
        }
        else
        {
            <div class="studio-page-head">
                <h1>@L.Markup("studio.app_roles.heading")</h1>
                <p>@L.Markup("studio.app_roles.intro_before")PWA) @L.Markup("studio.app_roles.intro_after")</p>
            </div>

            @if (Saved == "1") { <div class="st-chip st-chip-success" style="margin-bottom:14px;">@L.Markup("studio.app.saved") <AcIcon Name="check" Size="16" /></div> }

            <form method="post" action="@($"/studio/apps/{Slug}/roles/save")">
                <div class="studio-list">
                    @foreach (var tmpl in RoleCatalog.All)
                    {
                        var existing = tenant.Roles.FirstOrDefault(r => r.CatalogSlug == tmpl.Slug);
                        var isPicked = existing is not null;
                        <label class="st-card" style="cursor:pointer;display:flex;align-items:flex-start;gap:14px;
                                                       @(isPicked ? "border-color:var(--st-primary);background:var(--st-primary-50);" : "")">
                            @if (isPicked)
                            {
                                <input type="checkbox" name="role_@(tmpl.Slug)" value="1" checked
                                       style="margin-top:4px;width:18px;height:18px;flex-shrink:0;" />
                            }
                            else
                            {
                                <input type="checkbox" name="role_@(tmpl.Slug)" value="1"
                                       style="margin-top:4px;width:18px;height:18px;flex-shrink:0;" />
                            }
                            <div style="flex:1;">
                                <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
                                    <strong style="font-size:15px;"><AcIcon Name="@ACommerce.Widgets.AcIconMap.Resolve(tmpl.Icon, "tag")" Size="16" /> @tmpl.Label</strong>
                                    @if (isPicked)
                                    {
                                        <label style="display:inline-flex;align-items:center;gap:4px;font-size:12px;color:var(--st-muted);">
                                            <input type="radio" name="default_role" value="@tmpl.Slug"
                                                   checked="@(existing!.IsDefault)" />
                                            @L.Markup("studio.app_roles.default")@((MarkupString)"\n                                        ")
                                        </label>
                                    }
                                </div>
                                <p style="margin:0 0 8px;color:var(--st-muted);font-size:13px;">@tmpl.Description</p>
                                <div style="display:flex;flex-wrap:wrap;gap:4px;">
                                    @foreach (var p in tmpl.Permissions)
                                    {
                                        <span class="st-chip" style="font-size:11px;background:var(--st-line-soft);color:var(--st-ink-700);">@p</span>
                                    }
                                </div>
                            </div>
                        </label>
                    }
                </div>
                <button type="submit" class="st-btn st-btn-primary" style="margin-top:18px;">@L.Markup("studio.app_roles.save")</button>
            </form>
        }
    </ChildContent>
</StudioShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery] public string? Saved { get; set; }
    Tenant? tenant;

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is not null && tenant.OwnerUserId != Auth.UserId!.Value) tenant = null;
    }
}
