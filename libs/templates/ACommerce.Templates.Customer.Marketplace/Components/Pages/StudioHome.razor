@page "/studio"
@page "/studio/ideas"
@inject Services.Incubator.StudioAuth Auth
@inject Services.Incubator.FeasibilityAnalysisService Incubator
@inject Services.Queries.TenantDirectory Tenants
@using ACommerce.Templates.Customer.Marketplace.Services.Incubator
@inject L L
@using ACommerce.Kit.Tenants

@*
    لوحَة رائِد الأَعمال — مَدخَل مَوَحَّد:
    ١) تَطبيقاتي (المَتاجِر الَّتي يَملِكها) — كَ "اشتِراك مَتجَر تَطبيقات".
    ٢) أَفكاري وتَحاليلي (الـ incubator sessions).
    ٣) مَدخَلان واضِحان لِمَساعِدَي الذَّكاء:
       • «حَلِّل فِكرَة» (/studio/new) — دِراسَة جَدوى لِفِكرَة قَبل البِناء.
       • «وَكيل التَّطبيقات» (/studio/agent) — مُحادَثَة تُعَدِّل تَطبيقات
         قائِمَة (فِئات/أَدوار/مُدُن/خَصائِص) مَع فَحص ملكيَّة كُلّ عَمَلِيَّة.

    الـ Active يَتَبَدَّل بَين home/ideas حَسَب المَسار.
*@

<StudioShell Title="@Title" Active="@(IsIdeas ? "ideas" : "home")">
    <TopBarActions>
        <a class="st-btn st-btn-ghost" href="/studio/agent">
            <AcIcon Name="message" Size="14" /> @L.Markup("studio.home.agent_cta")@((MarkupString)"\n        ")
        </a>
        <a class="st-btn st-btn-primary" href="/studio/new" style="margin-inline-start:8px;">
            <AcIcon Name="lightbulb" Size="14" /> @L.Markup("studio.home.new_idea")@((MarkupString)"\n        ")
        </a>
    </TopBarActions>
    <ChildContent>
        <UpgradePrompt Reason="@Upgrade" CurrentTier="@(currentTier ?? "spark")" />

        <div class="studio-page-head">
            <h1>@(IsIdeas ? L["studio.home.ideas_title"] : Greeting)</h1>
            <p>@(IsIdeas ? L["studio.home.ideas_sub"]
                          : L["studio.home.home_sub"])</p>
        </div>

        @if (!IsIdeas)
        {
            @* بِطاقَتان واضِحَتان لِمَساعِدَي الذَّكاء — كُلّ واحِدَة بِغَرَض مُختَلِف. *@
            <div class="studio-list" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px;margin-bottom:18px;">
                <a class="studio-list-row" href="/studio/new" style="align-items:flex-start;">
                    <span class="studio-list-icon" style="background:#fef3c7;color:#854d0e;">
                        <AcIcon Name="lightbulb" Size="18" />
                    </span>
                    <div class="studio-list-body" style="flex:1;">
                        <strong>@L.Markup("studio.home.analyze_title")</strong>
                        <span style="line-height:1.6;">@L.Markup("studio.home.analyze_body")</span>
                    </div>
                    <span style="color:var(--st-faint);">←</span>
                </a>
                <a class="studio-list-row" href="/studio/agent" style="align-items:flex-start;">
                    <span class="studio-list-icon ac-chip-info">
                        <AcIcon Name="message" Size="18" />
                    </span>
                    <div class="studio-list-body" style="flex:1;">
                        <strong>@L.Markup("studio.home.agent_title")</strong>
                        <span style="line-height:1.6;">@L.Markup("studio.home.agent_body")</span>
                    </div>
                    <span style="color:var(--st-faint);">←</span>
                </a>
            </div>

            <div class="studio-stats">
                <div class="studio-stat">
                    <div class="studio-stat-label">@L.Markup("studio.home.stat_apps")</div>
                    <div class="studio-stat-value">@(myApps?.Count ?? 0)</div>
                    <div class="studio-stat-sub">@L.Markup("studio.home.stat_apps_sub")</div>
                </div>
                <div class="studio-stat">
                    <div class="studio-stat-label">@L.Markup("studio.home.stat_studies")</div>
                    <div class="studio-stat-value">@(sessions?.Count(s => s.Status == IncubatorStatus.Completed) ?? 0)</div>
                </div>
                <div class="studio-stat">
                    <div class="studio-stat-label">@L.Markup("studio.home.stat_ideas")</div>
                    <div class="studio-stat-value">@(sessions?.Count ?? 0)</div>
                </div>
            </div>

            <div class="st-section-title" style="display:flex;justify-content:space-between;align-items:center;">
                <span>@L.Markup("studio.home.my_apps")</span>
                <a href="/studio/new" style="font-size:12px;color:var(--st-primary);text-decoration:none;font-weight:600;">@L.Markup("studio.home.plus_idea")</a>
            </div>
            @if (myApps is null)
            {
                <div class="st-card">@L.Markup("studio.state.loading")</div>
            }
            else if (myApps.Count == 0)
            {
                <div class="st-card" style="text-align:center;padding:36px;">
                    <div style="font-size:42px;margin-bottom:6px;"><AcIcon Name="package" Size="48" /></div>
                    <h3 style="margin:0 0 6px;">@L.Markup("studio.home.no_apps")</h3>
                    <p style="color:var(--st-muted);margin:0 0 16px;">@L.Markup("studio.home.no_apps_body")</p>
                    <a class="st-btn st-btn-primary" href="/studio/new">@L.Markup("studio.home.start_idea")</a>
                </div>
            }
            else
            {
                <div class="studio-list">
                    @foreach (var t in myApps)
                    {
                        <a class="studio-list-row" href="@($"/studio/apps/{t.Slug}")">
                            <span class="studio-list-icon"
                                  style="background:@(t.BrandColor)1a;color:@t.BrandColor;">
                                @(t.Name.FirstOrDefault())
                            </span>
                            <div class="studio-list-body">
                                <strong>@t.Name</strong>
                                <span>/@t.Slug · @t.Categories.Count @L.Markup("studio.home.category_unit") · @t.Roles.Count @L.Markup("studio.home.role_unit")</span>
                            </div>
                            <span class="st-chip">@(t.Roles.Count == 0 ? L["studio.home.kind_store"] : L["studio.home.kind_multirole"])</span>
                            <span style="color:var(--st-faint);">←</span>
                        </a>
                    }
                </div>
            }
        }

        @if (!IsIdeas && recentDeals.Count > 0)
        {
            <div class="st-section-title">@L.Markup("studio.home.recent_deals")</div>
            <div class="studio-list">
                @foreach (var (slug, d) in recentDeals.Take(5))
                {
                    <a class="studio-list-row" href="@($"/studio/apps/{slug}/deals/{d.Id}")">
                        <span class="studio-list-icon ac-chip-info"><AcIcon Name="@StageEmoji(d.Stage)" Size="16" /></span>
                        <div class="studio-list-body">
                            <strong>
                                @(string.IsNullOrEmpty(d.ListingTitle) ? d.Pattern : d.ListingTitle)
                            </strong>
                            <span>/@slug · @d.Pattern · @d.UpdatedAt.ToString("HH:mm")</span>
                        </div>
                        <span class="st-chip">@Services.Deals.DealsPolicy.LabelAr(d.Stage)</span>
                    </a>
                }
            </div>
        }

        <div class="st-section-title">@(IsIdeas ? L["studio.home.analysis_sessions"] : L["studio.home.recent_ideas"])</div>
        @if (sessions is null)
        {
            <div class="st-card">@L.Markup("studio.state.loading")</div>
        }
        else if (sessions.Count == 0)
        {
            <div class="st-card" style="text-align:center;padding:36px;">
                <div style="font-size:42px;margin-bottom:6px;"><AcIcon Name="lightbulb" Size="48" /></div>
                <h3 style="margin:0 0 6px;">@L.Markup("studio.home.no_ideas")</h3>
                <p style="color:var(--st-muted);margin:0 0 16px;">@L.Markup("studio.home.no_ideas_body")</p>
                <a class="st-btn st-btn-primary" href="/studio/new">@L.Markup("studio.home.describe_idea")</a>
            </div>
        }
        else
        {
            <div class="studio-list">
                @foreach (var s in (IsIdeas ? sessions : sessions.Take(5)))
                {
                    <a class="studio-list-row" href="@($"/studio/s/{s.Id}")">
                        <span class="studio-list-icon"><AcIcon Name="@StatusIcon(s.Status)" Size="16" /></span>
                        <div class="studio-list-body">
                            <strong>@(string.IsNullOrEmpty(s.ProjectDescription)
                                ? L["studio.home.no_desc"] : Truncate(s.ProjectDescription, 70))</strong>
                            <span>@StatusLabel(s.Status) · @s.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        @if (s.Status == IncubatorStatus.Completed)
                        { <span class="st-chip st-chip-success">@L.Markup("admin.incubator.quality") @s.AnalysisQualityScore%</span> }
                        else if (s.Status == IncubatorStatus.Analyzing)
                        { <span class="st-chip st-chip-warning">@L.Markup("incubator.status.analyzing")</span> }
                        else if (s.Status == IncubatorStatus.Failed)
                        { <span class="st-chip st-chip-danger">@L.Markup("incubator.status.failed")</span> }
                    </a>
                }
            </div>
        }
    </ChildContent>
</StudioShell>

@code {
    [SupplyParameterFromQuery] public string? Upgrade { get; set; }
    List<IncubatorSession>? sessions;
    List<Tenant>? myApps;
    List<(string Slug, Services.Deals.Deal Deal)> recentDeals = new();
    string? currentTier;

    [Microsoft.AspNetCore.Components.Inject] NavigationManager Nav { get; set; } = default!;
    [Microsoft.AspNetCore.Components.Inject] Services.Incubator.StudioTierService TierSvc { get; set; } = default!;
    [Microsoft.AspNetCore.Components.Inject] Services.Deals.DealsService Deals { get; set; } = default!;
    bool IsIdeas => new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').EndsWith("/ideas");

    string Title => IsIdeas ? L["studio.home.ideas_title"] : L["admin.nav.my_board"];
    string Greeting => L.Format("studio.home.greeting", Auth.UserName ?? L["studio.home.owner_fallback"]);

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        var uid = Auth.UserId!.Value;
        sessions = await Incubator.ListForUserAsync(uid);
        myApps = (await Tenants.ListOwnedByAsync(uid)).ToList();
        var u = await TierSvc.GetUserAsync(uid);
        currentTier = u?.Tier ?? "spark";

        // اِجمَع آخِر الـ deals مِن كُلّ تَطبيقات هذا المُستَخدِم.
        foreach (var t in myApps)
        {
            try
            {
                var ds = await Deals.ListForTenantAsync(t.Slug, take: 5);
                foreach (var d in ds) recentDeals.Add((t.Slug, d));
            }
            catch { /* لا جَدوَل في هذا المُستَأجِر */ }
        }
        recentDeals = recentDeals.OrderByDescending(x => x.Deal.UpdatedAt).ToList();
    }

    static string StageEmoji(Services.Deals.DealStage s) => s switch
    {
        Services.Deals.DealStage.Offered => "clipboard",
        Services.Deals.DealStage.Booked => "calendar",
        Services.Deals.DealStage.Confirmed => "check",
        Services.Deals.DealStage.Paid => "credit-card",
        Services.Deals.DealStage.Shipping => "truck",
        Services.Deals.DealStage.Delivered => "package",
        Services.Deals.DealStage.Received => "check",
        Services.Deals.DealStage.Reviewed => "star",
        _ => "tag"
    };

    static string StatusIcon(IncubatorStatus s) => s switch
    {
        IncubatorStatus.Completed => "check",
        IncubatorStatus.Analyzing => "clock",
        IncubatorStatus.Failed    => "alert-circle",
        IncubatorStatus.PatternSuggested => "target",
        _ => "edit"
    };

    string StatusLabel(IncubatorStatus s) => s switch
    {
        IncubatorStatus.Discovery => L["incubator.status.discovery"],
        IncubatorStatus.PatternSuggested => L["incubator.status.pattern"],
        IncubatorStatus.Analyzing => L["incubator.status.analyzing"],
        IncubatorStatus.Completed => L["incubator.status.completed"],
        IncubatorStatus.Failed => L["incubator.status.failed"],
        _ => L["incubator.status.abandoned"]
    };

    static string Truncate(string s, int n) => s.Length <= n ? s : s[..n] + "…";
}
