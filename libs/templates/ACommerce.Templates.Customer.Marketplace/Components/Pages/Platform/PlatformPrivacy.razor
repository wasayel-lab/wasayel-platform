@page "/privacy"
@page "/privacy/{Lang}"
@using ACommerce.Templates.Customer.Marketplace.Services
@inject L L

@*
    سِياسَةُ الخُصوصِيَّة — **مَكتوبَةٌ بِالقِياسِ لا بِالتَعميم**.

    كُلُّ بَندٍ في «ما نَجمَعُه» يُقابِلُ حَقلاً مَوجوداً فِعلاً:
    ‏`User.Phone/Email/NationalId/FullName/AvatarUrl` و
    `AttributesJson` و`RoleAttributesJson` و`AnchorLat/Lng/RadiusKm`
    و`PushSubscriptions` و`AcceptedTermsAt/Version`، و
    `UserPreferences.Language/Theme/Notify*`، و`AuditEntry.Ip/UserAgent`.

    وقائِمَةُ الأَطرافِ الثالِثَةِ مَقيسَةٌ كَذلِك: مُضيفو الشَبَكَةِ
    الوَحيدونَ الَّذينَ يَطلُبُهُم المُتَصَفِّحُ في المُستَودَعِ كُلِّه
    أَربَعَة — خُطوطُ Google، وشَبَكَةُ jsDelivr (عَميلُ الاتِّصالِ
    الحَيّ)، وخَريطَةُ OpenStreetMap — ولا خامِسَ. **وصِفرُ أَداةِ
    تَحليلاتٍ أَو تَتَبُّعٍ إعلانيّ**، وهذا عَدٌّ لا ظَنّ.
*@

<div class="acs-page">
@if (!doc.IsRecognised)
{
    <p class="empty">@L.Markup("shell.error.not_found")</p>
}
else
{
    <article class="wsl-doc" dir="@doc.Dir" lang="@doc.Lang">
        <h1 class="wsl-doc-title">@doc.Markup("platform.privacy.title")</h1>
        <p class="wsl-doc-meta">@doc.Markup("platform.doc.updated")</p>

        <nav class="wsl-doc-nav" aria-label="@(doc["platform.footer.nav_label"])">
            <a class="wsl-doc-navlink" href="@Href("terms")">@doc.Markup("platform.footer.terms")</a>
            <a class="wsl-doc-navlink" href="@Href("refunds")">@doc.Markup("platform.footer.refunds")</a>
            <a class="wsl-doc-navlink" href="@Href("contact")">@doc.Markup("platform.footer.contact")</a>
            @if (doc.IsEnglish)
            {
                <a class="wsl-doc-navlink" href="/privacy">@doc.Markup("platform.doc.lang_ar")</a>
            }
            else
            {
                <a class="wsl-doc-navlink" href="/privacy/en">@doc.Markup("platform.doc.lang_en")</a>
            }
        </nav>

        <p class="wsl-placeholder wsl-doc-note">@doc.Markup("platform.doc.placeholder_note")</p>

        <p class="wsl-doc-lead">@doc.Markup("platform.privacy.intro")</p>

        <section class="wsl-doc-section">
            <h2>@doc.Markup("platform.privacy.s1_title")</h2>
            <p>@doc.Markup("platform.privacy.s1_body")</p>
            <ul class="wsl-doc-facts">
                <li><span class="wsl-placeholder">@doc.Markup("platform.doc.entity_name")</span></li>
                <li><span class="wsl-placeholder">@doc.Markup("platform.doc.entity_address")</span></li>
                <li><span class="wsl-placeholder">@doc.Markup("platform.doc.contact_email")</span></li>
            </ul>
        </section>

        <section class="wsl-doc-section">
            <h2>@doc.Markup("platform.privacy.s2_title")</h2>
            <p>@doc.Markup("platform.privacy.s2_intro")</p>
            <ul class="wsl-doc-list">
                <li>@doc.Markup("platform.privacy.item_phone")</li>
                <li>@doc.Markup("platform.privacy.item_nid")</li>
                <li>@doc.Markup("platform.privacy.item_name")</li>
                <li>@doc.Markup("platform.privacy.item_attributes")</li>
                <li>@doc.Markup("platform.privacy.item_location")</li>
                <li>@doc.Markup("platform.privacy.item_listings")</li>
                <li>@doc.Markup("platform.privacy.item_chats")</li>
                <li>@doc.Markup("platform.privacy.item_deals")</li>
                <li>@doc.Markup("platform.privacy.item_push")</li>
                <li>@doc.Markup("platform.privacy.item_audit")</li>
                <li>@doc.Markup("platform.privacy.item_prefs")</li>
                <li>@doc.Markup("platform.privacy.item_terms")</li>
            </ul>
        </section>

        <section class="wsl-doc-section">
            <h2>@doc.Markup("platform.privacy.s3_title")</h2>
            <p>@doc.Markup("platform.privacy.s3_body")</p>
            <p>@doc.Markup("platform.privacy.s3_note")</p>
        </section>

        <section class="wsl-doc-section">
            <h2>@doc.Markup("platform.privacy.s4_title")</h2>
            <p>@doc.Markup("platform.privacy.s4_body")</p>
        </section>

        <section class="wsl-doc-section">
            <h2>@doc.Markup("platform.privacy.s5_title")</h2>
            <p>@doc.Markup("platform.privacy.s5_intro")</p>
            <ul class="wsl-doc-list">
                <li>@doc.Markup("platform.privacy.share_otp")</li>
                <li>@doc.Markup("platform.privacy.share_nafath")</li>
                <li>@doc.Markup("platform.privacy.share_payment")</li>
                <li>@doc.Markup("platform.privacy.share_fonts")</li>
                <li>@doc.Markup("platform.privacy.share_maps")</li>
                <li>@doc.Markup("platform.privacy.share_legal")</li>
            </ul>
        </section>

        <section class="wsl-doc-section">
            <h2>@doc.Markup("platform.privacy.s6_title")</h2>
            <p>@doc.Markup("platform.privacy.s6_body")</p>
        </section>

        <section class="wsl-doc-section">
            <h2>@doc.Markup("platform.privacy.s7_title")</h2>
            <p>@doc.Markup("platform.privacy.s7_body")</p>
        </section>

        <section class="wsl-doc-section">
            <h2>@doc.Markup("platform.privacy.s8_title")</h2>
            <p>@doc.Markup("platform.privacy.s8_body")</p>
        </section>

        <section class="wsl-doc-section">
            <h2>@doc.Markup("platform.privacy.s9_title")</h2>
            <p>@doc.Markup("platform.privacy.s9_body")</p>
        </section>

        <section class="wsl-doc-section">
            <h2>@doc.Markup("platform.privacy.s10_title")</h2>
            <p>@doc.Markup("platform.privacy.s10_body")</p>
            <p><span class="wsl-placeholder">@doc.Markup("platform.doc.contact_email")</span></p>
        </section>
    </article>
}
</div>

@code {
    [Parameter] public string? Lang { get; set; }

    PlatformDocLanguage doc = PlatformDocLanguage.FromRoute(null);

    protected override void OnParametersSet()
        => doc = PlatformDocLanguage.FromRoute(Lang);

    string Href(string name) => doc.IsEnglish && name != "contact" ? $"/{name}/en" : $"/{name}";
}
