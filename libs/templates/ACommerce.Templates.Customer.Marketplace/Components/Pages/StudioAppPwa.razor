@page "/studio/apps/{slug}/pwa"
@inject Services.Incubator.StudioAuth Auth
@inject Services.Queries.TenantDirectory Tenants
@inject L L
@using ACommerce.Kit.Tenants
@using ACommerce.Kit.Roles

@*
    مُحَرِّر تَطبيقات الـ PWA داخِل واجِهَة الـ Studio — لِكُلّ دَور: اِسم
    مُخَصَّص (يَتَجاوَز التَّوليد التِلقائي) + أَيقونَة مُخَصَّصَة (تَتَجاوَز
    التَّوليد بِلَون العَلامَة). الأَيقونَة تُحَوَّل لِـ data: URL وَتُخزَّن
    مَعَ الدَور (سَقف ٢٥٦ كيلوبايت). تَركها فارِغَة = اِستِخدام التَّوليد
    التِلقائي.
*@

<StudioShell Title="@($"{L["studio.app_pwa.title"]} {tenant?.Name ?? Slug}")" Active="home">
    <TopBarActions>
        <a class="st-btn st-btn-ghost" href="@($"/studio/apps/{Slug}")">← @L.Markup("studio.app_nav.settings")</a>
    </TopBarActions>
    <ChildContent>
        @if (tenant is null)
        {
            <div class="st-card">@L.Markup("studio.app.not_found")</div>
        }
        else
        {
            <div class="studio-page-head">
                <h1>@L.Markup("studio.app_pwa.heading")</h1>
                <p>@L.Markup("studio.app_pwa.intro")</p>
            </div>

            @if (Saved == "1")             { <div class="st-chip st-chip-success" style="margin-bottom:14px;"><AcIcon Name="check" Size="14" /> @L.Markup("studio.app.saved")</div> }
            @if (Err == "icon_too_large")  { <div class="st-chip st-chip-danger"  style="margin-bottom:14px;">@L.Markup("studio.app_pwa.err_icon_large")</div> }
            @if (Err == "icon_bad_type")   { <div class="st-chip st-chip-danger"  style="margin-bottom:14px;">@L.Markup("studio.app_pwa.err_icon_type")</div> }

            @if (tenant.Roles.Count == 0)
            {
                <div class="st-card">
                    <p style="margin:0 0 12px;">@((MarkupString)"\n                        ")@L.Markup("studio.app_pwa.no_roles")@(Slug).
                        @L.Markup("studio.app_pwa.no_roles_hint")@((MarkupString)"\n                    ")
                    </p>
                    <a class="st-btn st-btn-primary" href="@($"/studio/apps/{Slug}/roles")">
                        <AcIcon Name="people" Size="16" /> @L.Markup("studio.app_pwa.setup_roles")@((MarkupString)"\n                    ")
                    </a>
                </div>
            }
            else
            {
                <form method="post" action="@($"/studio/apps/{Slug}/pwa/save")"
                      enctype="multipart/form-data">
                    @foreach (var r in tenant.Roles.OrderBy(r => r.SortOrder))
                    {
                        var iconUrl = $"/api/{Slug}/r/{r.Slug}/icon.svg";
                        <div class="st-card" style="margin-bottom:14px;">
                            <div style="display:flex;gap:16px;align-items:flex-start;">
                                <img src="@iconUrl" alt="@r.Label"
                                     style="width:96px;height:96px;border-radius:18px;
                                            background:#f4f4f5;flex-shrink:0;
                                            border:1px solid var(--ac-border);" />
                                <div style="flex:1;">
                                    <h3 style="margin:0 0 4px;">
                                        <AcIcon Name="@ACommerce.Widgets.AcIconMap.Resolve(r.Icon, "user")" Size="18" /> @r.Label
                                    </h3>
                                    <small style="color:var(--ac-text-muted);direction:ltr;">
                                        /@(Slug)/r/@(r.Slug)/
                                    </small>

                                    <AcField Label="@L["studio.app_pwa.field_name"]"
                                             Hint="@($"{L["studio.app_pwa.name_hint"]} {tenant.Name} — {r.Label}")">
                                        <input type="text" maxlength="60" class="ac-input"
                                               name="@($"name_{r.Slug}")"
                                               value="@(r.PwaName ?? "")"
                                               placeholder="@($"{tenant.Name} — {r.Label}")" />
                                    </AcField>

                                    <AcField Label="@L["studio.app_pwa.field_icon"]"
                                             Hint="@L["studio.app_pwa.icon_hint"]">
                                        <input type="file" class="ac-input"
                                               name="@($"icon_{r.Slug}")"
                                               accept="image/png,image/svg+xml,image/webp" />
                                    </AcField>

                                    @if (!string.IsNullOrEmpty(r.PwaIconDataUrl))
                                    {
                                        <label style="display:flex;align-items:center;gap:6px;font-size:13px;">
                                            <input type="checkbox"
                                                   name="@($"clear_{r.Slug}")" value="1" />
                                            @L.Markup("studio.app_pwa.clear_icon")@((MarkupString)"\n                                        ")
                                        </label>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div style="display:flex;gap:8px;margin-top:16px;">
                        <a class="st-btn st-btn-ghost" href="@($"/studio/apps/{Slug}")">@L.Markup("studio.app_pwa.cancel")</a>
                        <button type="submit" class="st-btn st-btn-primary">
                            <AcIcon Name="check" Size="18" /> @L.Markup("studio.app_pwa.save")@((MarkupString)"\n                        ")
                        </button>
                    </div>
                </form>
            }
        }
    </ChildContent>
</StudioShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }
    [SupplyParameterFromQuery(Name = "err")]   public string? Err { get; set; }
    Tenant? tenant;

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is not null && tenant.OwnerUserId != Auth.UserId!.Value) { tenant = null; return; }
    }
}
