@page "/studio/agent"
@rendermode RenderMode.InteractiveServer
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@inject ACommerce.Templates.Customer.Marketplace.Services.Incubator.StudioAgentSwitch AgentSwitch
@inject Services.Incubator.StudioAuth StudioAuth
@inject Marten.IDocumentStore Store
@using ACommerce.Templates.Customer.Marketplace.Services.Incubator
@inject ACommerce.Templates.Customer.Marketplace.Services.AgentService Agent
@inject ACommerce.Templates.Customer.Marketplace.Services.AgentToolExecutor Executor
@inject IHttpContextAccessor HttpCtx
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject L L

@*
    وَكيل التَّطبيقات — مِرآة AgentChat داخِل إطار الستوديو.

    الفَرق الجَوهَريّ عَن /admin/agent:
      ١) الجَلسَة مَحصورَة بِالمُستَخدِم (scopeId = studio-{userId}) — كُلّ
         رائِد أَعمال يَرى مُحادَثَتَه فَقَط.
      ٢) كُلّ تَنفيذ أَداة يَمُرّ بِفَحص ملكيَّة tenant.OwnerUserId == userId.
         رائِد أَعمال لا يَستَطيع تَعديل مَتجَر رائِد أَعمال آخَر — حَتَّى
         لَو طَلَب الوَكيل ذَلِك بِالخَطَأ.
      ٣) create_tenant يَكتُب OwnerUserId مُباشَرَةً عَلى المَتجَر الجَديد.

    InteractiveServer: HttpContext مُتاح أَوَّل render فَقَط. نَلتَقِط
    _userId مَرَّة واحِدَة هُناك ثُمَّ نَستَخدِمه في كُلّ نِداء.

    ‏2026-10-25 (تَدقيقُ الإطلاق، تَيّارُ W8-3 — lens-security-2؛ يُلحَقُ ولا يُعادُ حَرفٌ فَوقَ ما سَبَق): «كُلّ رائِد أَعمال» أَعلاه
    كانَ يُنفِقُ مِفتاحَ المالِكِ بِلا عَدّادٍ ولا حَدّ — كُلُّ رِسالَةٍ و«طَبِّق»/«ارفُض» نِداءٌ بِتاريخِ المُحادَثَةِ كامِلاً. صارَت المُحادَثَةُ
    والمُحَرِّرُ داخِلَ StudioAgentDoor.Opens — لِمُشرِفِ المَنَصَّةِ وَحدَه، بِقَرارِ PlatformAdminGuard نَفسِه، يُقرَأُ مَعَ _userId —
    ومَكانَهُما لِغَيرِه نَصُّ القامُوسِ المُغلَق، والمُعالِجاتُ الأَربَعَةُ تَسأَلُ البابَ قَبلَ أَيِّ نِداء. حَتّى يَقولَ المالِكُ حَدَّ الرَسائِلِ
    لِكُلِّ دَرَجَة («ب» W8-3 · ١ في سِجِلِّه)؛ والتَبديلُ في البابِ لا هُنا.

    ‏2026-10-25 (W8-3 — lens-dead-doors-1؛ يُلحَقُ ولا يُعادُ حَرفٌ فَوقَه): والبابُ يَسأَلُ مِفتاحَ وَكيلِ Studio أَيضاً — كانَ يُفتَحُ بِلاه عَلى مُحَرِّرٍ
    مُعَطَّلٍ ونَصِّ مُشَغِّلٍ («أَضِف Agent:ApiKey في الإعدادات» واسمِ المُزَوِّد)؛ صارَ نَصُّ القامُوسِ المُغلَقُ نَفسُه، وسَطرُ التَنبيهِ وشَرطا
    التَعطيلِ زالَت لِأَنّ الفَرعَ المَفتوحَ لا يُبلَغُ بِلا مِفتاح.

    ‏2026-11-05 (الموجَة ١٢ G2 · ١ — A-SESS-W12-2؛ تَوصيفُه 0f5a3c4؛ يُلحَقُ ولا يُعادُ حَرفٌ فَوقَ ما سَبَق): «نَلتَقِط _userId مَرَّة» كانَ يَعني أَنّ
    الدائِرَةَ المَفتوحَةَ تُرسِلُ وتُطَبِّقُ بِسُلطَةِ مُشرِفِ المَنَصَّةِ بَعدَ «اخرج من كل الأجهزة» وبَعدَ نَزعِ الإشراف (بَوّابَةُ الإصدارِ لِكُلِّ طَلَبِ HTTP ولا
    تَبلُغُ نَقرَةً عَبرَ SignalR). صارَ رَمزُ الاستوديو يُلتَقَطُ مَعَه (ذاكِرَةُ الخادِمِ وَحدَها، لا يُرسَمُ في الصَفحَة)، والمُعالِجاتُ الأَربَعَةُ تَسأَلُ
    StillPlatformAdminAsync قَبلَ أَيِّ نِداء — وَثيقَةٌ جَديدَة، والمُغلَقُ إلى /studio/auth بِلا نَموذَجٍ ولا أَداة.
*@

<StudioShell Title="@L["studio.agent.title"]" Active="home">
    <TopBarActions>
        <a class="st-btn st-btn-ghost" href="/studio">@L.Markup("studio.agent.back")</a>
    </TopBarActions>
    <ChildContent>
        @if (!_authChecked)
        {
            <div class="st-card">@L.Markup("studio.agent.checking")</div>
        }
        else if (_userId == Guid.Empty)
        {
            <div class="st-card">
                <p>@L.Markup("studio.agent.need_login")</p>
                <a class="st-btn st-btn-primary" href="/studio/auth">@L.Markup("studio.agent.login")</a>
            </div>
        }
        else if (!AgentSwitch.Enabled)
        {
            @* ‏(‏2026-11-07، الموجَة ١٣ W13-1·٦ — ADR-049 §٦) المِفتاحُ مُطفَأٌ ⇐ النَصُّ المُغلَقُ نَفسُه، لا مُحادَثَةَ ولا زِرّ — قَبلَ سُؤالِ البابِ لا بَعدَه. *@
            <div class="st-card">
                <p>@L.Markup(StudioAgentDoor.ClosedMessageKey)</p>
            </div>
        }
        else if (StudioAgentDoor.Opens(Agent.IsConfigured, _platformAdmin))
        {
            <div class="studio-page-head">
                <h1><AcIcon Name="message" Size="22" /> @L.Markup("studio.agent.title")</h1>
                <p>@L.Markup("studio.agent.help")</p>
                <span style="font-size:11px;color:var(--st-muted);direction:ltr;">
                    @Agent.ProviderName / @Agent.ModelName
                </span>
            </div>

            <div class="acm-agent-thread">
                @if (session.Turns.Count == 0)
                {
                    <div class="acm-agent-empty">
                        <span><AcIcon Name="message" Size="48" /></span>
                        <p>@L.Markup("studio.agent.empty")</p>
                    </div>
                }
                else
                {
                    foreach (var turn in session.Turns)
                    {
                        <div class="acm-agent-turn @(turn.Role == "user" ? "is-user" : "is-assistant")">
                            <div class="acm-agent-avatar">
                                <AcIcon Name="@(turn.Role == "user" ? "user" : "message")" Size="24" />
                            </div>
                            <div class="acm-agent-body">
                                @if (!string.IsNullOrEmpty(turn.Text))
                                {
                                    <div class="acm-agent-text">@turn.Text</div>
                                }
                                @if (turn.Tool is not null)
                                {
                                    <div class="acm-agent-tool @StatusClass(turn.Tool.Status)">
                                        <div class="acm-agent-tool-head">
                                            <strong>@ToolLabel(turn.Tool.Name)</strong>
                                            <span class="st-chip">@StatusLabel(turn.Tool.Status)</span>
                                        </div>
                                        <details class="acm-agent-tool-input">
                                            <summary>@L.Markup("agent.chat.params_toggle")</summary>
                                            <pre>@FormatJson(turn.Tool.InputJson)</pre>
                                        </details>
                                        @if (!string.IsNullOrEmpty(turn.Tool.Result))
                                        {
                                            <div class="acm-agent-tool-result">@turn.Tool.Result</div>
                                        }
                                        @if (turn.Tool.Status == "pending")
                                        {
                                            var toolIdCapture = turn.Tool.Id;
                                            <div class="acm-agent-tool-actions">
                                                <button type="button" class="st-btn st-btn-primary"
                                                        @onclick="() => ApplyAsync(toolIdCapture)"
                                                        disabled="@isWorking">
                                                    <AcIcon Name="check" Size="14" /> @L.Markup("agent.chat.apply")@((MarkupString)"\n                                                ")
                                                </button>
                                                <button type="button" class="st-btn st-btn-ghost"
                                                        @onclick="() => RejectAsync(toolIdCapture)"
                                                        disabled="@isWorking">
                                                    <AcIcon Name="x" Size="14" /> @L.Markup("agent.chat.reject")@((MarkupString)"\n                                                ")
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                <div id="thread-bottom"></div>
                @if (isWorking)
                {
                    <div class="acm-agent-turn is-assistant">
                        <div class="acm-agent-avatar"><AcIcon Name="message" Size="24" /></div>
                        <div class="acm-agent-body">
                            <div class="acm-agent-text" style="font-style:italic;color:var(--st-muted);">@((MarkupString)"\n                                ")@L.Markup("agent.chat.thinking")@((MarkupString)"\n                            ")
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="acm-agent-composer">
                <textarea @bind="newMessage" @bind:event="oninput" rows="3"
                          class="st-input"
                          disabled="@isWorking"
                          placeholder="@L["studio.agent.placeholder"]"></textarea>
                <div style="display:flex;flex-direction:column;gap:6px;">
                    <button type="button" class="st-btn st-btn-primary"
                            @onclick="SendAsync"
                            disabled="@(isWorking || string.IsNullOrWhiteSpace(newMessage))">
                        <AcIcon Name="send" Size="16" /> @L.Markup("agent.chat.send")@((MarkupString)"\n                    ")
                    </button>
                    <button type="button" class="st-btn st-btn-ghost"
                            @onclick="ResetAsync" disabled="@isWorking">
                        <AcIcon Name="x" Size="14" /> @L.Markup("studio.agent.clear")@((MarkupString)"\n                    ")
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="st-card">
                <p>@L.Markup(StudioAgentDoor.ClosedMessageKey)</p>
            </div>
        }
    </ChildContent>
</StudioShell>

@code {
    Guid _userId = Guid.Empty;
    bool _authChecked;
    // قَرارُ PlatformAdminGuard لِصاحِبِ الجَلسَة — مُدخَلُ StudioAgentDoor.Opens، يُقرَأُ حَيثُ يُقرَأُ _userId وبِالشَرطِ نَفسِه.
    bool _platformAdmin;
    // ‏(‏2026-11-05، G2 · ١) رَمزُ الجَلسَةِ الَّتي فُتِحَت بِها الدائِرَة — يُسأَلُ بِه قَبلَ كُلِّ فِعل؛ في ذاكِرَةِ الخادِمِ وَحدَها.
    string? _studioToken;
    string _scopeId = "";
    ACommerce.Templates.Customer.Marketplace.Services.AgentSession session = new();
    string newMessage = "";
    bool isWorking;
    bool firstRenderDone;

    protected override async Task OnInitializedAsync()
    {
        // HttpContext مُتاح في render الأَوَّل فَقَط (SSR phase). نَلتَقِط
        // userId مَرَّة وَنَحتَفِظ بِه — InteractiveServer لاحِقاً يَفقِد
        // HttpContext.
        if (_userId == Guid.Empty)
        {
            if (HttpCtx.HttpContext is not null)
            {
                StudioAuth.Load();
                if (StudioAuth.IsAuthenticated)
                {
                    _userId = StudioAuth.UserId!.Value;
                    _studioToken = HttpCtx.HttpContext.Request.Cookies[Services.Incubator.StudioAuth.CookieName];
                    _scopeId = "studio-" + _userId.ToString("N");
                    _platformAdmin = (await Services.PlatformAdminGuard.EvaluateAsync(Store, StudioAuth)).Allowed;
                }
            }
            _authChecked = true;
        }
        if (_userId != Guid.Empty && StudioAgentDoor.Opens(Agent.IsConfigured, _platformAdmin))
            session = await Agent.LoadSessionAsync(_scopeId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            firstRenderDone = true;
            await ScrollToBottom();
        }
    }

    // ‏(‏2026-11-05، G2R1-1) كُلُّ مُعالِجٍ يَحجِزُ isWorking قَبلَ أَوَّلِ await ثُمَّ يَسأَلُ الجَلسَة، ويَفُكُّ الحَجزَ عَلى الرَفض — السُؤالُ قِراءَةُ Postgres، ونَقرَةٌ
    // ثانِيَةٌ تَصِلُ أَثناءَها كانَت تَرى العَلَمَ فارِغاً فَتَعبُر (نِداءا نَموذَجٍ وتَشغيلا أَداة). والتَخويلُ قَبلَ فَحصِ الرِسالَةِ الفارِغَة (القاعِدَة ٦).
    async Task SendAsync()
    {
        if (isWorking || _userId == Guid.Empty || !StudioAgentDoor.Opens(Agent.IsConfigured, _platformAdmin)) return;
        var msg = newMessage?.Trim() ?? "";
        newMessage = "";
        isWorking = true;
        StateHasChanged();
        if (!await StillPlatformAdminAsync()) { isWorking = false; return; }
        if (string.IsNullOrEmpty(msg)) { isWorking = false; return; }
        session.Turns.Add(new ACommerce.Templates.Customer.Marketplace.Services.AgentTurn
        {
            Role = "user", Text = msg
        });
        StateHasChanged();
        await ScrollToBottom();
        session = await Agent.AskAsync(msg, _scopeId);
        isWorking = false;
        StateHasChanged();
        await ScrollToBottom();
    }

    async Task ApplyAsync(string toolId)
    {
        if (isWorking || _userId == Guid.Empty || !StudioAgentDoor.Opens(Agent.IsConfigured, _platformAdmin)) return;
        isWorking = true;
        StateHasChanged();
        if (!await StillPlatformAdminAsync()) { isWorking = false; return; }
        var turn = session.Turns.LastOrDefault(t => t.Tool?.Id == toolId);
        if (turn?.Tool is not null)
        {
            // فَحص الملكيَّة يَتِمّ داخِل ExecuteAsync — لَو المَتجَر
            // لَيس لِهذا المُستَخدِم، تَرجِع رِسالَة رَفض بِلا تَعديل.
            var (ok, msg) = await Executor.ExecuteAsync(turn.Tool.Name, turn.Tool.InputJson, _userId);
            await Agent.UpdateToolStatusAsync(toolId, ok ? "applied" : "error", msg, _scopeId);
            session = await Agent.ContinueAfterToolAsync(_scopeId);
        }
        isWorking = false;
        StateHasChanged();
        await ScrollToBottom();
    }

    async Task RejectAsync(string toolId)
    {
        if (isWorking || _userId == Guid.Empty || !StudioAgentDoor.Opens(Agent.IsConfigured, _platformAdmin)) return;
        isWorking = true;
        StateHasChanged();
        if (!await StillPlatformAdminAsync()) { isWorking = false; return; }
        await Agent.UpdateToolStatusAsync(toolId, "rejected", null, _scopeId);
        session = await Agent.ContinueAfterToolAsync(_scopeId);
        isWorking = false;
        StateHasChanged();
        await ScrollToBottom();
    }

    async Task ResetAsync()
    {
        if (isWorking || _userId == Guid.Empty || !StudioAgentDoor.Opens(Agent.IsConfigured, _platformAdmin)) return;
        isWorking = true;
        StateHasChanged();
        if (!await StillPlatformAdminAsync()) { isWorking = false; return; }
        await Agent.ResetAsync(_scopeId);
        session = await Agent.LoadSessionAsync(_scopeId);
        newMessage = "";
        isWorking = false;
        StateHasChanged();
    }

    /// <summary>‏(‏2026-11-05، G2 · ١) الجَلسَةُ الَّتي فُتِحَت بِها الدائِرَةُ ما زالَت مَفتوحَةً وصاحِبُها مُشرِفَ مَنَصَّة؟ — وَثيقَةٌ جَديدَةٌ
    /// (<c>SessionVersionGate.PlatformAdminStillOpenAsync</c>). وإلّا: لا نَموذَجَ ولا أَداة، والانتِقالُ إلى الدُخول (البَوّابَةُ تَنزِعُ الرَمزَ المُسقَط هُناك).</summary>
    async Task<bool> StillPlatformAdminAsync()
    {
        if (await Services.SessionVersionGate.PlatformAdminStillOpenAsync(Store, _studioToken, _userId)) return true;
        Nav.NavigateTo("/studio/auth", forceLoad: true);
        return false;
    }

    async Task ScrollToBottom()
    {
        if (!firstRenderDone) return;
        try { await JS.InvokeVoidAsync("scrollAgentToBottom"); } catch { /* ignore */ }
    }

    // غَير ساكِنَة: القيَم في المَعجَم، والساكِنَة لا تَبلُغ `L`.
    string ToolLabel(string name) => name switch
    {
        "create_tenant"  => L["agent.tool.create_tenant"],
        "set_categories" => L["agent.tool.set_categories"],
        "set_branding"   => L["agent.tool.set_branding"],
        "set_regions"    => L["agent.tool.set_regions"],
        "set_roles"      => L["agent.tool.set_roles"],
        "set_attributes" => L["agent.tool.set_attributes"],
        "set_pwa"        => L["agent.tool.set_pwa"],
        _ => name
    };

    string StatusLabel(string status) => status switch
    {
        "applied"  => L["agent.status.applied"],
        "rejected" => L["agent.status.rejected"],
        "error"    => L["agent.status.error"],
        _          => L["agent.status.pending"]
    };

    static string StatusClass(string status) => status switch
    {
        "applied"  => "is-applied",
        "rejected" => "is-rejected",
        "error"    => "is-error",
        _ => ""
    };

    static string FormatJson(string raw)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            return System.Text.Json.JsonSerializer.Serialize(
                doc.RootElement,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch { return raw; }
    }
}
