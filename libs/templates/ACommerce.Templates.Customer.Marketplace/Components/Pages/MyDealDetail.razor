@page "/{slug}/deals/{id:guid}"
@page "/{slug}/r/{role}/deals/{id:guid}"
@inject AuthSession Auth
@inject Services.Deals.DealsService Deals
@inject Services.Deals.DealShipping Shipping
@inject ACommerce.Kit.Reviews.ReviewsService Reviews
@inject IHttpContextAccessor HttpCtx
@inject L L
@using ACommerce.Templates.Customer.Marketplace.Services.Deals

@*
    تَفاصيل صَفقَة لِلعميل — stepper + إجراء بِوَعي الدَّور (يَظهَر زِرّ
    المُتابَعَة فَقَط لِمَن يَملِك تَحريك المَرحَلَة الحاليَّة). تَقييم
    في النِهايَة. مُواجِه لِلعميل.
    (و«تَحريكُ المَرحَلَةِ الحالِيَّة» = دُخولُ تاليها: فاعِلُ التالي لا فاعِلُها — ‏ADR-033 §٦‑ط، ‏2026-10-11.)
*@

<div class="acs-page">
    @if (!Auth.IsAuthenticated)
    {
        <AcEmptyState IconName="package" Title="@L["deals.detail.need_login"]"
                      ActionLabel="@L["shell.nav.login"]" ActionHref="@AuthSession.LinkFor(Slug, Role, "login")" />
    }
    else if (deal is null)
    {
        <AcEmptyState IconName="info" Title="@L["deals.detail.not_found"]" />
    }
    else
    {
        <a href="@AuthSession.LinkFor(Slug, Role, "deals")"
           style="color:var(--ac-text-muted);text-decoration:none;font-size:13px;">@L.Markup("deals.detail.back")</a>
        <h1 class="acm-wizard-title" style="margin-top:6px;">
            @(string.IsNullOrEmpty(deal.ListingTitle) ? L["deals.detail.title_fallback"] : deal.ListingTitle)
        </h1>

        @* ─── رَفضُ النُقطَةِ يُقرَأُ هُنا لا يُبتلَع ───
           `/accept` و`/cancel` تَرتَدّانِ إلى هذِه الصَفحَةِ بِـ`?err=<code>`، وأُنبوبُ
           المُحادَثَةِ يَعودُ إلَيها بِـ`partner_missing` — وكانَت بِلا مُعامِلٍ يَقرَؤُه
           (مُراجَعَةُ المَوجَة ١)، فَالنَقرَةُ المَرفوضَةُ تَعودُ بِصَفحَةٍ كَأَنَّ شَيئاً لَم
           يَكُن. الرَمزُ مِن مَعجَمَي التَخويلِ وأُنبوبِ المُحادَثَة (`DealRefusalTexts`)
           والكَلامُ في القامُوس — نَسَقُ `store.locked.write_denied` في `TenantHome`. *@
        @if (DealRefusalTexts.KeyFor(Err) is { } errKey)
        {
            <AcAlert Variant="danger" Message="@L[errKey]" />
        }

        @* ─── «دَورُكَ الآن» ────────────────────────────────────────────
           أَعلى نُقطَة تَحفيز: تُخبِر هذا المُستَخدِم تَحديداً هَل
           الإجراء التالي مِنه أَم لا. الفاعِل المُخَوَّل مَقروء مِن
           DealsPolicy.Actor عَبر DealTurnView — نَفس القاعِدَة الَّتي
           يَفرِضُها DealsService.AdvanceAsync، فَلا تَعِد البِطاقَة بِما
           سَيَرفُضُه المُحَرِّك. *@
        @if (deal.Status == DealStatus.Active)
        {
            @* مِن الصَفقَةِ نَفسِها لا مِن (النَمَط، المَرحَلَة) وَحدَهُما: طَريقَةُ
               الدَفعِ تُسقِطُ «دَفع» عَن النَقد (‏ADR-033 §٦)، فَلا يُقالُ لِمُشتَري
               نَقدٍ «دَورُكَ الآن: تَأكيد: شَحن» عِندَ مَرحَلَةٍ لا تَزورُها صَفقَتُه.
               **ولَم تَزُل الجُملَةُ — انتَقَلَت مَرحَلَة** (مُراجَعَةُ ‏2026-10-11؛ ‏ADR-033
               §٦‑ج مُلحَقاً): عِندَ `Confirmed` (‏`either`) التالي `Shipping`، فَيُقالُ لِمُشتَري
               النَقدِ «دَورُكَ الآن» ويُرسَمُ لَه «تَأكيد: شَحن» أَدناه وهُوَ لا يَشحَن — سُؤالُ
               المالِكِ «ب» S4·٤، ومُثَبَّتٌ بِاسمِه في `DealCashPolicyTests`.
               **وزالَت ‏2026-10-11** (‏ADR-033 §٦‑ط؛ ولا يُعادُ حَرفٌ فَوقَه): كانَت عَرَضَ إزاحَةٍ في
               قِراءَةِ عَمودِ الفاعِل — `DealTurnView` تَسأَلُ اليَومَ فاعِلَ المَرحَلَةِ المَدخولَة، فَعِندَ
               `Confirmed` لِلنَقدِ `Shipping` = الطَرَفُ المُقابِل: الدَورُ لِلبائِعِ والمُشتَري يَنتَظِر. *@
            var turn = Services.Ux.DealTurnView.For(deal, mySide);
            @* حالَة خاصَّة قائِمَة: عِندَ Offered يَقبَل مالِك الإعلان
               العَرض بِزِرّ مُنفَصِل (يَصيرُ طَرَفاً ثانِياً إن لَم يُربَط عِندَ
               الوِلادَة) — إجراء حَقيقيّ مَطلوب مِنه رَغم أَنّ فاعِل المَرحَلَة
               هو المُبادِر.
               **وصارَ الدَورُ دَورَه بِالقاعِدَةِ نَفسِها** (‏ADR-033 §٦‑ط، ‏2026-10-11): الخُروجُ مِن
               `Offered` يَسأَلُ فاعِلَ `Booked` = الطَرَفَ المُقابِل، فَالبائِعُ المَربوطُ عِندَ الوِلادَةِ
               دَورُه بِـ`turn.IsMine`؛ وتَبقى الحالَةُ الخاصَّةُ لِمالِكٍ لَم يَصِر طَرَفاً بَعد (عَرضٌ عَلى
               إعلان — جانِبُه «مُشاهِد») ولِزِرِّ القَبولِ الَّذي يُعَيِّنُه ويُشعِرُ المُشتَري. *@
            var acceptCase = deal.Stage == DealStage.Offered && isListingOwner && !isInitiator;
            var mine = acceptCase || turn.IsMine;
            <div class="acm-turn @(mine ? "is-mine" : "is-waiting")">
                <span class="acm-turn-icon" aria-hidden="true">
                    <AcIcon Name="@(mine ? "bell" : "clock")" Size="20" />
                </span>
                <span class="acm-turn-body">
                    <strong class="acm-turn-title">
                        @if (mine)
                        {
                            <text>@L.Markup("deals.detail.turn_mine")</text>
                        }
                        else
                        {
                            <text>@L.Markup("deals.detail.turn_waiting") @L[Services.Ux.DealTurnView.ActorLabelKey(turn.ActorKey, mySide)]</text>
                        }
                    </strong>
                    <span class="acm-turn-text">
                        @if (acceptCase)
                        {
                            <text>@L.Markup("deals.detail.turn_accept_hint")</text>
                        }
                        else if (turn.NextStage is { } ns2)
                        {
                            <text>@L.Markup("deals.detail.next_step") @DealsPolicy.LabelAr(ns2)</text>
                        }
                        else
                        {
                            <text>@L.Markup("deals.detail.no_next_step")</text>
                        }
                    </span>
                </span>
                @if (mine)
                {
                    <a class="ac-btn ac-btn-primary ac-btn-sm acm-turn-cta" href="#deal-action">@((MarkupString)"\n                        ")@L.Markup("deals.detail.to_action")@((MarkupString)"\n                    ")
                    </a>
                }
            </div>
        }

        @* شَرح التَدَفُّق كامِلاً — فَوق الـ stepper لا بَدَلاً مِنه:
           الـ stepper يَقول «أَينَ نَحنُ»، وهذا يَقول «ما الطَريق ومَن
           يُحَرِّك كُلّ خُطوَة». *@
        <FlowExplainer Pattern="@deal.Pattern" PayMethod="@DealsPolicy.PayMethodOf(deal)" Side="@mySide"
                       CurrentStage="@deal.Stage" />

        @* stepper *@
        <AcCard>
            <ChildContent>
                <div style="display:flex;flex-wrap:wrap;gap:6px;align-items:center;justify-content:space-between;">
                    @foreach (var st in stages)
                    {
                        var done = stages.IndexOf(st) < stages.IndexOf(deal.Stage);
                        var cur = st == deal.Stage;
                        <div style="flex:1;min-width:64px;text-align:center;">
                            <div style="width:30px;height:30px;border-radius:50%;display:grid;place-items:center;margin:0 auto 4px;
                                        background:@(cur ? "var(--ac-primary)" : done ? "#16a34a" : "var(--ac-border)");
                                        color:#fff;font-weight:700;font-size:13px;">
                                @if (done) { <AcIcon Name="check" Size="16" /> } else { @(stages.IndexOf(st) + 1) }
                            </div>
                            <div style="font-size:11px;color:@(cur ? "var(--ac-primary)" : "var(--ac-text-muted)");">
                                @DealsPolicy.LabelAr(st)
                            </div>
                        </div>
                    }
                </div>
            </ChildContent>
        </AcCard>

        @* ملخّص *@
        <AcCard>
            <ChildContent>
                <div style="display:flex;justify-content:space-between;font-size:14px;">
                    <span style="color:var(--ac-text-muted);">@L.Markup("deals.detail.amount_label")</span>
                    <strong>@((MarkupString)ACommerce.Kit.Culture.Money.Format(deal.AmountSar))</strong>
                </div>
                @* ولا صَفَّ عَمولَةٍ هُنا بَعدَ اليَوم: كانَ يُعرَضُ «عمولة
                   المَنصَّة» لِلطَرَفَين مِن `CommissionSar`، وأُسقِطَ مَعَ
                   الحَقلِ بِـADR-032 §٢‑ب (‏2026-10-11) — لا عَمولَةَ عَلى
                   الصَفَقات، والإيرادُ اشتِراكُ المُستَأجِرِ وَحدَه. *@
                <div style="display:flex;justify-content:space-between;font-size:13px;margin-top:4px;">
                    <span style="color:var(--ac-text-muted);">@L.Markup("deals.detail.other_party")</span>
                    <span>@(isInitiator ? (deal.CounterpartyName ?? L["deals.detail.awaiting_accept"]) : deal.InitiatorName)</span>
                </div>

                @* ─── بَياناتُ التَوصيلِ — لِمَن يُسَلِّمُ وَحدَه (P1-4) ───
                   `/checkout/submit` يَكتُبُ العُنوانَ والهاتِفَ في `Attributes` ولَم
                   تَرسُمهُما أَيُّ شاشَةٍ (مَقيس: صِفرُ `Attributes[` في صَفحاتِ الصَفقَةِ
                   الأَربَع) — فَالبائِعُ لا يَعرِفُ إلى أَينَ يَشحَن. تُرسَمُ لِلطَرَفِ
                   المُقابِلِ أَو مالِكِ الإعلانِ وَحدَه: لا لِلمُشتَري (بَياناتُه هُوَ،
                   كَتَبَها عِندَ الباب) ولا لِثالِث (الصَفحَةُ تُغلَقُ عَلى غَيرِ الطَرَفَين
                   أَعلاه). ومَعَها سَطرُ إفصاحٍ مِن القامُوس: لِلتَسليمِ وَحدَه (‏PDPL،
                   `PRODUCTION-PLAN.md:229`). والمِفتاحانِ ثابِتا `Deal` الَّذَينِ يَكتُبُ
                   بِهِما `/checkout/submit` — حَرفٌ واحِدٌ لِلكاتِبِ والقارِئ.
                   **ولا تُرسَمُ فارِغَةً** (‏2026-10-11، مُراجَعَةٌ ثانِيَة): كانَ العُنوانُ
                   والإفصاحُ يُرسَمانِ لِلبائِعِ وإن لَم تَحمِل الصَفقَةُ عُنواناً ولا هاتِفاً —
                   وهذِه حالُ كُلِّ صَفقَةٍ مِن مَسارِ العَرضِ عَلى إعلان (لا يَكتُبُ إلّا `note`)،
                   فَيُقالُ «لِلتَسليمِ وَحدَه» عَن لا شَيء. صارَت تُرسَمُ بِحُضورِ أَحَدِهِما. *@
                @if (deliveryVisible)
                {
                    <div style="margin-top:10px;padding-top:10px;border-top:1px solid var(--ac-border);font-size:13px;">
                        <strong style="display:block;margin-bottom:4px;">@L.Markup("deals.detail.delivery_title")</strong>
                        @if (!string.IsNullOrEmpty(buyerAddr))
                        {
                            <div style="display:flex;justify-content:space-between;gap:8px;">
                                <span style="color:var(--ac-text-muted);">@L.Markup("deals.detail.delivery_addr")</span>
                                <span>@buyerAddr</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(buyerPhone))
                        {
                            <div style="display:flex;justify-content:space-between;gap:8px;margin-top:4px;">
                                <span style="color:var(--ac-text-muted);">@L.Markup("deals.detail.delivery_phone")</span>
                                <span dir="ltr">@buyerPhone</span>
                            </div>
                        }
                        <span style="display:block;margin-top:6px;font-size:12px;color:var(--ac-text-muted);line-height:1.7;">
                            @L.Markup("deals.detail.delivery_disclosure")
                        </span>
                    </div>
                }

                @* ─── «تَواصَل مَع البائِع» — البابُ الَّذي يُسَمّيه نَصُّ الاستِرجاع ───
                   `legal.returns.how` يُحيلُ المُشتَريَ إلى هذا الزِرِّ بِاسمِه عَلى
                   هذِه الصَفحَة، وكانَت بِلا أَيِّ مَدخَلٍ إلى البائِع (مُراجَعَةُ
                   ‏2026-10-11: صِفرُ `href`/`form` إلى `vendor/` أَو `chat` هُنا؛
                   والمَدخَلُ الوَحيدُ مِن جِهَةِ المُشتَري إلى صَفحَةِ البائِعِ في
                   `TenantListingDetail` مَشروطٌ بِتَقييمٍ واحِدٍ فَأَكثَر) — نَصٌّ
                   يَعِدُ بِبابٍ لا يُفضي، وهُوَ عَينُ ما أَغلَقَته P0-5.
                   الأُنبوبُ القائِمُ `POST /{slug}/users/{id}/chat` (القاعِدَة ٨):
                   يَرفُضُ النَفسَ، ويَشتَرِطُ وُجودَ الطَرَف، ويَجِدُ المُحادَثَةَ
                   القائِمَةَ بِأَيِّ اتِّجاه، ويَرتَدُّ إلى `chats/{id}`. والبائِعُ
                   `Refs[listing_owner]` ثُمَّ `CounterpartyId`، ويُرسَمُ لِلمُبادِرِ
                   وَحدَه وحَيثُ يُعرَف — لا زِرَّ يَعِدُ بِما لا يَفتَح (القاعِدَة ١٢).
                   والتَسمِيَةُ مِفتاحُ صَفحَةِ البائِعِ نَفسُه، فَالنَصُّ والزِرُّ
                   حَرفٌ واحِدٌ يُقاسُ في `ReturnsPolicyTextTests`. *@
                @if (isInitiator && vendorId is { } vid)
                {
                    <form method="post" action="@($"/{Slug}/users/{vid}/chat")" style="margin-top:8px;">
                        @* المَنشَأ: فَشَلُ الأُنبوبِ (بائِعٌ حُذِفَ حِسابُه) يَعودُ إلى هذِه الصَفحَةِ
                           بِرَمزِه لا إلى صَفحَةِ السائِقينَ مَولِدِه (`ChatStartReturn`). *@
                        <input type="hidden" name="returnUrl" value="@AuthSession.LinkFor(Slug, Role, $"deals/{deal.Id}")" />
                        <button type="submit" class="ac-btn ac-btn-ghost ac-btn-sm ac-btn-block">
                            <AcIcon Name="message" Size="14" /> @L.Markup("vendors.profile.contact")
                        </button>
                    </form>
                }

                @* ─── وَضعُ التَجرِبَةِ يَبقى مُعلَناً **بَعدَ** النَقرَة ───
                   كانَتِ الشارَةُ تُرسَمُ في `CheckoutPage` وَحدَها — أَي
                   قَبلَ النَقرَةِ الأَخيرَةِ فَقَط — فَالعائِدُ إلى طَلَبِه
                   لاحِقاً يَرى مَبلَغاً وطَرَفاً **بِلا أَيِّ مُذَكِّرٍ**
                   بِأَنَّ الدَفعَ لَم يَقَع. والشَرطُ يُقرَأُ مِنَ
                   المَرجِعِ الَّذي كَتَبَته النُقطَةُ نَفسُها
                   (`payment_mode`)، لا مِن مُزَوِّدٍ يُحقَنُ هُنا: حالَةُ
                   الطَلَبِ ساعَةَ وَقَعَ، لا حالَةُ الخادِمِ ساعَةَ يُقرَأ.
                   ADR-025، والمِفتاحانِ هُما مِفتاحا الدَفعِ نَفسُهُما
                   (القاعِدَة ٨). *@
                @if (deal.Refs.TryGetValue(ACommerce.Kit.Payments.SimulatedPaymentProvider.ModeRefKey, out var payMode)
                     && payMode == ACommerce.Kit.Payments.SimulatedPaymentProvider.ConfiguredValue)
                {
                    <div style="display:flex;align-items:center;gap:8px;margin-top:10px;padding-top:10px;
                                border-top:1px solid var(--ac-border);">
                        <span class="ac-chip ac-chip-sm">@L.Markup("checkout.payment.simulation_badge")</span>
                        <span style="font-size:12px;color:var(--ac-text-muted);line-height:1.7;">
                            @L.Markup("checkout.payment.simulation_hint")
                        </span>
                    </div>
                }
            </ChildContent>
        </AcCard>

        @* ─── الشَحن — البوليصَةُ ورابِطُ التَتَبُّعِ لِلطَرَفَين (‏ADR-033 الخُطوَة 3) ───
           العَينُ الَّتي تُخرِجُها نُقطَةُ الشَحن (القاعِدَة ١٧): بوليصَةٌ يَطبَعُها البائِعُ ويَتَتَبَّعُ بِها المُشتَري طَلَبَه.
           والرابِطانِ مِن `DealShipping.LinksOf` — الدالَّةِ الَّتي يَقرَأُ بِها الشَحنُ والوارِدُ ما كَتَبا — `https` وَحدَه، ولا
           تُرسَمُ الكُتلَةُ بِلا أَحَدِهِما؛ والصَفقَةُ مِن الخِدمَةِ لا مِن جَلسَة (الطَبَقَةُ ٨). *@
        @if (labelUrl is not null || trackingUrl is not null)
        {
            <AcCard>
                <ChildContent>
                    <strong style="display:block;margin-bottom:6px;font-size:13px;">@L.Markup("deals.detail.shipping_title")</strong>
                    @if (labelUrl is not null)
                    {
                        <a class="ac-btn ac-btn-ghost ac-btn-sm ac-btn-block" href="@labelUrl" target="_blank" rel="noopener noreferrer">
                            <AcIcon Name="file" Size="14" /> @L.Markup("deals.detail.shipping_label")
                        </a>
                    }
                    @if (trackingUrl is not null)
                    {
                        <a class="ac-btn ac-btn-ghost ac-btn-sm ac-btn-block" href="@trackingUrl" target="_blank" rel="noopener noreferrer" style="margin-top:6px;">
                            <AcIcon Name="truck" Size="14" /> @L.Markup("deals.detail.shipping_tracking")
                        </a>
                    }
                </ChildContent>
            </AcCard>
        }

        @* إجراءات بِوَعي الدَّور *@
        <div id="deal-action"></div>
        @if (deal.Status == DealStatus.Active)
        {
            @* ─── إنشاءُ البوليصَة — لِمَن تَقبَلُه نُقطَةُ الشَحنِ وَحدَه (‏ADR-033 الخُطوَة 3؛ القاعِدَة ١٢) ───
               `DealShipAuthorization.IsAllowed` نَفسُها الَّتي تُطَبِّقُها `/ship` بِسِجِلِّ السُلطَةِ نَفسِه ورَمزِ ناقِلٍ يُحَلّ —
               فَبِلا رَمزٍ لا تُرسَمُ أَصلاً. ومَدينَةُ المُستَلِمِ يَكتُبُها البائِع (`city` إلزامِيٌّ عِندَ OTO والبابُ لا يَسأَلُ عَنها)،
               وطَلَبٌ أُنشِئَ في مُحاوَلَةٍ سابِقَةٍ يُستَأنَفُ بِلا مَدينَة (`DealShipping.IsPlaced`). وزِرُّ «تَأكيد: شَحن» أَدناه باقٍ
               بِلا تَغيير — شَحنٌ بِغَيرِ OTO، أَو حينَ تَرُدُّ OTO الطَلَب.
               **ولا يُرسَمُ حَيثُ الطَلَبُ عِندَ OTO** (مُراجَعَةُ تَيّارِ S7 الثانِيَة، ‏2026-10-12؛ ولا يُعادُ حَرفٌ فَوقَه): بَعدَ
               `shipment_unconfirmed` كانَ يُرسَمُ بِجِوارِ «أَكمِل الشَّحن» فَيُخرِجُها إلى «شَحن» بِلا سُؤالِ OTO ولا بوليصَة
               (تَوصيفُه `e52ba8f`). صارَت `AdvanceAsync` تَرُدُّه بِـ`deal_awaits_carrier` (`DealShipping.AwaitsCarrier`)، فَخُطوَةُ
               البائِعِ هُنا بابُها «أَكمِل الشَّحن» وَحدَه (`heldByCarrier` أَدناه). *@
            @if (canShip)
            {
                <form method="post" action="@($"/{Slug}/deals/{deal.Id}/ship")" style="margin-bottom:8px;">
                    @if (!shipResumes)
                    {
                        <AcField Label="@L["deals.detail.ship_city"]">
                            <input name="city" class="ac-input" required />
                        </AcField>
                    }
                    <AcButton Type="submit" Variant="primary" Size="lg" Block="true"
                              Text="@(shipResumes ? L["deals.detail.ship_resume"] : L["deals.detail.ship_submit"])" />
                    <span style="display:block;margin-top:6px;font-size:12px;color:var(--ac-text-muted);line-height:1.7;">
                        @L.Markup("deals.detail.ship_hint")
                    </span>
                </form>
            }

            @* مالِك الإعلان يَقبَل العَرض (الصَّفقَة في Offered وأَنا المالِك ولَستُ المُبادِر) *@
            @if (deal.Stage == DealStage.Offered && isListingOwner && !isInitiator)
            {
                <form method="post" action="@($"/{Slug}/deals/{deal.Id}/accept")">
                    <AcButton Type="submit" Variant="primary" Size="lg" Block="true" Text="@L["deals.detail.accept_offer"]" />
                </form>
            }
            else if (canAdvance && heldByCarrier)
            {
                @* خُطوَتُه «شَحن» وطَلَبُها عِندَ OTO: بابُها «أَكمِل الشَّحن» أَعلاه — لا «تَأكيد: شَحن» تَرُدُّه `AdvanceAsync` بِـ
                   `deal_awaits_carrier`، ولا «بانتِظار الطَّرَف الآخَر» عَن خُطوَتِه هُوَ (مُراجَعَةُ تَيّارِ S7 الثانِيَة، ‏2026-10-12). *@
            }
            else if (canAdvance && nextStage is { } ns)
            {
                <form method="post" action="@($"/{Slug}/deals/{deal.Id}/advance")">
                    <AcButton Type="submit" Variant="primary" Size="lg" Block="true"
                              Text="@($"{L["deals.detail.confirm_prefix"]} {DealsPolicy.LabelAr(ns)}")" />
                </form>
            }
            else if (nextStage is { } waiting)
            {
                <AcAlert Variant="info"
                         Message="@($"{L["deals.detail.awaiting_other"]} {DealsPolicy.LabelAr(waiting)}")" />
            }

            @* الإلغاءُ لِمَن تُلغي لَه النُقطَة — `DealCancelAuthorization.IsAllowed` نَفسُها بِسِجِلِّ السُلطَةِ نَفسِه (القاعِدَة ١٢؛
               مُراجَعَةُ تَيّارِ S6a الأولى، ‏2026-10-12): كانَت تُرسَمُ لِكُلِّ ناظِرٍ لِصَفقَةٍ فَعّالَة، فَيَرى مالِكُ إعلانِ العَرضِ قَبلَ
               أَن يَقبَلَ استِمارَةً تُرَدُّ بِـ`actor_not_party`. (والأَسطُرُ الداخِلِيَّةُ بِمَسافاتِها كَما كانَت — فَلا بايتَ يَتَغَيَّرُ لِطَرَف.) *@
            @if (canCancel)
            {
            <form method="post" action="@($"/{Slug}/deals/{deal.Id}/cancel")" style="margin-top:8px;">
                <input name="reason" class="ac-input" placeholder="@L["deals.detail.cancel_reason_placeholder"]" style="margin-bottom:6px;" />
                <AcButton Type="submit" Variant="ghost" Block="true" Text="@L["deals.detail.cancel_action"]" />
            </form>
            }
        }
        else if (deal.Status == DealStatus.Completed)
        {
            <AcAlert Variant="success" Message="@L["deals.detail.completed"]" />
            @* الاستِمارَةُ مِن البَوّابَةِ الَّتي تُطَبِّقُها النُقطَة (‏ADR-033 §٦‑ح) — كانَ شَرطُها هُنا
               «لَها طَرَف» والنُقطَةُ لا تَسأَلُ شَيئاً؛ فَصارَ ما يُرسَمُ هُوَ ما يُقبَل. *@
            @if (!alreadyReviewed && canReview)
            {
                <AcCard>
                    <ChildContent>
                        <h3 style="margin:0 0 10px;">@L.Markup("deals.detail.review_title")</h3>
                        <form method="post" action="@($"/{Slug}/deals/{deal.Id}/review")">
                            <AcField Label="@L["deals.detail.review_rating"]">
                                <select name="rating" class="ac-input">
                                    <option value="5">@L.Markup("deals.detail.rating_5")</option>
                                    <option value="4">@L.Markup("deals.detail.rating_4")</option>
                                    <option value="3">@L.Markup("deals.detail.rating_3")</option>
                                    <option value="2">@L.Markup("deals.detail.rating_2")</option>
                                    <option value="1">@L.Markup("deals.detail.rating_1")</option>
                                </select>
                            </AcField>
                            <AcField Label="@L["deals.detail.review_comment"]">
                                <textarea name="body" class="ac-input" rows="2" placeholder="@L["deals.detail.review_placeholder"]"></textarea>
                            </AcField>
                            <AcButton Type="submit" Variant="primary" Block="true" Text="@L["deals.detail.review_submit"]" />
                        </form>
                    </ChildContent>
                </AcCard>
            }
            else if (alreadyReviewed)
            {
                <AcAlert Variant="info" Message="@L["deals.detail.review_thanks"]" />
            }
        }
        else
        {
            <AcAlert Variant="@(deal.Status == DealStatus.Disputed ? "warning" : "danger")"
                     Message="@($"{L["deals.detail.status_prefix"]} {deal.Status}" + (string.IsNullOrEmpty(deal.CancelReason) ? "" : $" — {deal.CancelReason}"))" />
        }

        @* السِجِلّ *@
        <AcSectionHeader Title="@L["deals.detail.timeline_title"]" />
        <div class="acm-cat-list">
            @foreach (var e in deal.Timeline.OrderByDescending(x => x.At))
            {
                <div class="acm-cat-row">
                    <div style="flex:1;">
                        <strong style="font-size:13px;">@FormatEvent(e)</strong>
                        <span style="color:var(--ac-text-muted);font-size:11px;display:block;">
                            @(e.ActorName ?? "—") · @e.At.ToString("MM-dd HH:mm")
                        </span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [Parameter] public Guid Id { get; set; }
    /// <summary>رَمزُ رَفضٍ ارتَدَّت بِه نُقطَةٌ (<c>/accept</c>، <c>/cancel</c>، أُنبوبُ
    /// المُحادَثَة) — يُحَلُّ نَصّاً بِـ<see cref="DealRefusalTexts.KeyFor"/>، ولا يُرسَمُ
    /// لِرَمزٍ خارِجَ المَعجَم.</summary>
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }

    Deal? deal;
    List<DealStage> stages = new();
    bool isInitiator, isListingOwner, canAdvance, alreadyReviewed;
    /// <summary>الناظِرُ يُقَيِّمُ هذِه الصَفقَة — <see cref="DealReviewAuthorization.IsAllowed"/> نَفسُها الَّتي
    /// تُطَبِّقُها <c>/review</c> (‏ADR-033 §٦‑ح)، فَلا تُرسَمُ استِمارَةٌ تَرُدُّها النُقطَة.</summary>
    bool canReview;
    /// <summary>الناظِرُ يُلغي هذِه الصَفقَة — <see cref="DealCancelAuthorization.IsAllowed"/> نَفسُها الَّتي تُطَبِّقُها <c>/cancel</c>
    /// بِسِجِلِّ السُلطَةِ نَفسِه (<c>IsStoreAdmin: false</c>)، فَلا تُرسَمُ استِمارَةٌ تَرُدُّها النُقطَة (‏2026-10-12).</summary>
    bool canCancel;
    /// <summary>الناظِرُ يُنشِئُ بوليصَةَ هذِه الصَفقَة — <see cref="DealShipAuthorization.IsAllowed"/> نَفسُها الَّتي تُطَبِّقُها
    /// <c>/ship</c>، بِرَمزِ ناقِلٍ يُحَلُّ لِهذا المَتجَر (<see cref="DealShipping.CarrierReady"/>) — وبِلا رَمزٍ لا تُرسَم (القاعِدَة ١٢).
    /// و<c>shipResumes</c>: لِلصَفقَةِ طَلَبٌ عِندَ OTO مِن مُحاوَلَةٍ سابِقَة، فَالاستِمارَةُ بِلا مَدينَة.</summary>
    bool canShip, shipResumes;
    /// <summary>تاليها «شَحن» وطَلَبُها عِندَ OTO — <see cref="DealShipping.AwaitsCarrier"/> نَفسُها الَّتي تَسأَلُها <c>AdvanceAsync</c>
    /// فَتَرُدُّ «تَأكيد: شَحن» بِـ<c>deal_awaits_carrier</c>: فَلا يُرسَمُ لِمَن خُطوَتُه هذِه، وبابُها «أَكمِل الشَّحن» (مُراجَعَةُ تَيّارِ S7
    /// الثانِيَة، ‏2026-10-12؛ القاعِدَة ١٢).</summary>
    bool heldByCarrier;
    /// <summary>رابِطا البوليصَةِ والتَتَبُّعِ لِلطَرَفَين — <see cref="DealShipping.LinksOf"/>: <c>https</c> وَحدَه، و<c>null</c> لِما غاب.</summary>
    string? labelUrl, trackingUrl;
    DealStage? nextStage;
    /// <summary>بَياناتُ التَوصيلِ تُرسَمُ لِمَن يُسَلِّمُ وَحدَه — الطَرَفُ المُقابِلُ
    /// أَو مالِكُ الإعلانِ، ولَيسَ المُشتَري (P1-4) — <b>وبِحُضورِ عُنوانٍ أَو هاتِف</b>
    /// (‏2026-10-11): صَفقَةُ مَسارِ العَرضِ لا تَحمِلُ أَيّاً مِنهُما.</summary>
    bool deliveryVisible;
    string? buyerAddr, buyerPhone;
    /// <summary>البائِعُ الَّذي يُراسِلُه المُبادِر: مالِكُ الإعلانِ مِن
    /// <c>Refs[listing_owner]</c>، وإلّا الطَرَفُ المُقابِلُ بَعدَ القَبول؛
    /// و<c>null</c> حَيثُ لا يُعرَفُ أَو كانَ هُوَ أَنا — فَلا يُرسَمُ الزِرّ.</summary>
    Guid? vendorId;
    /// <summary>مَوقِعي مِن الصَّفقَة — يُغَذّي «دَورُكَ الآن» وَشَرح
    /// التَدَفُّق («صاحِب الطَلَب» تُصبِح «أَنتَ»).</summary>
    Services.Ux.DealSide mySide = Services.Ux.DealSide.Observer;

    protected override async Task OnInitializedAsync()
    {
        if (HttpCtx.HttpContext is { } ctx) { Auth.SetTenant(Slug); Auth.Load(ctx, Slug); }
        if (!Auth.IsAuthenticated) return;
        var uid = Auth.UserId!.Value;
        deal = await Deals.LoadAsync(Slug, Id);
        if (deal is null) return;
        // فَحص أَنّني طَرَف في الصَّفقَة.
        var ownerRef = deal.Refs.TryGetValue("listing_owner", out var lo) ? lo : null;
        isInitiator = deal.InitiatorId == uid;
        // هُوِيَّةُ المالِكِ بِقيمَةِ المُعَرِّفِ لا بِحَرفِ النَصّ — الدالَّةُ نَفسُها
        // الَّتي تَقرَؤُها نُقطَةُ `/accept` (`DealAcceptAuthorization.Validate`)، فَما
        // تَرسُمُه الشاشَةُ هُوَ ما تَقبَلُه النُقطَة (‏ADR-033 §٦). وكانَت
        // `ownerRef == uid.ToString()`.
        isListingOwner = DealAcceptAuthorization.OwnerIdOf(deal) == uid || deal.CounterpartyId == uid;
        if (!isInitiator && !isListingOwner) { deal = null; return; }
        vendorId = Guid.TryParse(ownerRef, out var ownerGuid) ? ownerGuid : deal.CounterpartyId;
        if (vendorId == uid) vendorId = null;

        // بَياناتُ التَوصيلِ لِمَن يُسَلِّمُ وَحدَه — لا لِلمُشتَري (بَياناتُه هُوَ) ولا
        // لِثالِث (أُغلِقَت الصَفحَةُ عَلَيه أَعلاه). وبِثابِتَي `Deal` لا بِحَرفِيَّة،
        // فَالقارِئُ يَقرَأُ ما كَتَبَه `/checkout/submit` بِحَرفِه (P1-4).
        if (!isInitiator && isListingOwner)
        {
            buyerAddr  = deal.Attributes.TryGetValue(Deal.DeliveryAddressAttribute, out var a) ? a : null;
            buyerPhone = deal.Attributes.TryGetValue(Deal.DeliveryPhoneAttribute, out var p) ? p : null;
        }
        // والكُتلَةُ بِحُضورِ أَحَدِهِما لا بِمَوقِعِ الناظِرِ وَحدَه (‏2026-10-11): كانَت
        // `deliveryVisible = !isInitiator && isListingOwner;` فَتُرسَمُ لِلبائِعِ عُنواناً وإفصاحاً
        // بِلا سَطرٍ تَحتَهُما في كُلِّ صَفقَةٍ مِن مَسارِ العَرض. ولا يُقرَأُ أَيٌّ مِنهُما إلّا لِلبائِع
        // أَعلاه — فَالحُضورُ يَحمِلُ الحارِسَ مَعَه.
        deliveryVisible = !string.IsNullOrEmpty(buyerAddr) || !string.IsNullOrEmpty(buyerPhone);

        mySide = Services.Ux.DealTurnView.SideOf(uid, deal.InitiatorId, deal.CounterpartyId);
        // مِن الصَفقَةِ نَفسِها: طَريقَةُ الدَفعِ تُسقِطُ «دَفع» عَن النَقدِ في
        // الـstepper والمَرحَلَةِ التالِيَةِ مَعاً (‏ADR-033 §٦) — نَفسُ الدالَّةِ
        // الَّتي يُحَرِّكُ بِها `DealsService.AdvanceAsync`.
        stages = DealsPolicy.StagesFor(deal).ToList();
        nextStage = DealsPolicy.Next(deal);
        // مَن يُخرِجُها مِن مَرحَلَتِها؟ فاعِلُ التالي — الدالَّةُ نَفسُها الَّتي تَفرِضُها
        // `DealsService.AdvanceAsync` (‏ADR-033 §٦‑ط، ‏2026-10-11؛ كانَ «مَن يُحَرِّك المَرحَلَة
        // الحاليَّة؟» بِـ`Actor(deal.Stage)` فَيُرسَمُ لِلمُشتَري زِرُّ «تَأكيد: حَجز» عَلى طَلَبِه).
        // و`null` عِندَ آخِرِ مَرحَلَةٍ يَسقُطُ إلى `_ => false`.
        var required = DealsPolicy.RequiredActorToLeave(deal);
        canAdvance = required switch
        {
            "initiator" => isInitiator,
            "counterparty" => deal.CounterpartyId == uid,
            "either" => isInitiator || deal.CounterpartyId == uid,
            _ => false
        };
        alreadyReviewed = await Reviews.HasReviewedAsync(Slug, uid, Id);
        canReview = DealReviewAuthorization.IsAllowed(deal, new DealReviewer(uid, Auth.UserName ?? ""));
        canCancel = DealCancelAuthorization.IsAllowed(deal, new DealCanceller(uid, Auth.UserName ?? "", IsStoreAdmin: false));
        // البوليصَة (‏ADR-033 الخُطوَة 3): رابِطاها لِلطَرَفَين بِالدالَّةِ الَّتي يَقرَأُ بِها الشَحنُ والوارِد، واستِمارَتُها بِالبَوّابَةِ
        // الَّتي تُطَبِّقُها النُقطَة — فَما يُرسَمُ هُوَ ما يُقبَل.
        (labelUrl, trackingUrl) = DealShipping.LinksOf(deal);
        canShip = DealShipAuthorization.IsAllowed(deal, new DealShipper(uid, Auth.UserName ?? ""), Shipping.CarrierReady(Slug));
        shipResumes = canShip && DealShipping.IsPlaced(deal);
        // وخُطوَةٌ طَلَبُها عِندَ OTO لا يُرسَمُ لَها «تَأكيد: شَحن» — الدالَّةُ الَّتي يَرُدُّ بِها المُحَرِّك (مُراجَعَةُ تَيّارِ S7 الثانِيَة).
        heldByCarrier = DealShipping.AwaitsCarrier(deal);
    }

    // ‏لَيسَت `static` بَعدَ اليَوم: قيَمُها صارَت مِن `L` وهو مَحقونٌ
    // ‏scoped — ودالَّةٌ ساكِنَة لا تَبلُغُه. المُستَهلِكُ واحِد
    // (`@FormatEvent(e)` في الحَلَقَة)، فَالتَبديلُ بِلا أَثَرٍ سِواه.
    string FormatEvent(DealEvent e) => e.Action switch
    {
        "created" => L["deals.detail.event_created"],
        "assigned" => L["deals.detail.event_assigned"],
        DealEvent.BoundAtBirth => L["deals.detail.event_bound"],
        DealEvent.CashOnDelivery => L["deals.detail.event_cash_on_delivery"],
        "advanced" => $"{DealsPolicy.LabelAr(e.StageBefore)} ← {DealsPolicy.LabelAr(e.StageAfter)}",
        "cancelled" => L["deals.detail.event_cancelled"],
        "disputed" => L["deals.detail.event_disputed"],
        "note" => e.Note ?? L["deals.detail.event_note"],
        _ => e.Action
    };
}
