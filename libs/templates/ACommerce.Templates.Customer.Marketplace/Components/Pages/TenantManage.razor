@page "/{slug}/manage"
@page "/{slug}/r/{role}/manage"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Accounts
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantAdminQueries TenantAdmin
@inject AuthSession Auth
@inject L L

@*
    لَوحَة tenant_admin — صَلاحِيَّة tenant.manage مَطلوبَة. تَعرِض إحصائِيّات
    سَريعَة + رَوابِط لِلأَدوات الإداريّة عَلى مُستَوى المَتجَر (نَقطَة دُخول
    مُختَلِفَة عَن /admin الَّذي هو لِإدارَة المنصّة كَكُلّ).
*@

<div class="acs-page">
@if (!Auth.IsAuthenticated)
{
    <AcEmptyState IconName="user" Title="@L["tenant.manage.need_login"]"
                  ActionLabel="@L["auth.action.login"]"
                  ActionHref="@AuthSession.LinkFor(Slug, Role, $"login?returnUrl=/{Slug}/manage")" />
}
else if (!canManage)
{
    <AcEmptyState IconName="alert-circle"
                  Title="@L["tenant.manage.no_permission"]"
                  Message="@L["tenant.manage.no_permission_hint"]"
                  ActionLabel="@L["admin.action.back"]"
                  ActionHref="@($"/{Slug}")" />
}
else if (tenant is null)
{
    <AcLoadingState />
}
else
{
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <div>
            <h1 class="acm-wizard-title" style="margin:0;">@L.Markup("tenant.manage.title_prefix") @tenant.Name</h1>
            <span style="color:var(--ac-text-muted);font-size:13px;">@L.Markup("tenant.manage.subtitle")</span>
        </div>
        <span style="font-size:32px;"><AcIcon Name="people" Size="24" /></span>
    </div>

    <div class="acm-home-grid acm-stats-grid" style="margin-top:8px;">
        <a class="acm-stat-tile" href="@AuthSession.LinkFor(Slug, Role, $"explore")">
            <strong>@listingsCount</strong>
            <span>@L.Markup("tenant.manage.stat_listings")</span>
        </a>
        <a class="acm-stat-tile" href="@AuthSession.LinkFor(Slug, Role, $"chats")">
            <strong>@convsCount</strong>
            <span>@L.Markup("tenant.manage.stat_conversations")</span>
        </a>
        <div class="acm-stat-tile" style="cursor:default;">
            <strong>@offersCount</strong>
            <span>@L.Markup("tenant.manage.stat_offers")</span>
        </div>
        <div class="acm-stat-tile" style="cursor:default;">
            <strong>@usersCount</strong>
            <span>@L.Markup("tenant.manage.stat_users")</span>
        </div>
    </div>

    <AcCard>
        <ChildContent>
            <h3 style="margin-top:0;">@L.Markup("tenant.manage.quick_actions")</h3>
            <div class="acm-home-actions">
                <AcActionCard Label="@L["tenant.manage.action_create"]"  IconName="plus"      Variant="primary" Href="@AuthSession.LinkFor(Slug, Role, $"create-listing")" />
                <AcActionCard Label="@L["tenant.manage.action_explore"]" IconName="search"  Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"explore")" />
                <AcActionCard Label="@L["tenant.manage.action_chats"]" IconName="message" Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"chats")" />
                <AcActionCard Label="@L["tenant.manage.action_support"]"  IconName="alert-circle" Variant="surface" Href="@AuthSession.LinkFor(Slug, Role, $"support")" />
            </div>
        </ChildContent>
    </AcCard>

    <AcCard>
        <ChildContent>
            <h3 style="margin-top:0;">@L.Markup("tenant.manage.settings_title")</h3>
            <p style="color:var(--ac-text-muted);font-size:13px;margin:0 0 12px;">@((MarkupString)"\n                ")@L.Markup("tenant.manage.settings_hint")@((MarkupString)"\n            ")
            </p>
            <div class="acm-home-actions">
                <AcActionCard Label="@L["tenant.manage.link_categories"]"       IconName="tag"      Variant="surface" Href="@($"/admin/tenants/{Slug}/categories?from=tenant")" />
                <AcActionCard Label="@L["tenant.manage.link_attributes"]"      IconName="settings" Variant="surface" Href="@($"/admin/tenants/{Slug}/attributes?from=tenant")" />
                <AcActionCard Label="@L["tenant.manage.link_regions"]"        IconName="map-pin"  Variant="surface" Href="@($"/admin/tenants/{Slug}/regions?from=tenant")" />
                <AcActionCard Label="@L["tenant.manage.link_roles"]"       IconName="user"     Variant="surface" Href="@($"/admin/tenants/{Slug}/roles?from=tenant")" />
                <AcActionCard Label="@L["tenant.manage.link_users"]"  IconName="user"     Variant="surface" Href="@($"/admin/tenants/{Slug}/users?from=tenant")" />
                <AcActionCard Label="@L["tenant.manage.link_branding"]"      IconName="settings" Variant="surface" Href="@($"/admin/tenants/{Slug}/branding?from=tenant")" />
            </div>
        </ChildContent>
    </AcCard>
}
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }

    Tenant? tenant;
    bool canManage;
    int listingsCount, convsCount, offersCount, usersCount;

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsAuthenticated) return;
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is null) return;

        // القَرارُ يَبقى هُنا: يَقرَأ أَدوارَ المُستَأجِر ودَورَ الـURL
        // ودَورَ المُستَخدِم مَعاً — تَأليفٌ لا استِعلام. والدَورُ
        // المَحفوظُ وَحدَه هُوَ ما يُسأَل عَنه.
        var storedRole = await Accounts.ActiveRoleAsync(Slug, Auth.UserId!.Value);
        canManage = ACommerce.Kit.Roles.RolePermissions.Has(
            tenant.Roles, Role ?? storedRole, "tenant.manage");
        if (!canManage) return;

        var overview  = await TenantAdmin.OverviewAsync(Slug);
        listingsCount = overview.Listings;
        convsCount    = overview.Conversations;
        offersCount   = overview.PendingOffers;
        usersCount    = overview.Users;
    }
}
