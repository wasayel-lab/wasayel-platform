@page "/studio/apps/{slug}/deals"
@inject Services.Incubator.StudioAuth Auth
@inject ACommerce.Kit.Culture.ICultureContext Culture
@inject Services.Queries.TenantDirectory Tenants
@inject Services.Deals.DealsService Deals
@inject Services.Queries.AccountQueries Account
@inject L L
@using ACommerce.Kit.Tenants
@using ACommerce.Templates.Customer.Marketplace.Services.Deals

@*
    قائِمَة الـ Deals لِلتَّطبيق — مَركَز عَمَلِيّات. فَلتَرَة بِالمَرحَلَة
    + الحالَة، عَرض الأَطراف والمَبلَغ، إجراء سَريع لِكُلّ صَفّ.
*@

<StudioShell Title="@($"{L["studio.app_deals.title"]} {tenant?.Name ?? Slug}")" Active="home">
    <TopBarActions>
        <a class="st-btn st-btn-ghost" href="@($"/studio/apps/{Slug}")">← @L.Markup("studio.app_nav.settings")</a>
        @* (‏2026-10-29، قَرارُ المالِك د32 «٢»): كانَ هُنا زِرُّ «+ عَمَلِيَّة تَجريبيَّة» إلى `/studio/apps/{slug}/deals/seed` — يَكتُبُ صَفقَةً حَقيقِيَّةً
           في المَتجَرِ تَقِفُ عِندَ «عَرض» (حارِسُ المُبادِرِ يَرُدُّ أَوَّلَ نَقرَةٍ إدارِيَّة)؛ فَحُذِفَ هُوَ واستِمارَةُ الصَفحَةِ الفارِغَةِ والبابُ نَفسُه (القاعِدَتانِ ١٢ و١٧). *@
    </TopBarActions>
    <ChildContent>
        @if (tenant is null)
        {
            <div class="st-card">@L.Markup("studio.app.not_found")</div>
        }
        else
        {
            <div class="studio-page-head">
                <h1>@L.Markup("studio.app_deals.heading")</h1>
                <p>@L.Markup("studio.app_deals.intro")</p>
            </div>

            @* نُقطَةُ `advance` الإدارِيَّةُ تَرتَدُّ إلى القائِمَةِ لِصَفقَةٍ لا تُحَمَّل — بِرَمزِها، والنَصُّ مِن مَعجَمِ الاستوديو
               (‏2026-10-13، مُراجَعَةُ المَوجَة 3a — G4 (i)؛ نَسَقُ شَريطِ `StudioAppDealDetail`). *@
            @if (DealRefusalTexts.StudioKeyFor(Err) is { } errKey)
            {
                <div class="st-chip st-chip-danger" style="margin-bottom:14px;">@L.Markup(errKey)</div>
            }
            @* تَنبيهاتُ صاحِبِ المَتجَرِ — «استِرجاعٌ مُستَحَقّ» و«فاتورَةٌ لَم تُلغَ» — صُفوفاً تُنقَرُ إلى صَفقاتِها (‏2026-10-29، مُراجَعَةُ تَيّارِ S3 الجَولَة ٢؛
               قَرارُ المالِك د3 (٢) «د»). وبِلا إشعارٍ لا يُرسَمُ شَيء — الكُتلَةُ بِلا فَراغٍ قَبلَها ولا بَعدَها فَالصَفحَةُ كَما كانَت بِحَرفِها. *@
            @if (ownerNotices.Count > 0)
            {
                <StudioOwnerNotices Slug="@Slug" Mine="@ownerNotices" />
            }

            <div class="studio-stats">
                <div class="studio-stat"><div class="studio-stat-label">@L.Markup("studio.app_deals.stat_total")</div>
                    <div class="studio-stat-value">@deals.Count</div></div>
                <div class="studio-stat"><div class="studio-stat-label">@L.Markup("studio.app_deals.stat_active")</div>
                    <div class="studio-stat-value" style="color:var(--st-success);">@deals.Count(d => d.Status == DealStatus.Active)</div></div>
                <div class="studio-stat"><div class="studio-stat-label">@L.Markup("studio.app_deals.stat_completed")</div>
                    <div class="studio-stat-value">@deals.Count(d => d.Status == DealStatus.Completed)</div></div>
                <div class="studio-stat"><div class="studio-stat-label">@L.Markup("studio.app_deals.stat_disputed")</div>
                    <div class="studio-stat-value" style="color:var(--st-danger);">@deals.Count(d => d.Status == DealStatus.Disputed)</div></div>
            </div>

            <div class="st-section-title">@L.Markup("studio.app_deals.list")</div>
            @if (deals.Count == 0)
            {
                <div class="st-card" style="text-align:center;padding:36px;">
                    <div style="margin-bottom:6px;"><AcIcon Name="package" Size="42" /></div>
                    <h3 style="margin:0 0 6px;">@L.Markup("studio.app_deals.empty")</h3>
                    <p style="color:var(--st-muted);margin:0;">@L.Markup("studio.app_deals.empty_hint")</p>
                </div>
            }
            else
            {
                <div class="studio-list">
                    @foreach (var d in deals)
                    {
                        <a class="studio-list-row" href="@($"/studio/apps/{Slug}/deals/{d.Id}")">
                            <span class="studio-list-icon" style="background:@StageBg(d.Stage);color:@StageColor(d.Stage);">
                                <AcIcon Name="@StageIcon(d.Stage)" Size="16" />
                            </span>
                            <div class="studio-list-body">
                                <strong>
                                    @(string.IsNullOrEmpty(d.ListingTitle) ? $"{L["studio.app_deals.untitled"]} {d.Id.ToString()[..8]}" : d.ListingTitle)
                                </strong>
                                <span>
                                    @d.Pattern · @d.InitiatorName
                                    @if (d.CounterpartyName is not null) { <text> ⇄ @d.CounterpartyName</text> }
                                    · @Culture.FormatTime(d.UpdatedAt, "HH:mm")
                                </span>
                            </div>
                            <span class="st-chip">@DealsPolicy.LabelAr(d.Stage)</span>
                            <span class="st-chip @StatusChip(d.Status)">@StatusLabel(d.Status)</span>
                            @if (d.AmountSar > 0)
                            {
                                <span style="font-weight:700;color:var(--st-ink-700);">@((MarkupString)ACommerce.Kit.Culture.Money.Format(d.AmountSar))</span>
                            }
                        </a>
                    }
                </div>
            }
        }
    </ChildContent>
</StudioShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
    /// <summary>رَمزُ رَفضٍ مِن نُقطَةٍ إدارِيَّةٍ ارتَدَّت إلى القائِمَة — يُحَلُّ بِـ<see cref="DealRefusalTexts.StudioKeyFor"/>.</summary>
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }
    Tenant? tenant;
    List<Deal> deals = new();
    /// <summary>إشعاراتُ صاحِبِ المَتجَرِ في مُستَأجِرِ المَتجَرِ بِمُعَرِّفِ جَلسَةِ الاستوديو — يَقرَؤُها القارِئُ القائِمُ نَفسُه (القاعِدَة ٨) بَعدَ فَحصِ المِلكِيَّة.</summary>
    IReadOnlyList<ACommerce.Kit.Notifications.Notification> ownerNotices = Array.Empty<ACommerce.Kit.Notifications.Notification>();

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is not null && tenant.OwnerUserId != Auth.UserId!.Value) { tenant = null; return; }
        if (tenant is null) return;
        deals = await Deals.ListForTenantAsync(Slug);
        ownerNotices = await Account.NotificationsAsync(Slug, Auth.UserId!.Value);
    }

    static string StageIcon(DealStage s) => s switch
    {
        DealStage.Offered => "clipboard", DealStage.Booked => "calendar",
        DealStage.Confirmed => "check", DealStage.Paid => "credit-card",
        DealStage.Shipping => "truck", DealStage.Delivered => "package",
        DealStage.Received => "check-circle", DealStage.Reviewed => "star",
        _ => "tag"
    };

    static string StageBg(DealStage s) => s switch
    {
        DealStage.Offered => "#dbeafe", DealStage.Booked => "#e0e7ff",
        DealStage.Confirmed => "#dcfce7", DealStage.Paid => "#cffafe",
        DealStage.Shipping => "#fef3c7", DealStage.Delivered => "#fed7aa",
        DealStage.Received => "#dcfce7", DealStage.Reviewed => "#fae8ff",
        _ => "#f1f5f9"
    };
    static string StageColor(DealStage s) => s switch
    {
        DealStage.Offered => "#1d4ed8", DealStage.Booked => "#4338ca",
        DealStage.Confirmed => "#15803d", DealStage.Paid => "#0e7490",
        DealStage.Shipping => "#854d0e", DealStage.Delivered => "#9a3412",
        DealStage.Received => "#15803d", DealStage.Reviewed => "#a21caf",
        _ => "#475569"
    };

    static string StatusChip(DealStatus s) => s switch
    {
        DealStatus.Active => "", DealStatus.Completed => "st-chip-success",
        DealStatus.Cancelled => "st-chip-warning", DealStatus.Disputed => "st-chip-danger",
        _ => ""
    };
    string StatusLabel(DealStatus s) => s switch
    {
        DealStatus.Active => L["studio.app_deals.status_active"], DealStatus.Completed => L["studio.app_deals.status_completed"],
        DealStatus.Cancelled => L["studio.app_deals.status_cancelled"], DealStatus.Disputed => L["studio.app_deals.status_disputed"],
        _ => s.ToString()
    };
}
