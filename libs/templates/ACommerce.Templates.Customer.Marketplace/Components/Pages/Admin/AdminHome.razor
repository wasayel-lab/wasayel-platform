@page "/admin"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject NavigationManager Nav
@inject L L

@*
    لَوحَة تَحَكُّم المنصَّة (admin) — لِإدارَة المُستَأجِرين.
    حاليّاً مَفتوحَة بِلا تَوثيق — ستُضاف auth في جَلسَة لاحِقَة.
*@

<RequirePlatformAdmin>
<div class="acs-page acm-admin">
    @* صَفحَة بِدايَة صاحِب المَتجَر الجَديد: ابدَأ بِتَحليل الفِكرَة قَبل الإنشاء. *@
    <AcCard Class="acm-incubator-hero">
        <ChildContent>
            <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
                <span style="font-size:46px;"><AcIcon Name="search" Size="46" /></span>
                <div style="flex:1;min-width:220px;">
                    <h2 style="margin:0 0 4px;">@L.Markup("admin.home.idea_title")</h2>
                    <p style="margin:0;color:var(--ac-text-muted);font-size:13px;line-height:1.7;">
                        @((MarkupString)"\n                        ")@L.Markup("admin.home.idea_body")@((MarkupString)"\n                    ")
                    </p>
                </div>
                <a class="ac-btn ac-btn-primary" href="/admin/incubator">
                    <AcIcon Name="star" Size="18" /> @L.Markup("admin.home.incubator_cta")@((MarkupString)"\n                ")
                </a>
            </div>
        </ChildContent>
    </AcCard>

    <div class="acm-admin-head" style="margin-top:20px;">
        <div>
            <h1 class="acm-wizard-title" style="margin:0;">@L.Markup("admin.home.tenants")</h1>
            <p style="color:var(--ac-text-muted);margin:4px 0 0;font-size:13px;">
                @(tenants?.Count ?? 0) @L.Markup("admin.home.count_note")@((MarkupString)"\n            ")
            </p>
        </div>
        <div style="display:flex;gap:8px;">
            <a class="ac-btn ac-btn-primary" href="/admin/tenants/new">
                <AcIcon Name="plus" Size="18" /> @L.Markup("admin.home.new_tenant")@((MarkupString)"\n            ")
            </a>
            <a class="ac-btn ac-btn-ghost" href="/admin/agent">
                <AcIcon Name="message" Size="18" /> @L.Markup("admin.home.agent_cta")@((MarkupString)"\n            ")
            </a>
        </div>
    </div>

    @if (tenants is null)
    {
        <AcLoadingState />
    }
    else if (tenants.Count == 0)
    {
        <AcEmptyState IconName="building"
                      Title="@(L["admin.home.empty_title"])"
                      Message="@(L["admin.home.empty_msg"])"
                      ActionLabel="@(L["admin.home.new_tenant"])"
                      ActionHref="/admin/tenants/new" />
    }
    else
    {
        <div class="acm-home-grid" style="margin-top:16px;">
            @foreach (var t in tenants)
            {
                <article class="acm-tenant-card"
                         style="border-inline-start:4px solid @t.BrandColor;position:relative;">
                    <a href="@($"/admin/tenants/{t.Slug}")"
                       style="display:block;text-decoration:none;color:inherit;">
                        <div class="acm-tenant-card-head">
                            <span class="acm-tenant-card-brand"
                                  style="background:@t.BrandColor;">@(t.Name.FirstOrDefault())</span>
                            <div class="acm-tenant-card-info">
                                <strong>@t.Name</strong>
                                <span>/@t.Slug · @t.City</span>
                            </div>
                        </div>
                        <p class="acm-tenant-card-tagline">@t.TagLine</p>
                        <div class="acm-tenant-card-meta">
                            <span><AcIcon Name="tag" Size="14" /> @t.Categories.Count @L.Markup("admin.home.category_unit")</span>
                            <span><AcIcon Name="@ChannelIcon(t.AuthChannel)" Size="14" />
                                  @ChannelLabel(t.AuthChannel)</span>
                            @if (t.Roles.Count > 0)
                            {
                                <span><AcIcon Name="user" Size="14" /> @t.Roles.Count @L.Markup("admin.home.roles_unit")</span>
                            }
                        </div>
                    </a>
                    @* مُبَدِّل الهُوِيَّة البَصَرِيَّة — مَدخَلُه هُنا لا في
                       صَفحَة المَتجَر وَحدَها: الصَفحَة خَلف بَوّابَة
                       مُشرِف المَنصَّة، وهذه هي لَوحَتُه. مَدخَلٌ خَلف
                       بَوّابَةٍ أَشَدّ مِن بَوّابَتِه لا يُبلَغ. *@
                    <a href="@($"/admin/tenants/{t.Slug}/theme")"
                       title="@(L["admin.home.theme_title"])"
                       style="position:absolute;top:10px;inset-inline-end:48px;
                              display:inline-flex;align-items:center;justify-content:center;
                              width:32px;height:32px;border-radius:999px;
                              background:var(--ac-bg-alt);color:var(--ac-text-muted);
                              text-decoration:none;font-size:14px;">
                        <AcIcon Name="brush" Size="15" />
                    </a>
                    @* رابِط مُنفَصِل لِفَتح المَتجَر نَفسه في تَبويب جَديد.
                       النَّقر عَلى البِطاقَة = تَحَكُّم، السَّهم = مُعايَنَة. *@
                    <a href="@($"/{t.Slug}")" target="_blank" rel="noopener"
                       title="@(L["admin.home.open_title"])"
                       style="position:absolute;top:10px;inset-inline-end:10px;
                              display:inline-flex;align-items:center;justify-content:center;
                              width:32px;height:32px;border-radius:999px;
                              background:var(--ac-bg-alt);color:var(--ac-text-muted);
                              text-decoration:none;font-size:14px;">
                        <AcIcon Name="external-link" Size="15" />
                    </a>
                </article>
            }
        </div>
    }
</div>

    @* monitoring CTA لِمُشرِف المَنصَّة *@
    <div style="margin-top:18px;">
        <a class="ac-btn ac-btn-ghost" href="/admin/monitor"><AcIcon Name="bar-chart" Size="16" /> @L.Markup("admin.home.monitor_cta")</a>
    </div>
</RequirePlatformAdmin>

@code {
    IReadOnlyList<Tenant>? tenants;

    protected override async Task OnInitializedAsync()
    {
        tenants = await Tenants.ListAsync();
    }

    static string ChannelIcon(string channel) => channel switch
    {
        "nafath" => "shield",
        "email"  => "mail",
        _        => "phone"
    };

    string ChannelLabel(string channel) => channel switch
    {
        "nafath" => L["auth.channel.nafath"],
        "email"  => L["auth.channel.email"],
        _        => L["auth.channel.phone"]
    };
}
