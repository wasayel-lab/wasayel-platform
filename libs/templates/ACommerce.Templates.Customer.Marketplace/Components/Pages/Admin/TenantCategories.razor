@page "/admin/tenants/{slug}/categories"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantAdminGuard Guard
@inject L L

@*
    مُحَرِّر الفِئات — قائِمَة + شَكل سَطر-لِكُلّ-فِئَة كَ textarea (نَفس
    شَكل صَفحَة إنشاء المَتجَر). يَسمَح بِإعادَة كِتابَة الشَجَرَة كامِلَة
    دَفعَة واحِدَة بِدون UI مُعَقَّد لِلتَّرتيب/الإضافَة الفَرديَّة.
*@

<RequireTenantAdmin Slug="@Slug">
<div class="acs-page acm-admin">
    @if (tenant is null)
    {
        <AcEmptyState IconName="info" Title="@L["admin.tenant.not_found"]" />
    }
    else
    {
        var backHref = From == "tenant" ? $"/{Slug}/r/admin/manage" : $"/admin/tenants/{Slug}";
        <div class="acm-admin-head">
            <div style="display:flex;align-items:center;gap:8px;">
                <a class="ac-btn ac-btn-ghost ac-btn-sm" href="@backHref">
                    <AcIcon Name="arrow-right" Size="16" />
                </a>
                <h1 class="acm-wizard-title" style="margin:0;">@L.Markup("admin.tenant_categories.heading") @tenant.Name</h1>
            </div>
        </div>

        @if (Err is not null)
        {
            <AcAlert Variant="danger" Message="@FormatError(Err)" />
        }

        <AcCard>
            <ChildContent>
                <h3 style="margin-top:0;">@L.Markup("admin.tenant_categories.current_before")@tenant.Categories.Count @L.Markup("admin.tenant_categories.current_after")</h3>
                @if (tenant.Categories.Count > 0)
                {
                    <div class="acm-cat-list">
                        @foreach (var c in tenant.Categories.OrderBy(c => c.SortOrder).ThenBy(c => c.Label))
                        {
                            <div class="acm-cat-row">
                                <span style="font-size:24px;"><AcIcon Name="@(string.IsNullOrEmpty(c.Icon) ? "tag" : ACommerce.Widgets.AcIconMap.Resolve(c.Icon, "tag"))" Size="24" /></span>
                                <div style="flex:1;">
                                    <strong>@c.Label</strong>
                                    <span style="color:var(--ac-text-muted);font-size:12px;
                                                 display:block;direction:ltr;">@c.Slug</span>
                                </div>
                                @if (!string.IsNullOrEmpty(c.Kind))
                                {
                                    <span class="ac-chip ac-chip-sm">@c.Kind</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p style="color:var(--ac-text-muted);">@L.Markup("admin.tenant_categories.empty")</p>
                }
            </ChildContent>
        </AcCard>

        <form method="post" action="@($"/admin/tenants/{Slug}/categories/save")" id="cats-form">
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("admin.tenant_categories.update_heading")</h3>
                    <p style="color:var(--ac-text-muted);font-size:13px;margin:0 0 14px;">@((MarkupString)"\n                        ")@L.Markup("admin.tenant_categories.hint_before") = @L.Markup("admin.tenant_categories.hint_after")
                        <strong>@L.Markup("admin.tenant_categories.warn_label")</strong>: @L.Markup("admin.tenant_categories.warn_body")@((MarkupString)"\n                    ")
                    </p>

                    <div class="ac-editor" id="cats-editor">
                        @foreach (var c in tenant.Categories.OrderBy(c => c.SortOrder).ThenBy(c => c.Label))
                        {
                            <div class="ac-editor-row" data-cat-row>
                                <div class="ac-editor-row-head">
                                    <input class="ac-input ac-cat-icon" value="@(c.Icon ?? "home")"
                                           aria-label="@L["admin.tenant_categories.icon_label"]" />
                                    <input class="ac-input ac-cat-label" placeholder="@L["admin.tenant_categories.name_placeholder"]" value="@c.Label" />
                                    <button type="button" class="ac-icon-btn" data-remove-cat aria-label="@L["admin.tenant_categories.remove"]"><AcIcon Name="x" Size="14" /></button>
                                </div>
                                <div class="ac-editor-grid2">
                                    <div>
                                        <span class="ac-chip-input-label">@L.Markup("admin.tenant_categories.slug_label")</span>
                                        <input class="ac-input ac-cat-slug" placeholder="apartments" value="@c.Slug" style="direction:ltr;" />
                                    </div>
                                    <div>
                                        <span class="ac-chip-input-label">@L.Markup("admin.tenant_categories.kind_label")</span>
                                        <input class="ac-input ac-cat-kind" placeholder="residential" value="@c.Kind"
                                               list="kind-list" style="direction:ltr;" />
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <datalist id="kind-list">
                        <option value="residential"></option>
                        <option value="commercial"></option>
                        <option value="roommate"></option>
                        <option value="vehicles"></option>
                        <option value="events"></option>
                        <option value="leisure"></option>
                    </datalist>

                    <button type="button" class="ac-add-row-btn" id="add-cat" style="margin-top:12px;">
                        <AcIcon Name="plus" Size="16" /> @L.Markup("admin.tenant_categories.add_row")@((MarkupString)"\n                    ")
                    </button>

                    <textarea name="categories" id="cats-hidden" hidden>@catsText</textarea>
                </ChildContent>
            </AcCard>

            <div style="display:flex;gap:8px;margin-top:16px;">
                <a class="ac-btn ac-btn-ghost" href="@($"/admin/tenants/{Slug}")">@L.Markup("admin.tenant_categories.cancel")</a>
                <button type="submit" class="ac-btn ac-btn-primary ac-btn-block">
                    <AcIcon Name="check" Size="18" /> @L.Markup("admin.tenant_categories.save")@((MarkupString)"\n                ")
                </button>
            </div>
        </form>

        <template id="cat-row-tpl">
            <div class="ac-editor-row" data-cat-row>
                <div class="ac-editor-row-head">
                    <input class="ac-input ac-cat-icon" value="tag" aria-label="@L["admin.tenant_categories.icon_label"]" />
                    <input class="ac-input ac-cat-label" placeholder="@L["admin.tenant_categories.name_placeholder"]" />
                    <button type="button" class="ac-icon-btn" data-remove-cat aria-label="@L["admin.tenant_categories.remove"]"><AcIcon Name="x" Size="14" /></button>
                </div>
                <div class="ac-editor-grid2">
                    <div>
                        <span class="ac-chip-input-label">@L.Markup("admin.tenant_categories.slug_label")</span>
                        <input class="ac-input ac-cat-slug" placeholder="apartments" style="direction:ltr;" />
                    </div>
                    <div>
                        <span class="ac-chip-input-label">@L.Markup("admin.tenant_categories.kind_label")</span>
                        <input class="ac-input ac-cat-kind" placeholder="residential" list="kind-list" style="direction:ltr;" />
                    </div>
                </div>
            </div>
        </template>
    }
</div>
</RequireTenantAdmin>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    Tenant? tenant;
    string catsText = "";

    protected override async Task OnParametersSetAsync()
    {
        // البَوّابَة قَبل أَيّ استِعلام: الرَّفض يَعني ألّا تُحَمَّل
        // بَيانات المَتجَر أَصلاً، لا أَن تُحَمَّل ثُمَّ تُحجَب عَن
        // التَّصيير. القَرار مَحفوظ لِلطَّلَب، فَنِداء RequireTenantAdmin
        // بَعدَه لا يُكَلِّف استِعلاماً ثانِياً.
        if (!await Guard.CanAdministerAsync(Slug)) return;
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is null) return;
        catsText = string.Join('\n', tenant.Categories
            .OrderBy(c => c.SortOrder).ThenBy(c => c.Label)
            .Select(c => $"{c.Slug} | {c.Label} | {c.Icon ?? "home"} | {c.Kind}"));
    }

    // الرَمزانِ مِن مُعجَم TenantConfigCodes المُغلَق — كانا
    // no_categories/bad_categories هُنا و‏empty/format في الاستوديو
    // لِنَفس المَعنى، وغَلَبَت empty/bad_format لِأَنَّها لُغَةُ
    // المَناطِق والخَصائِص على الطَرَفَين أَصلاً.
    string FormatError(string err) => err switch
    {
        "empty" => L["admin.tenant_categories.err_empty"],
        "bad_format" => L["admin.tenant_categories.err_format"],
        _ => err
    };
}
