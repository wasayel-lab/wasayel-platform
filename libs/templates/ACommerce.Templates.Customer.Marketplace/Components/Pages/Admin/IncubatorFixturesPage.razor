@page "/admin/fixtures"
@inject L L
@using ACommerce.Templates.Customer.Marketplace.Services.Incubator

@*
    صَفحَة fixtures المَرحَلَة ٩: تَعرِض ٢٠ مَشروع اختِبار + اختِبار
    PatternMatcher عَلَيها مُباشَرَةً (بِلا LLM). يَكشِف انحِراف القَواعِد.
*@

<RequirePlatformAdmin>
<div class="studio-root">
    <div class="studio-shell">
        <aside class="studio-sidebar">
            <div class="studio-sidebar-brand">
                <img src="_content/ACommerce.Templates.Customer.Marketplace/brand/wasayel-lockup-white.svg"
                     alt="@L["shell.seo.site_name"]" height="30" />
                <span style="font-size:13px;opacity:.65;font-weight:600;">Admin</span>
            </div>
            <nav class="studio-nav">
                <a class="studio-nav-item" href="/admin">
                    <AcIcon Name="building" Size="18" /> @L.Markup("admin.nav.tenants")@((MarkupString)"\n                ")
                </a>
                <a class="studio-nav-item" href="/admin/monitor">
                    <AcIcon Name="grid" Size="18" /> @L.Markup("admin.nav.monitor")@((MarkupString)"\n                ")
                </a>
                <a class="studio-nav-item active" href="/admin/fixtures">
                    <AcIcon Name="check-circle" Size="18" /> Fixtures
                </a>
                <a class="studio-nav-item" href="/admin/agent">
                    <AcIcon Name="message" Size="18" /> @L.Markup("admin.nav.agent")@((MarkupString)"\n                ")
                </a>
            </nav>
            <div class="studio-sidebar-footer">
                <a href="/studio" class="studio-nav-item">← @L.Markup("admin.nav.my_board")</a>
            </div>
        </aside>

        <div class="studio-main">
            <header class="studio-topbar">
                <h2 class="studio-topbar-title">@L.Markup("admin.fixtures.topbar")</h2>
            </header>
            <div class="studio-content">
                <div class="studio-page-head">
                    <h1>@L.Markup("admin.fixtures.title")</h1>
                    <p>@L.Markup("admin.fixtures.note")</p>
                </div>

                <div class="studio-stats">
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.fixtures.total")</div>
                        <div class="studio-stat-value">@IncubatorFixtures.All.Count</div>
                    </div>
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.fixtures.passed") <AcIcon Name="check" Size="14" /></div>
                        <div class="studio-stat-value" style="color:var(--st-success);">@passed</div>
                    </div>
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.fixtures.drift") <AcIcon Name="x" Size="14" /></div>
                        <div class="studio-stat-value" style="color:var(--st-danger);">@failed</div>
                    </div>
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.fixtures.rate")</div>
                        <div class="studio-stat-value">@(IncubatorFixtures.All.Count > 0 ? passed * 100 / IncubatorFixtures.All.Count : 0)%</div>
                    </div>
                </div>

                <div class="st-section-title">@L.Markup("admin.fixtures.results")</div>
                <div class="studio-list">
                    @foreach (var (f, actual) in results)
                    {
                        var ok = actual.Pattern == f.ExpectedPattern;
                        <div class="studio-list-row" style="cursor:default;">
                            <span class="studio-list-icon" style="@(ok ? "background:#dcfce7;color:#15803d;" : "background:#fee2e2;color:#b91c1c;")">
                                <AcIcon Name="@(ok ? "check" : "x")" Size="14" />
                            </span>
                            <div class="studio-list-body">
                                <strong>@f.Description</strong>
                                <span>
                                    @((MarkupString)"\n                                    ")@L.Markup("admin.fixtures.sector") @f.ExpectedSector · @L.Markup("admin.fixtures.expected") <code>@f.ExpectedPattern</code> ·
                                    @L.Markup("admin.fixtures.actual") <code>@actual.Pattern</code> (@actual.Confidence)
                                </span>
                            </div>
                            <span class="st-chip">@actual.LabelAr</span>
                        </div>
                    }
                </div>

                <div class="st-card" style="margin-top:18px;background:var(--st-line-soft);border:0;font-size:13px;color:var(--st-ink-700);">
                    <AcIcon Name="lightbulb" Size="16" /> @L.Markup("admin.fixtures.llm_hint")@((MarkupString)"\n                ")
                </div>
            </div>
        </div>
    </div>
</div>
</RequirePlatformAdmin>

@code {
    int passed, failed;
    List<(FeasibilityFixture, PatternSuggestion)> results = new();

    protected override void OnInitialized()
    {
        foreach (var f in IncubatorFixtures.All)
        {
            // اِبنِ Answers تَخيُّليَّة مِن النَّمَط المُتَوَقَّع لِفَحص PatternMatcher.
            var answers = AnswersFor(f);
            var actual = PatternMatcher.Match(answers);
            results.Add((f, actual));
            if (actual.Pattern == f.ExpectedPattern) passed++; else failed++;
        }
    }

    // إجابات الاكتِشاف الَّتي تُتَوَقَّع لِنَمَط مُعَيَّن.
    static Dictionary<string, string> AnswersFor(FeasibilityFixture f) => f.ExpectedPattern switch
    {
        "ondemand" => new() { ["sector"] = f.ExpectedSector, ["customer"] = "b2c", ["offer"] = "service",
                              ["payment"] = "oneoff", ["geo"] = "city", ["realtime"] = "yes" },
        "rental"   => new() { ["sector"] = f.ExpectedSector, ["customer"] = "b2c", ["offer"] = "rental",
                              ["payment"] = "oneoff", ["geo"] = "city", ["realtime"] = "no" },
        "marketplace" => new() { ["sector"] = f.ExpectedSector, ["customer"] = "b2c", ["offer"] = "twosided",
                                 ["payment"] = "commission", ["geo"] = "national", ["realtime"] = "no" },
        "classifieds" => new() { ["sector"] = f.ExpectedSector, ["customer"] = "b2c", ["offer"] = "twosided",
                                 ["payment"] = "subscription", ["geo"] = "city", ["realtime"] = "no" },
        _ => new() { ["sector"] = f.ExpectedSector, ["customer"] = "b2c", ["offer"] = "digital",
                     ["payment"] = "subscription", ["geo"] = "global", ["realtime"] = "no" }
    };
}
