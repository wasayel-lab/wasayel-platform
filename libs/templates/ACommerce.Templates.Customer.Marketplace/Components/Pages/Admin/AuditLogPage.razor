@page "/admin/audit"
@page "/admin/audit/{scope}"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AuditLogQueries AuditLog
@inject L L
@using ACommerce.Templates.Customer.Marketplace.Services.Audit

@*
    سِجِلّ التَّدقيق — يُعرَض حَسَب الـ scope (slug تَطبيق أَو "_platform").
    قائِمَة بِكُلّ المُستَأجِرين لِلتَّبديل بَينَهُم.
*@

<RequirePlatformAdmin>
<div class="studio-root">
    <div class="studio-shell">
        <aside class="studio-sidebar">
            <div class="studio-sidebar-brand">
                <img src="_content/ACommerce.Templates.Customer.Marketplace/brand/wasayel-lockup-white.svg"
                     alt="وَسايِل" height="30" />
                <span style="font-size:13px;opacity:.65;font-weight:600;">Admin</span>
            </div>
            <nav class="studio-nav">
                <a class="studio-nav-item" href="/admin">
                    <AcIcon Name="building" Size="18" /> @L.Markup("admin.nav.tenants")@((MarkupString)"\n                ")
                </a>
                <a class="studio-nav-item" href="/admin/monitor">
                    <AcIcon Name="grid" Size="18" /> @L.Markup("admin.nav.monitor")@((MarkupString)"\n                ")
                </a>
                <a class="studio-nav-item" href="/admin/fixtures">
                    <AcIcon Name="check-circle" Size="18" /> Fixtures
                </a>
                <a class="studio-nav-item active" href="/admin/audit">
                    <AcIcon Name="list" Size="18" /> @L.Markup("admin.nav.audit")@((MarkupString)"\n                ")
                </a>
                <a class="studio-nav-item" href="/admin/agent">
                    <AcIcon Name="message" Size="18" /> @L.Markup("admin.nav.agent")@((MarkupString)"\n                ")
                </a>
            </nav>
            <div class="studio-sidebar-footer">
                <a href="/studio" class="studio-nav-item">← @L.Markup("admin.nav.my_board")</a>
            </div>
        </aside>

        <div class="studio-main">
            <header class="studio-topbar">
                <h2 class="studio-topbar-title">@L.Markup("admin.audit.title") · @ScopeLabel</h2>
            </header>
            <div class="studio-content">
                <div class="studio-page-head">
                    <h1>@L.Markup("admin.audit.latest")</h1>
                    <p>@L.Markup("admin.audit.note")</p>
                </div>

                @* اختِيار النِطاق *@
                <div class="st-card" style="display:flex;gap:8px;flex-wrap:wrap;">
                    <span style="font-size:13px;color:var(--st-muted);align-self:center;">@L.Markup("admin.audit.scope")</span>
                    <a class="st-btn @(EffectiveScope == "_platform" ? "st-btn-primary" : "st-btn-ghost")" href="/admin/audit/_platform">@L.Markup("admin.audit.platform")</a>
                    @foreach (var t in tenants)
                    {
                        <a class="st-btn @(EffectiveScope == t.Slug ? "st-btn-primary" : "st-btn-ghost")"
                           href="@($"/admin/audit/{t.Slug}")">@t.Name</a>
                    }
                </div>

                <div class="st-section-title">@entries.Count @L.Markup("admin.audit.entry_unit")</div>
                @if (entries.Count == 0)
                {
                    <div class="st-card" style="text-align:center;padding:36px;color:var(--st-muted);">
                        @((MarkupString)"\n                        ")@L.Markup("admin.audit.empty")@((MarkupString)"\n                    ")
                    </div>
                }
                else
                {
                    <div class="studio-list">
                        @foreach (var e in entries)
                        {
                            <div class="studio-list-row" style="cursor:default;">
                                <span class="studio-list-icon ac-chip-muted" style="font-family:ui-monospace;font-size:12px;">
                                    @e.EntityType[..Math.Min(3, e.EntityType.Length)]
                                </span>
                                <div class="studio-list-body">
                                    <strong>@e.Action</strong>
                                    <span>
                                        @(e.ActorName) · @e.At.ToString("yyyy-MM-dd HH:mm:ss")
                                        @if (!string.IsNullOrEmpty(e.Note)) { <text> · @e.Note</text> }
                                    </span>
                                </div>
                                <code style="font-size:11px;color:var(--st-faint);">@e.EntityId[..Math.Min(8, e.EntityId.Length)]</code>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
</RequirePlatformAdmin>

@code {
    [Parameter] public string? Scope { get; set; }
    string EffectiveScope => string.IsNullOrEmpty(Scope) ? "_platform" : Scope;
    string ScopeLabel => EffectiveScope == "_platform" ? L["admin.audit.platform"] : EffectiveScope;

    IReadOnlyList<AuditEntry> entries = Array.Empty<AuditEntry>();
    IReadOnlyList<ACommerce.Kit.Tenants.Tenant> tenants = Array.Empty<ACommerce.Kit.Tenants.Tenant>();

    protected override async Task OnParametersSetAsync()
    {
        tenants = await Tenants.ListAsync();
        entries = await AuditLog.RecentAsync(EffectiveScope);
    }
}
