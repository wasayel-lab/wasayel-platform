@page "/admin/agent"
@using Microsoft.AspNetCore.Components.Web

@*
    مُضيف صَفحَة الوَكيل الإداريّ — تَصيير ثابِت (SSR) عَمداً، بِلا
    @@rendermode. مُهِمَّتُه الحُكم فَقَط؛ والواجِهَة كُلُّها في
    AgentChatPanel.

    لِماذا انقَسَمَت: كانَت الصَفحَة كُلُّها InteractiveServer، فَكانَ
    HttpContext يَغيب بَعدَ أَوَّل تَصيير وَلا يَبقى لِلحارِس ما يَقرَؤُه.
    وَكانَت — قَبل هذا — بِلا حارِس إطلاقاً: طَلَب مَجهول يَستَخرِج
    سِجِلّ مُحادَثات صاحِب المَنصَّة مَع الوَكيل، ثُمَّ يَفتَح circuit
    يُشَغِّل مِنه AgentToolExecutor على إعدادات المَتاجِر.

    الآن: RequirePlatformAdmin يَحكُم هُنا حَيثُ الـ cookie مَقروء،
    وَالجَزيرَة التَّفاعُلِيَّة لا تُبَثّ إلّا بَعدَ القَبول.
*@

<RequirePlatformAdmin>
    <AgentChatPanel @rendermode="RenderMode.InteractiveServer" />
</RequirePlatformAdmin>
