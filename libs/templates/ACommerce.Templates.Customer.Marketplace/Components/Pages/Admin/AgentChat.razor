@page "/admin/agent"
@using Microsoft.AspNetCore.Components.Web
@inject ACommerce.Templates.Customer.Marketplace.Services.Incubator.StudioAuth StudioAuth

@*
    مُضيف صَفحَة الوَكيل الإداريّ — تَصيير ثابِت (SSR) عَمداً، بِلا
    @@rendermode. مُهِمَّتُه الحُكم فَقَط؛ والواجِهَة كُلُّها في
    AgentChatPanel.

    لِماذا انقَسَمَت: كانَت الصَفحَة كُلُّها InteractiveServer، فَكانَ
    HttpContext يَغيب بَعدَ أَوَّل تَصيير وَلا يَبقى لِلحارِس ما يَقرَؤُه.
    وَكانَت — قَبل هذا — بِلا حارِس إطلاقاً: طَلَب مَجهول يَستَخرِج
    سِجِلّ مُحادَثات صاحِب المَنصَّة مَع الوَكيل، ثُمَّ يَفتَح circuit
    يُشَغِّل مِنه AgentToolExecutor على إعدادات المَتاجِر.

    الآن: RequirePlatformAdmin يَحكُم هُنا حَيثُ الـ cookie مَقروء،
    وَالجَزيرَة التَّفاعُلِيَّة لا تُبَثّ إلّا بَعدَ القَبول.

    ‏2026-10-25 (تَدقيقُ الإطلاق، W8-3 — lens-security-14؛ يُلحَقُ ولا يُعادُ حَرفٌ فَوقَه): وتَحمِلُ الجَزيرَةُ مُعَرِّفَ المُشرِفِ مِن هُنا — حَيثُ
    الـ cookie مَقروء — فَيولَدُ ما يُنشِئُه create_tenant مِلكَه لا يَتيماً يَتَبَنّاه أَقدَمُ مُستَخدِم. والوَسيطُ في واصِفِ المُكَوِّنِ المَحمِيِّ بِـData
    Protection، فَلا يُبَدِّلُه عَميل.
*@

<RequirePlatformAdmin>
    <AgentChatPanel @rendermode="RenderMode.InteractiveServer" AdminUserId="@_adminUserId" />
</RequirePlatformAdmin>

@code {
    Guid? _adminUserId;

    protected override void OnInitialized()
    {
        StudioAuth.Load();
        _adminUserId = StudioAuth.IsAuthenticated ? StudioAuth.UserId : null;
    }
}
