@page "/admin/tenants/{slug}/roles"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantAdminGuard Guard
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantRoleService Roles
@using ACommerce.Kit.Roles

@*
    مُحَرِّر الأَدوار — قائِمَة checklist مِن RoleCatalog. مُصَمِّم المَتجَر
    يَضَع علامَة عَلى الأَدوار المَطلوبَة، يُحَدِّد الافتراضي، ثُمّ يَحفَظ.
    التَخصيص العَميق (إضافَة حُقول مُخَصَّصَة) يَتِم مِن صَفحَة الخَصائِص
    الديناميكِيَّة عَلى scope الدَور.
*@

<RequireTenantAdmin Slug="@Slug">
<div class="acs-page acm-admin">
    @if (tenant is null)
    {
        <AcEmptyState IconName="info" Title="المَتجَر غَير مَوجود" />
    }
    else
    {
        var backHref = From == "tenant" ? $"/{Slug}/r/admin/manage" : $"/admin/tenants/{Slug}";
        <div class="acm-admin-head">
            <div style="display:flex;align-items:center;gap:8px;">
                <a class="ac-btn ac-btn-ghost ac-btn-sm" href="@backHref">
                    <AcIcon Name="arrow-right" Size="16" />
                </a>
                <h1 class="acm-wizard-title" style="margin:0;">أَدوار @tenant.Name</h1>
            </div>
        </div>

        @if (Err is not null) { <AcAlert Variant="danger"  Message="@FormatError(Err)" /> }
        @if (Saved == "1")    { <AcAlert Variant="success" Message="تَمّ الحِفظ." /> }

        <AcCard>
            <ChildContent>
                <h3 style="margin-top:0;">القَوالِب القِياسيَّة</h3>
                <p style="color:var(--ac-text-muted);font-size:13px;margin:0 0 16px;">
                    اختَر الأَدوار الَّتي تَنطَبِق عَلى مَتجَرِكَ. كُلّ دَور
                    يَأتي بِصَلاحِيّات + حُقول بَيانات افتراضِيَّة جاهِزَة.
                    اِحفَظ لِتَطبيق الاختِيارات.
                </p>

                <form method="post" action="@($"/admin/tenants/{Slug}/roles/save")">
                    <div class="acm-role-picklist">
                        @foreach (var tmpl in RoleCatalog.All)
                        {
                            var existing = tenant.Roles.FirstOrDefault(r => r.CatalogSlug == tmpl.Slug);
                            var isPicked = existing is not null;
                            <label class="acm-role-pickcard @(isPicked ? "is-picked" : "")">
                                @* Razor يَتَعامَل مَع checked كَ boolean attr عَبر
                                   conditional rendering لِيَتَجَنَّب gotcha أَنّ
                                   checked="False" يَجعَل الـ checkbox مَفعَّلَة. *@
                                @if (isPicked)
                                {
                                    <input type="checkbox" name="role_@(tmpl.Slug)" value="1" checked />
                                }
                                else
                                {
                                    <input type="checkbox" name="role_@(tmpl.Slug)" value="1" />
                                }
                                <span class="acm-role-pickcard-body">
                                    <strong style="font-size:15px;"><AcIcon Name="@ACommerce.Widgets.AcIconMap.Resolve(tmpl.Icon, "tag")" Size="16" /> @tmpl.Label</strong>
                                    <span>@tmpl.Description</span>
                                    <div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:4px;">
                                        @foreach (var p in tmpl.Permissions)
                                        {
                                            <span class="ac-chip ac-chip-sm" style="font-size:10px;">@p</span>
                                        }
                                    </div>
                                    @if (tmpl.Fields.Count > 0)
                                    {
                                        <small style="display:block;margin-top:6px;color:var(--ac-text-muted);">
                                            بَيانات لِلتَّسجيل: @string.Join("، ", tmpl.Fields.Select(f => f.Label))
                                        </small>
                                    }
                                </span>
                                <label class="acm-role-pickcard-default">
                                    <input type="radio" name="default_role" value="@tmpl.Slug"
                                           checked="@(existing?.IsDefault == true)" />
                                    افتراضي
                                </label>
                            </label>
                        }
                    </div>

                    <div style="display:flex;gap:8px;margin-top:16px;">
                        <a class="ac-btn ac-btn-ghost" href="@($"/admin/tenants/{Slug}")">إلغاء</a>
                        <button type="submit" class="ac-btn ac-btn-primary ac-btn-block">
                            <AcIcon Name="check" Size="18" /> حِفظ
                        </button>
                    </div>
                </form>
            </ChildContent>
        </AcCard>

        @*
            الأَدوار المُؤَلَّفَة — وَثائِق هذا المَتجَر وَحدَه، فَوق
            الكاتالوج لا مَحَلَّه. المُعَلَّق لا يَراه أَيّ مُستَخدِم؛
            الاعتِماد هُنا يَجعَلُه حَيّاً في البَوّابَة والتَسجيل
            والتَصيير بِالطَلَب التالي — بِلا بِناء وبِلا إعادَة تَشغيل.
        *@
        @if (definitions.Count > 0)
        {
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">أَدوار مُؤَلَّفَة لِهذا المَتجَر (@definitions.Count)</h3>
                    <p style="color:var(--ac-text-muted);font-size:13px;margin:0 0 16px;">
                        تُكتَب مِن الوَكيل (<code>define_role</code>) وتُخزَّن
                        <b>مُعَلَّقَة</b>. الاعتِماد قَرار مُشرِف المَنصَّة —
                        وبِه وَحدَه تَظهَر البِطاقَة لِلمُستَخدِمين.
                    </p>
                    <div class="acm-cat-list">
                        @foreach (var d in definitions)
                        {
                            <div class="acm-cat-row">
                                <div style="flex:1;">
                                    <strong>@d.Slug</strong>
                                    <span style="color:var(--ac-text-muted);font-size:12px;display:block;">
                                        @StatusLabel(d.Status) · كَتَبَها @d.CreatedBy ·
                                        @d.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC
                                        @if (d.DecidedBy is not null)
                                        {
                                            <text> · قَرَّرَ @d.DecidedBy</text>
                                        }
                                    </span>
                                </div>
                                @if (d.Status == TenantRoleStatuses.Pending)
                                {
                                    <form method="post" style="display:inline;"
                                          action="@($"/admin/tenants/{Slug}/roles/definitions/{d.Slug}/decide")">
                                        <input type="hidden" name="decision" value="approve" />
                                        <button type="submit" class="ac-btn ac-btn-primary ac-btn-sm">اِعتِماد</button>
                                    </form>
                                    <form method="post" style="display:inline;margin-inline-start:6px;"
                                          action="@($"/admin/tenants/{Slug}/roles/definitions/{d.Slug}/decide")">
                                        <input type="hidden" name="decision" value="reject" />
                                        <button type="submit" class="ac-btn ac-btn-ghost ac-btn-sm">رَفض</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="ac-chip ac-chip-sm">@StatusLabel(d.Status)</span>
                                }
                            </div>
                        }
                    </div>
                </ChildContent>
            </AcCard>
        }

        @if (tenant.Roles.Count > 0)
        {
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">المَفعَّلَة حاليّاً (@tenant.Roles.Count)</h3>
                    <div class="acm-cat-list">
                        @foreach (var r in tenant.Roles.OrderBy(r => r.SortOrder))
                        {
                            <div class="acm-cat-row">
                                <span><AcIcon Name="@ACommerce.Widgets.AcIconMap.Resolve(r.Icon, "user")" Size="24" /></span>
                                <div style="flex:1;">
                                    <strong>@r.Label</strong>
                                    <span style="color:var(--ac-text-muted);font-size:12px;display:block;">
                                        @r.Permissions.Count صَلاحِيَّة · @r.Fields.Count حَقل بَيانات
                                    </span>
                                </div>
                                @if (r.IsDefault) { <span class="ac-chip ac-chip-sm">افتراضي</span> }
                            </div>
                        }
                    </div>
                </ChildContent>
            </AcCard>
        }
    }
</div>
</RequireTenantAdmin>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "err")]   public string? Err { get; set; }
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }
    [SupplyParameterFromQuery(Name = "from")]  public string? From { get; set; }

    Tenant? tenant;

    /// <summary>تَعريفات هذا المَتجَر بِكُلّ حالاتِها — الصَفحَة الوَحيدَة
    /// الَّتي تَرى المُعَلَّق والمَرفوض. بَقِيَّة السُطوح تَرى المُعتَمَد
    /// فَقَط.</summary>
    IReadOnlyList<TenantRoleDefinition> definitions = Array.Empty<TenantRoleDefinition>();

    static string StatusLabel(string s) => s switch
    {
        TenantRoleStatuses.Approved => "مُعتَمَد",
        TenantRoleStatuses.Rejected => "مَرفوض",
        _                           => "مُعَلَّق"
    };

    protected override async Task OnParametersSetAsync()
    {
        // البَوّابَة قَبل أَيّ استِعلام: الرَّفض يَعني ألّا تُحَمَّل
        // بَيانات المَتجَر أَصلاً، لا أَن تُحَمَّل ثُمَّ تُحجَب عَن
        // التَّصيير. القَرار مَحفوظ لِلطَّلَب، فَنِداء RequireTenantAdmin
        // بَعدَه لا يُكَلِّف استِعلاماً ثانِياً.
        if (!await Guard.CanAdministerAsync(Slug)) return;
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is null) return;
        definitions = await Roles.ListAllAsync(Slug);
    }

    static string FormatError(string err) => err switch
    {
        _ => err
    };
}
