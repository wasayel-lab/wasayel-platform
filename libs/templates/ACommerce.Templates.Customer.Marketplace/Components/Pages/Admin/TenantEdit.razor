@page "/admin/tenants/{slug}"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantAdminGuard Guard
@inject L L

@*
    صَفحَة المُستَأجِر الواحِد في لَوحَة التَحَكُّم — تَعرِض المَيتاداتا
    وَتُقَدِّم روابِط لِكُلّ مُحَرِّر فَرعيّ (فِئات/خَصائِص/مُدُن/تَخصيص).
*@

<RequireTenantAdmin Slug="@Slug">
<div class="acs-page acm-admin">
    @if (tenant is null)
    {
        <AcEmptyState IconName="info"
                      Title="@L["admin.tenant.not_found"]"
                      ActionLabel="@L["admin.tenant_edit.back_dashboard"]"
                      ActionHref="/admin" />
    }
    else
    {
        @if (Saved == "1")
        {
            <AcAlert Variant="success" Message="@L["admin.tenant_edit.saved"]" />
        }

        <div class="acm-admin-head">
            <div style="display:flex;align-items:center;gap:12px;">
                <a class="ac-btn ac-btn-ghost ac-btn-sm" href="/admin" aria-label="@L["admin.action.back"]">
                    <AcIcon Name="arrow-right" Size="16" />
                </a>
                <span class="acm-tenant-card-brand" style="background:@tenant.BrandColor;">
                    @(tenant.Name.FirstOrDefault())
                </span>
                <div>
                    <h1 class="acm-wizard-title" style="margin:0;">@tenant.Name</h1>
                    <span style="color:var(--ac-text-muted);font-size:13px;">
                        /@tenant.Slug · @tenant.City
                    </span>
                </div>
            </div>
            <a class="ac-btn ac-btn-ghost" href="@($"/{tenant.Slug}")"
               target="_blank">
                <AcIcon Name="external-link" Size="16" /> @L.Markup("admin.theme.open_tenant")@((MarkupString)"\n            ")
            </a>
        </div>

        <div class="acm-tenant-managers">
            <a class="acm-manager-card" href="@($"/admin/tenants/{Slug}/categories")">
                <span class="acm-manager-icon"><AcIcon Name="tag" Size="24" /></span>
                <div>
                    <strong>@L.Markup("admin.tenant_edit.cat_title")</strong>
                    <span>@tenant.Categories.Count @L.Markup("admin.tenant_edit.cat_unit") @kindCount @L.Markup("admin.tenant_edit.cat_group")</span>
                </div>
                <AcIcon Name="chevron-left" Size="16" />
            </a>

            <a class="acm-manager-card" href="@($"/admin/tenants/{Slug}/attributes")">
                <span class="acm-manager-icon"><AcIcon Name="settings" Size="24" /></span>
                <div>
                    <strong>@L.Markup("admin.tenant_edit.attrs_title")</strong>
                    <span>@L.Markup("admin.tenant_edit.attrs_sub")</span>
                </div>
                <AcIcon Name="chevron-left" Size="16" />
            </a>

            <a class="acm-manager-card" href="@($"/admin/tenants/{Slug}/regions")">
                <span class="acm-manager-icon"><AcIcon Name="map-pin" Size="24" /></span>
                <div>
                    <strong>@L.Markup("admin.tenant_edit.regions_title")</strong>
                    <span>@L.Markup("admin.tenant_edit.regions_sub")</span>
                </div>
                <AcIcon Name="chevron-left" Size="16" />
            </a>

            <a class="acm-manager-card" href="@($"/admin/tenants/{Slug}/roles")">
                <span class="acm-manager-icon"><AcIcon Name="user" Size="24" /></span>
                <div>
                    <strong>@L.Markup("admin.tenant_edit.roles_title")</strong>
                    <span>@(tenant.Roles.Count == 0 ? L["admin.tenant_edit.roles_none"] : $"{tenant.Roles.Count} {L["admin.home.roles_unit"]}")</span>
                </div>
                <AcIcon Name="chevron-left" Size="16" />
            </a>

            <a class="acm-manager-card" href="@($"/admin/tenants/{Slug}/users")">
                <span class="acm-manager-icon"><AcIcon Name="user" Size="24" /></span>
                <div>
                    <strong>@L.Markup("admin.tenant_edit.users_title")</strong>
                    <span>@L.Markup("admin.tenant_edit.users_sub")</span>
                </div>
                <AcIcon Name="chevron-left" Size="16" />
            </a>

            <a class="acm-manager-card" href="@($"/admin/tenants/{Slug}/branding")">
                <span class="acm-manager-icon"
                      style="background:@tenant.BrandColor;color:var(--ac-text-on-dark);">
                    <AcIcon Name="brush" Size="24" />
                </span>
                <div>
                    <strong>@L.Markup("admin.tenant_edit.branding_title")</strong>
                    <span>@L.Markup("admin.tenant_edit.branding_sub")</span>
                </div>
                <AcIcon Name="chevron-left" Size="16" />
            </a>

            @* الهُوِيَّة البَصَرِيَّة كامِلَةً — حُزَم جاهِزَة (رُموز
               ومُتَغايِرات). البِطاقَة الَّتي فَوقَها تُغَيِّر لَون
               العَلامَة وَحدَه؛ هذه تُبَدِّل اللَوحَة والشَكل مَعاً.
               الصَفحَة خَلف بَوّابَة مُشرِف المَنصَّة — والفَرق مَذكور
               هُنا صَراحَةً كَي لا يَبدو الرَفض عُطلاً. *@
            <a class="acm-manager-card" href="@($"/admin/tenants/{Slug}/theme")">
                <span class="acm-manager-icon"
                      style="background:@tenant.BrandColor;color:var(--ac-text-on-dark);">
                    <AcIcon Name="brush" Size="24" />
                </span>
                <div>
                    <strong>@L.Markup("admin.tenant_edit.theme_title")</strong>
                    <span>@L.Markup("admin.tenant_edit.theme_sub")</span>
                </div>
                <AcIcon Name="chevron-left" Size="16" />
            </a>

            <a class="acm-manager-card" href="@($"/admin/tenants/{Slug}/pwa")">
                <span class="acm-manager-icon"
                      style="background:@tenant.BrandColor;color:var(--ac-text-on-dark);">
                    <AcIcon Name="device-mobile" Size="24" />
                </span>
                <div>
                    <strong>@L.Markup("admin.tenant_edit.pwa_title")</strong>
                    <span>@L.Markup("admin.tenant_edit.pwa_sub")</span>
                </div>
                <AcIcon Name="chevron-left" Size="16" />
            </a>
        </div>
    }
</div>
</RequireTenantAdmin>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }

    Tenant? tenant;
    int kindCount;

    protected override async Task OnParametersSetAsync()
    {
        // البَوّابَة قَبل أَيّ استِعلام: الرَّفض يَعني ألّا تُحَمَّل
        // بَيانات المَتجَر أَصلاً، لا أَن تُحَمَّل ثُمَّ تُحجَب عَن
        // التَّصيير. القَرار مَحفوظ لِلطَّلَب، فَنِداء RequireTenantAdmin
        // بَعدَه لا يُكَلِّف استِعلاماً ثانِياً.
        if (!await Guard.CanAdministerAsync(Slug)) return;
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is null) return;
        kindCount = tenant.Categories
            .Where(c => !string.IsNullOrEmpty(c.Kind))
            .Select(c => c.Kind).Distinct().Count();
    }
}
