@page "/admin/tenants/{slug}/plan"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.PlatformBillingQueries Billing
@inject L L
@inject ACommerce.Kit.Payments.Providers.PayPal.PayPalGateway PayPal
@using ACommerce.Kit.Subscriptions
@using ACommerce.Kit.Payments.Providers.PayPal

@*
    باقَةُ المَتجَرِ في **وَسايِل** — يَضبُطُها مُشرِفُ المَنَصَّة وَحدَه.
    ولا دَورَةَ اعتِمادٍ هُنا: القابِضُ هُوَ المُقِرّ، فَلا مَعنى لِأَن
    يَطلُبَ مِن نَفسِه.

    والحالَةُ المَعروضَةُ **مُشتَقَّةٌ مِن الوَقت** لا مَحفوظَة — فَما
    تَراه الشاشَةُ هُوَ ما يَراه الحارِسُ بِالضَبط، ولا وَظيفَةَ
    دَورِيَّةَ بَينَهُما تَتَأَخَّر.
*@

<RequirePlatformAdmin>
<div class="acs-page acm-admin">
    @if (tenant is null)
    {
        <AcEmptyState IconName="info" Title="@L["admin.tenant.not_found"]" />
    }
    else
    {
        <div class="acm-admin-head">
            <div style="display:flex;align-items:center;gap:8px;">
                <a class="ac-btn ac-btn-ghost ac-btn-sm" href="@($"/admin/tenants/{Slug}")">
                    <AcIcon Name="arrow-right" Size="16" />
                </a>
                <h1 class="acm-wizard-title" style="margin:0;">@L.Markup("admin.tenant_plan.heading") @tenant.Name</h1>
            </div>
        </div>

        @if (Err is not null)   { <AcAlert Variant="danger"  Message="@FormatError(Err)" /> }
        @if (Saved == "1")      { <AcAlert Variant="success" Message="@L["admin.tenant_plan.saved"]" /> }

        <AcCard>
            <ChildContent>
                <h3 style="margin-top:0;">@L.Markup("admin.tenant_plan.state_title")</h3>
                <p style="margin:0 0 6px;">
                    <span class="ac-chip ac-chip-sm">@StateLabel</span>
                </p>
                @if (plan is null)
                {
                    <p style="margin:0;font-size:13px;color:var(--ac-text-muted);">
                        @L.Markup("admin.tenant_plan.state_none_hint")
                    </p>
                }
                else
                {
                    <p style="margin:0;font-size:13px;color:var(--ac-text-muted);">
                        @L.Markup("admin.tenant_plan.expires_at") @plan.ExpiresAt.ToString("yyyy-MM-dd") ·
                        @L.Markup("admin.tenant_plan.hidden_at") @HiddenAtText
                    </p>
                    <form method="post" action="@($"/admin/tenants/{Slug}/plan/status")" style="margin-top:10px;">
                        <input type="hidden" name="action" value="@(plan.Status == PlatformPlanStatuses.Stopped ? "resume" : "stop")" />
                        <AcButton Type="submit" Variant="ghost" Size="sm"
                                  Text="@(plan.Status == PlatformPlanStatuses.Stopped ? L["admin.tenant_plan.resume"] : L["admin.tenant_plan.stop"])" />
                    </form>
                }
            </ChildContent>
        </AcCard>

        @*  إنشاءُ خُطَّةِ PayPal — **يُرسَم بِشَرطٍ واحِدٍ: مُزَوِّدٌ
            مُهَيَّأ**. وبِلا تَهيئَةٍ **لا نَموذَجَ إطلاقاً** — لا حَقلٌ
            يُملَأ ثُمَّ يُقال «‏PayPal غَير مُهَيَّأ» بَعدَ النَقر
            (القاعِدَة ١٢).

            **ولِماذا هُنا وقَد كانَت خُطوَةَ لَوحَة**: صَفحَةُ
            المُنتَجات/الخُطَط في لَوحَةِ PayPal **تَعَذَّرَ على المالِكِ
            فَتحُها**، وخُطُواتُ `docs/DEPLOY.md` §٢·ج تَفتَرِضُها.
            فَالواجِهَةُ REST تُنشِئُهُما مِن هُنا، واللَوحَةُ تَصير
            طَريقاً أَوَّلَ لا شَرطاً.

            **والحُقولُ فارِغَةٌ يَملَؤُها المالِك** (القاعِدَة ١٦):
            لا اسمَ باقَةٍ ولا سِعرَ في المُستَودَع. والعُملَةُ وَحدَها
            تَحمِل قيمَةً افتِراضِيَّةً لِأَنَّها **مَقيسَةٌ لا
            مَظنونَة** — والريالُ لَيسَ عُملَةَ مُعامَلَةٍ في PayPal
            إطلاقاً. *@
        @if (PayPal.IsConfigured)
        {
            <form method="post" action="@($"/admin/tenants/{Slug}/plan/paypal-plan")">
                <AcCard>
                    <ChildContent>
                        <h3 style="margin-top:0;">@L.Markup("admin.tenant_plan.paypal_plan_title")</h3>
                        <p style="margin:0 0 10px;font-size:13px;color:var(--ac-text-muted);">
                            @L.Markup("admin.tenant_plan.paypal_plan_hint")
                        </p>

                        @if (BoundPlan is { } b)
                        {
                            <p style="margin:0 0 6px;font-size:13px;">
                                <span class="ac-chip ac-chip-sm">@b.PlanId</span>
                                <span class="ac-chip ac-chip-sm">@b.ProductId</span>
                            </p>
                            <p style="margin:0 0 6px;font-size:13px;color:var(--ac-text-muted);">
                                @b.Name · @b.Amount @b.Currency · @b.IntervalUnit
                            </p>
                            @if (PayPalPlanResource(b.PlanId) is { } resource)
                            {
                                <p style="margin:0 0 10px;font-size:13px;word-break:break-all;">
                                    @L.Markup("admin.tenant_plan.paypal_plan_resource") @resource
                                </p>
                            }
                        }

                        <AcField Label="@L["admin.tenant_plan.paypal_plan_name"]" Required="true">
                            <input type="text" name="name" class="ac-input" required
                                   maxlength="@PayPalCatalogPolicy.MaxNameLength" value="" />
                        </AcField>

                        <AcField Label="@L["admin.tenant_plan.paypal_plan_price"]" Required="true">
                            <input type="number" name="price" class="ac-input" required
                                   min="0" step="0.01" value="" />
                        </AcField>

                        <AcField Label="@L["admin.tenant_plan.paypal_plan_period"]" Required="true">
                            <select name="period" class="ac-input" required>
                                <option value="@PayPalPlanIntervals.Month">@L["admin.tenant_plan.paypal_plan_monthly"]</option>
                                <option value="@PayPalPlanIntervals.Year">@L["admin.tenant_plan.paypal_plan_yearly"]</option>
                            </select>
                        </AcField>

                        <AcField Label="@L["admin.tenant_plan.paypal_plan_currency"]"
                                 Hint="@L["admin.tenant_plan.paypal_plan_currency_hint"]">
                            <select name="currency" class="ac-input">
                                @foreach (var c in PayPalCurrencies.Supported)
                                {
                                    <option value="@c" selected="@(c == PayPalCurrencies.Default)">@c</option>
                                }
                            </select>
                        </AcField>

                        <AcButton Type="submit" Variant="ghost" Size="sm"
                                  Text="@L["admin.tenant_plan.paypal_plan_create"]" />
                    </ChildContent>
                </AcCard>
            </form>
        }

        @*  رابِطُ دَفع PayPal — **يُرسَم بِشَرطَينِ مَعاً**: خُطَّةٌ
            مَذكورَةٌ في تَعريفِ الباقَة (`paypalPlanId`)، ومُزَوِّدٌ
            مُهَيَّأٌ في هذِه النُسخَة. وبِلا أَحَدِهِما **لا بِطاقَة
            إطلاقاً** — لا زِرَّ يَقول «قَريباً» (القاعِدَة ١٢)،
            فَالتَحويلُ البَنكيُّ هُوَ الطَريقُ القائِمُ ولَيسَ
            بَديلاً ناقِصاً. *@
        @if (PayPalPlanId is { Length: > 0 } && PayPal.IsConfigured && plan is not null)
        {
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("admin.tenant_plan.paypal_title")</h3>
                    <p style="margin:0 0 10px;font-size:13px;color:var(--ac-text-muted);">
                        @L.Markup("admin.tenant_plan.paypal_hint")
                    </p>

                    @if (!string.IsNullOrWhiteSpace(plan.PayPalApproveUrl))
                    {
                        <p style="margin:0 0 10px;font-size:13px;word-break:break-all;">
                            <a href="@plan.PayPalApproveUrl" target="_blank" rel="noopener">
                                @plan.PayPalApproveUrl
                            </a>
                        </p>
                    }

                    @if (plan.RenewalCancelledAt is { } cancelled)
                    {
                        <p style="margin:0 0 10px;font-size:13px;">
                            @L.Markup("admin.tenant_plan.paypal_renewal_stopped")
                            @cancelled.ToString("yyyy-MM-dd")
                        </p>
                    }

                    <form method="post" action="@($"/admin/tenants/{Slug}/plan/paypal-link")">
                        <AcButton Type="submit" Variant="ghost" Size="sm"
                                  Text="@L["admin.tenant_plan.paypal_create"]" />
                    </form>
                </ChildContent>
            </AcCard>
        }

        @*  رابِطُ دَفعٍ مَرِن (‏ADR-006) — **يُرسَم بِشَرطَينِ**:
            مُزَوِّدٌ مُهَيَّأ، ووَثيقَةُ باقَةٍ مَضبوطَة. ولا يَحتاج
            `paypalPlanId` إطلاقاً — **وهذا هُوَ المَقصود**: المَبلَغُ
            والمُدَّةُ يُرسَلانِ لَحظَةَ الطَلَب، فَلا خُطَّةَ مُسبَقَةً
            ولا صَفحَةَ لَوحَة.

            **وبِلا باقَةٍ لا بِطاقَة** لا زِرٌّ يَقول «قَريباً»
            (القاعِدَة ١٢): التَمديدُ يُحَرِّكُ تاريخَ وَثيقَةِ الباقَة،
            فَبِلا وَثيقَةٍ لا شَيءَ يُحَرَّك — والرابِطُ كانَ سَيُنتِج
            مالاً يَصِل ولا يُعرَف ماذا يُمَدَّدُ بِه. *@
        @if (PayPal.IsConfigured && plan is not null)
        {
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("admin.tenant_plan.paypal_order_title")</h3>
                    <p style="margin:0 0 10px;font-size:13px;color:var(--ac-text-muted);">
                        @L.Markup("admin.tenant_plan.paypal_order_hint")
                    </p>

                    <form method="post" action="@($"/admin/tenants/{Slug}/plan/paypal-order")">
                        @*  خُطوَةُ المَبلَغِ تَتبَع العُملَةَ المُختارَة:
                            ‏JPY/HUF/TWD بِلا كُسورٍ عِندَ PayPal، و«‏0.5
                            يَن» رَقَمٌ لا وُجودَ لَه. والمَخزونُ صارَ
                            **المَصوغ**، فَلَولا هذِه الخُطوَةُ لَكَتَبَ
                            المُشرِفُ ‏5000.5 ورَأى ‏5001 بَعدَ الحِفظِ
                            بِلا أَن يُقالَ لَه شَيءٌ قَبلَها. *@
                        <AcField Label="@L["admin.tenant_plan.paypal_order_amount"]" Required="true">
                            <input type="number" name="amount" class="ac-input" required
                                   id="pp-order-amount" min="0" step="0.01" value="" />
                        </AcField>

                        <AcField Label="@L["admin.tenant_plan.paypal_order_currency"]"
                                 Hint="@L["admin.tenant_plan.paypal_order_currency_hint"]">
                            @*  وقائِمَةُ العُملاتِ بِلا كُسورٍ تُقرَأُ مِن
                                مَعجَمِها المُغلَقِ ولا تُنسَخ في js. *@
                            <select name="currency" class="ac-input" id="pp-order-currency"
                                    data-whole="@string.Join(",", PayPalCurrencies.WithoutDecimals)">
                                @foreach (var c in PayPalCurrencies.Supported)
                                {
                                    <option value="@c" selected="@(c == PayPalCurrencies.Default)">@c</option>
                                }
                            </select>
                        </AcField>

                        <AcField Label="@L["admin.tenant_plan.paypal_order_days"]" Required="true"
                                 Hint="@L["admin.tenant_plan.paypal_order_days_hint"]">
                            <input type="number" name="days" class="ac-input" required
                                   min="1" max="@PayPalOrderPolicy.MaxDays" value="" />
                        </AcField>

                        <AcField Label="@L["admin.tenant_plan.paypal_order_description"]">
                            <input type="text" name="description" class="ac-input"
                                   maxlength="@PayPalOrderPolicy.MaxDescriptionLength" value="" />
                        </AcField>

                        <AcButton Type="submit" Variant="ghost" Size="sm"
                                  Text="@L["admin.tenant_plan.paypal_order_create"]" />
                    </form>
                    <script>
                        (function () {
                            var sel = document.getElementById('pp-order-currency');
                            var amt = document.getElementById('pp-order-amount');
                            if (!sel || !amt) return;
                            var whole = (sel.getAttribute('data-whole') || '').split(',');
                            function sync() { amt.step = whole.indexOf(sel.value) >= 0 ? '1' : '0.01'; }
                            sel.addEventListener('change', sync);
                            sync();
                        })();
                    </script>

                    <h3 style="margin:18px 0 6px;">@L.Markup("admin.tenant_plan.paypal_order_list")</h3>
                    @if (orders.Count == 0)
                    {
                        <p style="margin:0;font-size:13px;color:var(--ac-text-muted);">
                            @L.Markup("admin.tenant_plan.paypal_order_none")
                        </p>
                    }
                    else
                    {
                        @foreach (var o in orders)
                        {
                            <div style="border-top:1px solid var(--ac-border);padding-top:10px;margin-top:10px;">
                                <p style="margin:0 0 4px;font-size:13px;">
                                    <span class="ac-chip ac-chip-sm">@OrderStatusLabel(o.Status)</span>
                                    @o.Amount @o.Currency · @o.Days @L.Markup("admin.tenant_plan.paypal_order_days_unit")
                                </p>
                                <p style="margin:0 0 4px;font-size:12px;color:var(--ac-text-muted);word-break:break-all;">
                                    @o.Id · @o.CreatedAt.ToString("yyyy-MM-dd")
                                </p>
                                @if (!string.IsNullOrWhiteSpace(o.ApproveUrl))
                                {
                                    <p style="margin:0 0 6px;font-size:13px;word-break:break-all;">
                                        <a href="@o.ApproveUrl" target="_blank" rel="noopener">@o.ApproveUrl</a>
                                    </p>
                                }
                                @*  «التَقِط الآن» — ولا يُرسَم إلّا لِطَلَبٍ
                                    لَم يُلتَقَط بَعد. زِرٌّ يُرسَم دائِماً
                                    ويَرُدُّ ‏409 مَدخَلٌ يَضُرّ.

                                    **والشَرطُ مُعَرِّفُ الالتِقاطِ مَعَ
                                    الحالَة، ويُقرَأُ مِن النُقطَةِ
                                    نَفسِها** (`CanCaptureNow`): النِداءُ
                                    الناجِحُ يُثَبِّتُ `CaptureId` وتَبقى
                                    الحالَةُ «وافَقَ» حَتّى تَصِلَ
                                    رِسالَةُ `COMPLETED` — فَالحالَةُ
                                    وَحدَها كانَت تُبقي الزِرَّ مَرسوماً
                                    بَعدَ نَجاحِه. *@
                                @if (PayPalOrderPolicy.CanCaptureNow(o))
                                {
                                    <form method="post" action="@($"/admin/tenants/{Slug}/plan/paypal-capture")">
                                        <input type="hidden" name="@PayPalOrderSurfaceRef" value="@o.Id" />
                                        <AcButton Type="submit" Variant="ghost" Size="sm"
                                                  Text="@L["admin.tenant_plan.paypal_order_capture"]" />
                                    </form>
                                    <p style="margin:4px 0 0;font-size:12px;color:var(--ac-text-muted);">
                                        @L.Markup("admin.tenant_plan.paypal_order_capture_hint")
                                    </p>
                                }
                            </div>
                        }
                    }
                </ChildContent>
            </AcCard>
        }

        <form method="post" action="@($"/admin/tenants/{Slug}/plan/save")">
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("admin.tenant_plan.set_title")</h3>

                    <AcField Label="@L["admin.tenant_plan.field_plan"]" Required="true">
                        <select name="plan" class="ac-input" required>
                            @foreach (var d in PlatformPlanCatalog.All)
                            {
                                <option value="@d.Slug" selected="@(plan?.PlanId == d.Slug)">@d.LabelAr</option>
                            }
                        </select>
                    </AcField>

                    <AcField Label="@L["admin.tenant_plan.field_starts"]" Required="true">
                        <input type="date" name="starts" class="ac-input" required
                               value="@((plan?.StartsAt ?? DateTime.UtcNow).ToString("yyyy-MM-dd"))" />
                    </AcField>

                    <AcField Label="@L["admin.tenant_plan.field_expires"]" Required="true">
                        <input type="date" name="expires" class="ac-input" required
                               value="@(plan?.ExpiresAt.ToString("yyyy-MM-dd") ?? "")" />
                    </AcField>

                    <AcField Label="@L["admin.tenant_plan.field_grace"]"
                             Hint="@L["admin.tenant_plan.grace_hint"]">
                        <input type="number" name="grace" class="ac-input" min="0"
                               max="@TenantPlanPolicy.MaxGraceDays"
                               value="@(plan?.GraceDays ?? PlatformPlanCatalog.DefaultGraceDays)" />
                    </AcField>

                    <AcField Label="@L["admin.tenant_plan.field_price"]"
                             Hint="@L["admin.tenant_plan.price_hint"]">
                        <input type="number" name="price" class="ac-input" min="0" step="0.01"
                               value="@(plan?.Price ?? 0m)" />
                    </AcField>
                </ChildContent>
            </AcCard>

            <div style="display:flex;gap:8px;margin-top:16px;">
                <a class="ac-btn ac-btn-ghost" href="@($"/admin/tenants/{Slug}")">@L.Markup("admin.tenant_plan.cancel")</a>
                <button type="submit" class="ac-btn ac-btn-primary ac-btn-block">
                    <AcIcon Name="check" Size="18" /> @L.Markup("admin.tenant_plan.save")
                </button>
            </div>
        </form>
    }
</div>
</RequirePlatformAdmin>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "err")]   public string? Err { get; set; }
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }

    Tenant? tenant;
    TenantPlan? plan;
    PlatformPlanPayPal? bound;
    IReadOnlyList<PayPalOrderRecord> orders = Array.Empty<PayPalOrderRecord>();

    protected override async Task OnParametersSetAsync()
    {
        tenant = await Tenants.FindAsync(Slug);
        plan   = await Billing.PlanAsync(Slug);
        bound  = await Billing.PayPalPlanAsync(plan?.PlanId);
        orders = await Billing.OrdersForAsync(Slug);
    }

    /// <summary>اسمُ حَقلِ المَرجِع — <b>يُقرَأُ مِن المُهايِئِ ولا
    /// يُنسَخ</b>، فَلا يَنجَرِف بَينَ النَموذَجِ والنُقطَة.</summary>
    const string PayPalOrderSurfaceRef =
        ACommerce.Templates.Customer.Marketplace.Billing.PayPalOrderSurface.ReferenceField;

    /// <summary>حالَةُ الطَلَبِ بِالعَرَبِيَّة — مِن القامُوسِ لا مِن
    /// الكود، ومَعجَمٌ مُغلَقٌ يُقرَأُ مِن
    /// <see cref="PayPalOrderStatuses"/>.</summary>
    string OrderStatusLabel(string status) => status switch
    {
        PayPalOrderStatuses.Approved => L["admin.tenant_plan.paypal_status_approved"],
        PayPalOrderStatuses.Captured => L["admin.tenant_plan.paypal_status_captured"],
        PayPalOrderStatuses.Pending  => L["admin.tenant_plan.paypal_status_pending"],
        PayPalOrderStatuses.Denied   => L["admin.tenant_plan.paypal_status_denied"],
        PayPalOrderStatuses.Reversed => L["admin.tenant_plan.paypal_status_reversed"],
        _                            => L["admin.tenant_plan.paypal_status_created"]
    };

    string StateLabel => TenantPlanPolicy.Derive(plan, DateTime.UtcNow) switch
    {
        TenantPlanState.Active    => L["admin.tenant_plan.state_active"],
        TenantPlanState.Grace     => L["admin.tenant_plan.state_grace"],
        TenantPlanState.Suspended => L["admin.tenant_plan.state_suspended"],
        _                         => L["admin.tenant_plan.state_none"]
    };

    string HiddenAtText => TenantPlanPolicy.HiddenAt(plan)?.ToString("yyyy-MM-dd") ?? "—";

    /// <summary>خُطَّةُ PayPal مِن **الباقَة** لا مِن وَثيقَةِ المَتجَر
    /// — الرِبطُ بِالبَيانات لا بِالكود، وباقَةٌ واحِدَةٌ لِخُطَّةٍ
    /// واحِدَة. ومَصدَرانِ لِلقيمَةِ بِقاعِدَةِ تَرجيحٍ **واحِدَةٍ
    /// تَقرَؤُها الشاشَةُ والنُقطَةُ مَعاً**.</summary>
    string? PayPalPlanId => PlatformPlanPayPalBinding.Resolve(
        PlatformPlanCatalog.Find(plan?.PlanId), bound);

    /// <summary>الرِباطُ المَكتوبُ مِن هذِه الشاشَة — يُعرَض
    /// لِيَعرِفَ المُشرِفُ ماذا أَنشَأَ، فَـ«‏P-…» وَحدَه لا يَقول
    /// سِعراً ولا دَورِيَّة.</summary>
    PlatformPlanPayPal? BoundPlan => bound;

    /// <summary>عُنوانُ الخُطَّةِ كَمَورِدٍ في واجِهَةِ PayPal —
    /// بِمُضيفِ البيئَةِ المَضبوطَة، <b>نَصّاً لا رابِطاً يُنقَر</b>
    /// (المَورِدُ يَحتاج رَمزاً، ورابِطٌ يَرُدّ ‏401 مَدخَلٌ يَضُرّ).</summary>
    string? PayPalPlanResource(string planId)
        => PayPalEnvironment.PlanResourceUrl(PayPal.Options.Environment, planId);

    string FormatError(string err) => err switch
    {
        TenantPlanPolicy.PlanUnknown   => L["admin.tenant_plan.err_plan"],
        TenantPlanPolicy.PeriodInvalid => L["admin.tenant_plan.err_period"],
        TenantPlanPolicy.GraceNegative => L["admin.tenant_plan.err_grace"],
        TenantPlanPolicy.PriceNegative => L["admin.tenant_plan.err_price"],
        "tenant_plan_missing"          => L["admin.tenant_plan.err_missing"],
        // بِالمِساحَةِ كامِلَةً: `Billing` هُنا اسمُ الخِدمَةِ المَحقونَة
        // أَعلاه، فَاختِصارُ المِساحَةِ يُحيلُ إلَيها لا إلى المُهايِئ.
        ACommerce.Templates.Customer.Marketplace.Billing.PayPalSurface.LinkUnavailable
            => L["admin.tenant_plan.err_paypal_unavailable"],
        ACommerce.Templates.Customer.Marketplace.Billing.PayPalSurface.LinkRefused
            => L["admin.tenant_plan.err_paypal_link"],

        // خُروقُ نَموذَجِ الخُطَّة — رُموزٌ مِن مَعجَمٍ مُغلَقٍ في
        // `PayPalCatalogPolicy`، ونَصُّها مِن القامُوس لا مِن الكود.
        PayPalCatalogPolicy.PlanSlugEmpty       => L["admin.tenant_plan.err_paypal_plan_slug"],
        PayPalCatalogPolicy.NameEmpty           => L["admin.tenant_plan.err_paypal_plan_name"],
        PayPalCatalogPolicy.NameTooLong         => L["admin.tenant_plan.err_paypal_plan_name_long"],
        PayPalCatalogPolicy.AmountNotPositive   => L["admin.tenant_plan.err_paypal_plan_amount"],
        PayPalCatalogPolicy.CurrencyUnsupported => L["admin.tenant_plan.err_paypal_plan_currency"],
        PayPalCatalogPolicy.IntervalUnknown     => L["admin.tenant_plan.err_paypal_plan_period"],

        // خُروقُ نَموذَجِ رابِطِ الدَفعِ المَرِن (‏ADR-006) — نَفسُ
        // العادَة: رَمزٌ مِن مَعجَمٍ مُغلَقٍ ونَصٌّ مِن القامُوس.
        PayPalOrderPolicy.TenantEmpty         => L["admin.tenant_plan.err_paypal_order_tenant"],
        PayPalOrderPolicy.PlanMissing         => L["admin.tenant_plan.err_paypal_order_plan"],
        PayPalOrderPolicy.AmountNotPositive   => L["admin.tenant_plan.err_paypal_order_amount"],
        PayPalOrderPolicy.CurrencyUnsupported => L["admin.tenant_plan.err_paypal_order_currency"],
        PayPalOrderPolicy.DaysOutOfRange      => L["admin.tenant_plan.err_paypal_order_days"],
        PayPalOrderPolicy.DescriptionTooLong  => L["admin.tenant_plan.err_paypal_order_description"],
        ACommerce.Templates.Customer.Marketplace.Billing.PayPalOrderSurface.OrderRefused
            => L["admin.tenant_plan.err_paypal_order_failed"],
        ACommerce.Templates.Customer.Marketplace.Billing.PayPalOrderSurface.OrderNotFound
            => L["admin.tenant_plan.err_paypal_order_missing"],
        ACommerce.Templates.Customer.Marketplace.Billing.PayPalOrderSurface.CaptureRefused
            => L["admin.tenant_plan.err_paypal_capture"],
        ACommerce.Templates.Customer.Marketplace.Billing.PayPalOrderSurface.OrderSettled
            => L["admin.tenant_plan.err_paypal_order_settled"],
        ACommerce.Templates.Customer.Marketplace.Billing.PayPalOrderSurface.CaptureNotAllowed
            => L["admin.tenant_plan.err_paypal_capture_not_allowed"],

        // **خَطَأُ الاستِحقاقِ يُسَمّى ويُقالُ عِلاجُه** — وهُوَ
        // الاستِثناءُ الوَحيدُ مِن «تُعرَض رِسالَةُ PayPal كَما هي»:
        // نَصُّها إنجِليزيٌّ يَقول **ما وَقَعَ** ولا يَقول **ما يُفعَل**،
        // والعِلاجُ لَيسَ إعداداً يُبحَثُ عَنه في اللَوحَةِ بَل
        // **رِسالَةٌ إلى دَعمِ PayPal بِطَلَبٍ مُحَدَّد**. ويَبلُغُ هذا
        // المَوضِعَ مِن مَسارَين: إنشاءِ الخُطَّةِ وإنشاءِ رابِطِ
        // الدَفع — بِتَصنيفٍ واحِدٍ يَقرَآنِه (`PayPalFailure`).
        PayPalFailure.ReferenceTransactionsDisabled
            => L["admin.tenant_plan.err_paypal_reference_transactions"],

        // وما بَقِيَ **رِسالَةُ PayPal نَفسِها** بِرَمزِها ونَصِّها —
        // تُعرَض كَما هي عَمداً: «فَشِلَ الإنشاء» تُرسِل المُشرِفَ
        // يُخَمِّن، و«‏UNIT_AMOUNT_NOT_ALLOWED» تَقولُ لَه أَينَ يُصلِح.
        _ => err
    };
}
