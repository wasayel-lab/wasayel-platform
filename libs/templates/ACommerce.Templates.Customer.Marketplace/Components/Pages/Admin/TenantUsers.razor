@page "/admin/tenants/{slug}/users"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantAdminQueries TenantAdmin
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantAdminGuard Guard
@inject L L

@*
    إدارَة مُستَخدِمي المَتجَر — قائِمَة مَع الدَور النَّشِط لِكُلّ مُستَخدِم
    + زِرّ مَنح/سَحب صَلاحِيَّة tenant_admin. هذه القَناة المُعتَمَدَة لِتَعيين
    الإداريّين (الـ /me/role لا يَسمَح بِالاختِيار الذاتيّ لِـ admin).
*@

<RequireTenantAdmin Slug="@Slug">
<div class="acs-page acm-admin">
    @if (tenant is null)
    {
        <AcEmptyState IconName="info" Title="@L["admin.tenant.not_found"]" />
    }
    else
    {
        @* زِرّ الرُجوع يَحتَرِم سِياق الدُّخول: لَو جَئنا مِن إدارَة
           المَتجَر (from=tenant) نَعود إلَيها، وإلَّا (افتِراضيّاً)
           نَعود لِصَفحَة ادمن المَنصَّة. *@
        @* و«‏studio» ثالِثَةٌ: صاحِبُ المَتجَرِ يَصِلُ مِن لَوحَةِ
           تَطبيقِه لِيُعَيِّنَ أَوَّلَ مُشرِف، فَيَعودُ إلَيها لا إلى
           لَوحَةِ المَنَصَّة. *@
        string backHref = From switch
        {
            // ‏(‏2026-10-25، تَدقيقُ الإطلاق W8-3 — `lens-dead-doors-6`) كانَ `/{Slug}/r/admin/manage`: لا دَورَ «admin» في كاتالوج، والمَسارُ بِدَورٍ يَقرَأُ كوكي ذلِكَ الدَورِ وَحدَه — فَيَرى المُديرَ مَجهولاً. والمَسارُ بِلا دَورٍ يَقرَأُ أَيَّ جَلسَةٍ لِلمَتجَر (`AuthSession.ResolveCookieBase`).
            "tenant" => AuthSession.LinkFor(Slug, null, "manage"),
            "studio" => $"/studio/apps/{Slug}",
            _        => $"/admin/tenants/{Slug}"
        };
        <div class="acm-admin-head">
            <div style="display:flex;align-items:center;gap:8px;">
                <a class="ac-btn ac-btn-ghost ac-btn-sm" href="@backHref">
                    <AcIcon Name="arrow-right" Size="16" />
                </a>
                <h1 class="acm-wizard-title" style="margin:0;">@L.Markup("admin.tenant_users.title_prefix") @tenant.Name</h1>
            </div>
            <span class="ac-chip ac-chip-sm">@users.Count @L.Markup("admin.tenant_users.count_unit")</span>
        </div>

        @if (Saved == "1") { <AcAlert Variant="success" Message="@L["admin.tenant_users.updated"]" /> }
        @if (!hasAdminRole)
        {
            <AcAlert Variant="warning"
                     Message="@L["admin.tenant_users.no_admin_role"]" />
        }

        @if (users.Count == 0)
        {
            @* المَتجَرُ الجَديدُ يولَدُ بِصِفرِ مُستَخدِم: المَصنَعُ يَضبُطُ
               `OwnerUserId` ولا يُنشِئُ لِلمالِكِ مُستَخدِماً في واجِهَةِ
               مَتجَرِه (‏ADR-032 §٦‑هـ). فَكانَ العُنوانُ وَحدَه يَعِدُ
               بِتَعيينِ أَوَّلِ مُشرِفٍ ولا يَقولُ كَيف — والسَبيلُ قائِم:
               المُستَخدِمُ يولَدُ بِأَوَّلِ دُخولٍ مِن `/{slug}/login`
               (`AuthHandlers.GetOrCreateUserAsync`)، ثُمَّ يَعودُ المالِكُ
               إلى هُنا فَيَمنَحُ نَفسَه. نَصٌّ لا زِرّ: عَدَدُ النَقراتِ
               يُقاسُ قَبلَ أَن يُبنى (موجَزُ الفَجَوات P0-8، ‏2026-10-11). *@
            <AcEmptyState IconName="user" Title="@L["admin.tenant_users.empty"]"
                          Message="@(L.Format("admin.tenant_users.empty_hint", Slug))" />
        }
        else
        {
            @* ‏(‏2026-10-25، تَدقيقُ الإطلاق W8-3 — `brief-P0-8`) والتَلميحُ نَفسُه فَوقَ الجَدوَلِ
               ما دامَ لا يَحمِلُ أَحَدٌ مِن المَسرودينَ `tenant.manage`: كانَ لا يُرسَمُ إلّا
               في المَتجَرِ الخالي، فَمَن سَبَقَه إلى مَتجَرِه بائِعٌ أَو مُشتَرٍ رَأى صُفوفَهم
               بِلا سَطرٍ يَقولُ كَيفَ يَصيرُ لَه صَفّ (‏RELEASE-READINESS §٢·١، التَعَثُّرُ ب).
               والقَرارُ دالَّةُ الحارِسِ نَفسُها (`TenantAdminGuard.HasTenantManage`) لا تَعريفٌ
               ثانٍ — فَالمَتجَرُ بِلا أَدوارٍ (الوَضعُ المَوروث) لا يُرسَمُ لَه. نَصٌّ لا زِرّ. *@
            @if (!anyManager)
            {
                <AcAlert Variant="info" Message="@(L.Format("admin.tenant_users.empty_hint", Slug))" />
            }
            <AcCard>
                <ChildContent>
                    <div class="acm-cat-list">
                        @foreach (var u in users)
                        {
                            var isAdmin = u.ActiveRole == "tenant_admin";
                            // ‏المُعَرِّفُ الَّذي دَخَلَ بِه: الهاتِفُ حَيثُ وُجِد، وإلّا البَريد — قاعِدَةُ عَرضِ
                            // `AuthHandlers.GetOrCreateUserAsync` بِعَينِها. كانَ الصَفُّ يَرسُمُ الهاتِفَ وَحدَه،
                            // فَمُستَخدِمُ البَريدِ بِلا مُعَرِّفٍ ظاهِرٍ واسمُه «عُضو جَديد» الحَرفِيّ — وتَلميحُ
                            // الحالَةِ الفارِغَةِ يَقولُ لِلمالِكِ «بِجِوارِ هاتِفِك أَو بَريدِك» (‏2026-10-13).
                            var shownId = string.IsNullOrEmpty(u.Phone) ? u.Email : u.Phone;
                            <div class="acm-cat-row">
                                <span style="font-size:24px;"><AcIcon Name="@(isAdmin ? "people" : "user")" Size="24" /></span>
                                <div style="flex:1;min-width:0;">
                                    <strong>@u.FullName</strong>
                                    <span style="color:var(--ac-text-muted);font-size:12px;display:block;direction:ltr;">
                                        @shownId
                                    </span>
                                    @if (!string.IsNullOrEmpty(u.ActiveRole))
                                    {
                                        <span style="color:var(--ac-text-muted);font-size:11px;display:block;">@((MarkupString)"\n                                            ")@L.Markup("admin.tenant_users.role_label") @RoleLabel(u.ActiveRole)
                                        </span>
                                    }
                                </div>
                                @if (hasAdminRole)
                                {
                                    @if (isAdmin)
                                    {
                                        <form method="post"
                                              action="@($"/admin/tenants/{Slug}/users/{u.Id}/revoke-admin")"
                                              style="margin:0;">
                                            <button type="submit" class="ac-btn ac-btn-ghost ac-btn-sm">@((MarkupString)"\n                                                ")@L.Markup("admin.tenant_users.revoke")@((MarkupString)"\n                                            ")
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post"
                                              action="@($"/admin/tenants/{Slug}/users/{u.Id}/grant-admin")"
                                              style="margin:0;">
                                            <button type="submit" class="ac-btn ac-btn-primary ac-btn-sm">
                                                <AcIcon Name="check" Size="14" /> @L.Markup("admin.tenant_users.grant")@((MarkupString)"\n                                            ")
                                            </button>
                                        </form>
                                    }
                                }
                            </div>
                        }
                    </div>
                </ChildContent>
            </AcCard>
        }
    }
</div>
</RequireTenantAdmin>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    Tenant? tenant;
    List<User> users = new();
    bool hasAdminRole;
    bool anyManager;

    protected override async Task OnParametersSetAsync()
    {
        // البَوّابَة قَبل أَيّ استِعلام: الرَّفض يَعني ألّا تُحَمَّل
        // بَيانات المَتجَر أَصلاً، لا أَن تُحَمَّل ثُمَّ تُحجَب عَن
        // التَّصيير. القَرار مَحفوظ لِلطَّلَب، فَنِداء RequireTenantAdmin
        // بَعدَه لا يُكَلِّف استِعلاماً ثانِياً.
        if (!await Guard.CanAdministerAsync(Slug)) return;
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is null) return;
        hasAdminRole = tenant.Roles.Any(r => r.CatalogSlug == "tenant_admin");
        users = (await TenantAdmin.UsersAsync(Slug)).ToList();
        anyManager = users.Any(u => Services.TenantAdminGuard.HasTenantManage(tenant, u));
    }

    string RoleLabel(string slug)
    {
        var role = tenant?.Roles.FirstOrDefault(r => r.Slug == slug);
        return role?.Label ?? slug;
    }
}
