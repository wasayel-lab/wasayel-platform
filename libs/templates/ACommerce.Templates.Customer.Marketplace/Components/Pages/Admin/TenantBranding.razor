@page "/admin/tenants/{slug}/branding"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantAdminGuard Guard
@inject L L

@*
    مُحَرِّر الهُويَّة البَصَريّة — الاسم + الشِعار + اللَون + المَدينَة
    الافتراضيّة + قَناة الدُخول. كَذلك مُعايَنَة بَصَريّة لِلَون.
*@

<RequireTenantAdmin Slug="@Slug">
<div class="acs-page acm-admin">
    @if (tenant is null)
    {
        <AcEmptyState IconName="info" Title="@L["admin.tenant.not_found"]" />
    }
    else
    {
        var backHref = From == "tenant" ? $"/{Slug}/r/admin/manage" : $"/admin/tenants/{Slug}";
        <div class="acm-admin-head">
            <div style="display:flex;align-items:center;gap:8px;">
                <a class="ac-btn ac-btn-ghost ac-btn-sm" href="@backHref">
                    <AcIcon Name="arrow-right" Size="16" />
                </a>
                <h1 class="acm-wizard-title" style="margin:0;">@L.Markup("admin.tenant_branding.heading") @tenant.Name</h1>
            </div>
        </div>

        @if (Err is not null)
        {
            <AcAlert Variant="danger" Message="@FormatError(Err)" />
        }

        <form method="post" action="@($"/admin/tenants/{Slug}/branding/save")">
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("admin.tenant_branding.section_name")</h3>

                    <AcField Label="@L["admin.tenant_branding.field_name"]" Required="true">
                        <input type="text" name="name" required maxlength="60"
                               class="ac-input" value="@tenant.Name" />
                    </AcField>

                    <AcField Label="@L["admin.tenant_branding.field_tagline"]">
                        <input type="text" name="tagline" maxlength="120"
                               class="ac-input" value="@tenant.TagLine" />
                    </AcField>

                    <AcField Label="@L["admin.tenant_branding.field_city"]">
                        <input type="text" name="city" maxlength="40"
                               class="ac-input" value="@tenant.City" />
                    </AcField>
                </ChildContent>
            </AcCard>

            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("admin.tenant_branding.section_color")</h3>

                    <div style="display:flex;align-items:center;gap:16px;margin-bottom:12px;">
                        <span class="acm-tenant-card-brand"
                              style="background:@tenant.BrandColor;width:64px;height:64px;">
                            @(tenant.Name.FirstOrDefault())
                        </span>
                        <div style="flex:1;">
                            <input type="color" name="color" required class="ac-input"
                                   value="@tenant.BrandColor" />
                            <small style="color:var(--ac-text-muted);font-size:11px;direction:ltr;">
                                @tenant.BrandColor
                            </small>
                        </div>
                    </div>
                </ChildContent>
            </AcCard>

            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("admin.tenant_branding.section_auth")</h3>
                    <div class="acm-radio-cards">
                        <label class="acm-radio-card">
                            <input type="radio" name="channel" value="phone"
                                   checked="@(tenant.AuthChannel is not "nafath" and not "email")" />
                            <span class="acm-radio-card-body">
                                <strong><AcIcon Name="phone" Size="16" /> @L.Markup("admin.tenant_branding.auth_phone")</strong>
                                <span>@L.Markup("admin.tenant_branding.auth_phone_hint")</span>
                            </span>
                        </label>
                        <label class="acm-radio-card">
                            <input type="radio" name="channel" value="nafath"
                                   checked="@(tenant.AuthChannel == "nafath")" />
                            <span class="acm-radio-card-body">
                                <strong><AcIcon Name="key" Size="16" /> @L.Markup("admin.tenant_branding.auth_nafath")</strong>
                                <span>@L.Markup("admin.tenant_branding.auth_nafath_hint")</span>
                            </span>
                        </label>
                        <label class="acm-radio-card">
                            <input type="radio" name="channel" value="email"
                                   checked="@(tenant.AuthChannel == "email")" />
                            <span class="acm-radio-card-body">
                                <strong><AcIcon Name="mail" Size="16" /> @L.Markup("admin.tenant_branding.auth_email")</strong>
                                <span>@L.Markup("admin.tenant_branding.auth_email_hint")</span>
                            </span>
                        </label>
                    </div>
                </ChildContent>
            </AcCard>

            @* حُذِفَت بِطاقَةُ «تَعليمات الحَوالَة البَنكِيَّة» يَومَ
               ‏2026-08-23: التاجِرُ لا يَستَلِم حَوالات (قَرارُ المالِك)،
               فَالحَقلُ الَّذي يَعرِض آيبانَه لِمُشتَرٍ لَم يَعُد لَه
               مَعنى. والتَحويلُ صارَ إلى **وَسايِل** ونَصُّ تَعليماتِه
               يُحَرِّرُه مُشرِفُ المَنَصَّة مِن `/admin`. *@

            <div style="display:flex;gap:8px;margin-top:16px;">
                <a class="ac-btn ac-btn-ghost" href="@($"/admin/tenants/{Slug}")">@L.Markup("admin.tenant_branding.cancel")</a>
                <button type="submit" class="ac-btn ac-btn-primary ac-btn-block">
                    <AcIcon Name="check" Size="18" /> @L.Markup("admin.tenant_branding.save")@((MarkupString)"\n                ")
                </button>
            </div>
        </form>
    }
</div>
</RequireTenantAdmin>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "err")]  public string? Err { get; set; }
    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    Tenant? tenant;

    protected override async Task OnParametersSetAsync()
    {
        // البَوّابَة قَبل أَيّ استِعلام: الرَّفض يَعني ألّا تُحَمَّل
        // بَيانات المَتجَر أَصلاً، لا أَن تُحَمَّل ثُمَّ تُحجَب عَن
        // التَّصيير. القَرار مَحفوظ لِلطَّلَب، فَنِداء RequireTenantAdmin
        // بَعدَه لا يُكَلِّف استِعلاماً ثانِياً.
        if (!await Guard.CanAdministerAsync(Slug)) return;
        tenant = await Tenants.FindAsync(Slug);
    }

    string FormatError(string err) => err switch
    {
        "name_required" => L["admin.tenant_branding.err_name"],
        "color_invalid" => L["admin.tenant_branding.err_color"],
        _ => err
    };
}
