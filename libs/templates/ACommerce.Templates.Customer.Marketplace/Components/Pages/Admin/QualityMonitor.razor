@page "/admin/monitor"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.StudioQueries Studio
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject L L
@using ACommerce.Templates.Customer.Marketplace.Services.Incubator

@*
    لوحَة مُراقَبَة جَودَة التَّحاليل + الاستِخدام (Phase 8).
    تَجمَع: عَدَد جَلَسات بِالحالَة، مُتَوَسِّط جَودَة، تَوزيع الباقات،
    أَكثَر الـ prompt versions، آخِر الفَشَلات.
    مَحميَّة بِـ RequirePlatformAdmin.
*@

<RequirePlatformAdmin>
<div class="studio-root">
    <div class="studio-shell">
        <aside class="studio-sidebar">
            <div class="studio-sidebar-brand">
                <img src="_content/ACommerce.Templates.Customer.Marketplace/brand/wasayel-lockup-white.svg"
                     alt="@L["shell.seo.site_name"]" height="30" />
                <span style="font-size:13px;opacity:.65;font-weight:600;">Admin</span>
            </div>
            <nav class="studio-nav">
                <a class="studio-nav-item" href="/admin">
                    <AcIcon Name="building" Size="18" /> @L.Markup("admin.nav.tenants")@((MarkupString)"\n                ")
                </a>
                <a class="studio-nav-item active" href="/admin/monitor">
                    <AcIcon Name="grid" Size="18" /> @L.Markup("admin.nav.monitor")@((MarkupString)"\n                ")
                </a>
                <a class="studio-nav-item" href="/admin/fixtures">
                    <AcIcon Name="check-circle" Size="18" /> Fixtures
                </a>
                <a class="studio-nav-item" href="/admin/agent">
                    <AcIcon Name="message" Size="18" /> @L.Markup("admin.nav.agent")@((MarkupString)"\n                ")
                </a>
            </nav>
            <div class="studio-sidebar-footer">
                <a href="/studio" class="studio-nav-item">← @L.Markup("admin.nav.my_board")</a>
            </div>
        </aside>

        <div class="studio-main">
            <header class="studio-topbar">
                <h2 class="studio-topbar-title">@L.Markup("admin.monitor.topbar")</h2>
            </header>
            <div class="studio-content">
                <div class="studio-page-head">
                    <h1>@L.Markup("admin.monitor.title")</h1>
                    <p>@L.Markup("admin.monitor.subtitle")</p>
                </div>

                <div class="studio-stats">
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.monitor.total_sessions")</div>
                        <div class="studio-stat-value">@total</div>
                    </div>
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.monitor.completed")</div>
                        <div class="studio-stat-value" style="color:var(--st-success);">@completed</div>
                    </div>
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.monitor.analyzing")</div>
                        <div class="studio-stat-value" style="color:var(--st-warning);">@analyzing</div>
                    </div>
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.monitor.failed")</div>
                        <div class="studio-stat-value" style="color:var(--st-danger);">@failed</div>
                    </div>
                </div>

                <div class="studio-stats" style="margin-top:14px;">
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.monitor.avg_quality")</div>
                        <div class="studio-stat-value">@avgQuality%</div>
                        <div class="studio-stat-sub">@L.Markup("admin.monitor.over") @completed @L.Markup("admin.monitor.completed_unit")</div>
                    </div>
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.monitor.studio_users")</div>
                        <div class="studio-stat-value">@users</div>
                    </div>
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.monitor.stores")</div>
                        <div class="studio-stat-value">@stores</div>
                        <div class="studio-stat-sub">@L.Markup("admin.monitor.from_studies")</div>
                    </div>
                    <div class="studio-stat">
                        <div class="studio-stat-label">@L.Markup("admin.monitor.conversion")</div>
                        <div class="studio-stat-value">@(completed > 0 ? $"{stores * 100 / completed}%" : "—")</div>
                        <div class="studio-stat-sub">@L.Markup("admin.monitor.study_to_store")</div>
                    </div>
                </div>

                <div class="st-section-title">@L.Markup("admin.monitor.tier_split")</div>
                <div class="studio-list">
                    @foreach (var (tier, count) in tierCounts.OrderByDescending(x => x.Value))
                    {
                        var l = TierCatalog.For(tier);
                        var pct = users > 0 ? count * 100 / users : 0;
                        <div class="studio-list-row" style="cursor:default;">
                            <span class="st-chip">@l.LabelAr</span>
                            <div class="studio-list-body">
                                <strong>@count @L.Markup("admin.monitor.user_unit")</strong>
                                @* العُملَة مِن المُنَسِّق لا مِن المِفتاح (‏docs/I18N.md §٢-ب).
                                   و`L.Format` لا `L.Markup(key, args)`: الثاني يُرَمِّز
                                   الوَسيط فَتَصير «ر.س» مَراجِعَ رَقَمِيَّة، وهو بِعَينِه
                                   ما أَجَّلَ `UpgradePrompt` في المَوجَة الثانِيَة.
                                   والتَكافُؤ صِفريّ بِالقِياس: الباقات ‏99/199/399/999
                                   فَـ`N0` يُعطي الرَقَم نَفسَه بِلا فاصِلَة آلاف. *@
                                <span>@((MarkupString)L.Format("admin.monitor.tier_price", Money.Format(l.MonthlyPriceSar)))</span>
                            </div>
                            <span style="color:var(--st-muted);">@pct%</span>
                        </div>
                    }
                </div>

                <div class="st-section-title">@L.Markup("admin.monitor.prompt_versions")</div>
                <div class="studio-list">
                    @if (promptVersions.Count == 0)
                    {
                        <div class="st-card" style="color:var(--st-muted);text-align:center;">@L.Markup("admin.monitor.no_data")</div>
                    }
                    else
                    {
                        @foreach (var (v, count) in promptVersions.OrderByDescending(x => x.Value))
                        {
                            <div class="studio-list-row" style="cursor:default;">
                                <code style="font-size:12px;background:var(--st-line-soft);padding:2px 8px;border-radius:6px;">@v</code>
                                <div class="studio-list-body"><strong>@count @L.Markup("admin.monitor.session_unit")</strong></div>
                            </div>
                        }
                    }
                </div>

                <div class="st-section-title">@L.Markup("admin.monitor.last_failures")</div>
                @if (recentFailures.Count == 0)
                {
                    <div class="st-card" style="color:var(--st-muted);text-align:center;padding:24px;">
                        @((MarkupString)"\n                        ")@L.Markup("admin.monitor.no_failures") <AcIcon Name="sparkle" Size="16" />
                    </div>
                }
                else
                {
                    <div class="studio-list">
                        @foreach (var s in recentFailures)
                        {
                            <div class="studio-list-row" style="cursor:default;">
                                <span class="studio-list-icon" style="background:#fee2e2;color:#b91c1c;"><AcIcon Name="alert-circle" Size="16" /></span>
                                <div class="studio-list-body">
                                    <strong>@(string.IsNullOrEmpty(s.ProjectDescription) ? L["admin.monitor.no_desc"] : Truncate(s.ProjectDescription, 70))</strong>
                                    <span>@s.UpdatedAt.ToString("yyyy-MM-dd HH:mm") · @Truncate(s.AnalysisError ?? "", 80)</span>
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="st-section-title">@L.Markup("admin.monitor.last_completed")</div>
                <div class="studio-list">
                    @foreach (var s in recentCompleted)
                    {
                        <div class="studio-list-row" style="cursor:default;">
                            <span class="studio-list-icon" style="background:#dcfce7;color:#15803d;"><AcIcon Name="check" Size="16" /></span>
                            <div class="studio-list-body">
                                <strong>@(string.IsNullOrEmpty(s.ProjectDescription) ? L["admin.monitor.no_desc"] : Truncate(s.ProjectDescription, 70))</strong>
                                <span>@s.UpdatedAt.ToString("yyyy-MM-dd HH:mm") · @s.SuggestedPattern</span>
                            </div>
                            <span class="st-chip @QualityChip(s.AnalysisQualityScore)">@s.AnalysisQualityScore%</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</RequirePlatformAdmin>

@code {
    int total, completed, analyzing, failed, users, stores, avgQuality;
    IReadOnlyDictionary<string, int> tierCounts = new Dictionary<string, int>();
    IReadOnlyDictionary<string, int> promptVersions = new Dictionary<string, int>();
    IReadOnlyList<IncubatorSession> recentFailures = Array.Empty<IncubatorSession>();
    IReadOnlyList<IncubatorSession> recentCompleted = Array.Empty<IncubatorSession>();

    protected override async Task OnInitializedAsync()
    {
        var m = await Studio.MonitorAsync();
        total           = m.Total;
        completed       = m.Completed;
        analyzing       = m.Analyzing;
        failed          = m.Failed;
        avgQuality      = m.AvgQuality;
        promptVersions  = m.PromptVersions;
        recentFailures  = m.RecentFailures;
        recentCompleted = m.RecentCompleted;
        users           = m.Users;
        tierCounts      = m.TierCounts;

        // عَدَد المَتاجِر المَبنيَّة مِن جَلَسات تَحليل — مَصدَرُه سِجِلُّ
        // المُستَأجِرين العامّ، فَيُسأَل مِن مالِكِه لا مِن لَوحَةِ
        // المُراقَبَة.
        stores = (await Tenants.ListAsync()).Count(t => t.SourceAnalysisId is not null);
    }

    static string Truncate(string s, int n) => s.Length <= n ? s : s[..n] + "…";

    static string QualityChip(int q) => q >= 80 ? "st-chip-success"
                                      : q >= 60 ? "st-chip" : "st-chip-warning";
}
