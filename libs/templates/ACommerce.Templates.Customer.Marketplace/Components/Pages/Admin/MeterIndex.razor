@page "/admin/meter"
@using System.Globalization
@using ACommerce.Platform.Shared.Metering
@using ACommerce.Templates.Customer.Marketplace.Services.Queries
@inject ACommerce.Templates.Customer.Marketplace.Services.PlatformAdminGuard PlatformGuard
@inject MeterQueries Meter
@inject ACommerce.Kit.Culture.ICultureContext Culture
@inject L L

@*
    العَدُّ الداخِلِيّ — الفِهرِس (‏2026-11-12، الموجَة ١٣ W13-6·٥ — ADR-051 §١٣؛ التَصميم §11).
    لِكُلِّ مَتجَرٍ اليَوم (يَومُ الرِياض): عَمَلِيّاتُه لِكُلِّ وَحدَة، وما لَم يُحسَم بُعدُه (`_unresolved`) والبَذر (`_seed`) مَعدودَينِ لا مَخفِيَّين،
    ورائِدُ الأَعمالِ لَحظَةَ الكِتابَة؛ وسَطرُ المُجَمِّع. والأَرقامُ مِن `MeterQueries`: المَجموعُ حَتّى المُؤَشِّرِ والذَيلُ الخامُّ بَعدَه —
    صادِقَةٌ عَمِلَ المُجَمِّعُ أَم لَم يَعمَل.
    والمَدخَلُ رابِطٌ في `AdminHome.razor` بِجِوارِ لَوحَةِ المُراقَبَة (القاعِدَة ١٢)، والبابُ `RequirePlatformAdmin`، **والبَوّابَةُ قَبلَ الاستِعلام**:
    طَلَبٌ مَجهولٌ لا يُقرَأُ لَه الدَفتَرُ أَصلاً، لا يُقرَأُ ثُمَّ يُحجَب (نَمَطُ `TenantEdit.razor`).
    ‏(‏2026-11-14، مُراجَعَةُ الاكتِمال · W13-6·Z-R1·١ — M6Z-1؛ ADR-051 §١٣ سَطرُه المُؤَرَّخ) **وُلِدَت الصَفَحاتُ الَّتي كانَ الفِهرِسُ يَنتَظِرُها** (البُنودُ ١٩ و٢٠ و٢١):
    خانَةُ رائِدِ الأَعمالِ رابِطٌ إلى `/admin/meter/owners/{id}` لِمُعَرِّفِ الحِسابِ وَحدَه (الحارِسُ نَصٌّ) كَصَفحَةِ المَتجَر، وصَفُّ التَشغيلِ رابِطانِ لا يَتَداخَلان؛
    وقِسمُ «التِقنِيَة» يَعرِضُ حُضورَ اليَومِ لِكُلِّ مَتجَرٍ — ولَو خامِلاً لا عَمَلِيَّةَ لَه — رابِطاً إلى صَفحَتِه، فَلا مَتجَرَ يُبلَغُ بِكِتابَةِ عُنوانِه وَحدَه.
    وسِماتُ `data-meter-*` قَرائِنُ لِلبُرهانِ (`scripts/prove-meter.sh`) بِأَرقامٍ ثابِتَةِ الثَقافَة.
*@

<RequirePlatformAdmin>
<div class="studio-root">
    <div class="studio-shell">
        <aside class="studio-sidebar">
            <div class="studio-sidebar-brand">
                <img src="_content/ACommerce.Templates.Customer.Marketplace/brand/wasayel-lockup-white.svg"
                     alt="@L["shell.seo.site_name"]" height="30" />
            </div>
            <nav class="studio-nav">
                <a class="studio-nav-item" href="/admin">
                    <AcIcon Name="building" Size="18" /> @L.Markup("admin.nav.tenants")
                </a>
                <a class="studio-nav-item" href="/admin/monitor">
                    <AcIcon Name="grid" Size="18" /> @L.Markup("admin.nav.monitor")
                </a>
                <a class="studio-nav-item active" href="/admin/meter">
                    <AcIcon Name="bar-chart" Size="18" /> @L.Markup("admin.nav.meter")
                </a>
            </nav>
            <div class="studio-sidebar-footer">
                <a href="/studio" class="studio-nav-item">← @L.Markup("admin.nav.my_board")</a>
            </div>
        </aside>

        <div class="studio-main">
            <header class="studio-topbar">
                <h2 class="studio-topbar-title">@L.Markup("admin.meter.topbar")</h2>
            </header>
            <div class="studio-content">
                <div class="studio-page-head">
                    <h1>@L.Markup("admin.meter.title")</h1>
                    @if (reading is { State: MeterReadState.Data })
                    {
                        <p>@L.Markup("admin.meter.subtitle", reading.To)</p>
                    }
                </div>

                @if (reading is null || reading.State == MeterReadState.Error)
                {
                    <div data-meter-state="error">
                        <AcAlert Variant="danger" Title="@L["admin.meter.error_title"]" Message="@L["admin.meter.error_body"]" />
                    </div>
                }
                else if (reading.State == MeterReadState.NoLedger)
                {
                    <div data-meter-state="no-ledger">
                        <AcEmptyState IconName="inbox" Title="@L["admin.meter.no_ledger_title"]" Message="@L["admin.meter.no_ledger_body"]" />
                    </div>
                }
                else
                {
                    <div data-meter-state="data">
                        @if (!reading.AggregatorRan)
                        {
                            <div data-meter-agg="absent">
                                <AcAlert Variant="warning" Message="@L["admin.meter.agg_absent"]" />
                            </div>
                        }
                        else
                        {
                            <div data-meter-agg="ran" data-meter-tail="@Num(reading.TailEntries())">
                                <AcAlert Variant="info" Message="@L.Format("admin.meter.agg_ran", Culture.FormatTime(reading.PulledAtUtc!.Value, "yyyy-MM-dd HH:mm"), Num(reading.TailEntries()))" />
                            </div>
                        }

                        <div class="st-section-title">@L.Markup("admin.meter.side_operation")</div>
                        @if (reading.Apps().Count == 0)
                        {
                            <div class="st-card" data-meter-apps="0">@L.Markup("admin.meter.empty_today")</div>
                        }
                        else
                        {
                            <div class="studio-list" data-meter-apps="@Num(reading.Apps().Count)">
                                @foreach (var app in reading.Apps())
                                {
                                    @* ‏(W13-6·Z-R1·١) رابِطانِ لا يَتَداخَلان: السلاجُ إلى صَفحَةِ المَتجَر، ومُعَرِّفُ رائِدِ الأَعمالِ إلى صَفحَتِه. *@
                                    <div class="studio-list-row" style="cursor:default;" data-meter-app="@app">
                                        <span class="studio-list-icon"><AcIcon Name="store" Size="18" /></span>
                                        <div class="studio-list-body">
                                            <a href="/admin/meter/stores/@app"><strong>@app</strong></a>
                                            <span>
                                                @L.Markup("admin.meter.entrepreneur_label")
                                                @foreach (var (value, i) in reading.By(r => r.Entrepreneur, app).Select((e, i) => (e.Value, i)))
                                                {
                                                    if (i > 0) { <text> · </text> }
                                                    if (Guid.TryParse(value, out _))
                                                    {
                                                        <a href="/admin/meter/owners/@value" data-meter-entrepreneur="@value"><code>@value</code></a>
                                                    }
                                                    else
                                                    {
                                                        <code data-meter-entrepreneur="@value">@value</code>
                                                    }
                                                }
                                            </span>
                                            <span data-meter-unresolved="@Num(reading.Unresolved(app))" data-meter-seed="@Num(reading.Seed(app))">
                                                @L.Markup("admin.meter.unresolved_seed", Num(reading.Unresolved(app)), Num(reading.Seed(app)))
                                            </span>
                                        </div>
                                        @foreach (var (unit, entries) in reading.Operations(app))
                                        {
                                            <span class="st-chip" data-meter-unit="@unit" data-entries="@Num(entries)">@UnitLabel(unit) @Num(entries)</span>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @* ‏(‏2026-11-14، W13-6·Z-R1·١ — M6Z-1؛ التَصميم §11) **جانِبُ التِقنِيَة**: كُلُّ مَتجَرٍ لَه سَطرُ حُضورٍ اليَوم — ومِنها الخامِلُ الَّذي لا يُدرِجُه قِسمُ
                           التَشغيل — صَفٌّ يَربِطُ صَفحَتَه بِوَحَداتِ حُضورِه وكَمِّيّاتِها ورائِدِ أَعمالِه لَحظَةَ اللَقطَة. بِسِماتِ `data-meter-presence-*` لا `data-meter-app`
                           ولا `data-meter-unit`، فَما يَقرَؤُه `prove-meter.sh` وصُفوفُ G11 مِن قِسمِ التَشغيلِ لا يَتَغَيَّر. *@
                        <div class="st-section-title">@L.Markup("admin.meter.side_technology")</div>
                        @if (reading.PresenceApps().Count == 0)
                        {
                            <div class="st-card" data-meter-presence-apps="0">@L.Markup("admin.meter.presence_empty_today")</div>
                        }
                        else
                        {
                            <div class="studio-list" data-meter-presence-apps="@Num(reading.PresenceApps().Count)">
                                @foreach (var app in reading.PresenceApps())
                                {
                                    <div class="studio-list-row" style="cursor:default;" data-meter-presence-app="@app">
                                        <span class="studio-list-icon"><AcIcon Name="store" Size="18" /></span>
                                        <div class="studio-list-body">
                                            <a href="/admin/meter/stores/@app"><strong>@app</strong></a>
                                            <span>
                                                @L.Markup("admin.meter.entrepreneur_label")
                                                @foreach (var (value, i) in reading.PresenceEntrepreneurs(app).Select((e, i) => (e, i)))
                                                {
                                                    if (i > 0) { <text> · </text> }
                                                    if (Guid.TryParse(value, out _))
                                                    {
                                                        <a href="/admin/meter/owners/@value" data-meter-presence-entrepreneur="@value"><code>@value</code></a>
                                                    }
                                                    else
                                                    {
                                                        <code data-meter-presence-entrepreneur="@value">@value</code>
                                                    }
                                                }
                                            </span>
                                        </div>
                                        @foreach (var (unit, quantity) in reading.Presence(app))
                                        {
                                            <span class="st-chip" data-meter-presence-unit="@unit" data-quantity="@Num(quantity)">@UnitLabel(unit) @Num(quantity)</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
</RequirePlatformAdmin>

@code {
    MeterReading? reading;

    protected override async Task OnInitializedAsync()
    {
        // البَوّابَةُ قَبلَ أَيِّ استِعلام — والقَرارُ مَحفوظٌ لِلطَّلَب، فَنِداءُ RequirePlatformAdmin بَعدَه لا يُكَلِّفُ استِعلاماً ثانِياً.
        if (!(await PlatformGuard.EvaluateAsync()).Allowed) return;
        reading = await Meter.TodayAsync();
    }

    /// <summary>اسمُ الوَحدَةِ مِن القامُوس، ورَمزُها حينَ لا يَعرِفُها المُعجَم — تُعرَضُ ولا تُبتَلَع.</summary>
    string UnitLabel(string unit)
        => MeterUnitCatalog.Default.Find(unit) is null ? unit : L[MeterUnitCatalog.LabelKey(unit)];

    static string Num(long n) => n.ToString(CultureInfo.InvariantCulture);
}
