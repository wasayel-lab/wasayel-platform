@page "/admin/tenants/{slug}/theme"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantThemeService Themes
@inject L L
@using ACommerce.Kit.Theme

@*
    مُبَدِّل الهُوِيَّة البَصَرِيَّة — ثَلاث حُزَم مُنَسَّقَة، ونَقرَة
    واحِدَة تُطَبِّق إحداها عَلى المَتجَر **فَوراً**: كِتابَة + إبطال
    كاش، والصَفحَة التالِيَة بِالهُوِيَّة الجَديدَة، بِنَفس العَمَلِيَّة
    وبِلا إعادَة بِناء.

    **البَوّابَة بَوّابَة مُشرِف المَنصَّة** لا مُشرِف المَتجَر — بِخِلاف
    بَقِيَّة صَفَحات /admin/tenants/{slug}/*. والسَبَب أَنّ الزِرّ هُنا
    يَنتَهي بِـ«اعتِماد»: هي العَمَلِيَّة الَّتي تَجعَل الثيم مَبثوثاً في
    <head> لِكُلّ زائِر، وهي نَفسُها الَّتي تَحرُسُها نُقطَتا
    theme/propose و theme/{slug}/decide بِـPlatformAdminGuard. صَفحَةٌ
    بِحارِس أَخَفّ مِن نُقطَتِها بابٌ جانِبيّ، لا واجِهَة.

    ولا يُعرَض هُنا مُحَرِّر رُموز حُرّ: ما يُرسَل **اسم حُزمَة**،
    وجِسمُها يُقرَأ مِن ThemePresetCatalog — أَي مِن المُستودَع.
*@

<RequirePlatformAdmin>
<div class="acs-page acm-admin">
    @if (tenant is null)
    {
        <AcEmptyState IconName="info" Title="@(L["admin.theme.not_found"])" />
    }
    else
    {
        <div class="acm-admin-head">
            <div style="display:flex;align-items:center;gap:8px;">
                <a class="ac-btn ac-btn-ghost ac-btn-sm" href="@($"/admin/tenants/{Slug}")"
                   aria-label="@(L["admin.action.back"])">
                    <AcIcon Name="arrow-right" Size="16" />
                </a>
                <h1 class="acm-wizard-title" style="margin:0;">@L.Markup("admin.theme.identity_of") @tenant.Name @L.Markup("admin.theme.identity_visual")</h1>
            </div>
            <a class="ac-btn ac-btn-ghost" href="@($"/{Slug}")" target="_blank">
                <AcIcon Name="external-link" Size="16" /> @L.Markup("admin.theme.open_tenant")@((MarkupString)"\n            ")
            </a>
        </div>

        @if (Err is not null)   { <AcAlert Variant="danger"  Message="@Err" /> }
        @if (Saved is not null) { <AcAlert Variant="success" Message="@Saved" /> }

        <AcCard>
            <ChildContent>
                <h3 style="margin-top:0;">@L.Markup("admin.theme.presets") (@ThemePresetCatalog.Count)</h3>
                <p style="color:var(--ac-text-muted);font-size:13px;margin:0 0 16px;">
                    @((MarkupString)"\n                    ")@L.Markup("admin.theme.preset_note_1") <b>@L.Markup("admin.theme.preset_note_2")</b>@L.Markup("admin.theme.preset_note_3")
                    <b>@L.Markup("admin.theme.preset_note_4")</b>@L.Markup("admin.theme.preset_note_5")@((MarkupString)"\n                ")
                </p>

                <div class="acm-role-picklist">
                    @foreach (var p in ThemePresetCatalog.All)
                    {
                        var isLive = string.Equals(p.Slug, liveSlug, StringComparison.Ordinal);
                        <div class="acm-role-pickcard @(isLive ? "is-picked" : "")">
                            <span class="acm-role-pickcard-body">
                                <strong style="font-size:15px;">
                                    @p.Label.Ar
                                    @if (isLive)
                                    {
                                        <span class="ac-chip ac-chip-sm"
                                              style="font-size:10px;margin-inline-start:6px;">@L.Markup("admin.theme.applied_now")</span>
                                    }
                                </strong>

                                @* مُعايَنَة مُصَغَّرَة: مُرَبَّعات الأَلوان
                                   مَقروءَة مِن الحُزمَة نَفسِها — لا لَون
                                   مَكتوب في هذه الصَفحَة. *@
                                <span style="display:flex;gap:6px;margin-top:8px;flex-wrap:wrap;">
                                    @foreach (var key in SwatchKeys)
                                    {
                                        var v = p.Definition.Tokens.TryGetValue(key, out var raw) ? raw : null;
                                        if (v is not null)
                                        {
                                            <span title="@key"
                                                  style="@($"width:26px;height:26px;border-radius:6px;background:{v};border:1px solid var(--ac-border);display:inline-block;")"></span>
                                        }
                                    }
                                </span>

                                <span style="display:flex;flex-wrap:wrap;gap:4px;margin-top:8px;">
                                    @foreach (var slot in ThemeVariantCatalog.All)
                                    {
                                        var value = p.Definition.Variants.TryGetValue(slot.Key, out var vv)
                                            ? vv : slot.DefaultValue;
                                        <span class="ac-chip ac-chip-sm" style="font-size:10px;">
                                            @SlotLabel(slot.Key): @value
                                        </span>
                                    }
                                </span>
                            </span>

                            <form method="post" action="@($"/admin/tenants/{Slug}/theme/apply")"
                                  style="margin:0;">
                                <input type="hidden" name="preset" value="@p.Slug" />
                                <button type="submit" class="ac-btn ac-btn-primary ac-btn-sm">
                                    <AcIcon Name="check" Size="16" /> @L.Markup("admin.theme.apply")@((MarkupString)"\n                                ")
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </ChildContent>
        </AcCard>

        <AcCard>
            <ChildContent>
                <h3 style="margin-top:0;">@L.Markup("admin.theme.live_now")</h3>
                <div class="acm-cat-list">
                    <div class="acm-cat-row">
                        <div style="flex:1;">
                            <strong>@(liveSlug ?? ThemeCatalog.DefaultSlug)</strong>
                            <span style="color:var(--ac-text-muted);font-size:12px;display:block;">
                                @((MarkupString)"\n                                ")@L.Markup("admin.theme.active") <code>@live.Slug</code> ·
                                @L.Markup("admin.theme.base") <code>@live["color.primary"]</code> ·
                                @L.Markup("admin.theme.surface") <code>@live["color.surface"]</code> ·
                                @L.Markup("admin.theme.text") <code>@live["color.text"]</code>
                            </span>
                        </div>
                    </div>
                    @foreach (var slot in ThemeVariantCatalog.All)
                    {
                        <div class="acm-cat-row">
                            <div style="flex:1;">
                                <strong>@SlotLabel(slot.Key)</strong>
                                <span style="color:var(--ac-text-muted);font-size:12px;display:block;">
                                    <code>@slot.Key</code> = <code>@live.VariantValue(slot.Key)</code>
                                    @{
                                        var suffix = live.VariantClassSuffix(slot.Key);
                                    }
                                    @if (suffix.Length == 0)
                                    {
                                        <text> · @L.Markup("admin.theme.no_variant")</text>
                                    }
                                    else
                                    {
                                        <text> · @L.Markup("admin.theme.variant_class")</text> <code>@suffix.Trim()</code>
                                    }
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </ChildContent>
        </AcCard>

        @if (definitions.Count > 0)
        {
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("admin.theme.docs") (@definitions.Count)</h3>
                    <p style="color:var(--ac-text-muted);font-size:13px;margin:0 0 16px;">
                        @((MarkupString)"\n                        ")@L.Markup("admin.theme.docs_note_1")<b>@L.Markup("admin.theme.docs_note_2")</b>@L.Markup("admin.theme.docs_note_3")@((MarkupString)"\n                    ")
                    </p>
                    <div class="acm-cat-list">
                        @foreach (var d in definitions)
                        {
                            <div class="acm-cat-row">
                                <div style="flex:1;">
                                    <strong>@d.Slug</strong>
                                    <span style="color:var(--ac-text-muted);font-size:12px;display:block;">
                                        @StatusLabel(d.Status) · @L.Markup("admin.theme.written_by") @d.CreatedBy ·
                                        @d.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC
                                        @if (d.DecidedAt is { } at)
                                        {
                                            <text> · @L.Markup("admin.theme.decided_at") @at.ToString("yyyy-MM-dd HH:mm:ss") UTC</text>
                                        }
                                    </span>
                                </div>
                                <span class="ac-chip ac-chip-sm">@StatusLabel(d.Status)</span>
                            </div>
                        }
                    </div>
                </ChildContent>
            </AcCard>
        }
    }
</div>
</RequirePlatformAdmin>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "err")]   public string? Err { get; set; }
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }

    Tenant? tenant;

    /// <summary>الثيم الفَعّال لِهذا المَتجَر — نَفس ما يُبَثّ في
    /// <c>&lt;head&gt;</c>، مَقروءاً مِن نَفس الخِدمَة. الصَفحَة تَعرِض
    /// الحالَة الحَقيقيَّة لا حِسابَها مِن جَديد.</summary>
    EffectiveTheme live = ThemeCatalog.Default;

    /// <summary>سلاج الوَثيقَة المَبثوثَة، أَو <c>null</c> إن لَم يَكُن
    /// لِلمَتجَر ثيم مُؤَلَّف.</summary>
    string? liveSlug;

    IReadOnlyList<TenantThemeDefinition> definitions = Array.Empty<TenantThemeDefinition>();

    /// <summary>الرُموز الَّتي تُعايَن كَمُرَبَّعات. خَمسَة تَكفي لِلحُكم
    /// مِن ثَلاثَة أَمتار: أَساس، سَطح، خَلفِيَّة، نَصّ، ثانَويّ.</summary>
    static readonly string[] SwatchKeys =
    {
        "color.primary", "color.surface", "color.bg", "color.text", "color.secondary"
    };

    string SlotLabel(string key) => key switch
    {
        ThemeVariantCatalog.PortalRoleCards => L["admin.theme.slot_role_card"],
        ThemeVariantCatalog.ListingCard     => L["admin.theme.slot_listing_card"],
        ThemeVariantCatalog.HeaderBar       => L["admin.theme.slot_header"],
        _                                   => key
    };

    string StatusLabel(string s) => s switch
    {
        TenantThemeStatuses.Approved => L["theme.status.approved"],
        TenantThemeStatuses.Rejected => L["theme.status.rejected"],
        _                            => L["theme.status.pending"]
    };

    protected override async Task OnParametersSetAsync()
    {
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is null) return;

        var set = await Themes.ForAsync(Slug);
        live     = set.Theme;
        liveSlug = set.TenantAuthored?.Slug;

        definitions = await Themes.ListAllAsync(Slug);
    }
}
