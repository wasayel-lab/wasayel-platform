@page "/admin/tenants/{slug}/pwa"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantAdminGuard Guard
@inject L L
@using ACommerce.Kit.Roles

@*
    مُحَرِّر تَطبيقات الـ PWA — لِكُلّ دَور: اِسم مُخَصَّص (يَتَجاوَز
    التَّوليد التِلقائي) + أَيقونَة مُخَصَّصَة (تَتَجاوَز التَّوليد بِلَون
    العَلامَة). الأَيقونَة تُحَوَّل لِـ data: URL وَتُخزَّن مَعَ الدَور
    (سَقف ٢٥٦ كيلوبايت). تَركها فارِغَة = اِستِخدام التَّوليد التِلقائي.

    لِمَتجَر بِلا أَدوار نَعرِض إعدادات افتراضِيَّة عَلى مُستَوى المَتجَر
    (تَحت "(بِلا دَور)").
*@

<RequireTenantAdmin Slug="@Slug">
<div class="acs-page acm-admin">
    @if (tenant is null)
    {
        <AcEmptyState IconName="info" Title="@L["admin.tenant.not_found"]" />
    }
    else
    {
        <div class="acm-admin-head">
            <div style="display:flex;align-items:center;gap:8px;">
                <a class="ac-btn ac-btn-ghost ac-btn-sm" href="@($"/admin/tenants/{Slug}")">
                    <AcIcon Name="arrow-right" Size="16" />
                </a>
                <h1 class="acm-wizard-title" style="margin:0;">@((MarkupString)"\n                    ")@L.Markup("admin.tenant_pwa.heading") @tenant.Name
                </h1>
            </div>
        </div>

        @if (Err is not null) { <AcAlert Variant="danger"  Message="@FormatError(Err)" /> }
        @if (Saved == "1")    { <AcAlert Variant="success" Message="@L["admin.tenant_pwa.saved"]" /> }

        <p style="color:var(--ac-text-muted);font-size:13px;">@((MarkupString)"\n            ")@L.Markup("admin.tenant_pwa.intro")@((MarkupString)"\n        ")
        </p>

        @if (tenant.Roles.Count == 0)
        {
            <AcCard>
                <ChildContent>
                    <AcAlert Variant="info"
                             Message="@($"{L["admin.tenant_pwa.no_roles"]} PWA {L["admin.tenant_pwa.no_roles_mid"]}{Slug}. {L["admin.tenant_pwa.no_roles_hint"]}")" />
                    <a class="ac-btn ac-btn-primary" style="margin-top:12px;"
                       href="@($"/admin/tenants/{Slug}/roles")">
                        <AcIcon Name="people" Size="16" /> @L.Markup("admin.tenant_pwa.setup_roles")@((MarkupString)"\n                    ")
                    </a>
                </ChildContent>
            </AcCard>
        }
        else
        {
            <form method="post" action="@($"/admin/tenants/{Slug}/pwa/save")"
                  enctype="multipart/form-data">
                @foreach (var r in tenant.Roles.OrderBy(r => r.SortOrder))
                {
                    var iconUrl = $"/api/{Slug}/r/{r.Slug}/icon.svg";
                    <AcCard>
                        <ChildContent>
                            <div style="display:flex;gap:16px;align-items:flex-start;">
                                <img src="@iconUrl" alt="@r.Label"
                                     style="width:96px;height:96px;border-radius:18px;
                                            background:#f4f4f5;flex-shrink:0;
                                            border:1px solid var(--ac-border);" />
                                <div style="flex:1;">
                                    <h3 style="margin:0 0 4px;">
                                        <AcIcon Name="@ACommerce.Widgets.AcIconMap.Resolve(r.Icon, "user")" Size="18" /> @r.Label
                                    </h3>
                                    <small style="color:var(--ac-text-muted);direction:ltr;">
                                        /@(Slug)/r/@(r.Slug)/
                                    </small>

                                    <AcField Label="@L["admin.tenant_pwa.field_name"]"
                                             Hint="@($"{L["admin.tenant_pwa.name_hint"]} {tenant.Name} — {r.Label}")">
                                        <input type="text" maxlength="60" class="ac-input"
                                               name="@($"name_{r.Slug}")"
                                               value="@(r.PwaName ?? "")"
                                               placeholder="@($"{tenant.Name} — {r.Label}")" />
                                    </AcField>

                                    <AcField Label="@L["admin.tenant_pwa.field_icon"]"
                                             Hint="@L["admin.tenant_pwa.icon_hint"]">
                                        <input type="file" class="ac-input"
                                               name="@($"icon_{r.Slug}")"
                                               accept="image/png,image/svg+xml,image/webp" />
                                    </AcField>

                                    @if (!string.IsNullOrEmpty(r.PwaIconDataUrl))
                                    {
                                        <label style="display:flex;align-items:center;gap:6px;font-size:13px;">
                                            <input type="checkbox"
                                                   name="@($"clear_{r.Slug}")" value="1" />
                                            @L.Markup("admin.tenant_pwa.clear_icon")@((MarkupString)"\n                                        ")
                                        </label>
                                    }
                                </div>
                            </div>
                        </ChildContent>
                    </AcCard>
                }

                <div style="display:flex;gap:8px;margin-top:16px;">
                    <a class="ac-btn ac-btn-ghost" href="@($"/admin/tenants/{Slug}")">@L.Markup("admin.tenant_pwa.cancel")</a>
                    <button type="submit" class="ac-btn ac-btn-primary ac-btn-block">
                        <AcIcon Name="check" Size="18" /> @L.Markup("admin.tenant_pwa.save")@((MarkupString)"\n                    ")
                    </button>
                </div>
            </form>
        }
    }
</div>
</RequireTenantAdmin>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery(Name = "err")]   public string? Err { get; set; }
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }

    Tenant? tenant;

    protected override async Task OnParametersSetAsync()
    {
        // البَوّابَة قَبل أَيّ استِعلام: الرَّفض يَعني ألّا تُحَمَّل
        // بَيانات المَتجَر أَصلاً، لا أَن تُحَمَّل ثُمَّ تُحجَب عَن
        // التَّصيير. القَرار مَحفوظ لِلطَّلَب، فَنِداء RequireTenantAdmin
        // بَعدَه لا يُكَلِّف استِعلاماً ثانِياً.
        if (!await Guard.CanAdministerAsync(Slug)) return;
        tenant = await Tenants.FindAsync(Slug);
    }

    string FormatError(string err) => err switch
    {
        "icon_too_large" => L["admin.tenant_pwa.err_icon_large"],
        "icon_bad_type"  => L["admin.tenant_pwa.err_icon_type"],
        _ => err
    };
}
