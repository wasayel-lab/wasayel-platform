@page "/{slug}/me/offers"
@page "/{slug}/r/{role}/me/offers"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Accounts
@inject ACommerce.Kit.Culture.ICultureContext Culture
@inject AuthSession Auth
@inject L L

@*
    قائِمَة العُروض الَّتي قَدَّمها هذا المُستَخدِم — pending أَوَّلاً،
    ثُمّ المُقَرَّرَة. مُلاءِم لِلسائِق (Injez) لِيَرى عُروضَه الفَعّالَة.
*@

<div class="acs-page">
    <h1 class="acm-wizard-title">@L.Markup("offers.mine.title")</h1>

    @if (!Auth.IsAuthenticated)
    {
        <AcEmptyState IconName="user" Title="@L["offers.mine.need_login"]"
                      ActionLabel="@L["auth.action.login"]"
                      ActionHref="@AuthSession.LinkFor(Slug, Role, $"login?returnUrl=/{Slug}/me/offers")" />
    }
    else if (offers is null)
    {
        <AcLoadingState />
    }
    else if (offers.Count == 0)
    {
        <AcEmptyState IconName="package" Title="@L["offers.mine.empty_title"]"
                      Message="@L["offers.mine.empty_hint"]"
                      ActionLabel="@L["offers.mine.empty_action"]"
                      ActionHref="@AuthSession.LinkFor(Slug, Role, "explore")" />
    }
    else
    {
        <div class="ac-offer-list">
            @foreach (var o in offers)
            {
                var dist = ListingPickup.TryGetValue(o.ListingId, out var pu) && pu is not null
                    ? ACommerce.Kit.Offers.OfferHelpers.DistanceKm(o.Lat, o.Lng, pu.Value.Lat, pu.Value.Lng)
                    : (double?)null;
                <a class="ac-offer" href="@AuthSession.LinkFor(Slug, Role, $"listings/{o.ListingId}")"
                   style="text-decoration:none;color:inherit;display:block;">
                    <div style="display:flex;justify-content:space-between;align-items:center;">
                        <span class="ac-chip ac-chip-sm">@StatusLabel(Shown(o))</span>
                        <span class="acm-details-price">@((MarkupString)ACommerce.Kit.Culture.Money.Format(o.Price, style: ACommerce.Kit.Culture.MoneyUnitStyle.Name))</span>
                    </div>
                    @if (!string.IsNullOrEmpty(o.Message))
                    {
                        <p style="margin:6px 0 0;font-size:13px;color:var(--ac-text-muted);">@o.Message</p>
                    }
                    <p style="margin:6px 0 0;font-size:11px;color:var(--ac-text-muted);">@((MarkupString)"\n                        ")@L.Markup("offers.mine.submitted_at") @Culture.FormatTime(o.SubmittedAt, "yyyy-MM-dd HH:mm")
                        @if (Live(o))
                        {
                            <span> · @L.Markup("offers.mine.valid_until") @Culture.FormatTime(o.ExpiresAt, "HH:mm")</span>
                        }
                        @if (dist.HasValue)
                        {
                            <span> · <AcIcon Name="map-pin" Size="14" /> @dist.Value.ToString("0.#") @L.Markup("offers.mine.distance_rider")</span>
                        }
                    </p>
                </a>
                @if (Live(o))
                {
                    <form method="post" action="@($"/{Slug}/offers/{o.Id}/withdraw")" style="margin:0;">
                        <button type="submit" class="ac-btn ac-btn-ghost ac-btn-sm">
                            <AcIcon Name="x" Size="14" /> @L.Markup("offers.mine.withdraw")@((MarkupString)"\n                        ")
                        </button>
                    </form>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    List<ACommerce.Kit.Offers.Offer>? offers;
    Dictionary<Guid, (double Lat, double Lng)?> ListingPickup = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsAuthenticated) return;
        // العُروضُ ومَواقِعُ الالتِقاط — نَفسُ التَرتيب (المُنتَهي يُؤَخَّر
        // وإن بَقِيَ Pending في المَخزَن) ونَفسُ قِراءَةِ مَجرى الأَحداث،
        // انتَقَلا إلى AccountQueries.MyOffersAsync.
        now = DateTime.UtcNow;
        var view = await Accounts.MyOffersAsync(Slug, Auth.UserId!.Value, now);
        offers = view.Offers.ToList();
        ListingPickup = view.Pickups.ToDictionary(kv => kv.Key, kv => kv.Value);
    }

    /// <summary>لَحظَةُ القِراءَة — يُرَتِّبُ بِها الاستِعلامُ ويُسَمّي بِها الصَفُّ حالَ العَرض.</summary>
    DateTime now;

    /// <summary>(‏2026-10-30، تَدقيقُ الموجَة ١١ CO8) مُعَلَّقٌ لَم تَنتَهِ مُدَّتُه — لا يَقبَلُه بابُ القَبولِ بَعدَها (<c>OfferExpiry.ExpiredAt</c>)، فَلا يُرسَمُ لَه
    /// «صالِح حَتَّى» ولا «سَحب» بَعدَها، ويُسَمّى «مُنتَهي» لا «قَيد المُراجَعَة».</summary>
    bool Live(ACommerce.Kit.Offers.Offer o)
        => o.Status == ACommerce.Kit.Offers.OfferStatus.Pending && !ACommerce.Kit.Offers.OfferExpiry.ExpiredAt(o, now);

    ACommerce.Kit.Offers.OfferStatus Shown(ACommerce.Kit.Offers.Offer o)
        => o.Status == ACommerce.Kit.Offers.OfferStatus.Pending && !Live(o) ? ACommerce.Kit.Offers.OfferStatus.Expired : o.Status;

    string StatusLabel(ACommerce.Kit.Offers.OfferStatus s) => s switch
    {
        ACommerce.Kit.Offers.OfferStatus.Pending   => L["offers.status.pending"],
        ACommerce.Kit.Offers.OfferStatus.Accepted  => L["offers.status.accepted"],
        ACommerce.Kit.Offers.OfferStatus.Rejected  => L["offers.status.rejected"],
        ACommerce.Kit.Offers.OfferStatus.Withdrawn => L["offers.status.withdrawn"],
        ACommerce.Kit.Offers.OfferStatus.Expired   => L["offers.status.expired"],
        _ => s.ToString()
    };
}
