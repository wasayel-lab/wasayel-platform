@page "/studio/apps/{slug}/tickets/{id:guid}"
@inject Services.Incubator.StudioAuth Auth
@inject Services.Queries.TenantDirectory Tenants
@inject Services.Queries.TenantAdminQueries TenantAdmin
@inject L L
@using ACommerce.Kit.Tenants
@using ACommerce.Kit.Support

@*
    تَفاصيل تَذكَرَة + خَيط الرُدود + نَموذَج رَدّ. صَفّ زَمَنيّ مَع
    تَمييز رُدود الفَريق.
*@

<StudioShell Title="@(L["studio.app_ticket.title"])" Active="home">
    <TopBarActions>
        <a class="st-btn st-btn-ghost" href="@($"/studio/apps/{Slug}/tickets")">@L.Markup("studio.app_ticket.back")</a>
    </TopBarActions>
    <ChildContent>
        @if (ticket is null)
        {
            <div class="st-card">@L.Markup("studio.app_ticket.not_found")</div>
        }
        else
        {
            <div class="studio-page-head">
                <h1>@ticket.Subject</h1>
                <p>@L.Markup("studio.app_ticket.from") @ticket.AuthorName · @ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm") @L.Markup("studio.app_ticket.status_label")
                    <span class="st-chip @StatusChip(ticket.Status)">@StatusLabel(ticket.Status)</span>
                </p>
            </div>

            @if (Replied == "1") { <div class="st-chip st-chip-success" style="margin-bottom:14px;"><AcIcon Name="check" Size="14" /> @L.Markup("studio.app_ticket.replied")</div> }
            @if (Closed == "1")  { <div class="st-chip st-chip-success" style="margin-bottom:14px;"><AcIcon Name="check" Size="14" /> @L.Markup("studio.app_ticket.closed_ok")</div> }

            @* الرِسالَة الأَصلِيَّة *@
            <div class="st-card">
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                    <div style="width:36px;height:36px;border-radius:50%;background:#f1f5f9;display:grid;place-items:center;
                                color:var(--st-ink-700);font-weight:700;">
                        @(ticket.AuthorName.FirstOrDefault())
                    </div>
                    <div>
                        <strong>@ticket.AuthorName</strong>
                        <span style="display:block;font-size:12px;color:var(--st-muted);">
                            @ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </span>
                    </div>
                </div>
                <p style="margin:0;white-space:pre-wrap;line-height:1.8;">@ticket.Body</p>
            </div>

            @* خَيط الرُدود *@
            @foreach (var r in ticket.Replies.OrderBy(r => r.At))
            {
                var staff = r.FromStaff;
                <div class="st-card" style="margin-top:10px;
                            @(staff ? "background:var(--st-primary-50);border-color:var(--st-primary);" : "")">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                        <div style="width:36px;height:36px;border-radius:50%;
                                    background:@(staff ? "var(--st-primary)" : "#f1f5f9");
                                    color:@(staff ? "#fff" : "var(--st-ink-700)");
                                    display:grid;place-items:center;font-weight:700;">
                            @(r.AuthorName.FirstOrDefault())
                        </div>
                        <div>
                            <strong>
                                @r.AuthorName
                                @if (staff) { <span class="st-chip" style="margin-inline-start:6px;">@L.Markup("studio.app_ticket.staff_badge")</span> }
                            </strong>
                            <span style="display:block;font-size:12px;color:var(--st-muted);">
                                @r.At.ToString("yyyy-MM-dd HH:mm")
                            </span>
                        </div>
                    </div>
                    <p style="margin:0;white-space:pre-wrap;line-height:1.8;">@r.Body</p>
                </div>
            }

            @* نَموذَج الرَّدّ + إغلاق *@
            @if (ticket.Status != "closed")
            {
                <div class="st-section-title">@L.Markup("studio.app_tickets.reply_unit")</div>
                <form method="post" action="@($"/studio/apps/{Slug}/tickets/{ticket.Id}/reply")" class="st-card">
                    <textarea class="st-textarea" name="body" rows="4" required
                              placeholder="اكتُب رَدَّكَ هُنا…"></textarea>
                    <div style="display:flex;gap:8px;margin-top:12px;">
                        <button type="submit" class="st-btn st-btn-primary">@L.Markup("studio.app_ticket.reply_send")</button>
                    </div>
                </form>

                <form method="post" action="@($"/studio/apps/{Slug}/tickets/{ticket.Id}/close")" style="margin-top:10px;">
                    <button type="submit" class="st-btn st-btn-ghost">@L.Markup("studio.app_ticket.close_action")</button>
                </form>
            }
            else
            {
                <div class="st-card" style="background:var(--st-line-soft);color:var(--st-muted);text-align:center;">@((MarkupString)"\n                    ")@L.Markup("studio.app_ticket.closed_note")@((MarkupString)"\n                ")
                </div>
            }
        }
    </ChildContent>
</StudioShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] public string? Replied { get; set; }
    [SupplyParameterFromQuery] public string? Closed { get; set; }
    Ticket? ticket;

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        var t = await Tenants.FindAsync(Slug);
        if (t is null || t.OwnerUserId != Auth.UserId!.Value) return;
        // الجَلسَةُ كانَت `LightweightSession` ولا تَكتُب حَرفاً — شَكلٌ
        // كاتِبٌ لِقِراءَةٍ خالِصَة. صارَت قِراءَةً مُعلَنَة.
        ticket = await TenantAdmin.TicketAsync(Slug, Id);
    }

    static string StatusChip(string s) => s switch
    { "open" => "st-chip-danger", "answered" => "st-chip-warning", "closed" => "st-chip-success", _ => "" };
    // غَير ساكِنَة عَمداً: القيَم صارَت في المَعجَم، والمَنفَذ `L` مَحقون
    // في الصَفحَة — والساكِنَة لا تَبلُغُه.
    string StatusLabel(string s) => s switch
    { "open" => L["studio.app_tickets.status_open"], "answered" => L["studio.app_tickets.status_answered"], "closed" => L["studio.app_tickets.status_closed"], _ => s };
}
