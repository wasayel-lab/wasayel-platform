@inject L L
@if (Stage != "verify")
{
    <form method="post" action="@($"/{Slug}/auth/phone/login")">
        @if (!string.IsNullOrEmpty(AsRole))
        {
            <input type="hidden" name="as" value="@AsRole" />
        }
        <AcField Label="@L["auth.phone.label_phone"]" Required="true">
            <input type="tel" name="phone" value="@Phone" required pattern="[0-9]{9,15}"
                   class="ac-input" style="direction:ltr;font-size:16px;"
                   placeholder="7XXXXXXXX" />
        </AcField>
        @if (ErrorMessage is not null)
        {
            <AcAlert Variant="danger">@ErrorMessage</AcAlert>
        }
        <AcButton Type="submit" Variant="primary" Size="lg" Block="true" Text="@L["auth.otp.send_code"]" />
    </form>
}
else
{
    <form method="post" action="@($"/{Slug}/auth/phone/verify")">
        <input type="hidden" name="phone" value="@Phone" />
        @* ومُعَرِّفُ المُحاوَلَةِ الَّتي فَتَحَت الصَفحَة — بِه تُعادُ مَرحَلَةُ الرَمزِ بَعدَ الخَطَإ، لا بِالمَوضوعِ المَكتوب (‏2026-10-25، مُراجَعَةُ تَيّارِ W8-2). *@
        @if (!string.IsNullOrEmpty(AttemptId))
        {
            <input type="hidden" name="attempt" value="@AttemptId" />
        }
        @if (!string.IsNullOrEmpty(AsRole))
        {
            <input type="hidden" name="as" value="@AsRole" />
        }
        <p class="acs-nafath-instruction">@L.Markup("auth.otp.code_sent_to") <strong>@Phone</strong></p>

        @* الـplaceholder نَمَطٌ مُحايِد لا رَمزٌ صالِح: كانَ `123456` —
           وهُوَ بِعَينِه رَمزُ المُزَوِّد الوَهميّ — فَيَقرَؤُه الزائِرُ
           اقتِراحاً لا شَكلاً، ويَبقى مَعروضاً حَتّى مَعَ مُزَوِّدٍ
           فِعليّ. لَوحَةُ رَمزِ التَطوير أَدناه (`DevHint`) هي المَوضِعُ
           الَّذي يُقالُ فيه الرَمزُ الحَقيقيّ، وهي مَشروطَةٌ بِالقَناة. *@
        <AcField Label="@L["auth.otp.label_code"]" Required="true">
            <input type="text" name="code" required minlength="4" maxlength="6"
                   pattern="[0-9]{4,6}" autofocus
                   class="ac-input" style="direction:ltr;font-size:18px;
                          letter-spacing:.4em;text-align:center;"
                   placeholder="000000" />
        </AcField>

        @* الرَمزُ كانَ مَكتوباً ثابِتاً هُنا — يُعرَض لِكُلّ زائِر في كُلّ
           بيئَة. صارَ يُقرَأ مِن القَناة نَفسِها كَما في نَموذَج البَريد:
           مُزَوِّدٌ فِعليّ ← <c>null</c> ← لا لَوحَة. *@
        @if (DevHint is not null)
        {
            <div class="acs-nafath-state acs-nafath-state--ok mt-2" style="display:flex;gap:6px;align-items:center;">
                <AcIcon Name="info" Size="16" />
                <span>@L.Markup("auth.otp.dev_code") <strong>@DevHint</strong></span>
            </div>
        }

        @if (ErrorMessage is not null) { <AcAlert Variant="danger">@ErrorMessage</AcAlert> }

        <AcButton Type="submit" Variant="primary" Size="lg" Block="true" Text="@L["auth.otp.verify"]" />
        <a href="@AuthSession.LinkFor(Slug, AsRole, Via is null ? $"login" : $"login?via={Via}")"
           style="display:block;text-align:center;margin-top:10px;
                  color:var(--ac-text-muted);font-size:13px;text-decoration:none;">@((MarkupString)"\n            ")@L.Markup("auth.phone.change_number")@((MarkupString)"\n        ")
        </a>
    </form>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Stage { get; set; }
    [Parameter] public string? Phone { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string? AsRole { get; set; }
    /// <summary>‏(‏2026-10-29، A2) القَناةُ الثانِيَةُ حينَ تُرسَمُ هذِه الاستِمارَةُ في مَتجَرٍ قَناتُه غَيرُها — يُبقيها رابِطُ «غَيِّر»؛ و<c>null</c> لِقَناةِ المَتجَر.</summary>
    [Parameter] public string? Via { get; set; }
    /// <summary>مُعَرِّفُ المُحاوَلَةِ مِن رابِطِ الصَفحَة (<c>attempt=</c>) — يُرسَلُ مَعَ الرَمزِ فَتُعادُ بِه المَرحَلَةُ بَعدَ الخَطَإ.</summary>
    [Parameter] public string? AttemptId { get; set; }
    /// <summary>كود المُزَوِّد الوَهميّ حينَ يَكون فَعّالاً؛ <c>null</c> مَع
    /// مُزَوِّد فِعليّ (Twilio) فَلا نَعرِض شَيئاً.</summary>
    [Parameter] public string? DevHint { get; set; }
}
