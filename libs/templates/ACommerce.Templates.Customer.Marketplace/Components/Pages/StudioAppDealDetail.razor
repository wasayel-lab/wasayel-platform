@page "/studio/apps/{slug}/deals/{id:guid}"
@inject Services.Incubator.StudioAuth Auth
@inject ACommerce.Kit.Culture.ICultureContext Culture
@inject Services.Queries.TenantDirectory Tenants
@inject Services.Deals.DealsService Deals
@inject L L
@using ACommerce.Kit.Tenants
@using ACommerce.Templates.Customer.Marketplace.Services.Deals

@*
    تَفاصيل صَفقَة + شَريط مَراحِل بَصَريّ + سَجِلّ زَمَنيّ + إجراءات.
*@

<StudioShell Title="@($"{L["studio.deal.title_prefix"]} {Id.ToString()[..8]}")" Active="home">
    <TopBarActions>
        <a class="st-btn st-btn-ghost" href="@($"/studio/apps/{Slug}/deals")">@L.Markup("studio.deal.back_list")</a>
    </TopBarActions>
    <ChildContent>
        @* ─── رَفضُ المَسارِ الإداريِّ يُقرَأُ هُنا لا يُبتلَع (‏2026-10-13، مُراجَعَةُ المَوجَة 3a — G4 (i)) ───
           نِقاطُ `advance` و`cancel` و`dispute` تَرتَدُّ إلى هذِه الصَفحَةِ بِـ`?err=<code>` — وكانَت تَعودُ بِلا مُعامِلٍ يُقرَأ (تَوصيفُه
           `StudioDealRefusalTests`). نَسَقُ شَريطِ `MyDealDetail` بِمَعجَمِ الاستوديو (`DealRefusalTexts.StudioKeyFor`): رَمزٌ لا نَصَّ لَه
           لا يُرسَمُ لَه شَيء، والكَلامُ في القامُوس. *@
        @if (DealRefusalTexts.StudioKeyFor(Err) is { } errKey)
        {
            <div class="st-chip st-chip-danger" style="margin-bottom:14px;">@L.Markup(errKey)</div>
        }
        @if (deal is null)
        {
            <div class="st-card">@L.Markup("studio.deal.not_found")</div>
        }
        else
        {
            <div class="studio-page-head">
                <h1>@(string.IsNullOrEmpty(deal.ListingTitle) ? $"{L["studio.deal.title_prefix"]} {Id.ToString()[..8]}" : deal.ListingTitle)</h1>
                <p>@L.Markup("studio.deal.pattern_label") @deal.Pattern · @L.Markup("studio.deal.created_label") @Culture.FormatTime(deal.CreatedAt, "yyyy-MM-dd HH:mm")</p>
            </div>

            @* شَريط مَراحِل (Stepper) *@
            <div class="st-card">
                <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:space-between;">
                    @foreach (var st in stages)
                    {
                        var done = stages.IndexOf(st) < stages.IndexOf(deal.Stage);
                        var current = st == deal.Stage;
                        <div style="flex:1;min-width:80px;text-align:center;">
                            <div style="width:34px;height:34px;border-radius:50%;display:grid;place-items:center;margin:0 auto 4px;
                                        background:@(current ? "var(--st-primary)" : done ? "var(--st-success)" : "var(--st-line)");
                                        color:#fff;font-weight:700;font-size:14px;">
                                @if (done) { <AcIcon Name="check" Size="16" /> } else { @(stages.IndexOf(st) + 1) }
                            </div>
                            <div style="font-size:12px;color:@(current ? "var(--st-primary)" : "var(--st-muted)");font-weight:@(current ? "700" : "400");">
                                @DealsPolicy.LabelAr(st)
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* الأَطراف والمال *@
            <div class="studio-stats" style="margin-top:14px;">
                <div class="studio-stat">
                    <div class="studio-stat-label">@L.Markup("studio.deal.initiator")</div>
                    <div class="studio-stat-value" style="font-size:15px;">@deal.InitiatorName</div>
                </div>
                <div class="studio-stat">
                    <div class="studio-stat-label">@L.Markup("studio.deal.counterparty")</div>
                    <div class="studio-stat-value" style="font-size:15px;">
                        @(deal.CounterpartyName ?? "—")
                    </div>
                </div>
                <div class="studio-stat">
                    <div class="studio-stat-label">@L.Markup("studio.deal.amount")</div>
                    <div class="studio-stat-value">@((MarkupString)ACommerce.Kit.Culture.Money.Format(deal.AmountSar))</div>
                </div>
                <div class="studio-stat">
                    <div class="studio-stat-label">@L.Markup("studio.deal.status")</div>
                    <div class="studio-stat-value" style="font-size:15px;">@StatusLabel(deal.Status)</div>
                </div>
            </div>

            @* الإجراءات *@
            @if (deal.Status == DealStatus.Active)
            {
                <div class="st-section-title">@L.Markup("studio.deal.actions")</div>
                <div class="st-card" style="display:flex;gap:10px;flex-wrap:wrap;">
                    @* «→ التالي» حَيثُ يُحَرِّكُ المَسارُ الإداريُّ الصَفقَةَ وَحدَه — الدالَّةُ نَفسُها الَّتي تَسأَلُها النُقطَةُ قَبلَ أَيِّ
                       كِتابَة (القاعِدَة ١٢؛ ‏ADR-033 §٦‑ط مُلحَقاً، ‏2026-10-12). كانَ يُرسَمُ لِكُلِّ صَفقَةٍ لَها تالٍ، فَيُرَدُّ بِلا
                       كَلِمَةٍ عِندَ خُطوَتَي المُشتَري (دَفع، استِلام) وصَفقَةِ البَذرَةِ التَجريبِيَّة. *@
                    @if (DealsService.AdminPathCanMove(deal, Auth.UserId!.Value) && DealsPolicy.Next(deal) is { } next)
                    {
                        @* والمَرحَلَةُ الَّتي رُسِمَ عَلَيها الزِرّ — نُقطَتُه تُمَرِّرُها `from:` (‏2026-10-24، تَدقيقُ الإطلاق brief-P0-6؛ ‏ADR-036 §١٣). *@
                        <form method="post" action="@($"/studio/apps/{Slug}/deals/{deal.Id}/advance")"
                              style="display:flex;gap:8px;flex:1;min-width:200px;">
                            <input type="hidden" name="from" value="@deal.Stage" />
                            <input class="st-input" name="note" placeholder="@L["studio.deal.note_placeholder"]" />
                            <button type="submit" class="st-btn st-btn-primary" style="white-space:nowrap;">
                                → @DealsPolicy.LabelAr(next)
                            </button>
                        </form>
                    }
                    <form method="post" action="@($"/studio/apps/{Slug}/deals/{deal.Id}/dispute")"
                          style="display:flex;gap:8px;flex:1;min-width:200px;">
                        <input class="st-input" name="reason" placeholder="@L["studio.deal.dispute_placeholder"]" />
                        <button type="submit" class="st-btn st-btn-ghost" style="white-space:nowrap;color:var(--st-danger);">
                            <AcIcon Name="alert-circle" Size="16" /> @L.Markup("studio.deal.dispute")@((MarkupString)"\n                        ")
                        </button>
                    </form>
                    <form method="post" action="@($"/studio/apps/{Slug}/deals/{deal.Id}/cancel")"
                          style="display:flex;gap:8px;flex:1;min-width:200px;">
                        <input class="st-input" name="reason" placeholder="@L["studio.deal.cancel_placeholder"]" />
                        @* وصَفقَةٌ عَلى فاتورَةِ بَوّابَةٍ مَفتوحَةٍ مُشتَرَكَة لا تُلغى وَحدَها — الإلغاءُ لِلطَلَبِ كُلِّه (‏2026-10-13، G5 M4). *@
                        @if (cancelShared)
                        {
                            <input type="hidden" name="scope" value="order" />
                        }
                        <button type="submit" class="st-btn st-btn-ghost" style="white-space:nowrap;">@((MarkupString)"\n                            ")@L.Markup(cancelShared ? "studio.deal.cancel_order" : "studio.deal.cancel")@((MarkupString)"\n                        ")
                        </button>
                    </form>
                </div>
            }

            @* السِجِلّ الزَّمَنيّ *@
            <div class="st-section-title">@L.Markup("studio.deal.timeline")</div>
            <div class="studio-list">
                @foreach (var e in deal.Timeline.OrderByDescending(x => x.At))
                {
                    <div class="studio-list-row" style="cursor:default;">
                        <span class="studio-list-icon ac-chip-muted" style="font-size:14px;">
                            <AcIcon Name="@ActionIcon(e.Action)" Size="16" />
                        </span>
                        <div class="studio-list-body">
                            <strong>@FormatEvent(e)</strong>
                            <span>
                                @(DealEvent.IsByPlatform(e) ? L["deals.detail.actor_platform"] : e.ActorName ?? "—") · @Culture.FormatTime(e.At, "yyyy-MM-dd HH:mm:ss")
                                @if (!string.IsNullOrEmpty(e.Note)) { <text> · @e.Note</text> }
                            </span>
                        </div>
                    </div>
                }
            </div>

            @* التَّقييم المُتَبادَل (يَظهَر في Reviewed أَو Delivered) *@
            @if (deal.Stage is DealStage.Reviewed or DealStage.Delivered or DealStage.Received
                 && deal.CounterpartyId is not null)
            {
                <div class="st-section-title"><AcIcon Name="star" Size="16" /> @L.Markup("studio.deal.review")</div>
                <div class="st-card">
                    <p style="margin:0 0 12px;font-size:14px;color:var(--st-muted);">@((MarkupString)"\n                        ")@L.Markup("studio.deal.review_hint")@((MarkupString)"\n                    ")
                    </p>
                    <form method="post" action="@($"/studio/apps/{Slug}/deals/{deal.Id}/review")"
                          style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                        <div class="st-field" style="margin:0;">
                            <label class="st-label">@L.Markup("studio.deal.reviewer")</label>
                            <select class="st-input" name="target">
                                <option value="counterparty">@deal.InitiatorName @L.Markup("studio.deal.reviews_verb") @deal.CounterpartyName</option>
                                <option value="initiator">@deal.CounterpartyName @L.Markup("studio.deal.reviews_verb") @deal.InitiatorName</option>
                            </select>
                        </div>
                        <div class="st-field" style="margin:0;">
                            <label class="st-label">@L.Markup("studio.deal.stars")</label>
                            <select class="st-input" name="rating">
                                <option value="5">@L.Markup("deals.detail.rating_5")</option>
                                <option value="4">@L.Markup("deals.detail.rating_4")</option>
                                <option value="3">@L.Markup("deals.detail.rating_3")</option>
                                <option value="2">@L.Markup("deals.detail.rating_2")</option>
                                <option value="1">@L.Markup("deals.detail.rating_1")</option>
                            </select>
                        </div>
                        <div class="st-field" style="margin:0;grid-column:1/-1;">
                            <label class="st-label">@L.Markup("studio.deal.comment")</label>
                            <textarea class="st-textarea" name="body" rows="3" required
                                      placeholder="@L["studio.deal.review_placeholder"]"></textarea>
                        </div>
                        <button type="submit" class="st-btn st-btn-primary" style="grid-column:1/-1;">@((MarkupString)"\n                            ")@L.Markup("studio.deal.review_submit")@((MarkupString)"\n                        ")
                        </button>
                    </form>
                </div>
            }

            @* المَراجِع (PaymentId، ShipmentId، …) *@
            @if (deal.Refs.Count > 0)
            {
                <div class="st-section-title">@L.Markup("studio.deal.refs")</div>
                <div class="st-card">
                    @foreach (var (k, v) in deal.Refs)
                    {
                        <div style="display:flex;justify-content:space-between;padding:4px 0;">
                            <span style="color:var(--st-muted);">@k</span>
                            <code style="font-size:12px;">@v</code>
                        </div>
                    }
                </div>
            }
        }
    </ChildContent>
</StudioShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public Guid Id { get; set; }
    /// <summary>رَمزُ رَفضِ نُقطَةِ المَسارِ الإداريّ — يُحَلُّ نَصّاً بِـ<see cref="DealRefusalTexts.StudioKeyFor"/>، ولا يُرسَمُ لِرَمزٍ لا نَصَّ لَه.</summary>
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }
    Deal? deal;
    List<DealStage> stages = new();
    bool cancelShared;

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        var t = await Tenants.FindAsync(Slug);
        if (t is null || t.OwnerUserId != Auth.UserId!.Value) return;
        deal = await Deals.LoadAsync(Slug, Id);
        // صَفقَةٌ عَلى فاتورَةِ بَوّابَةٍ مَفتوحَةٍ تَدفَعُ لِأَخَواتٍ قائِمَة — بابُها إلغاءُ الطَلَبِ كُلِّه (‏2026-10-13، G5 M4).
        if (deal is not null) cancelShared = !GatewayInvoiceShare.IsValid(deal, await Deals.InvoiceSiblingsAsync(Slug, deal));
        // بِوَعيِ طَريقَةِ الدَفع (‏ADR-033 §٦): صَفقَةُ النَقدِ لا تَرسُمُ خُطوَةَ «دَفع».
        if (deal is not null) stages = DealsPolicy.StagesFor(deal).ToList();
    }

    static string ActionIcon(string action) => action switch
    {
        "created" => "sparkle", "assigned" => "people", "advanced" => "arrow-right",
        "cancelled" => "x", "disputed" => "alert-circle", "note" => "edit",
        "refund" => "refresh", _ => "tag"
    };

    string FormatEvent(DealEvent e) => e.Action switch
    {
        "created"   => L["studio.deal.event_created"],
        "assigned"  => L["studio.deal.event_assigned"],
        DealEvent.BoundAtBirth   => L["studio.deal.event_bound"],
        DealEvent.CashOnDelivery => L["studio.deal.event_cash_on_delivery"],
        DealEvent.GatewayPaid      => L["studio.deal.event_gateway_paid"],
        DealEvent.GatewayRefundDue => L["studio.deal.event_gateway_refund_due"],
        "advanced"  => $"{DealsPolicy.LabelAr(e.StageBefore)} ← {DealsPolicy.LabelAr(e.StageAfter)}",
        "cancelled" => L["studio.deal.event_cancelled"],
        "disputed"  => L["studio.deal.event_disputed"],
        "note"      => L["studio.deal.event_note"],
        _ => e.Action
    };

    string StatusLabel(DealStatus s) => s switch
    {
        DealStatus.Active => L["studio.deal.status_active"], DealStatus.Completed => L["studio.deal.status_completed"],
        DealStatus.Cancelled => L["studio.deal.status_cancelled"], DealStatus.Disputed => L["studio.deal.status_disputed"],
        _ => s.ToString()
    };
}
