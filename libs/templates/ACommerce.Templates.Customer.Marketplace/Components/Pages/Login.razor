@page "/{slug}/login"
@page "/{slug}/r/{role}/login"
@inject ITenantContext Tenant
@inject NavigationManager Nav
@inject AuthSession Auth
@inject IHttpContextAccessor HttpCtx
@inject IServiceProvider Sp
@inject L L

@*
    صَفحَة دُخول SSR. لا Blazor interactivity — كلّ شَيء forms POST عاديّة
    تَصِل إلى endpoints مُسَجَّلَة في Program.cs، والـ endpoint يَضَع cookie
    ويُعيد التَوجيه. هذا يَعمَل بدون JS ويَتَجاوَز مَشاكِل circuit/HttpContext.

    الـ tenant يُحَدِّد القَناة: Ashare = Nafath، Ejar = Phone، وقَناة
    البَريد (email) لِمَن لا هاتِف لَه. لا اختِيار للمُستَخدِم.
*@

@{
    // إن كانَ المُستَخدِم مُسَجَّل دُخول بِالفِعل (cookie صالِح)، أَعِده لِلصَفحَة
    // الرَئيسِيَّة بِـ history.replaceState — يَكسِر الـ trap حَيث الـ back
    // مِن الرَئيسِيَّة يَرجِع إلى /login → /verify. لِأَنّ POST /verify لا
    // يَستَطيع حَذف صَفحات سابِقَة مِن history، نَستَخدِم replace هُنا
    // لِبَعد الدُخول الناجِح.
    if (HttpCtx.HttpContext is { } authCtx && Tenant.IsResolved)
    {
        Auth.SetTenant(Tenant.Slug);
        Auth.Load(authCtx, Tenant.Slug);
    }
    var bouncePath = AuthSession.LinkFor(Slug, Role, "");
}

@if (Auth.IsAuthenticated)
{
    <script>
        (function () {
            try { history.replaceState(null, '', '@bouncePath'); } catch (_) {}
            location.replace('@bouncePath');
        })();
    </script>
    <p style="text-align:center;padding:20px;">@L.Markup("auth.login.redirecting")</p>
}
else if (!Tenant.IsResolved)
{
    <p>@L.Markup("auth.login.tenant_missing")</p>
}
else
{
    <div class="ac-auth-wrap" style="--ac-primary:@Tenant.BrandColor;">
        <div class="ac-auth-card">
            <div class="ac-auth-logo" style="background:@Tenant.BrandColor;">
                <AcIcon Name="@ChannelIcon" Size="24" />
            </div>
            <h1 class="ac-auth-title">@Tenant.Name</h1>
            <p class="ac-auth-sub">@L.Markup("auth.login.sub_prefix") @ChannelLabel</p>

            @{
                // الـ URL يَتَفَوَّق عَلى الـ query: لَو وُجِدَ /r/{role}/login نَتَجاهَل ?as=
                var effectiveRole = !string.IsNullOrEmpty(Role) ? Role : AsRole;
            }
            @if (!ChannelRegistered)
            {
                @* لا قَناةَ مُسَجَّلَة (إنتاجٌ بِلا مُزَوِّدٍ مَضبوط) — لا
                   يُعرَض نَموذَجٌ يَقود إلى رَفض. نَفسُ رِسالَةِ المَسار. *@
                <AcAlert Variant="danger">@ChannelUnavailableMessage</AcAlert>
            }
            else if (Tenant.AuthChannel == "nafath")
            {
                <NafathLoginForm Slug="@Slug" ErrorMessage="@ErrorMessage" Stage="@Stage"
                                 NationalId="@NationalIdValue" AttemptId="@AttemptId" DisplayCode="@DisplayCode"
                                 AsRole="@effectiveRole" DevAuto="@NafathDevAuto" />
            }
            else if (Tenant.AuthChannel == "email")
            {
                <EmailLoginForm Slug="@Slug" ErrorMessage="@ErrorMessage" Stage="@Stage"
                                Email="@EmailValue" AsRole="@effectiveRole"
                                DevHint="@EmailDevHint" />
            }
            else
            {
                <PhoneLoginForm Slug="@Slug" ErrorMessage="@ErrorMessage" Stage="@Stage"
                                Phone="@PhoneValue" AsRole="@effectiveRole"
                                DevHint="@PhoneDevHint" />
            }

            <p class="ac-auth-back">
                <a href="@($"/{Slug}")">@L.Markup("auth.login.back_to") @Tenant.Name</a>
            </p>
        </div>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    /// <summary>الدَور المُختار مِن /r/{role}/login (يَتَفَوَّق عَلى ?as=).</summary>
    [Parameter] public string? Role { get; set; }
    [SupplyParameterFromQuery] public string? Stage { get; set; }
    [SupplyParameterFromQuery] public string? Err { get; set; }
    [SupplyParameterFromQuery(Name = "phone")]    public string? PhoneValue { get; set; }
    [SupplyParameterFromQuery(Name = "email")]    public string? EmailValue { get; set; }
    [SupplyParameterFromQuery(Name = "nid")]      public string? NationalIdValue { get; set; }
    [SupplyParameterFromQuery(Name = "attempt")]  public string? AttemptId { get; set; }
    [SupplyParameterFromQuery(Name = "code")]     public string? DisplayCode { get; set; }
    /// <summary>دَور مَختار مُسبَقاً (مِن صَفحَة /{slug}/r/landing).
    /// يُمَرَّر كَ hidden إلى الـ POST لِيُسَكِّن ActiveRole بَعد التَّوثيق.</summary>
    [SupplyParameterFromQuery(Name = "as")]       public string? AsRole { get; set; }

    string ChannelIcon => Tenant.AuthChannel switch
    {
        "nafath" => "key",
        "email"  => "mail",
        _        => "phone"
    };

    string ChannelLabel => Tenant.AuthChannel switch
    {
        "nafath" => L["auth.channel.nafath"],
        "email"  => L["auth.channel.email_full"],
        _        => L["auth.channel.phone_full"]
    };

    /// <summary>كود المُزَوِّد الوَهميّ إن كانَ هو المُسَجَّل — نَقرَؤُه مِن
    /// القَناة نَفسها لا نَكتُبه ثابِتاً، فَلا تَكذِب الواجِهَة إذا بُدِّل
    /// المُزَوِّد بِـ SMTP. <c>GetService</c> (لا Required) كَي لا تَنكَسِر
    /// صَفحَة الدُخول في مُضيف لَم يُسَجِّل قَناة بَريد أَصلاً.</summary>
    string? EmailDevHint =>
        (Sp.GetService(typeof(ACommerce.Kit.Auth.IEmailOtpChannel))
            as ACommerce.Kit.Auth.IEmailOtpChannel)?.DevHintCode;

    /// <summary>نَفسُ قِراءَة البَريد لِلهاتِف. كانَ الرَمز <b>مَكتوباً
    /// ثابِتاً</b> في <c>PhoneLoginForm</c> (‏<c>123456</c>) فَيُعرَض
    /// لِكُلّ زائِرٍ حَتّى مَع مُزَوِّدٍ فِعليّ — وهو نِصفُ الثَغرَة:
    /// النِصفُ الآخَر أَنَّه كانَ صَحيحاً.</summary>
    string? PhoneDevHint =>
        (Sp.GetService(typeof(ACommerce.Kit.Auth.IOtpChannel))
            as ACommerce.Kit.Auth.IOtpChannel)?.DevHintCode;

    /// <summary>مُحاكي نَفاذ لا يَملِك رَمزاً مَعروضاً — يَملِك
    /// مُوافَقَةً تِلقائِيَّة. فَالعَلامَةُ هي ما يُقرَأ.</summary>
    bool NafathDevAuto =>
        Sp.GetService(typeof(ACommerce.Kit.Auth.INafathChannel))
            is ACommerce.Kit.Auth.IDevelopmentStubChannel;

    /// <summary>أَمُسَجَّلَةٌ قَناةُ هذا المُستَأجِر؟ خارِجَ التَطوير بِلا
    /// مُزَوِّدٍ مَضبوط لا تُسَجَّل، فَلا نَموذَجَ يُعرَض.</summary>
    bool ChannelRegistered => Tenant.AuthChannel switch
    {
        "nafath" => Sp.GetService(typeof(ACommerce.Kit.Auth.INafathChannel)) is not null,
        "email"  => Sp.GetService(typeof(ACommerce.Kit.Auth.IEmailOtpChannel)) is not null,
        _        => Sp.GetService(typeof(ACommerce.Kit.Auth.IOtpChannel)) is not null
    };

    string ChannelUnavailableMessage => Tenant.AuthChannel switch
    {
        "nafath" => L["auth.login.err_nafath_unavailable"],
        "email"  => L["auth.login.err_email_unavailable"],
        _        => L["auth.login.err_phone_unavailable"]
    };

    string? ErrorMessage => Err switch
    {
        "phone_required" => L["auth.login.err_phone_required"],
        "email_required" => L["auth.login.err_email_required"],
        "email_invalid"  => L["auth.login.err_email_invalid"],
        "send_failed"    => L["auth.login.err_send_failed"],
        "code_invalid"   => L["auth.login.err_code_invalid"],
        "nid_required"   => L["auth.login.err_nid_required"],
        "not_approved"   => L["auth.login.err_not_approved"],
        "phone_unavailable"  => L["auth.login.err_phone_unavailable"],
        "email_unavailable"  => L["auth.login.err_email_unavailable"],
        "nafath_unavailable" => L["auth.login.err_nafath_unavailable"],
        _                => null
    };
}
