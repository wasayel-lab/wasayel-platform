@page "/studio/apps/{slug}/console"
@inject Services.Incubator.StudioAuth Auth
@inject Services.Queries.TenantDirectory Tenants
@inject Services.Queries.TenantAdminQueries TenantAdmin
@inject L L
@using ACommerce.Kit.Tenants
@using ACommerce.Kit.Auth
@using ACommerce.Kit.Support
@using ACommerce.Kit.Listings
@using ACommerce.Kit.Subscriptions
@using ACommerce.Kit.Notifications

@*
    لوحَة تَشغيل التَّطبيق — قِراءَة لِأَرقام الإدارَة الأَساسيَّة:
    عَدَد المُستَخدِمين، الإعلانات، التَّذاكِر، الإشعارات، الباقات.
    تَحَقُّق مِلكِيَّة قَبل عَرض البَيانات.
*@

<StudioShell Title="@($"{L["studio.app_console.title"]} {tenant?.Name ?? Slug}")" Active="home">
    <TopBarActions>
        <a class="st-btn st-btn-ghost" href="@($"/studio/apps/{Slug}")">← @L.Markup("studio.app_nav.settings")</a>
    </TopBarActions>
    <ChildContent>
        @if (tenant is null)
        {
            <div class="st-card">@L.Markup("studio.app.not_found")</div>
        }
        else
        {
            <div class="studio-page-head">
                <h1>@L.Markup("studio.app_console.heading")</h1>
                <p>@L.Markup("studio.app_console.intro") <strong>@tenant.Name</strong>.</p>
            </div>

            <div class="studio-stats">
                <div class="studio-stat"><div class="studio-stat-label">@L.Markup("studio.app_console.stat_users")</div><div class="studio-stat-value">@userCount</div></div>
                <div class="studio-stat"><div class="studio-stat-label">@L.Markup("studio.app_console.stat_listings")</div><div class="studio-stat-value">@listingCount</div></div>
                <div class="studio-stat"><div class="studio-stat-label">@L.Markup("studio.app_console.stat_open_tickets")</div><div class="studio-stat-value">@openTicketCount</div><div class="studio-stat-sub">@totalTicketCount @L.Markup("studio.app_console.total_suffix")</div></div>
                <div class="studio-stat"><div class="studio-stat-label">@L.Markup("studio.app_console.stat_plans")</div><div class="studio-stat-value">@planCount</div></div>
            </div>

            @* مَنح/سَحب صَلاحيَّة الإدارَة لِلمَتجَر هي عَمَلِيَّة عَلى
               مُستَوى المَنصَّة — لا تَنتَمي لِإطار رائِد الأَعمال. عُملاء
               المَتجَر يُحصَون أَدناه (@userCount). *@
            <div class="st-section-title">@L.Markup("studio.app_console.section_moderation")</div>
            <div class="studio-list">
                <a class="studio-list-row" href="@($"/studio/apps/{Slug}/listings")">
                    <span class="studio-list-icon" style="background:#fef3c7;color:#854d0e;"><AcIcon Name="clipboard" Size="16" /></span>
                    <div class="studio-list-body"><strong>@L.Markup("studio.app_console.listings_title")</strong>
                        <span>@listingCount @L.Markup("studio.app_console.listings_sub")</span></div>
                    <span style="color:var(--st-faint);">←</span>
                </a>
                <a class="studio-list-row" href="@($"/studio/apps/{Slug}/tickets")">
                    <span class="studio-list-icon" style="background:#fee2e2;color:#b91c1c;"><AcIcon Name="ticket" Size="16" /></span>
                    <div class="studio-list-body"><strong>@L.Markup("studio.app_console.tickets_title")</strong>
                        <span>@openTicketCount @L.Markup("studio.app_console.tickets_open") @totalTicketCount @L.Markup("studio.app_console.total_suffix")</span></div>
                    <span style="color:var(--st-faint);">←</span>
                </a>
            </div>

            <div class="st-section-title" style="display:flex;justify-content:space-between;align-items:center;">
                <span>@L.Markup("studio.app_console.support")</span>
                @* نَفسُ خَرق التَبايُن الَّذي أُصلِحَ في `/studio`
                   (‏4.33 دونَ 4.5): الأَخضَرُ الفاتِح نَصّاً على
                   خَلفِيَّة الاستوديو. والأَخضَرُ الغامِق في اللَوحَة
                   سَلَفاً. كُشِفَ بِمَسحٍ ثانٍ لِلطَبَقَة السادِسَة بَعدَ
                   إصلاح الأَوَّل — فَالمَسحُ الواحِد لا يَكفي لِنَمَطٍ
                   مُكَرَّر. *@
                <a href="@($"/studio/apps/{Slug}/tickets")"
                   style="font-size:12px;color:var(--st-primary-700);text-decoration:none;font-weight:600;">@((MarkupString)"\n                    ")@L.Markup("studio.app_console.all_tickets") ←
                </a>
            </div>
            @if (recentTickets is { Count: > 0 })
            {
                <div class="studio-list">
                    @foreach (var t in recentTickets)
                    {
                        <a class="studio-list-row" href="@($"/studio/apps/{Slug}/tickets/{t.Id}")">
                            <span class="studio-list-icon" style="background:#fef3c7;color:#854d0e;"><AcIcon Name="ticket" Size="16" /></span>
                            <div class="studio-list-body">
                                <strong>@(string.IsNullOrEmpty(t.Subject) ? L["studio.app_console.ticket_untitled"] : t.Subject)</strong>
                                <span>@t.AuthorName · @t.CreatedAt.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                            <span class="st-chip">@t.Status</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="st-card" style="color:var(--st-muted);text-align:center;padding:24px;">@((MarkupString)"\n                    ")@L.Markup("studio.app_console.no_tickets")@((MarkupString)"\n                ")
                </div>
            }

            <div class="st-section-title">@L.Markup("studio.app_console.section_plans")</div>
            @if (plans is { Count: > 0 })
            {
                <div class="studio-list">
                    @foreach (var p in plans)
                    {
                        <div class="studio-list-row" style="cursor:default;">
                            <span class="studio-list-icon" style="background:#dcfce7;color:#15803d;"><AcIcon Name="wallet" Size="16" /></span>
                            <div class="studio-list-body">
                                <strong>@p.Name</strong>
                                <span>@((MarkupString)ACommerce.Kit.Culture.Money.Format(p.Price, style: ACommerce.Kit.Culture.MoneyUnitStyle.Name))@L.Markup("studio.app_console.plan_period") @(p.IsActive ? L["studio.app_console.plan_on"] : L["studio.app_console.plan_off"])</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="st-card" style="color:var(--st-muted);text-align:center;padding:24px;">@((MarkupString)"\n                    ")@L.Markup("studio.app_console.no_plans")@((MarkupString)"\n                ")
                </div>
            }

            <div class="st-section-title">@L.Markup("studio.app_console.section_activity")</div>
            @if (recentNotifs is { Count: > 0 })
            {
                <div class="studio-list">
                    @foreach (var n in recentNotifs)
                    {
                        <div class="studio-list-row" style="cursor:default;">
                            <span class="studio-list-icon" style="background:#fae8ff;color:#a21caf;"><AcIcon Name="bell" Size="16" /></span>
                            <div class="studio-list-body">
                                <strong>@n.Title</strong>
                                <span>@n.Type · @n.At.ToString("yyyy-MM-dd HH:mm")</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="st-card" style="color:var(--st-muted);text-align:center;padding:24px;">@((MarkupString)"\n                    ")@L.Markup("studio.app_console.no_activity")@((MarkupString)"\n                ")
                </div>
            }
        }
    </ChildContent>
</StudioShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
    Tenant? tenant;
    int userCount, listingCount, planCount, openTicketCount, totalTicketCount;
    List<Ticket>? recentTickets;
    List<Plan>? plans;
    List<Notification>? recentNotifs;

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is null || tenant.OwnerUserId != Auth.UserId!.Value) { tenant = null; return; }

        // سَبعُ قِراءات بِسُقوطِها انتَقَلَت إلى
        // TenantAdminQueries.ConsoleAsync — و`null` ما زالَت تَعني
        // «جَدوَل غَير مُهَيَّأ» لا «فارِغ».
        var console      = await TenantAdmin.ConsoleAsync(Slug);
        userCount        = console.Users;
        listingCount     = console.Listings;
        plans            = console.Plans;
        planCount        = plans?.Count ?? 0;
        recentTickets    = console.RecentTickets;
        totalTicketCount = console.TotalTickets;
        openTicketCount  = console.OpenTickets;
        recentNotifs     = console.RecentNotifications;
    }

}
