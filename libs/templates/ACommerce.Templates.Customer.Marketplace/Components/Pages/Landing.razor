@page "/"
@inject IQuerySession Db
@inject Marten.IDocumentStore Store
@inject Services.Incubator.StudioAuth StudioAuthSvc

@*
    صَفحَة الهبوط — تَدعو العَميل لِوَصف فِكرَة تَطبيقِه. الإرسال يَحفَظ
    المُطالَبَة ويُحَوِّل لِلدُخول الوهميّ، ثُمَّ يُولَّد التَّحليل تِلقائيّاً.
    إذا كانَ المُستَخدِم مُسَجَّلاً، نَعرِض زِرّ "لوحَتي" بَدَلَ "تَسجيل الدُخول".
    تَصميم احترافيّ (studio-root) مُنفَصِل عَن واجِهات المَتاجِر.
*@

@{ StudioAuthSvc.Load(); }

<div class="studio-root">
    <nav class="landing-nav">
        <div class="landing-brand">
            <img src="_content/ACommerce.Templates.Customer.Marketplace/brand/wasayel-lockup-color.svg"
                 alt="وَسايِل" class="landing-brand-logo" height="36" />
        </div>
        @if (StudioAuthSvc.IsAuthenticated)
        {
            <a class="st-btn st-btn-primary" href="/studio">لوحَتي ←</a>
        }
        else
        {
            <a class="st-btn st-btn-ghost" href="/studio/auth">تَسجيل الدُخول</a>
        }
    </nav>

    <section class="landing-hero">
        <span class="landing-eyebrow"><AcIcon Name="sparkle" Size="16" /> مَدعوم بِالذَّكاء الاصطِناعيّ + بيانات السوق السعودي</span>
        <h1 class="landing-title">
            حَوِّل فِكرَتَكَ إلى <span class="grad">تَطبيق جاهِز</span><br/>
            في أَيّام، لا شُهور
        </h1>
        <p class="landing-sub">
            صِف فِكرَة مَشروعِكَ، واحصُل على دِراسَة جَدوى احترافيَّة بِأَرقام
            السوق السعودي ومَخاطِر حَقيقيَّة — ثُمَّ أَطلِق متجَرَكَ على نَفس المَنصَّة.
        </p>

        <form method="post" action="/studio/begin" class="landing-prompt">
            <textarea name="prompt" required
                      placeholder="مَثَلاً: مَنصَّة تَربِط أَصحاب المَطاعِم بِمَورّدي الخُضار في الرياض بِنِظام عُمولَة…"></textarea>
            <div class="landing-prompt-bar">
                <span class="landing-prompt-hint">اكتُب بِالعَرَبيَّة أَو الإنجليزيَّة — كُلَّما زادَ الوَصف، دَقَّ التَّحليل</span>
                <button type="submit" class="st-btn st-btn-primary">
                    حَلِّل فِكرَتي ←
                </button>
            </div>
        </form>

        <div class="landing-examples">
            <span class="landing-example" onclick="fillPrompt(this)">سوق إعلانات سيّارات مُستَعمَلَة</span>
            <span class="landing-example" onclick="fillPrompt(this)">تَطبيق توصيل طَعام في جدة</span>
            <span class="landing-example" onclick="fillPrompt(this)">تَأجير مَعَدّات تَصوير</span>
            <span class="landing-example" onclick="fillPrompt(this)">مَنصَّة خَدَمات منزليَّة حَسَب الطَّلَب</span>
        </div>
    </section>

    <section class="landing-features">
        <div class="landing-feature">
            <div class="landing-feature-icon"><AcIcon Name="bar-chart" Size="28" /></div>
            <h3>تَحليل سعوديّ حَقيقيّ</h3>
            <p>أَرقام السوق، المنافِسون، التَّكاليف، ودُروس مِن مَشاريع فَشِلَت فِعلاً.</p>
        </div>
        <div class="landing-feature">
            <div class="landing-feature-icon"><AcIcon Name="sparkle" Size="28" /></div>
            <h3>إطلاق سَريع</h3>
            <p>أَربَعَة أَنماط جاهِزَة تُطلِق متجَرَكَ في ١-٣ أَيّام بَدَلاً مِن ستَّة أَشهُر.</p>
        </div>
        <div class="landing-feature">
            <div class="landing-feature-icon"><AcIcon Name="target" Size="28" /></div>
            <h3>صَريح وموضوعيّ</h3>
            <p>يُبرِز المَخاطِر بِقَدر الفُرَص — لا تَملُّق، قَرار استثماريّ واعٍ.</p>
        </div>
    </section>

    @* أَرقام حَيَّة عَن المَنصَّة — مَتاجِر، إعلانات، أَدوار — مِن DB. *@
    @if (totalListings > 0 || (tenants?.Count ?? 0) > 0)
    {
        <section style="max-width:1000px;margin:0 auto 32px;padding:0 24px;">
            <div class="studio-stats" style="grid-template-columns:repeat(4,1fr);">
                <div class="studio-stat"><div class="studio-stat-label">مَتاجِر مُطلَقَة</div><div class="studio-stat-value">@(tenants?.Count ?? 0)</div></div>
                <div class="studio-stat"><div class="studio-stat-label">إجمالي الإعلانات</div><div class="studio-stat-value">@totalListings</div></div>
                <div class="studio-stat"><div class="studio-stat-label">أَدوار/تَطبيقات</div><div class="studio-stat-value">@totalRoles</div></div>
                <div class="studio-stat"><div class="studio-stat-label">مُدُن مُغَطّاة</div><div class="studio-stat-value">@cityCount</div></div>
            </div>
        </section>
    }

    @if (tenants is { Count: > 0 })
    {
        <section style="max-width:1000px;margin:0 auto 56px;padding:0 24px;">
            <div class="st-section-title">مَتاجِر مُطلَقَة على المَنصَّة</div>
            <div class="studio-list">
                @foreach (var t in tenants)
                {
                    var lc = listingsByTenant.GetValueOrDefault(t.Slug, 0);
                    <a class="studio-list-row" href="/@t.Slug">
                        <span class="studio-list-icon" style="background:@(t.BrandColor)1a;color:@t.BrandColor;">
                            @(t.Name.FirstOrDefault())
                        </span>
                        <div class="studio-list-body">
                            <strong>@t.Name</strong>
                            <span>
                                @(string.IsNullOrEmpty(t.TagLine) ? "—" : t.TagLine)
                                @if (!string.IsNullOrEmpty(t.City)) { <text> · @t.City</text> }
                            </span>
                        </div>
                        <span class="st-chip">@lc إعلان</span>
                        @if (t.Roles.Count > 0)
                        {
                            <span class="st-chip" style="background:var(--st-line-soft);color:var(--st-ink-700);">@t.Roles.Count دَور</span>
                        }
                        <span style="color:var(--st-faint);">←</span>
                    </a>
                }
            </div>
        </section>
    }
</div>

<script>
    function fillPrompt(el) {
        var ta = document.querySelector('.landing-prompt textarea');
        if (ta) { ta.value = el.textContent.trim(); ta.focus(); }
    }
</script>

@code {
    List<Tenant>? tenants;
    Dictionary<string, int> listingsByTenant = new();
    int totalListings;
    int totalRoles;
    int cityCount;

    protected override async Task OnInitializedAsync()
    {
        tenants = (await Db.Query<Tenant>().OrderBy(t => t.CreatedAt).ToListAsync()).ToList();
        totalRoles = tenants.Sum(t => t.Roles.Count);
        var allCities = new HashSet<string>(
            tenants.Where(t => !string.IsNullOrEmpty(t.City)).Select(t => t.City!));

        // اِعدد الإعلانات لِكُلّ مُستَأجِر (sessions per-tenant لِأَنّ Listing conjoined).
        foreach (var t in tenants)
        {
            try
            {
                await using var s = Store.QuerySession(t.Slug);
                var count = await s.Query<ACommerce.Kit.Listings.Listing>()
                    .Where(l => !l.IsDeleted).CountAsync();
                listingsByTenant[t.Slug] = count;
                totalListings += count;
            }
            catch { /* tenant بِدون جَدوَل listings — تَجاهَل */ }
        }
        cityCount = allCities.Count;
    }
}
