@page "/{slug}/explore"
@page "/{slug}/r/{role}/explore"
@inject IDocumentStore Store
@inject AuthSession Auth
@inject L L
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantRoleService Roles
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantThemeService Themes

@*
    نُصوص هذه الصَفحَة كُلُّها في `I18n/Locales/ar.json` تَحتَ
    `listings.explore.*` (‏القاعِدَة ١١). ومَنفَذان لا واحِد، والفَرق
    مَقيس لا ذَوقيّ:
      · `L["…"]` — نَصّ خام لِلخَصائِص (‏aria-label، title، placeholder)
        ولِلكود. الخاصِّيَّة تُرَمِّزُها Razor عِندَ الكِتابَة، تَماماً
        كَما كانَت تُرَمِّز الحَرفِيَّة الَّتي حَلَّ مَحَلَّها.
      · `L.Markup("…")` — عُقدَة نَصّ. Razor يَكتُب حَرفِيَّة المارك-أَب
        **خاماً** ومُخرَج التَعبير **مُرَمَّزاً** (`&#x639;`…)، فَلَو
        كُتِبَت العُقدَة تَعبيراً عادِيّاً لَتَبَدَّلَت بايتات الصَفحَة
        بِلا أَن يَتَبَدَّل حَرفٌ واحِد مِمّا يُرى — وضاعَت البَوّابَة
        الَّتي تَحرُس التَشكيل. وسَلامَتُه عِندَ المُصادِق:
        `value_unsafe_markup` يَرُدّ `< > &`.
    وما بَقيَ حَرفِيّاً عَمداً: «الاستِكشاف» المُمَرَّرَة إلى
    `RoleComponentMap.Map` — وَسم فَتحَة يَذهَب إلى `Console.Error`
    وَحدَه، أَي أَداة لا واجِهَة.
*@

@*
    صَفحة استِكشاف الإعلانات. بُنية مَنقولَة مِن
    AcListingExplorePage.razor في القالِب القَديم:
      ├─ Filter bar: AcHScroll مِن chips (الكلّ + الفِئات) + زِرّ sliders
      ├─ Sort bar: عَدد النَتائِج + قائِمَة تَرتيب
      ├─ Filter modal (sliders): مَدينَة/حَيّ + سِعر أَدنى/أَعلى
      └─ شَبَكَة بِطاقات AcSpaceCard

    لأنّ الصَفحَة SSR، الـ "modal" مُنَفَّذ كَـ <details> مَفتوح
    بِـ ?filters=open في الـ URL — يَتَوَلّى المُتَصَفِّح فَتح/إغلاق
    العُنصُر بِلا JavaScript.
*@

<div class="acs-page acm-explore">
@if (tenant is null)
{
    <AcLoadingState />
}
else
{
    <h1 class="acm-explore-title">@L.Format("listings.explore.title", tenant.Name)</h1>

    @* Filter bar: شَجَرَة kinds + leaves + sliders button — مُطابِق
       لِبِنية AcTaxonomyChips الأَصلِيَّة. *@
    <div class="acm-explore-filterbar">
        @* TaxonomyChips تَظهَر فَقَط لَو فيه أَكثَر مِن فِئَة. *@
        @if (tenant.Categories.Count > 1)
        {
            <div class="acm-explore-chips">
                <TaxonomyChips Slug="@Slug"
                               Categories="tenant.Categories"
                               ActiveKind="@Kind"
                               ActiveCategory="@Category" />
            </div>
        }
        else
        {
            <div class="acm-explore-chips"></div>
        }
        <a class="acm-explore-filterbtn" href="@FilterToggleHref" aria-label="@(L["listings.explore.filters"])">
            <AcIcon Name="sliders" Size="18" />
        </a>
    </div>

    @* Sort bar: count + sort dropdown *@
    <div class="acm-explore-sortbar">
        <span class="acm-explore-count">@L.Markup("listings.explore.result_count", items?.Count ?? 0)</span>
        <div class="acm-explore-sortbar-right">
            @* حَفظ الفَلتَر الحالي كَ بَحث لِلإشعارات. POST عَلى نَفس
               endpoint /searches/save مَع الحُقول المَأخوذَة مِن الـ
               query string الحالي. *@
            <form method="post" action="@($"/{Slug}/searches/save")" class="acm-sort-form">
                <input type="hidden" name="label" value="@SearchLabel()" />
                <input type="hidden" name="category" value="@(Category ?? "")" />
                <input type="hidden" name="district" value="@(District ?? "")" />
                <input type="hidden" name="min" value="@(MinPrice?.ToString() ?? "")" />
                <input type="hidden" name="max" value="@(MaxPrice?.ToString() ?? "")" />
                <button type="submit" class="ac-btn ac-btn-ghost ac-btn-sm" title="@(L["listings.explore.save_search_hint"])">
                    @* الذَيل صَريح، وهو اكتِشاف البَوّابَة لا زينَة: مُصَيِّر
                       المُكَوِّنات يَحذِف عُقدَة النَصّ **الفارِغَة الأَخيرَة**
                       داخِل العُنصُر. وقَبل التَرحيل لَم تَكُن فارِغَة — كانَ
                       فَراغ الإزاحَة مُلتَصِقاً بِالحَرفِيَّة في عُقدَة واحِدَة
                       فَنَجا؛ وبَعدَه انفَصَلَ فَحُذِف، فَسَقَطَ سَطرٌ و16 مَسافَة
                       مِن الصَفحَة. قاسَتهُ المُقارَنَة بايتاً بِبايت (‏0A ثُمَّ
                       0x20×16) ولا تَراهُ عَين. وهذا **يَقَع في كُلّ عُقدَة نَصّ
                       أَخيرَة تُرَحَّل** — مُوَثَّق في `docs/I18N.md`. *@
                    <AcIcon Name="bell" Size="14" /> @L.Markup("listings.explore.save_search")@((MarkupString)"\n                ")
                </button>
            </form>
            <form method="get" action="@($"/{Slug}/explore")" class="acm-sort-form">
                @PreserveHidden(except: "sort")
                <select name="sort" class="ac-input acm-filter-select" aria-label="@(L["listings.explore.sort"])"
                        onchange="this.form.submit()">
                    <option value="newest"     selected="@(string.IsNullOrEmpty(Sort) || Sort == "newest")">@L.Markup("listings.explore.sort_newest")</option>
                    <option value="price_asc"  selected="@(Sort == "price_asc")">@L.Markup("listings.explore.sort_price_asc")</option>
                    <option value="price_desc" selected="@(Sort == "price_desc")">@L.Markup("listings.explore.sort_price_desc")</option>
                </select>
            </form>
        </div>
    </div>

    @* Filter modal — مُطابِق بِنيَة AcModal الأَصلِيَّة (backdrop +
       ac-modal-header + ac-modal-body + ac-modal-footer). يُفتَح بِـ
       ?filters=open. الـ backdrop رابِط يُغلِق الـ modal. *@
    @if (Filters == "open")
    {
        var closeHref = $"/{Slug}/explore" + Preserve(except: "filters");
        <a class="ac-modal-backdrop" href="@closeHref" aria-label="@(L["common.action.close"])"></a>
        <div class="ac-modal acm-explore-filter-modal" role="dialog" aria-modal="true">
            <div class="ac-modal-header">
                <h3 class="ac-modal-title">@L.Markup("listings.explore.filters")</h3>
                <div class="ac-modal-header-actions">
                    <a class="ac-modal-close" href="@closeHref" aria-label="@(L["common.action.close"])">
                        <AcIcon Name="x" Size="20" />
                    </a>
                </div>
            </div>
            @* form يَحفَظ السِياق الحاليّ (category/kind/sort) كَ hidden inputs
               حَتّى لا تُفقَد عِنْدَ تَطبيق الفَلتَر. الـ inputs المَرئيَّة
               (district/min/max/q) تَملِك أَسماء فَريدَة فلا تَكرار. *@
            <form method="get" action="@($"/{Slug}/explore")">
                @if (!string.IsNullOrEmpty(Category)) { <input type="hidden" name="category" value="@Category" /> }
                @if (!string.IsNullOrEmpty(Kind))     { <input type="hidden" name="kind"     value="@Kind" /> }
                @if (!string.IsNullOrEmpty(Sort))     { <input type="hidden" name="sort"     value="@Sort" /> }

                <div class="ac-modal-body">
                    <section class="acm-explore-filtersec">
                        <h4 class="acm-explore-filtersec-title">@L.Markup("listings.explore.section_location")</h4>
                        <select name="district" class="ac-input">
                            <option value="">@L.Markup("common.option.all")</option>
                            @foreach (var d in districts)
                            {
                                <option value="@d" selected="@(District == d)">@d</option>
                            }
                        </select>
                    </section>

                    <section class="acm-explore-filtersec">
                        <h4 class="acm-explore-filtersec-title">@L.Markup("listings.explore.section_price")</h4>
                        <div class="acm-explore-pricerange">
                            <input type="number" name="min" class="ac-input" min="0" step="1"
                                   inputmode="numeric"
                                   value="@(MinPrice?.ToString("0", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                   placeholder="@(L["listings.explore.price_min"])" />
                            <span>—</span>
                            <input type="number" name="max" class="ac-input" min="0" step="1"
                                   inputmode="numeric"
                                   value="@(MaxPrice?.ToString("0", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                   placeholder="@(L["listings.explore.price_max"])" />
                        </div>
                    </section>

                    <section class="acm-explore-filtersec">
                        <h4 class="acm-explore-filtersec-title">@L.Markup("listings.explore.section_search")</h4>
                        <input type="search" name="q" class="ac-input"
                               value="@(Query ?? "")"
                               placeholder="@(L["listings.explore.query_placeholder"])" />
                    </section>
                </div>

                <div class="ac-modal-footer">
                    <a class="ac-btn ac-btn-ghost" href="@AuthSession.LinkFor(Slug, Role, $"explore")">@L.Markup("listings.explore.reset")</a>
                    <button type="submit" class="ac-btn ac-btn-primary">@L.Markup("listings.explore.apply")</button>
                </div>
            </form>
        </div>
    }

    @if (items is null)
    {
        <AcLoadingState Message="@(L["common.state.loading"])" />
    }
    else if (items.Count == 0)
    {
        <AcEmptyState IconName="building"
                      Title="@(L["listings.explore.empty_title"])"
                      Message="@(L["listings.explore.empty_message"])"
                      ActionLabel="@(L["listings.explore.empty_action"])"
                      ActionHref="@AuthSession.LinkFor(Slug, Role, $"explore")" />
    }
    else
    {
        <div class="acm-explore-grid">
            @foreach (var l in items)
            {
                <AcSpaceCard Title="@l.Title"
                             VariantClassSuffix="@listingCardVariant"
                             Href="@AuthSession.LinkFor(Slug, Role, $"listings/{l.Id}")"
                             ImageUrl="@(l.MediaUrls.Count > 0 ? l.MediaUrls[0] : null)"
                             Location="@($"{l.City} — {l.District}")"
                             PriceLabel="@FormatPrice(l)"
                             IsVerified="@l.IsVerified"
                             IsFeatured="@l.IsFeatured"
                             ReviewCount="@ReviewCountOf(l)"
                             ShowFavorite="@Auth.IsAuthenticated"
                             IsFavorite="@favIds.Contains(l.Id)"
                             FavoriteFormAction="@($"/{Slug}/listings/{l.Id}/favorite")"
                             FavoriteFormReturn="@($"/{Slug}/explore")"
                             AddFavoriteAriaLabel="@(L["listings.card.favorite_add"])"
                             RemoveFavoriteAriaLabel="@(L["listings.card.favorite_remove"])" />
            }
        </div>
    }
}
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? Category { get; set; }
    [SupplyParameterFromQuery(Name = "q")]        public string? Query    { get; set; }
    [SupplyParameterFromQuery(Name = "sort")]     public string? Sort     { get; set; }
    [SupplyParameterFromQuery(Name = "min")]      public decimal? MinPrice { get; set; }
    [SupplyParameterFromQuery(Name = "max")]      public decimal? MaxPrice { get; set; }
    [SupplyParameterFromQuery(Name = "district")] public string? District { get; set; }
    [SupplyParameterFromQuery(Name = "filters")]  public string? Filters  { get; set; }
    [SupplyParameterFromQuery(Name = "kind")]     public string? Kind     { get; set; }

    Tenant? tenant;
    ACommerce.Templates.Customer.Marketplace.Services.Patterns.PatternProfile? profile;

    string FormatPrice(Listing l)
    {
        if (profile is null) return L.Format("listings.price.amount", l.Price);
        return profile.Pattern switch
        {
            Services.Patterns.AppPattern.Rental
                => L.Format("listings.price.rental", l.Price,
                     l.Attributes.TryGetValue("lease_term", out var t) ? t : L["listings.price.monthly"]),
            Services.Patterns.AppPattern.Roommate
                => l.Price > 0 ? L.Format("listings.price.per_month", l.Price)
                               : L["listings.price.negotiable"],
            Services.Patterns.AppPattern.Trip => L.Format("listings.price.starts_from", l.Price),
            _ => L.Format("listings.price.amount", l.Price)
        };
    }
    List<Listing>? items;
    List<string> districts = new();
    HashSet<Guid> favIds = new();
    /// <summary>عَدَد تَقييمات كُلّ مُعلِن ظاهِر — استِعلام واحِد لِكُلّهم.</summary>
    Dictionary<Guid, int> reviewCounts = new();

    static Guid? OwnerOf(Listing l)
        => l.Attributes.TryGetValue("owner_id", out var s) && Guid.TryParse(s, out var g)
           ? g : null;

    int? ReviewCountOf(Listing l)
        => OwnerOf(l) is { } owner && reviewCounts.TryGetValue(owner, out var n) && n > 0
           ? n : null;

    string FilterToggleHref =>
        $"/{Slug}/explore" + Preserve(set: Filters == "open" ? null : ("filters", "open"),
                                       except: "filters");

    /// <summary>اِسم وَصفيّ لِلبَحث المَحفوظ يَعتَمِد عَلى الفَلاتِر الحالِيَّة.</summary>
    string SearchLabel()
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(Category)) parts.Add(Category);
        if (!string.IsNullOrEmpty(District)) parts.Add(District);
        if (MinPrice.HasValue || MaxPrice.HasValue)
            parts.Add($"{MinPrice?.ToString("N0") ?? "0"}-{MaxPrice?.ToString("N0") ?? "∞"}");
        if (!string.IsNullOrEmpty(Query)) parts.Add($"«{Query}»");
        return parts.Count == 0
            ? L["listings.explore.saved_search_default"]
            : string.Join(" · ", parts);
    }

    /// <summary>يَبني query-string يَحفَظ القِيَم الحاليّة مَع إمكان حَذف
    /// مِفتاح أو إضافَة جَديد. النَّتيجَة تَبدَأ بِـ ? لَو غَير فارِغَة.</summary>
    string Preserve(string? except = null, (string Key, string Value)? set = null, string? prefix = null)
    {
        var pairs = new List<KeyValuePair<string, string?>>
        {
            new("category", Category),
            new("q",        Query),
            new("sort",     Sort),
            new("min",      MinPrice?.ToString()),
            new("max",      MaxPrice?.ToString()),
            new("district", District),
            new("filters",  Filters),
        };
        var parts = new List<string>();
        foreach (var p in pairs)
        {
            if (p.Key == except) continue;
            if (string.IsNullOrEmpty(p.Value)) continue;
            parts.Add($"{p.Key}={Uri.EscapeDataString(p.Value)}");
        }
        if (set is { } s) parts.Add($"{s.Key}={Uri.EscapeDataString(s.Value)}");
        if (parts.Count == 0) return "";
        return (prefix ?? "?") + string.Join("&", parts);
    }

    /// <summary>نَفس Preserve لكن كـ hidden inputs داخِل form.</summary>
    RenderFragment PreserveHidden(string? except = null) => @<text>
        @foreach (var p in new[] {
            ("category", Category),
            ("q",        Query),
            ("sort",     Sort),
            ("min",      MinPrice?.ToString()),
            ("max",      MaxPrice?.ToString()),
            ("district", District),
            ("filters",  Filters)
        })
        {
            if (p.Item1 != except && !string.IsNullOrEmpty(p.Item2))
            {
                <input type="hidden" name="@p.Item1" value="@p.Item2" />
            }
        }
    </text>;

    /// <summary>قاموس مُغلَق: قيمَة فَتحَة <c>explore</c> إلى وَضع
    /// الصَفحَة. <c>driverExplore</c> وَحدَه يُفَعِّل فَلتَرَة السائِق.</summary>
    static readonly Dictionary<string, bool> ExploreModes = new(StringComparer.Ordinal)
    {
        [ACommerce.Kit.Roles.RoleComponents.DefaultExplore] = false,
        [ACommerce.Kit.Roles.RoleComponents.DriverExplore]  = true,
    };

    /// <summary>لاحِقَة صَنف مُتَغايِر بِطاقَة الإعلان. فارِغَة =
    /// الشَكل المُفَصَّل الافتِراضيّ.</summary>
    string listingCardVariant = "";

    bool driverMode;
    bool driverHasAnchor;
    double driverAnchorLat, driverAnchorLng;
    int driverRadius;

    protected override async Task OnParametersSetAsync()
    {
        // مَوضِع الالتِقاط في الاستِكشاف — فَتحَة <c>explore</c> لِدَور
        // مُؤَلَّف تُقرَأ مِن تَعريفِه.
        var withRoles = await Roles.LoadAsync(Slug);
        tenant = withRoles.Tenant;
        var roleSet = withRoles.Roles;

        listingCardVariant = (await Themes.EffectiveAsync(Slug))
            .VariantClassSuffix(ACommerce.Kit.Theme.ThemeVariantCatalog.ListingCard);

        if (tenant is null) return;
        profile = Services.Patterns.PatternProfileResolver.Of(tenant);

        await using var t = Store.QuerySession(Slug);

        // فَلتَرَة تِلقائيَّة لِلسائِق/الشَحّان: لا يَرى إلّا الإعلانات
        // الَّتي تَقبَل عُروضاً (طَلَبات الراكِبين). UI بَقيَّة الـ explore
        // كَما هو لِكُلّ الأَدوار.
        if (tenant.Roles.Count > 0 && Auth.IsAuthenticated && Auth.UserId.HasValue)
        {
            var me = await t.LoadAsync<User>(Auth.UserId.Value);
            var role = me is null ? null
                : tenant.Roles.FirstOrDefault(r => r.Slug == (Role ?? me.ActiveRole));
            driverMode = ACommerce.Kit.Roles.RoleComponentMap.Map(
                ExploreModes,
                roleSet.ResolveComposition(role?.CatalogSlug).Explore,
                false,
                "الاستِكشاف");
            if (driverMode && me is not null)
            {
                driverHasAnchor = me.HasAnchor;
                driverAnchorLat = me.AnchorLat;
                driverAnchorLng = me.AnchorLng;
                driverRadius    = me.RadiusKm;
            }
        }

        var q = t.Query<Listing>().Where(x => !x.IsDeleted && !x.IsHiddenByModerator);
        if (!string.IsNullOrEmpty(Category))   q = q.Where(x => x.CategorySlug == Category);
        else if (!string.IsNullOrEmpty(Kind))
        {
            // فَلتَرَة بِالـ Kind: نَأخُذ كُلّ slugs الَّتي تَنتَمي لِلـ Kind
            // المُختار مِن tenant.Categories. هذا يَسمَح بِفَلتَرَة "كُلّ
            // العَقارات السَكَنيّة" دون اختِيار فِئَة بِعَينها.
            var slugs = tenant.Categories
                .Where(c => c.Kind == Kind)
                .Select(c => c.Slug).ToList();
            q = q.Where(x => slugs.Contains(x.CategorySlug));
        }
        if (!string.IsNullOrEmpty(District))   q = q.Where(x => x.District == District);
        if (MinPrice.HasValue && MinPrice > 0) q = q.Where(x => x.Price >= MinPrice.Value);
        if (MaxPrice.HasValue && MaxPrice > 0) q = q.Where(x => x.Price <= MaxPrice.Value);
        if (!string.IsNullOrEmpty(Query))
        {
            var s = Query;
            q = q.Where(x => x.Title.Contains(s) ||
                             (x.Description != null && x.Description.Contains(s)));
        }
        q = Sort switch
        {
            "price_asc"  => q.OrderBy(x => x.Price),
            "price_desc" => q.OrderByDescending(x => x.Price),
            _            => q.OrderByDescending(x => x.CreatedAt),
        };
        items = (await q.Take(driverMode ? 200 : 200).ToListAsync()).ToList();
        if (driverMode)
        {
            // أَبقِ فَقَط الَّتي تَقبَل عُروضاً وَ لَيسَت مُتَطابِقَة (سَواء
            // Active/Completed/Aborted) — أَيّ ListingMatch يَعني أَنّ
            // الإعلان "صَدَرَت لَه نَتيجَة" وَلا يَجِب إظهارُه كَفُرصَة جَديدَة.
            var matchedIds = (await t.Query<ACommerce.Kit.Offers.ListingMatch>()
                .ToListAsync()).Select(m => m.Id).ToHashSet();
            items = items
                .Where(l => l.Attributes.TryGetValue("accepts_offers", out var v) &&
                            string.Equals(v, "true", System.StringComparison.OrdinalIgnoreCase))
                .Where(l => !matchedIds.Contains(l.Id))
                .ToList();

            // فَلتَرَة المَنطِقَة لَو السائِق ضَبَط نِصف قُطر.
            if (driverHasAnchor && driverRadius > 0)
            {
                items = items.Where(l =>
                {
                    if (!l.Attributes.TryGetValue("pickup_lat", out var latS) ||
                        !l.Attributes.TryGetValue("pickup_lng", out var lngS)) return true;
                    if (!double.TryParse(latS, System.Globalization.NumberStyles.Float,
                                         System.Globalization.CultureInfo.InvariantCulture, out var plat)) return true;
                    if (!double.TryParse(lngS, System.Globalization.NumberStyles.Float,
                                         System.Globalization.CultureInfo.InvariantCulture, out var plng)) return true;
                    var d = ACommerce.Kit.Offers.OfferHelpers.DistanceKm(
                        driverAnchorLat, driverAnchorLng, plat, plng);
                    return d <= driverRadius;
                }).ToList();
            }
            items = items.Take(60).ToList();
        }
        else
        {
            // باقي الزَوّار (عَميل/زائِر/تاجِر…): لا يَرَون طَلَبات السائِق
            // المُؤَقَّتَة. تَظهَر فَقَط الإعلانات الكاتالوجِيَّة.
            items = items
                .Where(l => !(l.Attributes.TryGetValue("accepts_offers", out var v) &&
                              string.Equals(v, "true", System.StringComparison.OrdinalIgnoreCase)))
                .Take(60).ToList();
        }

        districts = (await t.Query<Listing>()
            .Where(x => !x.IsDeleted && x.District != null)
            .Select(x => x.District!)
            .ToListAsync())
            .Distinct().OrderBy(s => s).ToList();

        // مُؤَشِّر ثِقَة: عَدَد تَقييمات المُعلِن — استِعلام واحِد لِكُلّ
        // المُعلِنين الظاهِرين في هذه الصَفحَة (لا N+1).
        var ownerIds = items.Select(OwnerOf).Where(g => g.HasValue)
                            .Select(g => g!.Value).Distinct().ToList();
        if (ownerIds.Count > 0)
        {
            var revs = await t.Query<ACommerce.Kit.Reviews.Review>()
                .Where(r => !r.Hidden && ownerIds.Contains(r.TargetUserId))
                .ToListAsync();
            reviewCounts = revs.GroupBy(r => r.TargetUserId)
                               .ToDictionary(g => g.Key, g => g.Count());
        }

        if (Auth.IsAuthenticated && Auth.UserId.HasValue)
        {
            var favs = await t.Query<Favorite>()
                .Where(f => f.UserId == Auth.UserId.Value).ToListAsync();
            favIds = favs.Select(f => f.ListingId).ToHashSet();
        }
    }
}
