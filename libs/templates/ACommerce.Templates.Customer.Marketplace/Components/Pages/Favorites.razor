@page "/{slug}/favorites"
@page "/{slug}/r/{role}/favorites"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Accounts
@inject AuthSession Auth
@inject NavigationManager Nav
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantThemeService Themes

<div class="acs-page">
    @if (!Auth.IsAuthenticated)
    {
        <AcEmptyState IconName="heart"
                      Title="المُفَضَّلَة تَحتاج تَسجيل دُخول"
                      Message="سَجِّل دُخولك لِحِفظ الإعلانات الَّتي تَهُمّك."
                      ActionLabel="تَسجيل دُخول"
                      ActionHref="@AuthSession.LinkFor(Slug, Role, $"login?returnUrl=/{Slug}/favorites")" />
    }
    else
    {
        <h1 class="acm-wizard-title">المُفَضَّلَة</h1>

        @if (items is null)
        {
            <AcLoadingState Message="جارٍ التَحميل…" />
        }
        else if (items.Count == 0)
        {
            <AcEmptyState IconName="heart"
                          Title="لا مُفَضَّلَة بَعد"
                          Message="ابدَأ بِالتَصَفُّح وأَضِف الإعلانات الَّتي تُعجِبك."
                          ActionLabel="استِكشاف"
                          ActionHref="@AuthSession.LinkFor(Slug, Role, $"explore")" />
        }
        else
        {
            <div class="acm-home-grid">
                @foreach (var l in items)
                {
                    <AcSpaceCard Title="@l.Title"
                                 VariantClassSuffix="@listingCardVariant"
                                 Href="@AuthSession.LinkFor(Slug, Role, $"listings/{l.Id}")"
                                 Location="@($"{l.City} — {l.District}")"
                                 PriceLabel="@($"{l.Price:N0} ريال")"
                                 IsVerified="@l.IsVerified"
                                 IsFeatured="@l.IsFeatured"
                                 ShowFavorite="true"
                                 IsFavorite="true"
                                 FavoriteFormAction="@($"/{Slug}/listings/{l.Id}/favorite")"
                                 FavoriteFormReturn="@($"/{Slug}/favorites")"
                                 AddFavoriteAriaLabel="أَضِف لِلمُفَضَّلَة"
                                 RemoveFavoriteAriaLabel="أَزِل مِن المُفَضَّلَة" />
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    List<Listing>? items;

    /// <summary>لاحِقَة صَنف مُتَغايِر بِطاقَة الإعلان. فارِغَة =
    /// الشَكل المُفَصَّل الافتِراضيّ.</summary>
    string listingCardVariant = "";

    protected override async Task OnParametersSetAsync()
    {
        listingCardVariant = (await Themes.EffectiveAsync(Slug))
            .VariantClassSuffix(ACommerce.Kit.Theme.ThemeVariantCatalog.ListingCard);

        if (!Auth.IsAuthenticated) return;
        items = (await Accounts.FavoriteListingsAsync(Slug, Auth.UserId!.Value)).ToList();
    }
}
