@page "/{slug}"
@page "/{slug}/r/{role}"
@inject IDocumentStore Store
@inject AuthSession Auth
@inject ITenantContext Tenant
@inject L L
@inject NavigationManager Nav
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantRoleService Roles
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantThemeService Themes

@*
    صَفحة الـ tenant الرَئيسيّة. كُلّ النَّقَرات تَستَخدِم Href بَدَلَ
    OnClick لِتَعمَل تَحت SSR بِلا Blazor interactivity.
*@

<div class="acs-page acm-home">
    @if (loaded is null)
    {
        <AcLoadingState />
    }
    else if (loaded.Roles.Count > 0 && (!Auth.IsAuthenticated || activeRole is null))
    {
        @* مَتجَر بِأَدوار + غَير مُسَجَّل دُخول (أَو بِلا ActiveRole):
           لا يَرى أَيّ مُحتَوى. يَرَى صَفحَة اختِيار التَّطبيق الفَرعيّ.
           هذا يُحَوِّل /{slug} مِن صَفحَة عامَّة إلى نُقطَة دُخول مُتَفَرِّعَة. *@
        <RoleLanding Slug="@Slug" Tenant="loaded" Role="@Role"/>
    }
    else if (RoleHome() is { } roleHome)
    {
        @roleHome
    }
    else
    {
        @* قالِب العَميل/الافتراضي — الصَفحَة الكَلاسيكِيَّة: hero + بَحث +
           فِئات + مُمَيَّز + أَحدَث. هذا أَيضاً قالِب المَتاجِر بِلا أَدوار. *@
        <AcHeroBanner Title="@(profile?.HomeHeroTitlePattern ?? $"ابحَث في {loaded.Name}")"
                      Subtitle="@loaded.TagLine">
            <LogoContent>
                <div class="acm-hero-brand">
                    <span class="acm-hero-brand-mark" aria-hidden="true">
                        <AcIcon Name="home" Size="20" />
                    </span>
                    <span class="acm-hero-brand-text">@loaded.Name</span>

                    @* مُنتَقي المَدينَة: form GET يُرسِل ?city=… على change.
                       تَحت SSR لا يَتَوَفَّر <select dropdown مُخَصَّص>، نَستَخدِم
                       <select> الأَصلي بِشكل style مُتوافِق مَع AcCityPicker. *@
                    @if (cities is { Count: > 0 })
                    {
                        <form method="get" action="@($"/{Slug}")" class="acm-hero-city">
                            <label for="city-select" class="acm-hero-city-icon" aria-hidden="true">
                                <AcIcon Name="map-pin" Size="14" />
                            </label>
                            <select id="city-select" name="city" class="acm-hero-city-select"
                                    aria-label="اختَر المَدينَة" onchange="this.form.submit()">
                                <option value="">كلّ المُدُن</option>
                                @foreach (var c in cities)
                                {
                                    <option value="@c" selected="@(City == c)">@c</option>
                                }
                            </select>
                        </form>
                    }
                </div>
            </LogoContent>
            <ChildContent>
                <form method="get" action="@($"/{Slug}/explore")" role="search" class="ac-search">
                    <span class="ac-search-icon" aria-hidden="true">
                        <AcIcon Name="search" Size="18" />
                    </span>
                    <input type="search" name="q" class="ac-search-input"
                           placeholder="@($"ابحَث في {loaded.Name}…")"
                           autocomplete="off" inputmode="search" />
                    <button type="submit" class="ac-search-submit" aria-label="بَحث">
                        <AcIcon Name="arrow-left" Size="18" />
                    </button>
                </form>
            </ChildContent>
        </AcHeroBanner>

        @* شَجَرَة الفِئات تَظهَر فَقَط لَو فيه أَكثَر مِن فِئَة. مَتجَر بِفِئَة
           واحِدَة لا يَحتاج اختِيار — كُلّ شَيء في تِلكَ الفِئَة. *@
        @if (loaded.Categories.Count > 1)
        {
            <AcSectionHeader Title="الفِئات" />
            <TaxonomyChips Slug="@Slug"
                           Categories="loaded.Categories"
                           ActiveKind="@Kind" />
        }

        @* CTA "أَضِف إعلانك" — يُعرَض فَقَط لِمَن لَدَيه listing.create.
           لِلمَتاجِر بِلا أَدوار يَظهَر لِلجَميع (سُلوك قَديم). لِلمَتاجِر
           بِأَدوار، يُحجَب عَن العُمَلاء/السائِقين/الشَحّانين الَّذين لا
           يَنشُرون إعلانات. *@
        @if (canCreateListing)
        {
            <AcCtaCard Title="عِندَك ما تَعرِضه؟"
                       Subtitle="أَضِف إعلانك الآن واصِل لِلمُهتَمّين بِسُرعَة"
                       IconName="house-add"
                       Variant="surface"
                       Href="@AuthSession.LinkFor(Slug, Role, $"create-listing")" />
        }

        @if (featured is { Count: > 0 })
        {
            <AcSectionHeader Title="مُمَيَّز"
                             ActionLabel="عَرض الكلّ"
                             ActionHref="@AuthSession.LinkFor(Slug, Role, $"explore")" />
            <AcHScroll Class="acm-home-rail">
                @foreach (var l in featured)
                {
                    <div class="acm-home-rail-item">
                        <AcSpaceCard Title="@l.Title"
                                     VariantClassSuffix="@listingCardVariant"
                                     Href="@AuthSession.LinkFor(Slug, Role, $"listings/{l.Id}")"
                                     ImageUrl="@(l.MediaUrls.Count > 0 ? l.MediaUrls[0] : null)"
                                     Location="@($"{l.City} — {l.District}")"
                                     PriceLabel="@FormatPrice(l)"
                                     IsVerified="@l.IsVerified"
                                     IsFeatured="@l.IsFeatured"
                                     ReviewCount="@ReviewCountOf(l)"
                                     ShowFavorite="@Auth.IsAuthenticated"
                                     IsFavorite="@favIds.Contains(l.Id)"
                                     FavoriteFormAction="@($"/{Slug}/listings/{l.Id}/favorite")"
                                     FavoriteFormReturn="@($"/{Slug}")"
                                     AddFavoriteAriaLabel="أَضِف لِلمُفَضَّلَة"
                                     RemoveFavoriteAriaLabel="أَزِل مِن المُفَضَّلَة" />
                    </div>
                }
            </AcHScroll>
        }

        @if (latest is { Count: > 0 })
        {
            <AcSectionHeader Title="أُضيفَ حَديثاً"
                             ActionLabel="عَرض الكلّ"
                             ActionHref="@AuthSession.LinkFor(Slug, Role, $"explore")" />
            <div class="acm-home-grid">
                @foreach (var l in latest)
                {
                    <AcSpaceCard Title="@l.Title"
                                 VariantClassSuffix="@listingCardVariant"
                                 Href="@AuthSession.LinkFor(Slug, Role, $"listings/{l.Id}")"
                                 ImageUrl="@(l.MediaUrls.Count > 0 ? l.MediaUrls[0] : null)"
                                 Location="@($"{l.City} — {l.District}")"
                                 PriceLabel="@FormatPrice(l)"
                                 IsVerified="@l.IsVerified"
                                 IsFeatured="@l.IsFeatured"
                                 ReviewCount="@ReviewCountOf(l)"
                                 ShowFavorite="@Auth.IsAuthenticated"
                                 IsFavorite="@favIds.Contains(l.Id)"
                                 FavoriteFormAction="@($"/{Slug}/listings/{l.Id}/favorite")"
                                 FavoriteFormReturn="@($"/{Slug}")"
                                 AddFavoriteAriaLabel="أَضِف لِلمُفَضَّلَة"
                                 RemoveFavoriteAriaLabel="أَزِل مِن المُفَضَّلَة" />
                }
            </div>
        }

        <section class="acm-home-actions">
            <AcActionCard Label="استِكشاف"
                          IconName="search-heart"
                          Variant="primary"
                          Href="@AuthSession.LinkFor(Slug, Role, $"explore")" />
            <AcActionCard Label="@(Auth.IsAuthenticated ? "حِسابي" : "تَسجيل دُخول")"
                          IconName="user"
                          Variant="surface"
                          Href="@(Auth.IsAuthenticated ? $"/{Slug}/me" : $"/{Slug}/login")" />
        </section>

        @* فَراغ مُوَجَّه: لا رِسالَة صامِتَة. ثَلاث حالات وَلِكُلٍّ خُطوَة
           تالِيَة واحِدَة — فَلتَر مَدينَة يُرفَع، أَو إعلان أَوَّل يُنشَر
           (لِمَن يَملِك الصَلاحِيَّة)، أَو تَصَفُّح. *@
        @if ((featured is null || featured.Count == 0) && (latest is null || latest.Count == 0))
        {
            @if (!string.IsNullOrEmpty(City))
            {
                <AcEmptyState IconName="building"
                              Title="@($"لا إعلانات في {City} بَعد")"
                              Message="جَرِّب كُلّ المُدُن — قَد يَكون ما تَبحَث عَنه قَريباً."
                              ActionLabel="كُلّ المُدُن"
                              ActionHref="@AuthSession.LinkFor(Slug, Role, "")" />
            }
            else if (canCreateListing)
            {
                <AcEmptyState IconName="building"
                              Title="لا إعلانات بَعد"
                              Message="كُن أَوَّل مَن يَنشُر هُنا — إعلانك سَيَظهَر في الرَئيسيَّة فَوراً."
                              ActionLabel="أَضِف أَوَّل إعلان"
                              ActionHref="@AuthSession.LinkFor(Slug, Role, "create-listing")" />
            }
            else
            {
                <AcEmptyState IconName="building"
                              Title="لا إعلانات بَعد"
                              Message="تَصَفَّح كُلّ الفِئات — الجَديد يَصِل أَوَّلاً إلى صَفحَة الاستِكشاف."
                              ActionLabel="استِكشاف"
                              ActionHref="@AuthSession.LinkFor(Slug, Role, "explore")" />
            }
        }
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }   // مِن /r/{role}/
    [SupplyParameterFromQuery(Name = "city")] public string? City { get; set; }
    [SupplyParameterFromQuery(Name = "kind")] public string? Kind { get; set; }

    Tenant? loaded;

    /// <summary>لاحِقَة صَنف مُتَغايِر بِطاقَة الإعلان في هذا المَتجَر.
    /// فارِغَة = الشَكل المُفَصَّل الافتِراضيّ، وهي قيمَة البَدء فَلا
    /// يَتَغَيَّر وَسم مَتجَر بِلا ثيم بِحَرف.</summary>
    string listingCardVariant = "";

    ACommerce.Templates.Customer.Marketplace.Services.Patterns.PatternProfile? profile;
    List<Listing>? latest;
    List<Listing>? featured;

    /// <summary>تَنسيق السِعر حَسَب نَمَط المُستَأجِر: إيجار → «… ر.س / شَهرِيّ»،
    /// مَتجَر → «… ر.س»، مَشاوير → «اعرِض/ابدَأ مِن». نُسخَة طِبق الأَصل
    /// مِن <c>TenantExplore.FormatPrice</c> — والتَكرار قائِم قَبلَ هذه
    /// المَوجَة وبَعدَها، ورَفعُه استِخراجٌ لَه مَوجَتُه.</summary>
    string FormatPrice(Listing l)
    {
        if (profile is null) return Money.Format(l.Price);
        return profile.Pattern switch
        {
            Services.Patterns.AppPattern.Rental
                => L.Format("listings.price.rental", Money.Format(l.Price),
                     l.Attributes.TryGetValue("lease_term", out var t) ? t : L["listings.price.monthly"]),
            Services.Patterns.AppPattern.Roommate
                => l.Price > 0 ? L.Format("listings.price.per_month", Money.Format(l.Price))
                               : L["listings.price.negotiable"],
            Services.Patterns.AppPattern.Trip
                => L.Format("listings.price.starts_from", Money.Format(l.Price)),
            _ => Money.Format(l.Price)
        };
    }
    List<string> cities = new();
    HashSet<Guid> favIds = new();
    /// <summary>عَدَد تَقييمات كُلّ مُعلِن ظاهِر في هذه الصَفحَة —
    /// استِعلام واحِد لِكُلّهم، لا استِعلام لِكُلّ بِطاقَة.</summary>
    Dictionary<Guid, int> reviewCounts = new();

    /// <summary>مالِك الإعلان مِن الخَصائِص (نَفس المِفتاح الَّذي تَكتُبُه
    /// نُقطَة إنشاء الإعلان).</summary>
    static Guid? OwnerOf(Listing l)
        => l.Attributes.TryGetValue("owner_id", out var s) && Guid.TryParse(s, out var g)
           ? g : null;

    int? ReviewCountOf(Listing l)
        => OwnerOf(l) is { } owner && reviewCounts.TryGetValue(owner, out var n) && n > 0
           ? n : null;

    ACommerce.Kit.Roles.Role? activeRole;
    bool canCreateListing = true;   // افتراضيّاً true لِمَتاجِر بِلا أَدوار

    /// <summary>لَقطَة أَدوار هذا المَتجَر — الكاتالوج المَضمون وفَوقَه
    /// تَعريفاتُه المُؤَلَّفَة المُعتَمَدَة. <b>مَوضِع الالتِقاط الأَوَّل</b>:
    /// مِنها تُبنى بِطاقات البَوّابَة (عَبر <c>Tenant.Roles</c>
    /// المُجَسَّدَة) ومِنها يُقرَأ التَركيب. مُهَيَّأَة إلى قاعِدَة
    /// المَنصَّة فَلا فَرق قَبل الحِمل.</summary>
    ACommerce.Kit.Roles.TenantRoleSet roleSet = ACommerce.Kit.Roles.TenantRoleSet.Platform;

    /// <summary>الرَئيسِيَّة الَّتي يُصَيِّرُها هذا الدَور — قاموس مُغلَق
    /// مِن قيمَة فَتحَة <c>home</c> إلى مَندوب تَصيير. <c>null</c> تَعني
    /// «الفَرع الافتِراضيّ المُضَمَّن أَدناه» لا «لا شَيء»، ولِذلك هو
    /// أَيضاً قيمَة <c>defaultHome</c> المُسَجَّلَة وقيمَة السُقوط مَعاً.</summary>
    RenderFragment? RoleHome()
    {
        RenderFragment rider  = @<ACommerce.Templates.Customer.Marketplace.Components.RoleHomes.RiderHome Slug="@Slug" Role="@Role"/>;
        RenderFragment driver = @<ACommerce.Templates.Customer.Marketplace.Components.RoleHomes.DriverHome Slug="@Slug" Role="@Role"/>;
        RenderFragment seller = @<ACommerce.Templates.Customer.Marketplace.Components.RoleHomes.SellerHome
                                      Slug="@Slug" RoleSlug="@(activeRole?.CatalogSlug ?? "")" Role="@Role"/>;

        var table = new Dictionary<string, RenderFragment?>(StringComparer.Ordinal)
        {
            [ACommerce.Kit.Roles.RoleComponents.DefaultHome] = null,
            [ACommerce.Kit.Roles.RoleComponents.RiderHome]   = rider,
            [ACommerce.Kit.Roles.RoleComponents.DriverHome]  = driver,
            [ACommerce.Kit.Roles.RoleComponents.SellerHome]  = seller,
        };

        return ACommerce.Kit.Roles.RoleComponentMap.Map(
            table,
            roleSet.ResolveComposition(activeRole?.CatalogSlug).Home,
            null,
            "الرَئيسِيَّة");
    }

    protected override async Task OnParametersSetAsync()
    {
        // مَوضِع الالتِقاط: بَدَل LoadAsync<Tenant> عارِياً، تُحَمَّل
        // الوَثيقَة وتُجَسَّد فَوقَها أَدوار المَتجَر المُؤَلَّفَة. مُستَأجِر
        // بِلا تَأليف يَخرُج مِن هُنا بِنَفس الكائِن وبِنَفس قائِمَتِه.
        var withRoles = await Roles.LoadAsync(Slug);
        loaded  = withRoles.Tenant;
        roleSet = withRoles.Roles;

        listingCardVariant = (await Themes.EffectiveAsync(Slug))
            .VariantClassSuffix(ACommerce.Kit.Theme.ThemeVariantCatalog.ListingCard);

        if (loaded is null) return;
        profile = Services.Patterns.PatternProfileResolver.Of(loaded);

        await using var tq = Store.QuerySession(Slug);

        if (loaded.Roles.Count > 0)
        {
            // مَتجَر بِأَدوار — افتَرِض المَنع حَتَّى نَتَحَقَّق مِن صَلاحِيَّة المُستَخدِم.
            canCreateListing = false;
            if (Auth.IsAuthenticated && Auth.UserId.HasValue)
            {
                var me = await tq.LoadAsync<User>(Auth.UserId.Value);
                // الـ URL role (Role param) يَتَفَوَّق عَلى user.ActiveRole
                // (الـ DB يَحوي حَقل واحِد، لكِنّ المُستَخدِم قَد يَكون مُسَجَّلاً
                // بِدَورَين في تَبويبَين — كُلّ تَبويب يَجِب أَن يَحتَرِم URLه).
                var effectiveRoleSlug = !string.IsNullOrEmpty(Role) ? Role : me?.ActiveRole;
                if (!string.IsNullOrEmpty(effectiveRoleSlug))
                {
                    activeRole = loaded.Roles.FirstOrDefault(r => r.Slug == effectiveRoleSlug);
                    canCreateListing = ACommerce.Kit.Roles.RolePermissions.Has(
                        loaded.Roles, effectiveRoleSlug, "listing.create");
                }
            }
        }

        var baseQ = tq.Query<Listing>().Where(x => !x.IsDeleted && !x.IsHiddenByModerator);
        if (!string.IsNullOrEmpty(City))
            baseQ = baseQ.Where(x => x.City == City);

        latest = (await baseQ
            .OrderByDescending(x => x.CreatedAt)
            .Take(20).ToListAsync()).ToList();   // نَجلِب أَكثَر ثُمّ نُصَفِّي

        // المُمَيَّز = ما عُلِّمَ IsFeatured (مِن لَوحَة الإدارَة/اشتِراك مَدفوع).
        // إن لَم يَكُن هُناك أَيّ مُمَيَّز بَعد، نَستَخدِم الأَعلى سِعراً كَ
        // fallback لِنَملَأ الكاروسيل. اختِيار قابِل لِلتَّبديل لاحِقاً.
        featured = (await baseQ.Where(x => x.IsFeatured)
            .OrderByDescending(x => x.CreatedAt).Take(20).ToListAsync()).ToList();
        if (featured.Count == 0)
            featured = (await baseQ.OrderByDescending(x => x.Price).Take(20).ToListAsync()).ToList();

        // فَلتَرَة الإعلانات الَّتي تَقبَل عُروضاً (طَلَبات السائِق المُؤَقَّتَة):
        // لا تَظهَر في الصَفحَة الرَّئيسِيَّة العامَّة لِأَنَّها لَيسَت كاتالوج.
        // السائِق يَراها في feed الخاصّ بِه. الـ owner يَراها في "طَلَباتي".
        latest   = latest.Where(l => !IsTripRequest(l)).Take(6).ToList();
        featured = featured.Where(l => !IsTripRequest(l)).Take(4).ToList();

        cities = (await tq.Query<Listing>()
            .Where(x => !x.IsDeleted && x.City != null)
            .Select(x => x.City!)
            .ToListAsync())
            .Distinct().OrderBy(s => s).ToList();

        // مُؤَشِّر ثِقَة: عَدَد تَقييمات المُعلِن. استِعلام واحِد يُغَطّي كُلّ
        // البِطاقات المَعروضَة (≤ ١٠ مُعلِنين) — لا N+1.
        var ownerIds = latest.Concat(featured)
            .Select(OwnerOf).Where(g => g.HasValue).Select(g => g!.Value)
            .Distinct().ToList();
        if (ownerIds.Count > 0)
        {
            var revs = await tq.Query<ACommerce.Kit.Reviews.Review>()
                .Where(r => !r.Hidden && ownerIds.Contains(r.TargetUserId))
                .ToListAsync();
            reviewCounts = revs.GroupBy(r => r.TargetUserId)
                               .ToDictionary(g => g.Key, g => g.Count());
        }

        if (Auth.IsAuthenticated && Auth.UserId.HasValue)
        {
            var favs = await tq.Query<Favorite>()
                .Where(f => f.UserId == Auth.UserId.Value).ToListAsync();
            favIds = favs.Select(f => f.ListingId).ToHashSet();
        }
    }

    static bool IsTripRequest(Listing l) =>
        l.Attributes.TryGetValue("accepts_offers", out var v) &&
        string.Equals(v, "true", System.StringComparison.OrdinalIgnoreCase);
}
