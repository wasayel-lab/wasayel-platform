@page "/{slug}/checkout"
@page "/{slug}/r/{role}/checkout"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Accounts
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.TenantDirectory Tenants
@inject AuthSession Auth
@inject IHttpContextAccessor HttpCtx
@inject ACommerce.Kit.Payments.IPaymentProvider Payments
@inject ACommerce.Templates.Customer.Marketplace.Services.Deals.GatewayPayments Gateway
@inject L L
@using ACommerce.Kit.Cart
@using ACommerce.Kit.Payments
@using ACommerce.Templates.Customer.Marketplace.Services.Deals

@*
    Checkout مُتَعَدِّد الخُطوات — تَجرِبَة Order.V2:
    Step 1: عُنوان التَّوصيل
    Step 2: طَريقَة الدَّفع (بِطاقَة/نَقد عِندَ التَّسليم)
    Step 3: مُلَخَّص + تَأكيد

    خُطوَة واحِدَة في كُلّ صَفحَة — SSR بِلا JS. الخُطوَة في
    <c>?step=1|2|3</c>. الـ form يَتَراكَم القِيَم عَبر hidden inputs.
*@

<div class="acs-page">
    @if (!Auth.IsAuthenticated)
    {
        <AcEmptyState IconName="package" Title="@L["checkout.gate.need_login"]"
                      ActionLabel="@L["shell.nav.login"]" ActionHref="@AuthSession.LinkFor(Slug, Role, "login")" />
    }
    else if (cart is null || cart.Items.Count == 0)
    {
        <AcEmptyState IconName="package" Title="@L["checkout.gate.cart_empty"]"
                      ActionLabel="@L["shell.nav.explore"]" ActionHref="@AuthSession.LinkFor(Slug, Role, "explore")" />
    }
    else
    {
        <h1 class="acm-wizard-title">@L.Markup("checkout.wizard.title")</h1>

        @* stepper *@
        <div style="display:flex;gap:6px;margin-bottom:16px;">
            @for (var i = 1; i <= 3; i++)
            {
                var current = i == Step;
                var done = i < Step;
                <div style="flex:1;text-align:center;">
                    @* الخُطوَةُ الآتِيَة رَقمُها كانَ **أَبيَضَ على
                       `--ac-border`** — والرَمزُ حَدٌّ لا سَطح، قيمَتُه
                       ‏`rgba(17,24,39,.07)` أَي رَماديٌّ شاحِب. النِسبَةُ
                       المَقيسَة ‏**1.20**: الرَقَمانِ ‏٢ و٣ غَيرُ
                       مَنظورَينِ إطلاقاً في النافِذَتَين. والخَطَأُ
                       لَيسَ في الرَمز بَل في تَعبِئَةِ حَدٍّ بِنَصّ —
                       فَيُصَحَّح النَصُّ حَيثُ يَقَع، ولا يُمَسّ الرَمز. *@
                    <div style="width:30px;height:30px;border-radius:50%;margin:0 auto 4px;display:grid;place-items:center;
                                background:@(current ? "var(--ac-primary)" : done ? "#16a34a" : "var(--ac-border)");color:@(current || done ? "#fff" : "var(--ac-text)");font-weight:700;">
                        @if (done) { <AcIcon Name="check" Size="16" /> } else { @i }
                    </div>
                    <div style="font-size:11px;color:@(current ? "var(--ac-primary)" : "var(--ac-text-muted)");">
                        @(i == 1 ? L["checkout.step.address"] : i == 2 ? L["checkout.step.payment"] : L["checkout.step.confirm"])
                    </div>
                </div>
            }
        </div>

        @if (Step == 1)
        {
            <form method="get" action="@($"/{Slug}/checkout")">
                <input type="hidden" name="step" value="2" />
                <AcCard>
                    <ChildContent>
                        <h3 style="margin-top:0;">@L.Markup("checkout.address.title")</h3>
                        @* لِمَن يَصِلُ ما يُكتَبُ هُنا — قَبلَ أَوَّلِ حَقل (‏2026-10-11، مُراجَعَةٌ ثانِيَة): الهاتِفُ
                           والعُنوانُ يُكتَبانِ في الصَفقَةِ ويُرسَمانِ لِلبائِعِ وَحدَه بِإفصاحٍ يُجيزُ مَن يوصِلُ
                           عَنه (`MyDealDetail`، P1-4)، ولَم يَكُن المُشتَري يُقالُ لَه ذلك عِندَ الكِتابَة. *@
                        <div class="ac-text-muted ac-text-sm ac-mb-sm">@L.Markup("checkout.address.disclosure")</div>
                        <AcField Label="@L["checkout.address.name"]" Required="true">
                            <input name="name" required class="ac-input" value="@Name" />
                        </AcField>
                        <AcField Label="@L["checkout.address.phone"]" Required="true">
                            <input name="phone" required class="ac-input" dir="ltr" value="@Phone" />
                        </AcField>
                        <AcField Label="@L["checkout.address.line"]" Required="true">
                            <input name="addr" required class="ac-input" value="@Addr" />
                        </AcField>
                    </ChildContent>
                </AcCard>
                <AcButton Type="submit" Variant="primary" Block="true" Text="@L["checkout.action.next"]" />
            </form>
        }
        else if (Step == 2)
        {
            <form method="get" action="@($"/{Slug}/checkout")">
                <input type="hidden" name="step" value="3" />
                <input type="hidden" name="name" value="@Name" />
                <input type="hidden" name="phone" value="@Phone" />
                <input type="hidden" name="addr" value="@Addr" />
                <AcCard>
                    <ChildContent>
                        <h3 style="margin-top:0;">@L.Markup("checkout.payment.title")</h3>
                        @if (ErrorMessage is { } err)
                        {
                            <AcAlert Variant="warning" Message="@err" />
                        }
                        @*
                            **البِطاقَةُ لا تُعرَض في مَتجَرٍ لا يَقبِض** —
                            نَفسُ ما تَفعَلُه `Plans.razor` بِـ
                            `PlanPurchasePolicy.Visible` حَرفاً. وكانَت
                            تُعرَض **مُؤَشَّرَةً افتِراضِيّاً** بِلا
                            مُزَوِّدٍ خَلفَها، فَيَنتَهي الطَلَبُ بِـ
                            `payment_status = Failed` عَلى صَفقَةٍ لَم
                            يُطلَب فيها دَفعٌ أَصلاً.
                        *@
                        <div class="acm-radio-cards">
                            @if (CardOffered)
                            {
                                <label class="acm-radio-card">
                                    <input type="radio" name="pay" value="@CheckoutPayMethods.Card" required
                                           checked="@(EffectivePay == CheckoutPayMethods.Card)" />
                                    <span class="acm-radio-card-body">
                                        <strong>
                                            <AcIcon Name="credit-card" Size="16" /> @L.Markup("checkout.payment.card")
                                            @* **وَضعُ التَجرِبَةِ يُعلَنُ حَيثُ يُنقَر**: الشاشَةُ
                                               والنُقطَةُ تَقرَآنِ `PaymentSimulationSurface`
                                               نَفسَها، فَلا تَعرِضُ الشاشَةُ حَقيقِيّاً ما
                                               سَيُحاكيهِ المُزَوِّد. ADR-025. *@
                                            @if (Simulated)
                                            {
                                                <span class="ac-chip ac-chip-sm">@L.Markup("checkout.payment.simulation_badge")</span>
                                            }
                                        </strong>
                                        @* **وأَينَ يُدفَعُ يُقالُ حَيثُ يُنقَر** (‏ADR-032 الخُطوَة 8، ‏2026-10-12): بِمِفتاحِ المَتجَرِ عَلى صَفحَةِ بَوّابَتِه —
                                           ولا شارَةَ تَجرِبَةٍ لِبِطاقَةٍ لا يَمَسُّها مُزَوِّدُ النُسخَة (`Simulated` يَسأَلُ `ThroughGateway`). *@
                                        <span>@(Facts.ThroughGateway ? L["checkout.payment.card_hint_gateway"] : Simulated ? L["checkout.payment.simulation_hint"] : L["checkout.payment.card_hint"])</span>
                                    </span>
                                </label>
                            }
                            else if (CartRefusalText(Facts.CartRefusal) is { } why)
                            {
                                @* بِطاقَةُ البَوّابَةِ لِسَلَّةٍ لا تَحمِلُها فاتورَةٌ واحِدَة (‏2026-10-13، G5 (xvi-g)): لا تُرسَمُ — ويُقالُ لِماذا حَيثُ كانَت، بِنَصِّ رَمزِها
                                   الَّذي تَرُدُّ بِه النُقطَةُ أَيضاً (`card.CartRefusal ?? payRefusal`)؛ فَلا يَختَفي خِيارٌ بِلا كَلِمَة. *@
                                <p class="ac-muted" style="margin:0 0 8px;font-size:13px;">@why</p>
                            }
                            <label class="acm-radio-card">
                                <input type="radio" name="pay" value="@CheckoutPayMethods.CashOnDelivery" required
                                       checked="@(EffectivePay == CheckoutPayMethods.CashOnDelivery)" />
                                <span class="acm-radio-card-body">
                                    <strong><AcIcon Name="cash" Size="16" /> @L.Markup("checkout.payment.cash")</strong>
                                    <span>@L.Markup("checkout.payment.cash_hint")</span>
                                </span>
                            </label>
                        </div>
                        @* إفصاحُ الطَلَباتِ المُستَقِلَّةِ حَيثُ يُختارُ الدَفع (موجَزُ الفَجَوات P3-9؛ ‏ADR-033 §٣‑٩): الإرسالُ يَبدَأُ صَفقَةً
                           لِكُلِّ بَندٍ لا لِكُلِّ بائِع — فَكُلُّ بَندٍ يُشحَنُ بِبوليصَتِه ويُدفَعُ نَقدُه عِندَ تَسليمِه. *@
                        <p class="ac-muted" style="margin:12px 0 0;font-size:13px;">@L.Markup("checkout.payment.per_item_note")</p>
                    </ChildContent>
                </AcCard>
                <div style="display:flex;gap:8px;">
                    <a href="@AuthSession.LinkFor(Slug, Role, $"checkout?step=1&name={Uri.EscapeDataString(Name)}&phone={Uri.EscapeDataString(Phone)}&addr={Uri.EscapeDataString(Addr)}")"
                       class="ac-btn ac-btn-ghost">@L.Markup("checkout.action.previous")</a>
                    <AcButton Type="submit" Variant="primary" Block="true" Text="@L["checkout.action.next"]" />
                </div>
            </form>
        }
        else
        {
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("checkout.summary.title")</h3>
                    @foreach (var item in cart.Items)
                    {
                        <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:4px;">
                            <span>@item.Title × @item.Quantity</span>
                            <span>@((MarkupString)ACommerce.Kit.Culture.Money.Format(item.UnitPriceSar * item.Quantity))</span>
                        </div>
                    }
                    <hr />
                    <div style="display:flex;justify-content:space-between;font-weight:700;">
                        <span>@L.Markup("checkout.summary.total")</span>
                        <span style="color:var(--ac-primary);">@cart.SubtotalSar.ToString("N2") @((MarkupString)ACommerce.Kit.Culture.Money.Unit())</span>
                    </div>
                    <hr />
                    <div style="font-size:13px;color:var(--ac-text-muted);">
                        <strong>@L.Markup("checkout.summary.ship_to")</strong> @Name · @Phone<br />
                        @Addr<br />
                        <strong>@L.Markup("checkout.summary.pay_with")</strong> @(EffectivePay == CheckoutPayMethods.Card ? L["checkout.payment.card_short"] : L["checkout.payment.cash"])
                        @* وتُعادُ الكَلِمَةُ قَبلَ النَقرَةِ الأَخيرَة — لا
                           تُقالُ مَرَّةً في خُطوَةٍ سابِقَةٍ ثُمَّ تُنسى. *@
                        @if (Simulated && EffectivePay == CheckoutPayMethods.Card)
                        {
                            <span class="ac-chip ac-chip-sm">@L.Markup("checkout.payment.simulation_badge")</span>
                            <br />
                            <span>@L.Markup("checkout.payment.simulation_hint")</span>
                        }
                        @if (Facts.ThroughGateway && EffectivePay == CheckoutPayMethods.Card)
                        {
                            <br />
                            <span>@L.Markup("checkout.payment.card_hint_gateway")</span>
                        }
                    </div>
                </ChildContent>
            </AcCard>
            <form method="post" action="@($"/{Slug}/checkout/submit")">
                <input type="hidden" name="name"  value="@Name" />
                <input type="hidden" name="phone" value="@Phone" />
                <input type="hidden" name="addr"  value="@Addr" />
                <input type="hidden" name="pay"   value="@EffectivePay" />
                <AcButton Type="submit" Variant="primary" Size="lg" Block="true" Text="@L["checkout.action.submit"]" />
            </form>
        }
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [SupplyParameterFromQuery] public int Step { get; set; } = 1;
    [SupplyParameterFromQuery] public string Name { get; set; } = "";
    [SupplyParameterFromQuery] public string Phone { get; set; } = "";
    [SupplyParameterFromQuery] public string Addr { get; set; } = "";
    [SupplyParameterFromQuery] public string Pay { get; set; } = CheckoutPayMethods.Card;

    /// <summary>رَمزُ الرَفضِ المُعادُ مِن النُقطَة — <b>يُقرَأُ ولا
    /// يُبتلَع</b>. نَفسُ شَكلِ <c>Plans.razor.Err</c>.</summary>
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }

    Cart? cart;

    /// <summary>
    /// <para><b>مُدخَلاتُ قَرارِ البِطاقَةِ مَحسوبَةً مَرَّةً</b> (‏ADR-032 الخُطوَة 8 — شَطرُ <c>CardOffered</c>، ‏2026-10-12): عَلَمُ المَتجَرِ
    /// (‏<c>Tenant.PaymentProviderConfigured</c>) وقُدرَةُ مُزَوِّدِ النُسخَة (<c>PaymentChargeSurface.CanCharge</c>) — كَما كانا — ومَعَهُما
    /// ما تَحسُبُه <c>GatewayPayments.CardFactsAsync</c>: مِفتاحٌ مَختومٌ مَربوط، وخِزانَةٌ تَفُكّ، وعَميلُ بَوّابَةٍ مُسَجَّل. <b>والنُقطَةُ
    /// تُنادي الدالَّةَ نَفسَها بِالمُدخَلَينِ نَفسَيهِما</b> وتُقَرِّرُ بِـ<see cref="CheckoutCardFacts"/> نَفسِها — فَلا تَعرِضُ الشاشَةُ ما سَتَرُدُّه.</para>
    /// <para>كانَ هُنا <c>TenantCollects</c> و<c>ProviderCanCharge</c> يُمَرَّرانِ إلى <c>CardOffered</c> و<c>Decide</c> — وكانَت البِطاقَةُ
    /// تَقبِضُ بِمُزَوِّدِ النُسخَةِ وَحدَه؛ وصارَت لِمَتجَرٍ رَبَطَ مِفتاحَه تَقبِضُ بِبَوّابَتِه.</para>
    /// </summary>
    CheckoutCardFacts Facts = new(StoreCollects: false, SealedKeyBound: false, VaultCanUnseal: false,
        GatewayClientRegistered: false, InstanceCanCharge: false);

    /// <summary>البِطاقَةُ تُعرَضُ بِما تُقَرِّرُه <see cref="CheckoutCardFacts.CardOffered"/> — والنُقطَةُ تَقبَلُ بِالمُدخَلاتِ نَفسِها.</summary>
    bool CardOffered => Facts.CardOffered;

    /// <summary><b>أَمُزَوِّدُ هذِه النُسخَةِ في وَضعِ التَجرِبَة؟</b> —
    /// نَفسُ المُسنَدِ الَّذي تَقرَؤُه النُقطَة، فَلا يَنجَرِفُ
    /// طَرَفان. <b>ولا يُسأَلُ لِبِطاقَةٍ تَمُرُّ بِبَوّابَةِ المَتجَر</b>
    /// (‏2026-10-12): لا يَمَسُّها مُزَوِّدُ النُسخَة، فَشارَتُه عَلَيها كَذِب.</summary>
    bool Simulated => !Facts.ThroughGateway && PaymentSimulationSurface.IsSimulated(Payments);

    /// <summary><b>طَريقَةُ الدَفعِ الَّتي سَتُرسَل</b> — مِن الدالَّةِ
    /// النَقِيَّةِ نَفسِها الَّتي تَقرَؤُها النُقطَة، فَلا تَعرِضُ
    /// الشاشَةُ ما سَتَرُدُّه.</summary>
    string EffectivePay => CheckoutPaymentPolicy.Decide(Pay, Facts.Collects, Facts.ChargerCanCharge).Method;

    string? ErrorMessage => Err switch
    {
        CheckoutPayMethods.CardUnavailable => L["checkout.payment.err_card_unavailable"],
        CheckoutPayMethods.GatewayOpenFailed => L["checkout.payment.err_gateway_open_failed"],
        CheckoutPayMethods.CardCartTooMany or CheckoutPayMethods.CardAmountUnbillable => CartRefusalText(Err),
        _ => null
    };

    /// <summary>نَصُّ رَمزِ السَلَّةِ لِبِطاقَةِ البَوّابَة (<see cref="CheckoutCardFacts.CartRefusal"/>) — والحَدُّ مِن الثابِتِ لا مِن النَصّ
    /// (<see cref="GatewayPaymentProof.MaxDealsPerInvoice"/>)؛ و<c>null</c> لِما سِواهُما.</summary>
    string? CartRefusalText(string? code) => code switch
    {
        CheckoutPayMethods.CardCartTooMany => L.Format("checkout.payment.err_card_cart_too_many", GatewayPaymentProof.MaxDealsPerInvoice),
        CheckoutPayMethods.CardAmountUnbillable => L["checkout.payment.err_card_amount_unbillable"],
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        if (HttpCtx.HttpContext is { } ctx) { Auth.SetTenant(Slug); Auth.Load(ctx, Slug); }
        if (!Auth.IsAuthenticated) return;
        if (Step < 1 || Step > 3) Step = 1;
        cart = await Accounts.CartAsync(Slug, Auth.UserId!.Value);
        var tenant = await Tenants.FindAsync(Slug);
        Facts = await Gateway.CardFactsAsync(Slug, tenant?.PaymentProviderConfigured ?? false, PaymentChargeSurface.CanCharge(Payments), cart);
        if (Auth.UserName is { } un && string.IsNullOrEmpty(Name)) Name = un;
    }
}
