@page "/{slug}/checkout"
@page "/{slug}/r/{role}/checkout"
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Accounts
@inject AuthSession Auth
@inject IHttpContextAccessor HttpCtx
@inject L L
@using ACommerce.Kit.Cart

@*
    Checkout مُتَعَدِّد الخُطوات — تَجرِبَة Order.V2:
    Step 1: عُنوان التَّوصيل
    Step 2: طَريقَة الدَّفع (بِطاقَة/نَقد عِندَ التَّسليم)
    Step 3: مُلَخَّص + تَأكيد

    خُطوَة واحِدَة في كُلّ صَفحَة — SSR بِلا JS. الخُطوَة في
    <c>?step=1|2|3</c>. الـ form يَتَراكَم القِيَم عَبر hidden inputs.
*@

<div class="acs-page">
    @if (!Auth.IsAuthenticated)
    {
        <AcEmptyState IconName="package" Title="@L["checkout.gate.need_login"]"
                      ActionLabel="@L["shell.nav.login"]" ActionHref="@AuthSession.LinkFor(Slug, Role, "login")" />
    }
    else if (cart is null || cart.Items.Count == 0)
    {
        <AcEmptyState IconName="package" Title="@L["checkout.gate.cart_empty"]"
                      ActionLabel="@L["shell.nav.explore"]" ActionHref="@AuthSession.LinkFor(Slug, Role, "explore")" />
    }
    else
    {
        <h1 class="acm-wizard-title">@L.Markup("checkout.wizard.title")</h1>

        @* stepper *@
        <div style="display:flex;gap:6px;margin-bottom:16px;">
            @for (var i = 1; i <= 3; i++)
            {
                var current = i == Step;
                var done = i < Step;
                <div style="flex:1;text-align:center;">
                    <div style="width:30px;height:30px;border-radius:50%;margin:0 auto 4px;display:grid;place-items:center;
                                background:@(current ? "var(--ac-primary)" : done ? "#16a34a" : "var(--ac-border)");color:#fff;font-weight:700;">
                        @if (done) { <AcIcon Name="check" Size="16" /> } else { @i }
                    </div>
                    <div style="font-size:11px;color:@(current ? "var(--ac-primary)" : "var(--ac-text-muted)");">
                        @(i == 1 ? L["checkout.step.address"] : i == 2 ? L["checkout.step.payment"] : L["checkout.step.confirm"])
                    </div>
                </div>
            }
        </div>

        @if (Step == 1)
        {
            <form method="get" action="@($"/{Slug}/checkout")">
                <input type="hidden" name="step" value="2" />
                <AcCard>
                    <ChildContent>
                        <h3 style="margin-top:0;">@L.Markup("checkout.address.title")</h3>
                        <AcField Label="@L["checkout.address.name"]" Required="true">
                            <input name="name" required class="ac-input" value="@Name" />
                        </AcField>
                        <AcField Label="@L["checkout.address.phone"]" Required="true">
                            <input name="phone" required class="ac-input" dir="ltr" value="@Phone" />
                        </AcField>
                        <AcField Label="@L["checkout.address.line"]" Required="true">
                            <input name="addr" required class="ac-input" value="@Addr" />
                        </AcField>
                    </ChildContent>
                </AcCard>
                <AcButton Type="submit" Variant="primary" Block="true" Text="@L["checkout.action.next"]" />
            </form>
        }
        else if (Step == 2)
        {
            <form method="get" action="@($"/{Slug}/checkout")">
                <input type="hidden" name="step" value="3" />
                <input type="hidden" name="name" value="@Name" />
                <input type="hidden" name="phone" value="@Phone" />
                <input type="hidden" name="addr" value="@Addr" />
                <AcCard>
                    <ChildContent>
                        <h3 style="margin-top:0;">@L.Markup("checkout.payment.title")</h3>
                        <div class="acm-radio-cards">
                            <label class="acm-radio-card">
                                <input type="radio" name="pay" value="card" required checked="@(Pay != "cash")" />
                                <span class="acm-radio-card-body">
                                    <strong><AcIcon Name="credit-card" Size="16" /> @L.Markup("checkout.payment.card")</strong>
                                    <span>@L.Markup("checkout.payment.card_hint")</span>
                                </span>
                            </label>
                            <label class="acm-radio-card">
                                <input type="radio" name="pay" value="cash" checked="@(Pay == "cash")" />
                                <span class="acm-radio-card-body">
                                    <strong><AcIcon Name="cash" Size="16" /> @L.Markup("checkout.payment.cash")</strong>
                                    <span>@L.Markup("checkout.payment.cash_hint")</span>
                                </span>
                            </label>
                        </div>
                    </ChildContent>
                </AcCard>
                <div style="display:flex;gap:8px;">
                    <a href="@AuthSession.LinkFor(Slug, Role, $"checkout?step=1&name={Uri.EscapeDataString(Name)}&phone={Uri.EscapeDataString(Phone)}&addr={Uri.EscapeDataString(Addr)}")"
                       class="ac-btn ac-btn-ghost">@L.Markup("checkout.action.previous")</a>
                    <AcButton Type="submit" Variant="primary" Block="true" Text="@L["checkout.action.next"]" />
                </div>
            </form>
        }
        else
        {
            <AcCard>
                <ChildContent>
                    <h3 style="margin-top:0;">@L.Markup("checkout.summary.title")</h3>
                    @foreach (var item in cart.Items)
                    {
                        <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:4px;">
                            <span>@item.Title × @item.Quantity</span>
                            <span>@((MarkupString)ACommerce.Kit.Culture.Money.Format(item.UnitPriceSar * item.Quantity))</span>
                        </div>
                    }
                    <hr />
                    <div style="display:flex;justify-content:space-between;font-weight:700;">
                        <span>@L.Markup("checkout.summary.total")</span>
                        <span style="color:var(--ac-primary);">@cart.SubtotalSar.ToString("N2") @((MarkupString)ACommerce.Kit.Culture.Money.Unit())</span>
                    </div>
                    <hr />
                    <div style="font-size:13px;color:var(--ac-text-muted);">
                        <strong>@L.Markup("checkout.summary.ship_to")</strong> @Name · @Phone<br />
                        @Addr<br />
                        <strong>@L.Markup("checkout.summary.pay_with")</strong> @(Pay == "cash" ? L["checkout.payment.cash"] : L["checkout.payment.card_short"])
                    </div>
                </ChildContent>
            </AcCard>
            <form method="post" action="@($"/{Slug}/checkout/submit")">
                <input type="hidden" name="name"  value="@Name" />
                <input type="hidden" name="phone" value="@Phone" />
                <input type="hidden" name="addr"  value="@Addr" />
                <input type="hidden" name="pay"   value="@Pay" />
                <AcButton Type="submit" Variant="primary" Size="lg" Block="true" Text="@L["checkout.action.submit"]" />
            </form>
        }
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [SupplyParameterFromQuery] public int Step { get; set; } = 1;
    [SupplyParameterFromQuery] public string Name { get; set; } = "";
    [SupplyParameterFromQuery] public string Phone { get; set; } = "";
    [SupplyParameterFromQuery] public string Addr { get; set; } = "";
    [SupplyParameterFromQuery] public string Pay { get; set; } = "card";
    Cart? cart;

    protected override async Task OnInitializedAsync()
    {
        if (HttpCtx.HttpContext is { } ctx) { Auth.SetTenant(Slug); Auth.Load(ctx, Slug); }
        if (!Auth.IsAuthenticated) return;
        if (Step < 1 || Step > 3) Step = 1;
        cart = await Accounts.CartAsync(Slug, Auth.UserId!.Value);
        if (Auth.UserName is { } un && string.IsNullOrEmpty(Name)) Name = un;
    }
}
