@page "/{slug}/deals"
@page "/{slug}/r/{role}/deals"
@inject IDocumentStore Store
@inject AuthSession Auth
@inject Services.Deals.DealsService Deals
@inject IHttpContextAccessor HttpCtx
@inject L L
@using ACommerce.Templates.Customer.Marketplace.Services.Deals

@*
    «صَفقاتي» لِلعميل — كُلّ الصَّفقات الَّتي أَنا طَرَف فيها (مُبادِر أَو
    مالِك إعلان قُدِّم عَلَيه عَرض). تَجرِبَة مُواجِهَة لِلعميل (داخِل
    MainLayout، لا StudioShell).
*@

<div class="acs-page">
    @if (!Auth.IsAuthenticated)
    {
        <AcEmptyState IconName="package"
                      Title="@L["deals.mine.need_login"]"
                      Message="@L["deals.mine.need_login_hint"]"
                      ActionLabel="@L["auth.action.login"]"
                      ActionHref="@AuthSession.LinkFor(Slug, Role, $"login?returnUrl=/{Slug}/deals")" />
    }
    else
    {
        <h1 class="acm-wizard-title">@L.Markup("deals.mine.title")</h1>

        @if (mine.Count == 0 && asOwner.Count == 0)
        {
            <AcEmptyState IconName="package" Title="@L["deals.mine.empty_title"]"
                          Message="@L["deals.mine.empty_hint"]"
                          ActionLabel="@L["deals.mine.empty_action"]"
                          ActionHref="@AuthSession.LinkFor(Slug, Role, "explore")" />
        }
        else
        {
            @if (mine.Count > 0)
            {
                <AcSectionHeader Title="@L["deals.mine.section_mine"]" />
                <div class="acm-cat-list">
                    @foreach (var d in mine)
                    {
                        @DealRow(d)
                    }
                </div>
            }
            @if (asOwner.Count > 0)
            {
                <AcSectionHeader Title="@L["deals.mine.section_incoming"]" />
                <div class="acm-cat-list">
                    @foreach (var d in asOwner)
                    {
                        @DealRow(d)
                    }
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    List<Deal> mine = new();
    List<Deal> asOwner = new();

    protected override async Task OnInitializedAsync()
    {
        if (HttpCtx.HttpContext is { } ctx) { Auth.SetTenant(Slug); Auth.Load(ctx, Slug); }
        if (!Auth.IsAuthenticated) return;
        var uid = Auth.UserId!.Value;
        var all = await Deals.ListForUserAsync(Slug, uid);
        mine = all.Where(d => d.InitiatorId == uid).ToList();
        // العُروضُ الوارِدَةُ قَبلَ القَبول داخِلَةٌ في هذا النِداء —
        // انظُر <c>DealsService.ListForListingOwnerAsync</c>.
        //
        // وكانَ هُنا مُرَشِّحٌ ثانٍ يَبحَثُ عَنها في `all`، **ولا يُمكِنُ
        // أَن يُطابِقَ شَيئاً أَبَداً**: مَصدَرُ `all` هو
        // `ListForUserAsync` وشَرطُه `InitiatorId == uid ||
        // CounterpartyId == uid`، والمُرَشِّحُ يَطلُب `CounterpartyId is
        // null && InitiatorId != uid` — نَقيضُه حَرفاً. حُذِفَ، ونُقِلَ
        // السُؤالُ إلى الاستِعلام الَّذي يَملِكُ الجَواب.
        asOwner = await Deals.ListForListingOwnerAsync(Slug, uid);
    }

    RenderFragment DealRow(Deal d) => @<a class="acm-cat-row" style="text-decoration:none;color:inherit;"
        href="@AuthSession.LinkFor(Slug, Role, $"deals/{d.Id}")">
        <span><AcIcon Name="@StageIcon(d.Stage)" Size="22" /></span>
        <div style="flex:1;">
            <strong>@(string.IsNullOrEmpty(d.ListingTitle) ? d.Pattern : d.ListingTitle)</strong>
            <span style="color:var(--ac-text-muted);font-size:12px;display:block;">
                @DealsPolicy.LabelAr(d.Stage) · @StatusLabel(d.Status) ·
                @((MarkupString)ACommerce.Kit.Culture.Money.Format(d.AmountSar)) · @d.UpdatedAt.ToString("MM-dd HH:mm")
            </span>
        </div>
        <AcIcon Name="chevron-left" Size="16" />
    </a>;

    static string StageIcon(DealStage s) => s switch
    {
        DealStage.Offered => "clipboard", DealStage.Booked => "calendar", DealStage.Confirmed => "check",
        DealStage.Paid => "credit-card", DealStage.Shipping => "truck", DealStage.Delivered => "package",
        DealStage.Received => "check-circle", DealStage.Reviewed => "star", _ => "tag"
    };
    string StatusLabel(DealStatus s) => s switch
    {
        DealStatus.Active => L["deals.status.active"], DealStatus.Completed => L["deals.status.completed"],
        DealStatus.Cancelled => L["deals.status.cancelled"], DealStatus.Disputed => L["deals.status.disputed"], _ => s.ToString()
    };
}
