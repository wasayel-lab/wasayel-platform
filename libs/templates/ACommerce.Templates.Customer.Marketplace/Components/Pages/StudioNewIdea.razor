@page "/studio/new"
@inject Services.Incubator.StudioAuth Auth
@using ACommerce.Templates.Customer.Marketplace.Services.Incubator
@inject L L

@*
    صَفحَة "فِكرَة جَديدَة" داخِل الـ studio (لِلمُستَخدِم المُسَجَّل) —
    نَفس حَقل المُطالَبَة لكِنّ بِلا تَدَفُّق الزائر (لا "تَسجيل الدُخول"،
    لا hero تَسويقيّ). تُرسِل إلى /studio/begin مِثل صَفحَة الهبوط، الـ
    endpoint نَفسه يَنشُر التَّحليل وَيُحَوِّل لِ‍ /studio/s/{id}.
*@

<StudioShell Title="@(L["studio.new.head_title"])" Active="">
    <ChildContent>
        <div class="studio-page-head">
            <h1>@L.Markup("studio.new.title") <AcIcon Name="sparkle" Size="24" /></h1>
            <p>@L.Markup("studio.new.subtitle")</p>
        </div>

        <div class="st-card">
            <form method="post" action="/studio/begin">
                <label class="st-label">@L.Markup("studio.new.prompt_label")</label>
                <textarea name="prompt" required rows="6" class="st-textarea"
                    placeholder="@L["studio.new.idea_placeholder"]"></textarea>

                <div class="st-section-title" style="margin-top:18px;">@L.Markup("studio.new.examples")</div>
                <div class="landing-examples" style="justify-content:flex-start;margin:8px 0 18px;">
                    <span class="landing-example" onclick="fillNew(this)">@L.Markup("studio.new.example_cars")</span>
                    <span class="landing-example" onclick="fillNew(this)">@L.Markup("studio.new.example_food")</span>
                    <span class="landing-example" onclick="fillNew(this)">@L.Markup("studio.new.example_gear")</span>
                    <span class="landing-example" onclick="fillNew(this)">@L.Markup("studio.new.example_home")</span>
                </div>

                <div style="display:flex;gap:8px;">
                    <a class="st-btn st-btn-ghost" href="/studio">@L.Markup("admin.new.cancel")</a>
                    <button type="submit" class="st-btn st-btn-primary st-btn-block">
                        @((MarkupString)"\n                        ")@L.Markup("studio.new.submit") ←
                    </button>
                </div>
            </form>
        </div>
    </ChildContent>
</StudioShell>

<script>
    function fillNew(el) {
        var ta = document.querySelector('.st-textarea');
        if (ta) { ta.value = el.textContent.trim(); ta.focus(); }
    }
</script>
