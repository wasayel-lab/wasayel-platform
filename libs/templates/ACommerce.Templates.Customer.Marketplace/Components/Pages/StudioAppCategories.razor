@page "/studio/apps/{slug}/categories"
@inject Services.Incubator.StudioAuth Auth
@inject Services.Queries.TenantDirectory Tenants
@inject L L
@using ACommerce.Kit.Tenants

@*
    تَحرير الفِئات — textarea نَصّيّ: كُلّ سَطر "slug | اسم | إيموجي | تَجميع".
    أَبسَط مِن جَدوَل ديناميكيّ ويَكفي لِلتَّحرير السَريع. التَّجميع
    اختياريّ (residential/commercial/fnb/transport/services/...).
*@

<StudioShell Title="@($"{L["studio.app_categories.title"]} {tenant?.Name ?? Slug}")" Active="home">
    <TopBarActions>
        <a class="st-btn st-btn-ghost" href="@($"/studio/apps/{Slug}")">← @L.Markup("studio.app_nav.settings")</a>
    </TopBarActions>
    <ChildContent>
        @if (tenant is null)
        {
            <div class="st-card">@L.Markup("studio.app.not_found")</div>
        }
        else
        {
            <div class="studio-page-head">
                <h1>@L.Markup("studio.app_categories.heading")</h1>
                <p>@L.Markup("studio.app_categories.intro_before")@tenant.Categories.Count @L.Markup("studio.app_categories.intro_after")</p>
            </div>

            @if (Saved == "1")    { <div class="st-chip st-chip-success" style="margin-bottom:14px;">@L.Markup("studio.app.saved") <AcIcon Name="check" Size="16" /></div> }
            @if (Err == "bad_format") { <div class="st-chip st-chip-danger"  style="margin-bottom:14px;">@L.Markup("studio.app_categories.err_format")</div> }
            @if (Err == "empty")  { <div class="st-chip st-chip-danger"  style="margin-bottom:14px;">@L.Markup("studio.app_categories.err_empty")</div> }

            <form method="post" action="@($"/studio/apps/{Slug}/categories/save")" id="cats-form" class="st-card">
                <p style="color:var(--st-muted);font-size:13px;margin:0 0 14px;">@((MarkupString)"\n                    ")@L.Markup("studio.app_categories.hint_before") = @L.Markup("studio.app_categories.hint_after")@((MarkupString)"\n                ")
                </p>

                <div class="ac-editor" id="cats-editor">
                    @foreach (var c in tenant.Categories.OrderBy(c => c.SortOrder))
                    {
                        <div class="ac-editor-row" data-cat-row>
                            <div class="ac-editor-row-head">
                                <input class="ac-input ac-cat-icon" value="@(c.Icon ?? "tag")" aria-label="@L["studio.app_categories.icon_label"]" />
                                <input class="ac-input ac-cat-label" placeholder="@L["studio.app_categories.name_placeholder"]" value="@c.Label" />
                                <button type="button" class="ac-icon-btn" data-remove-cat aria-label="@L["studio.app_categories.remove"]"><AcIcon Name="x" Size="14" /></button>
                            </div>
                            <div class="ac-editor-grid2">
                                <div>
                                    <span class="ac-chip-input-label">@L.Markup("studio.app_categories.slug_label")slug)</span>
                                    <input class="ac-input ac-cat-slug" placeholder="apartments" value="@c.Slug" style="direction:ltr;" />
                                </div>
                                <div>
                                    <span class="ac-chip-input-label">@L.Markup("studio.app_categories.kind_label")</span>
                                    <input class="ac-input ac-cat-kind" placeholder="residential" value="@c.Kind" list="kind-list" style="direction:ltr;" />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <datalist id="kind-list">
                    <option value="residential"></option>
                    <option value="commercial"></option>
                    <option value="roommate"></option>
                    <option value="vehicles"></option>
                    <option value="events"></option>
                    <option value="leisure"></option>
                </datalist>

                <button type="button" class="ac-add-row-btn" id="add-cat" style="margin-top:12px;">
                    <AcIcon Name="plus" Size="16" /> @L.Markup("studio.app_categories.add_row")@((MarkupString)"\n                ")
                </button>

                <textarea name="categories" id="cats-hidden" hidden>@CategoriesAsText(tenant.Categories)</textarea>

                <button type="submit" class="st-btn st-btn-primary" style="margin-top:16px;">@L.Markup("studio.app_categories.save")</button>
            </form>

            <template id="cat-row-tpl">
                <div class="ac-editor-row" data-cat-row>
                    <div class="ac-editor-row-head">
                        <input class="ac-input ac-cat-icon" value="tag" aria-label="@L["studio.app_categories.icon_label"]" />
                        <input class="ac-input ac-cat-label" placeholder="@L["studio.app_categories.name_placeholder"]" />
                        <button type="button" class="ac-icon-btn" data-remove-cat aria-label="@L["studio.app_categories.remove"]"><AcIcon Name="x" Size="14" /></button>
                    </div>
                    <div class="ac-editor-grid2">
                        <div>
                            <span class="ac-chip-input-label">@L.Markup("studio.app_categories.slug_label")slug)</span>
                            <input class="ac-input ac-cat-slug" placeholder="apartments" style="direction:ltr;" />
                        </div>
                        <div>
                            <span class="ac-chip-input-label">@L.Markup("studio.app_categories.kind_label")</span>
                            <input class="ac-input ac-cat-kind" placeholder="residential" list="kind-list" style="direction:ltr;" />
                        </div>
                    </div>
                </div>
            </template>
        }
    </ChildContent>
</StudioShell>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [SupplyParameterFromQuery] public string? Saved { get; set; }
    [SupplyParameterFromQuery] public string? Err   { get; set; }
    Tenant? tenant;

    protected override async Task OnInitializedAsync()
    {
        Auth.Load();
        if (!Auth.IsAuthenticated) return;
        tenant = await Tenants.FindAsync(Slug);
        if (tenant is not null && tenant.OwnerUserId != Auth.UserId!.Value) tenant = null;
    }

    static string CategoriesAsText(List<Category> cats)
        => string.Join("\n", cats.OrderBy(c => c.SortOrder)
            .Select(c => $"{c.Slug} | {c.Label} | {c.Icon ?? "tag"} | {c.Kind}"));
}
