@page "/{slug}/terms"
@page "/{slug}/r/{role}/terms"
@inject ITenantContext Tenant
@inject AuthSession Auth
@inject IHttpContextAccessor HttpCtx
@inject L L
@using ACommerce.Templates.Customer.Marketplace.Gates

@*
    صَفحَة قَبول الشُروط والأَحكام. تُعرَض إجبارِيّاً بَعد التَّسجيل
    قَبل أَيّ إجراء يَكتُب بَيانات (نَشر إعلان، تَقديم عَرض، رِسالَة، …).
    POST يَحفَظ AcceptedTermsAt + AcceptedTermsVersion عَلى User،
    ثُمَّ يَعود لِـ returnUrl.

    لِكُلّ مَتجَر يُمكِن لاحِقاً تَخصيص نَصّ الشُروط (TenantTermsHtml) —
    حاليّاً نَستَخدِم نَصّ عامّ.
*@

@{
    if (HttpCtx.HttpContext is { } ctx && Tenant.IsResolved)
    {
        Auth.SetTenant(Tenant.Slug);
        Auth.Load(ctx, Tenant.Slug);
    }
    var bouncePath = AuthSession.LinkFor(Slug, Role, "");
}

@if (!Auth.IsAuthenticated)
{
    <script>location.replace('@AuthSession.LinkFor(Slug, Role, "login")');</script>
}
else
{
    <div class="acs-page" style="max-width:680px;margin:0 auto;">
        <div style="text-align:center;padding-top:16px;">
            <div style="font-size:48px;"><AcIcon Name="file" Size="48" /></div>
            <h1 class="acm-wizard-title">@L.Markup("terms.page.title")</h1>
            <p style="color:var(--ac-text-muted);font-size:13px;">
                @Tenant.Name · @L.Markup("terms.page.version_label") @TermsPolicy.CurrentVersion
            </p>
        </div>

        <AcCard>
            <ChildContent>
                <div style="font-size:14px;line-height:2;color:var(--ac-text);">
                    @* ‏(2026-10-29، مُراجَعَةُ تَيّارِ S2 الجَولَة ١ — قَرارُ المالِك د20 «أ»): كانَ النَصُّ «لا نُشارِكها مَع أَطراف ثالِثَة بِدون إذنِكَ الصَّريح» —
                       الجُملَةُ الَّتي صَحَّحَها المالِكُ في مُوافَقَةِ الاستوديو، و`/privacy` §٥ تُسَمّي مُستَلِميها. صارَ يَقولُ ما تَقولُه الموافَقَة، والرابِطُ إلى السِياسَةِ
                       الَّتي تُسَمّيهِم (القاعِدَة ١٢: إحالَةٌ بِلا بابٍ لا تُبلَغ). مَحروسٌ في `StoreTermsPrivacyClaimTests`. *@
                    <p><strong>@L.Markup("terms.privacy.heading")</strong> @L.Markup("terms.privacy.body") <a href="/privacy">@L.Markup("terms.privacy.policy_link")</a></p>

                    <p><strong>@L.Markup("terms.transactions.heading")</strong> @L.Markup("terms.transactions.body")</p>

                    <p><strong>@L.Markup("terms.conduct.heading")</strong> @L.Markup("terms.conduct.body")</p>

                    <p><strong>@L.Markup("terms.changes.heading")</strong> @L.Markup("terms.changes.body")</p>

                    <p><strong>@L.Markup("terms.notifications.heading")</strong> @L.Markup("terms.notifications.body")</p>
                </div>

                <form method="post"
                      action="@($"/{Slug}/terms/accept?returnUrl={Uri.EscapeDataString(ReturnUrl ?? bouncePath)}")"
                      style="margin-top:20px;">
                    <label style="display:flex;gap:8px;align-items:flex-start;font-size:14px;">
                        <input type="checkbox" name="accept" required value="1"
                               style="margin-top:3px;flex-shrink:0;" />
                        <span>@L.Markup("terms.accept.checkbox")</span>
                    </label>
                    <div style="display:flex;gap:8px;margin-top:16px;">
                        @* ‏(‏2026-10-24، تَدقيقُ الإطلاق lens-dead-doors-2) «رَفضٌ وخُروج» كانَ رابِطَ GET إلى `…/logout` — ولا مَسارَ GET
                           لَه (‏404)، فَيَبقى المُستَخدِمُ مُسَجَّلاً. صارَ زِرّاً يُرسِلُ الاستِمارَةَ نَفسَها إلى `POST /{slug}/auth/logout`
                           (نَمَطُ `Me.razor`) بِلا شَرطِ مُربَّعِ القَبول. مَحروسٌ في `RouteResolutionTests`. *@
                        <button type="submit" class="ac-btn ac-btn-ghost"
                                formaction="@($"/{Slug}/auth/logout")" formnovalidate>@L.Markup("terms.accept.reject")</button>
                        <button type="submit" class="ac-btn ac-btn-primary ac-btn-block">
                            <AcIcon Name="check" Size="18" /> @L.Markup("terms.accept.submit")@((MarkupString)"\n                        ")
                        </button>
                    </div>
                </form>
            </ChildContent>
        </AcCard>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
}
