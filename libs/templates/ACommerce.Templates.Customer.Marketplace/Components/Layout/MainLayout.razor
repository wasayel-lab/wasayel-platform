@inherits LayoutComponentBase
@inject ITenantContext Tenant
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx
@inject AuthSession Auth
@inject L L
@inject Marten.IDocumentStore Store

@{
    var slug = Tenant.Slug;
    var brand = Tenant.BrandColor;
    var path = new Uri(Nav.Uri).AbsolutePath;
    var isLogin = path.Contains("/login", StringComparison.OrdinalIgnoreCase);

    // قائِمَة nav مُلائِمَة لِلدَور النَّشِط — تَحتاج load بِسيط.
    var (topItems, bottomItems) = BuildNav(slug, activeRoleSlug);
}

@if (Tenant.IsResolved)
{
    @* nav fixed-positioned: خارِج .acs-page حَتّى لا تُفَسَّر كَ overflow في فُحوص الـ runtime. *@
    @if (!isLogin)
    {
        <nav class="acm-mobile-nav" style="--ac-primary:@brand;">
            <div class="acm-mobile-nav-inner">
                <div class="acm-mobile-nav-brand">
                    <span class="acm-mobile-nav-brand-name">@Tenant.Name</span>
                </div>
                <div class="acm-mobile-nav-actions">
                    <a class="acm-mobile-nav-btn" href="@($"/{slug}/notifications")" aria-label="الإشعارات">
                        <AcIcon Name="bell" Size="24" />
                    </a>
                </div>
            </div>
        </nav>
    }

    <div class="acs-page" style="--ac-primary:@brand; --ac-primary-dark:@brand; --ac-primary-light:@brand; --ac-primary-hover:@brand;">
        @if (!isLogin)
        {
            <div class="acm-v2-topnav-wrap">
                <AcTopNav Items="topItems">
                    <BrandContent>
                        <div class="acm-brand">
                            <span class="acm-brand-text">@Tenant.Name</span>
                        </div>
                    </BrandContent>
                    <RightActions>
                        <form method="post" action="/lang/@(L.IsArabic ? "en" : "ar")" style="margin:0;">
                            <input type="hidden" name="return" value="@Nav.Uri" />
                            <button type="submit" class="ac-lang-toggle"
                                    aria-label="Toggle language">
                                @(L.IsArabic ? "EN" : "AR")
                            </button>
                        </form>
                    </RightActions>
                </AcTopNav>
            </div>
        }

        <main>
            @Body

            @if (!isLogin)
            {
                <div class="acm-v2-bottom-nav-wrap">
                    <AcBottomNav Items="bottomItems" ExtraClass="acm-v2-bottomnav" />
                </div>
            }
        </main>
    </div>
}
else
{
    <div class="acs-page" style="--ac-primary:#1D4ED8;">
        <main>@Body</main>
    </div>
}

@code {
    string activeRoleSlug = "";

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.IsResolved && HttpCtx.HttpContext is { } ctx)
        {
            Auth.SetTenant(Tenant.Slug);
            Auth.Load(ctx, Tenant.Slug);

            // قِراءَة الدَور النَّشِط لِبِناء nav المُلائِم. خَطَأ DB لا يَكسِر الـ layout.
            if (Auth.IsAuthenticated && Auth.UserId.HasValue)
            {
                try
                {
                    await using var s = Store.QuerySession(Tenant.Slug);
                    var me = await s.LoadAsync<ACommerce.Kit.Auth.User>(Auth.UserId.Value);
                    if (me is not null) activeRoleSlug = me.ActiveRole ?? "";
                }
                catch { /* ignore — nav يَسقُط لِلافتراضيّ */ }
            }
        }
    }

    // قائِمَة عَناصِر nav حَسَب الدَور النَّشِط — كُلّ دَور لَه قائِمَة
    // مُختَلِفَة. القَوالِب الَّتي لا تَنطَبِق عَلى الدَور لا تُعرَض.
    static (List<AcTopNav.TopNavItem> Top, List<ACommerce.Templates.Shared.Models.BottomNavItemDto> Bottom)
        BuildNav(string slug, string roleSlug)
    {
        var ar = (
            Top:    new List<AcTopNav.TopNavItem>(),
            Bottom: new List<ACommerce.Templates.Shared.Models.BottomNavItemDto>()
        );

        void Add(string href, string label, string icon, bool exact = false)
        {
            ar.Top.Add(new(href, label, icon, null, exact));
            ar.Bottom.Add(new() { Href = href, Label = label, IconName = icon, Exact = exact });
        }

        // الرَّئيسِيَّة دائِماً
        Add($"/{slug}", "الرَئيسيّة", "home", exact: true);

        switch (roleSlug)
        {
            case "rider":
                Add($"/{slug}/me/listings", "طَلَباتي",  "package");
                Add($"/{slug}/chats",       "رَسائل",    "message");
                break;
            case "driver":
            case "shipper":
                Add($"/{slug}/explore",      "مَشاوير",   "search");
                Add($"/{slug}/me/offers",    "عُروضي",     "package");
                Add($"/{slug}/me/searches",  "إشعارات",   "bell");
                Add($"/{slug}/chats",        "رَسائل",     "message");
                break;
            case "vendor":
            case "host":
                Add($"/{slug}/me/listings",  "إعلاناتي",  "package");
                Add($"/{slug}/chats",        "رَسائل",     "message");
                Add($"/{slug}/notifications","إشعارات",   "bell");
                break;
            case "tenant_admin":
                Add($"/{slug}/manage",       "إدارَة",     "settings");
                Add($"/{slug}/chats",        "رَسائل",     "message");
                Add($"/{slug}/notifications","إشعارات",   "bell");
                break;
            default:
                // customer + لا دَور = القائِمَة الكَلاسيكِيَّة
                Add($"/{slug}/explore",      "استِكشاف",   "search");
                Add($"/{slug}/favorites",    "مُفَضَّلَة",     "heart");
                Add($"/{slug}/chats",        "رَسائل",     "message");
                Add($"/{slug}/notifications","إشعارات",   "bell");
                break;
        }

        // حِسابي دائِماً آخِراً
        ar.Top.Add(new($"/{slug}/me", "حِسابي", "user"));
        ar.Bottom.Add(new() { Href = $"/{slug}/me", Label = "حِسابي", IconName = "user" });
        return ar;
    }
}
