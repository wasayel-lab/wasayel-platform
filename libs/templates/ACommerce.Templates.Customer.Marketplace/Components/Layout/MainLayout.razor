@inherits LayoutComponentBase
@inject ITenantContext Tenant
@inject NavigationManager Nav
@inject IHttpContextAccessor HttpCtx
@inject AuthSession Auth
@inject L L
@inject Marten.IDocumentStore Store
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantRoleService Roles
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantThemeService Themes

@{
    var slug = Tenant.Slug;
    var brand = Tenant.BrandColor;
    var path = new Uri(Nav.Uri).AbsolutePath;
    var isLogin = path.Contains("/login", StringComparison.OrdinalIgnoreCase);

    // إخفاء nav عَلى صَفحَة اختِيار التَّطبيق الفَرعيّ — لا nav قَبل
    // أَن يَختار المُستَخدِم دَوراً، فَالـ tabs لا تَنطَبِق بَعد.
    var trimmed = path.TrimEnd('/');
    var isEntry = trimmed.Equals($"/{slug}", StringComparison.OrdinalIgnoreCase) &&
                  tenantHasRoles && !Auth.IsAuthenticated;
    var chromeHidden = isLogin || isEntry;

    // الدَور المُستَخرَج مِن URL (لِبِناء روابِط /r/{role}/ في الـ nav).
    var urlRole = AuthSession.ExtractRoleFromPath(new PathString(path));

    var (topItems, bottomItems) = BuildNav(slug, activeRoleSlug, urlRole);
}

@if (Tenant.IsResolved)
{
    @* nav fixed-positioned: خارِج .acs-page حَتّى لا تُفَسَّر كَ overflow في فُحوص الـ runtime. *@
    @if (!chromeHidden)
    {
        <nav class="acm-mobile-nav" style="--ac-primary:@brand;">
            <div class="acm-mobile-nav-inner">
                <div class="acm-mobile-nav-brand">
                    <span class="acm-mobile-nav-brand-name">@Tenant.Name</span>
                </div>
                <div class="acm-mobile-nav-actions">
                    <a class="acm-mobile-nav-btn" href="@($"/{slug}/notifications")" aria-label="الإشعارات">
                        <AcIcon Name="bell" Size="24" />
                    </a>
                </div>
            </div>
        </nav>
    }

    <div class="acs-page" style="--ac-primary:@brand; --ac-primary-dark:@brand; --ac-primary-light:@brand; --ac-primary-hover:@brand;">
        @if (!chromeHidden)
        {
            <div class="acm-v2-topnav-wrap@(theme.VariantClassSuffix(ACommerce.Kit.Theme.ThemeVariantCatalog.HeaderBar))">
                <AcTopNav Items="topItems">
                    <BrandContent>
                        <div class="acm-brand">
                            <span class="acm-brand-text">@Tenant.Name</span>
                        </div>
                    </BrandContent>
                    <RightActions>
                        <form method="post" action="/lang/@(L.IsArabic ? "en" : "ar")" style="margin:0;">
                            <input type="hidden" name="return" value="@Nav.Uri" />
                            <button type="submit" class="ac-lang-toggle"
                                    aria-label="Toggle language">
                                @(L.IsArabic ? "EN" : "AR")
                            </button>
                        </form>
                    </RightActions>
                </AcTopNav>
            </div>
        }

        <main>
            @Body

            @if (!chromeHidden)
            {
                <div class="acm-v2-bottom-nav-wrap">
                    <AcBottomNav Items="bottomItems" ExtraClass="acm-v2-bottomnav" />
                </div>
            }
        </main>
    </div>
}
else
{
    <div class="acs-page" style="--ac-primary:#1D4ED8;">
        <main>@Body</main>
    </div>
}

@code {
    string activeRoleSlug = "";
    bool tenantHasRoles;

    /// <summary>لَقطَة أَدوار المَتجَر — <b>مَوضِع الالتِقاط في
    /// التَّنَقُّل</b>: فَتحَة <c>nav</c> لِدَور مُؤَلَّف تُقرَأ مِن
    /// تَعريفِه. بِلا تَأليف هي قاعِدَة المَنصَّة، فَالشَّريط كَما كان.</summary>
    ACommerce.Kit.Roles.TenantRoleSet roleSet = ACommerce.Kit.Roles.TenantRoleSet.Platform;

    /// <summary>ثيم المَتجَر — <b>مَوضِع الالتِقاط في الترويسَة</b>.
    /// مُهَيَّأ إلى قاعِدَة المَنصَّة: صَفَحات المَنصَّة نَفسِها (بِلا
    /// مُستَأجِر) لا تَستَعلِم أَصلاً، والفَرع الآخَر لا شَريط فيه.</summary>
    ACommerce.Kit.Theme.EffectiveTheme theme = ACommerce.Kit.Theme.ThemeCatalog.Default;

    string? listingPattern;
    int unreadMessages;
    int unreadNotifications;

    protected override async Task OnInitializedAsync()
    {
        if (Tenant.IsResolved && HttpCtx.HttpContext is { } ctx)
        {
            Auth.SetTenant(Tenant.Slug);
            Auth.Load(ctx, Tenant.Slug);

            theme = await Themes.EffectiveAsync(Tenant.Slug);

            // اِكتَشِف هَل لِلمَتجَر أَدوار — تَحديد عَرض الـ landing.
            try
            {
                var withRoles = await Roles.LoadAsync(Tenant.Slug);
                var t = withRoles.Tenant;
                roleSet = withRoles.Roles;
                tenantHasRoles = t is not null && t.Roles.Count > 0;
                // اِشتِقاق النَّمَط لِتَحديد ظُهور السَّلَّة: فَئات «menu»
                // (مَقاهي/مَطاعِم) أَو غِياب الأَدوار العَقارِيَّة = marketplace.
                if (t is not null)
                {
                    var kinds = t.Categories.Select(c => c.Kind).ToHashSet();
                    var roleCats = t.Roles.Select(r => r.CatalogSlug).ToHashSet();
                    listingPattern =
                        roleCats.Contains("rider") || roleCats.Contains("driver") ? "trip" :
                        roleCats.Contains("host") || kinds.Contains("residential") ||
                        kinds.Contains("commercial") || kinds.Contains("roommate") ? "rental" :
                        "marketplace";
                }
            }
            catch { /* ignore */ }

            if (Auth.IsAuthenticated && Auth.UserId.HasValue)
            {
                try
                {
                    await using var s = Store.QuerySession(Tenant.Slug);
                    var me = await s.LoadAsync<ACommerce.Kit.Auth.User>(Auth.UserId.Value);
                    // الـ URL يَتَفَوَّق عَلى user.ActiveRole — السبَب: نَفس
                    // المُستَخدِم قَد يَكون مُسَجَّلاً بِدَورَين في تَبويبَين،
                    // فَالـ DB حَقل واحِد بَينَما الـ URL يُحَدِّد كُلّ تَبويب.
                    var currentPath = new Uri(Nav.Uri).AbsolutePath;
                    var urlRoleInit = AuthSession.ExtractRoleFromPath(new PathString(currentPath));
                    activeRoleSlug = urlRoleInit ?? me?.ActiveRole ?? "";

                    // عَدّاد المُحادَثات الَّتي فيها رَسائِل جَديدَة لي.
                    // Conversation تَخزِنها كَ OwnerUnread / PartnerUnread —
                    // الرَسائِل الَّتي أَرسَلتُها أَنا لا تَزيد عَدّادي
                    // (الـ /chats/{id}/send يَزيد عَدّاد الطَّرَف الآخَر فَقَط).
                    var convs = await s.Query<ACommerce.Kit.Chat.Conversation>()
                        .Where(c => c.OwnerId == Auth.UserId.Value || c.PartnerId == Auth.UserId.Value)
                        .ToListAsync();
                    unreadMessages = convs.Count(c =>
                        (c.OwnerId == Auth.UserId.Value   && c.OwnerUnread > 0) ||
                        (c.PartnerId == Auth.UserId.Value && c.PartnerUnread > 0));

                    unreadNotifications = await s.Query<ACommerce.Kit.Notifications.Notification>()
                        .CountAsync(n => n.UserId == Auth.UserId.Value && !n.IsRead);
                }
                catch { /* ignore — nav يَسقُط لِلافتراضيّ */ }
            }
        }
    }

    // قائِمَة عَناصِر nav حَسَب الدَور النَّشِط — مَع badge عَلى الرَسائِل
    // والإشعارات. <paramref name="urlRole"/> يُحَدِّد البادِئَة /r/{role}/
    // لِكُلّ رابِط داخِل التَّطبيق الفَرعيّ، فَكُلّ التَنَقُّل يَبقَى داخِل
    // الـ session role-scoped.
    (List<AcTopNav.TopNavItem> Top, List<ACommerce.Templates.Shared.Models.BottomNavItemDto> Bottom)
        BuildNav(string slug, string roleSlug, string? urlRole)
    {
        var ar = (
            Top:    new List<AcTopNav.TopNavItem>(),
            Bottom: new List<ACommerce.Templates.Shared.Models.BottomNavItemDto>()
        );

        string Link(string path) => AuthSession.LinkFor(slug, urlRole, path);

        // الشَّريط السُّفليّ في الهاتِف يَجِب أَلّا يَتَجاوَز ٥ تَبويبات
        // (مِعيار تَطبيقات احتِرافِيَّة). الزائِد عَنها يَظهَر في nav الحاسوب
        // العُلويّ + في صَفحَة «حِسابي» (hub). نُمَرِّر bottom:false لِلزائِد.
        void Add(string path, string label, string icon, bool exact = false,
                 int? badge = null, bool bottom = true)
        {
            var href = Link(path);
            ar.Top.Add(new(href, label, icon, badge, exact));
            if (bottom)
                ar.Bottom.Add(new() { Href = href, Label = label, IconName = icon, Exact = exact, Badge = badge });
        }

        Add("", "الرَئيسيّة", "home", exact: true);

        var msgBadge   = unreadMessages > 0      ? (int?)unreadMessages      : null;
        var notifBadge = unreadNotifications > 0 ? (int?)unreadNotifications : null;

        // أَيّ نَمَط يَستَخدِم السَّلَّة؟ (cafe/grocery/marketplace). أَنماط
        // الإيجار/السَكَن المُشتَرَك/المَشاوير لا سَلَّة فيها — نُخفيها.
        var usesCart = listingPattern is "marketplace" or "service" or null
                       && roleSlug is not ("rider" or "driver" or "shipper" or "host");

        // ٥ تَبويبات: رَئيسيّة + استِكشاف + مُفَضَّلَة + رَسائل + حِسابي.
        // (الصَّفقات/السَّلَّة/الإشعارات في nav الحاسوب + صَفحَة حِسابي.)
        void DefaultTabs()
        {
            Add("explore",      "استِكشاف", "search");
            Add("favorites",    "مُفَضَّلَة",   "heart");
            Add("chats",        "رَسائل",   "message", badge: msgBadge);
            Add("deals",        "صَفقاتي",  "receipt", bottom: false);
            if (usesCart) Add("cart", "السَّلَّة", "package", bottom: false);
            Add("notifications","إشعارات",  "bell",    badge: notifBadge, bottom: false);
        }

        // قاموس مُغلَق: قيمَة فَتحَة nav ← مَندوب بِناء التَّبويبات.
        var navTable = new Dictionary<string, Action>(StringComparer.Ordinal)
        {
            [ACommerce.Kit.Roles.RoleComponents.RiderNav] = () =>
            {
                // ٤ تَبويبات: رَئيسيّة + طَلَباتي + رَسائل + حِسابي.
                Add("me/listings",  "طَلَباتي", "package");
                Add("chats",        "رَسائل",   "message", badge: msgBadge);
                Add("notifications","إشعارات",  "bell",    badge: notifBadge, bottom: false);
            },
            [ACommerce.Kit.Roles.RoleComponents.DriverNav] = () =>
            {
                // ٥ تَبويبات: رَئيسيّة + مَشاوير + عُروضي + رَسائل + حِسابي.
                Add("explore",      "مَشاوير",  "search");
                Add("me/offers",    "عُروضي",   "package");
                Add("chats",        "رَسائل",   "message", badge: msgBadge);
                Add("me/searches",  "بَحثي",    "bell",    badge: notifBadge, bottom: false);
                Add("notifications","إشعارات",  "bell",    badge: notifBadge, bottom: false);
            },
            [ACommerce.Kit.Roles.RoleComponents.VendorNav] = () =>
            {
                // ٥ تَبويبات: رَئيسيّة + إعلاناتي + صَفقات + رَسائل + حِسابي.
                Add("me/listings",  "إعلاناتي", "package");
                Add("deals",        "صَفقات",   "receipt");
                Add("chats",        "رَسائل",   "message", badge: msgBadge);
                Add("notifications","إشعارات",  "bell",    badge: notifBadge, bottom: false);
            },
            [ACommerce.Kit.Roles.RoleComponents.AdminNav] = () =>
            {
                // ٤ تَبويبات: رَئيسيّة + إدارَة + رَسائل + حِسابي.
                Add("manage",       "إدارَة",   "settings");
                Add("chats",        "رَسائل",   "message", badge: msgBadge);
                Add("notifications","إشعارات",  "bell",    badge: notifBadge, bottom: false);
            },
            [ACommerce.Kit.Roles.RoleComponents.DefaultNav] = DefaultTabs,
        };

        ACommerce.Kit.Roles.RoleComponentMap.Map(
            navTable,
            roleSet.ResolveComposition(roleSlug).Nav,
            DefaultTabs,
            "التَّنَقُّل")();

        var meHref = Link("me");
        ar.Top.Add(new(meHref, "حِسابي", "user"));
        ar.Bottom.Add(new() { Href = meHref, Label = "حِسابي", IconName = "user" });
        return ar;
    }
}
