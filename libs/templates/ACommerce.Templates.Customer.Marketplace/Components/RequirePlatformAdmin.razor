@inject Services.PlatformAdminGuard Guard
@using ACommerce.Templates.Customer.Marketplace.Services
@inject L L

@*
    مُكَوِّن يَفحَص أَنّ المُستَخدِم مُسَجَّل وَيَملِك صَلاحيَّة platform_admin.
    لَو فَشِلَ يَعرِض رِسالَة دُخول/مَنع، وَإلّا يَعرِض @@ChildContent.

    القَرار نَفسُه لا يَسكُن هُنا — هُوَ في Services.PlatformAdminGuard،
    نَفس التَّعريف الَّذي تَقرَؤُه نِقاط الـ POST على مُستَوى المَنصَّة.
    كانَ مَكتوباً هُنا وَمَرَّةً ثانِيَة في نُقطَة suspend، فَانفَرَدَت
    الصَفَحات الأُخرى بِلا حارِس أَصلاً.
*@

@switch (_state)
{
    case State.Loading:
        <div style="padding:60px;text-align:center;color:var(--ac-text-muted);">
            @((MarkupString)"\n            ")@L.Markup("admin.guard.checking")@((MarkupString)"\n        ")
        </div>
        break;
    case State.NeedAuth:
        <div class="studio-root">
            <div class="auth-wrap">
                <div class="auth-card" style="text-align:center;">
                    <div class="auth-logo-mark"><AcIcon Name="shield" Size="28" /></div>
                    <h1 class="auth-title">@L.Markup("admin.guard.need_auth_title")</h1>
                    <p class="auth-sub">@L.Markup("admin.guard.need_auth_sub")</p>
                    <a class="st-btn st-btn-primary st-btn-block st-btn-lg"
                       href="/studio/auth">@L.Markup("auth.action.login")</a>
                </div>
            </div>
        </div>
        break;
    case State.Forbidden:
        <div class="studio-root">
            <div class="auth-wrap">
                <div class="auth-card" style="text-align:center;">
                    <div class="auth-logo-mark" style="background:linear-gradient(135deg,#dc2626,#ea580c);"><AcIcon Name="alert-circle" Size="28" /></div>
                    <h1 class="auth-title">@L.Markup("admin.guard.forbidden_title")</h1>
                    <p class="auth-sub">@L.Markup("admin.guard.forbidden_sub")</p>
                    <a class="st-btn st-btn-primary st-btn-block" href="/studio">@L.Markup("admin.nav.my_board")</a>
                </div>
            </div>
        </div>
        break;
    case State.Allowed:
        @ChildContent
        break;
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    enum State { Loading, NeedAuth, Forbidden, Allowed }
    State _state = State.Loading;

    protected override async Task OnInitializedAsync()
    {
        var decision = await Guard.EvaluateAsync();
        _state = decision.Outcome switch
        {
            PlatformAdminOutcome.Allowed  => State.Allowed,
            PlatformAdminOutcome.NotAdmin => State.Forbidden,
            _                             => State.NeedAuth
        };
    }
}
