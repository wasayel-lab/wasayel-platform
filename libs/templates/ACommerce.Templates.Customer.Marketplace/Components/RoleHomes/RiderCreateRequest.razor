@inject ACommerce.Templates.Customer.Marketplace.Services.DynamicAttributesService DynAttrs
@inject L L

@*
    نَموذَج إنشاء طَلَب مِشوار — مَيدان pickup/dropoff ثابِت (الحَدّ
    الأَدنَى لِأَيّ مَتجَر مَشاوير)، ثُمّ الخَصائِص الديناميكِيَّة الَّتي
    يُعَرِّفها مُصَمِّم المَتجَر عَلى الفِئَة (مَثَلاً نَوع المَركَبَة
    المَطلوبَة، عَدَد الرُكّاب، وَقت الانطِلاق…) تَظهَر بَعدُ بِشَكل
    تِلقائيّ. هكَذا يَكون لِلمُصَمِّم مَرونَة.
*@

<div class="acs-page">
    <a class="ac-btn ac-btn-ghost ac-btn-sm" href="@($"/{Slug}")">
        <AcIcon Name="arrow-right" Size="16" /> @L.Markup("rider.request.back")@((MarkupString)"\n    ")
    </a>

    <h1 class="acm-wizard-title">@L.Markup("roles.rider.new_request")</h1>
    <p style="color:var(--ac-text-muted);font-size:14px;margin:0 0 16px;">
        @((MarkupString)"\n        ")@L.Markup("rider.request.subtitle")@((MarkupString)"\n    ")
    </p>

    @if (Err == "invalid")
    {
        <AcAlert Variant="danger" Message="@(L["rider.request.err_invalid"])" />
    }
    else if (Err == "forbidden")
    {
        <AcAlert Variant="danger" Message="@(L["rider.request.err_forbidden"])" />
    }

    @if (DefaultCategory is null)
    {
        <AcAlert Variant="warning"
                 Message="@(L["rider.request.err_no_category"])" />
    }
    else
    {
        <form method="post" action="@($"/{Slug}/listings/create")">
            <input type="hidden" name="category"             value="@DefaultCategory.Slug" />
            @* `value` تَبقى حَرفِيَّة — عُنصُر ساكِن بِالكامِل، وتَرحيلُه
               يَقلِبُه ديناميكِيّاً فَتَتَبَدَّل بايتاتُه (‏مَراجِع رَقَمِيَّة،
               و`<input …>` يَصير `<input … />`). نَفس مُؤَجَّل `alt` في
               `Landing`، ومَقيسٌ هُناكَ بِبَوّابَةٍ احمَرَّت. *@
            <input type="hidden" name="title"                value="طَلَب مِشوار" />
            <input type="hidden" name="attr_accepts_offers"  value="true" />

            <AcCard>
                <ChildContent>
                    <AcLocationInput Name="attr_pickup"  Label="@(L["rider.request.pickup"])"  Required="true" />
                    <div style="height:12px;"></div>
                    <AcLocationInput Name="attr_dropoff" Label="@(L["rider.request.dropoff"])"   Required="true" />
                </ChildContent>
            </AcCard>

            @* خَصائِص ديناميكِيَّة لِفِئَة المَشاوير — مُعَرَّفَة مِن
               /admin/tenants/{slug}/attributes عَلى نِطاق الفِئَة. لَو لَم
               يُعَرِّف المُصَمِّم أَيّاً، لا يَظهَر هذا الـ Card. *@
            @if (dynFields is { Count: > 0 })
            {
                <AcCard>
                    <ChildContent>
                        <h3 style="margin-top:0;font-size:14px;">@L.Markup("rider.request.extra_details")</h3>
                        @foreach (var f in dynFields)
                        {
                            <AcField Label="@f.Label" Required="@f.IsRequired">
                                @RenderDynInput(f)
                            </AcField>
                        }
                    </ChildContent>
                </AcCard>
            }

            <AcCard>
                <ChildContent>
                    <AcField Label="@(L["rider.request.notes"])">
                        @* و`placeholder` كَذلك مُؤَجَّلَة — `<textarea>` ساكِن بِالكامِل. *@
                        <textarea name="description" rows="3" maxlength="400"
                                  class="ac-input" style="resize:vertical;font-family:inherit;"
                                  placeholder="مَثَلاً: مَع طِفل، أَو وَزن أَمتِعَة، أَو وَقت الوُصول المُفَضَّل…"></textarea>
                    </AcField>

                    <AcField Label="@(L.Format("rider.request.suggested_price", Money.Unit(style: MoneyUnitStyle.Name)))">
                        <input type="number" name="price" min="0" step="1"
                               class="ac-input" inputmode="numeric" placeholder="0" value="0" />
                    </AcField>

                    <input type="hidden" name="city"     value="@(DefaultCity ?? "")" />
                    <input type="hidden" name="district" value="—" />
                </ChildContent>
            </AcCard>

            <button type="submit" class="ac-btn ac-btn-primary ac-btn-lg ac-btn-block" style="margin-top:16px;">
                <AcIcon Name="send" Size="18" /> @L.Markup("rider.request.submit")@((MarkupString)"\n            ")
            </button>
        </form>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [Parameter] public Tenant? Tenant { get; set; }
    [Parameter] public string? Err { get; set; }

    Category? DefaultCategory =>
        Tenant?.Categories.OrderBy(c => c.SortOrder).FirstOrDefault();

    string? DefaultCity => Tenant?.City;

    IReadOnlyList<ACommerce.Templates.Customer.Marketplace.Services.DynField>? dynFields;

    protected override async Task OnParametersSetAsync()
    {
        if (DefaultCategory is not null)
            dynFields = await DynAttrs.GetForListingCategoryAsync(Slug, DefaultCategory.Slug);
    }

    RenderFragment RenderDynInput(ACommerce.Templates.Customer.Marketplace.Services.DynField f) => @<text>
        @{ var name = "attr_" + f.Code; }
        @switch (f.Type)
        {
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Number:
                <input type="number" name="@name" class="ac-input"
                       required="@f.IsRequired" inputmode="numeric" />
                break;
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.LongText:
                <textarea name="@name" rows="2" class="ac-input"
                          required="@f.IsRequired" style="resize:vertical;font-family:inherit;"></textarea>
                break;
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Boolean:
                <label style="display:inline-flex;align-items:center;gap:8px;">
                    <input type="checkbox" name="@name" value="true" />
                    <span>@L.Markup("common.option.yes")</span>
                </label>
                break;
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.SingleSelect:
                <select name="@name" class="ac-input" required="@f.IsRequired">
                    <option value="">@L.Markup("common.option.choose")</option>
                    @foreach (var o in f.Options) { <option value="@o.Value">@o.Label</option> }
                </select>
                break;
            case ACommerce.Templates.Customer.Marketplace.Services.DynFieldType.Date:
                <input type="date" name="@name" class="ac-input" required="@f.IsRequired" />
                break;
            default:
                <input type="text" name="@name" class="ac-input"
                       required="@f.IsRequired" maxlength="200" />
                break;
        }
    </text>;
}
