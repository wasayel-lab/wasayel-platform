@inject IDocumentStore Store
@inject AuthSession Auth
@inject L L

@*
    صَفحَة الراكِب الرَّئيسِيَّة — لا hero بَحث، لا rail "مُمَيَّز".
    البَطَل المَركَزيّ: "اِنشُر طَلَب مِشوار"، وَ تَحتَه طَلَباتي السابِقَة.
*@

<div class="acm-role-home acm-role-home-rider">
    <header class="acm-role-home-head">
        <h2>@(Greeting)</h2>
        <p>@L.Markup("roles.rider.subtitle")</p>
    </header>

    <a class="acm-role-cta-primary" href="@AuthSession.LinkFor(Slug, Role, $"create-listing")">
        <span class="acm-role-cta-icon"><AcIcon Name="map-pin" Size="22" /></span>
        <span class="acm-role-cta-label">
            <strong>@L.Markup("roles.rider.new_request")</strong>
            <small>@L.Markup("roles.rider.new_request_hint")</small>
        </span>
        <AcIcon Name="chevron-left" Size="20" />
    </a>

    <a class="acm-role-cta-pill" href="@AuthSession.LinkFor(Slug, Role, $"drivers")"
       style="display:block;text-align:center;padding:14px;margin-bottom:16px;text-decoration:none;">
        <strong style="font-size:14px;color:var(--ac-text);">
            <AcIcon Name="user" Size="14" /> @L.Markup("roles.rider.browse_drivers")@((MarkupString)"\n        ")
        </strong>
        <span style="font-size:11px;color:var(--ac-text-muted);display:block;margin-top:2px;">
            @((MarkupString)"\n            ")@L.Markup("roles.rider.contact_driver")@((MarkupString)"\n        ")
        </span>
    </a>

    @if (myRequests is null)
    {
        <AcLoadingState />
    }
    else if (myRequests.Count > 0)
    {
        <AcSectionHeader Title="@(L["roles.rider.my_requests_title"])" />
        <div class="acm-role-list">
            @foreach (var (l, offers, matched) in myRequests)
            {
                <a class="acm-role-request-card" href="@AuthSession.LinkFor(Slug, Role, $"listings/{l.Id}")">
                    <div style="flex:1;min-width:0;">
                        <strong>@l.Title</strong>
                        <span class="ac-muted" style="font-size:12px;display:block;">
                            @l.City — @l.District · @l.CreatedAt.ToString("HH:mm")
                        </span>
                    </div>
                    @if (matched)
                    {
                        <span class="ac-chip ac-chip-sm" style="background:#dcfce7;color:#166534;"><AcIcon Name="check" Size="14" /> @L.Markup("roles.rider.matched")</span>
                    }
                    else if (offers > 0)
                    {
                        <span class="ac-chip ac-chip-sm" style="background:color-mix(in srgb,var(--ac-primary) 15%,transparent);">
                            @offers @L.Markup("common.unit.offer")@((MarkupString)"\n                        ")
                        </span>
                    }
                    else
                    {
                        <span class="ac-chip ac-chip-sm">@L.Markup("roles.rider.waiting_drivers")</span>
                    }
                </a>
            }
        </div>
    }
    else if (Auth.IsAuthenticated)
    {
        <div class="acm-role-empty">
            <AcIcon Name="map" Size="36" />
            <p>@L.Markup("roles.rider.empty")</p>
        </div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }

    List<(Listing Listing, int Offers, bool Matched)>? myRequests;

    string Greeting => string.IsNullOrEmpty(Auth.UserName)
        ? L["roles.greeting.rider_plain_dest"]
        : L.Format("roles.greeting.rider_named", Auth.UserName);

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsAuthenticated || Auth.UserId is null) return;
        await using var s = Store.QuerySession(Slug);
        var meId = Auth.UserId.Value.ToString();
        var all = (await s.Query<Listing>().Where(l => !l.IsDeleted).ToListAsync())
            .Where(l => l.Attributes.TryGetValue("owner_id", out var oid) && oid == meId)
            .OrderByDescending(l => l.CreatedAt)
            .Take(8)
            .ToList();

        var result = new List<(Listing, int, bool)>(all.Count);
        foreach (var l in all)
        {
            var matched = await s.LoadAsync<ACommerce.Kit.Offers.ListingMatch>(l.Id);
            var count = await s.Query<ACommerce.Kit.Offers.Offer>()
                .CountAsync(o => o.ListingId == l.Id
                              && o.Status == ACommerce.Kit.Offers.OfferStatus.Pending);
            result.Add((l, count, matched is not null));
        }
        myRequests = result;
    }
}
