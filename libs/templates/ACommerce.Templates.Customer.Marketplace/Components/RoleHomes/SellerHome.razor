@inject IDocumentStore Store
@inject AuthSession Auth
@inject L L

@*
    قالِب البائِع المُشتَرَك (vendor + host) — لَوحَة "إعلاناتي" مَع
    إجراءات سَريعَة. يَختَلِف عَن RiderHome في أَنّ الإعلانات هُنا
    مَخزون دائِم (سَكَن/سَلعَة) لا طَلَب مُؤَقَّت.
*@

<div class="acm-role-home acm-role-home-seller">
    <header class="acm-role-home-head">
        <h2>@(Greeting)</h2>
        <p>@(Subtitle)</p>
    </header>

    <a class="acm-role-cta-primary" href="@AuthSession.LinkFor(Slug, Role, $"create-listing")">
        <span class="acm-role-cta-icon"><AcIcon Name="plus" Size="22" /></span>
        <span class="acm-role-cta-label">
            <strong>@L.Markup("roles.hero.new_listing")</strong>
            <small>@L.Markup("roles.seller.new_listing_hint")</small>
        </span>
        <AcIcon Name="chevron-left" Size="20" />
    </a>

    <div class="acm-role-cta-row">
        <div class="acm-role-cta-pill" style="cursor:default;">
            <strong>@activeCount</strong>
            <span>@L.Markup("roles.seller.active_listings")</span>
        </div>
        <div class="acm-role-cta-pill" style="cursor:default;">
            <strong>@totalViews</strong>
            <span>@L.Markup("roles.seller.views")</span>
        </div>
        <a class="acm-role-cta-pill" href="@AuthSession.LinkFor(Slug, Role, $"chats")">
            <strong>@conversations</strong>
            <span>@L.Markup("roles.seller.conversations")</span>
        </a>
    </div>

    @if (myListings is null)
    {
        <AcLoadingState />
    }
    else if (myListings.Count == 0)
    {
        <div class="acm-role-empty">
            <AcIcon Name="package" Size="36" />
            <p>@L.Markup("roles.seller.empty")</p>
        </div>
    }
    else
    {
        <AcSectionHeader Title="@(L["roles.hero.my_listings"])"
                         ActionLabel="@(myListings.Count > 6 ? L["roles.seller.all_listings"] : null)"
                         ActionHref="@AuthSession.LinkFor(Slug, Role, $"me/listings")" />
        <div class="acm-role-list">
            @foreach (var l in myListings.Take(6))
            {
                <a class="acm-role-request-card" href="@AuthSession.LinkFor(Slug, Role, $"listings/{l.Id}")">
                    <div style="flex:1;min-width:0;">
                        <strong>@l.Title</strong>
                        <span class="ac-muted" style="font-size:12px;display:block;">
                            @l.CategorySlug · @l.City — @l.District
                        </span>
                    </div>
                    <span class="acm-details-price" style="font-size:14px;">
                        @((MarkupString)Money.Format(l.Price, style: MoneyUnitStyle.Name))
                    </span>
                </a>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [Parameter] public string RoleSlug { get; set; } = "vendor";

    List<Listing>? myListings;
    int activeCount;
    int totalViews;
    int conversations;

    string Greeting => RoleSlug switch
    {
        "host" => string.IsNullOrEmpty(Auth.UserName) ? L["roles.greeting.host"] : L.Format("roles.greeting.named", Auth.UserName),
        _      => string.IsNullOrEmpty(Auth.UserName) ? L["roles.greeting.vendor"]   : L.Format("roles.greeting.named", Auth.UserName)
    };

    string Subtitle => RoleSlug switch
    {
        "host" => L["roles.subtitle.host"],
        _      => L["roles.subtitle.vendor"],
    };

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsAuthenticated || Auth.UserId is null) return;
        await using var s = Store.QuerySession(Slug);
        var meId = Auth.UserId.Value.ToString();
        myListings = (await s.Query<Listing>().Where(l => !l.IsDeleted).ToListAsync())
            .Where(l => l.Attributes.TryGetValue("owner_id", out var oid) && oid == meId)
            .OrderByDescending(l => l.CreatedAt).ToList();
        activeCount = myListings.Count;
        totalViews  = myListings.Sum(l => l.ViewCount);
        conversations = await s.Query<Conversation>()
            .CountAsync(c => c.OwnerId == Auth.UserId.Value || c.PartnerId == Auth.UserId.Value);
    }
}
