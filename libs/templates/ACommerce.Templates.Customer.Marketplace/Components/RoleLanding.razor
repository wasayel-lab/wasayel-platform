@inject ACommerce.Templates.Customer.Marketplace.Services.TenantThemeService Themes
@inject L L
@inject AuthSession Auth

@*
    صَفحَة دُخول المَتجَر مُتَعَدِّد التَّطبيقات الفَرعيَّة (مَتجَر بِأَدوار).
    تَظهَر عَلى /{slug} عِندَ مَتجَر مِثل إنجيز قَبل أَن يَختار المُستَخدِم
    تَطبيقَه الفَرعيّ. لا مُحتَوى ولا feed — فَقَط بِطاقات لِلتَّطبيقات
    المُتاحَة. كُلّ بِطاقَة تَحمِل لِـ login مُسبَق-التَّحديد لِلدَور.
    ومُنذُ ‏2026-10-11 (‏ADR-035): ورابِطٌ واحِدٌ إلى الاستِكشافِ لِلزائِر.
*@

<div class="acs-page acm-role-landing">
    <header class="acm-role-landing-head">
        <div class="acm-role-landing-brand"
             style="background:@Tenant.BrandColor;">
            @(Tenant.Name.FirstOrDefault())
        </div>
        <h1>@Tenant.Name</h1>
        @if (!string.IsNullOrEmpty(Tenant.TagLine))
        {
            <p>@Tenant.TagLine</p>
        }
        <span class="acm-role-landing-hint">
            <AcIcon Name="star" Size="14" /> @L.Markup("roles.landing.pick_hint")@((MarkupString)"\n        ")
        </span>
    </header>

    <div class="acm-role-landing-cards@(theme.VariantClassSuffix(ACommerce.Kit.Theme.ThemeVariantCatalog.PortalRoleCards))">
        @foreach (var r in Tenant.Roles
                    .Where(r => r.CatalogSlug != "tenant_admin")
                    .OrderBy(r => r.SortOrder))
        {
            @* المَقطَعُ `r/{role}` يُبنى مِن **جَذر المُستَأجِر** لا مِن
               الدَور الحاليّ. وتَمريرُ `Role` هُنا كانَ يُنتِج
               `/{slug}/r/{cur}/r/{new}/login` — مَسارٌ غَيرُ مُعَرَّف
               يَرُدّ ‏404، ويَقَع كُلَّما صُيِّرَت هذِه البِطاقاتُ على
               `/{slug}/r/{role}` (زائِرٌ يَفتَح تَطبيقَ دَورٍ مُباشَرَةً،
               أَو يَخرُج مِن جَلسَتِه فيه). فَبَوّابَةُ الأَدوارِ نَفسُها
               كانَت تَرُدُّ النَقرَةَ بِصَفحَةِ خَطَأ. *@
            <a class="acm-role-landing-card"
               href="@AuthSession.LinkFor(Slug, null, $"r/{r.Slug}/login")">
                <span class="acm-role-landing-card-icon">
                    <AcIcon Name="@ACommerce.Widgets.AcIconMap.Resolve(r.Icon, "user")" Size="26" />
                </span>
                <div>
                    <strong>@r.Label</strong>
                    @* الشَكل «المَضغوط» فَرقُه بِنيَويّ لا تَنسيقيّ: الوَصف
                       لا يُصَيَّر أَصلاً. إخفاؤُه بِـdisplay:none كانَ
                       سَيُبقي نَصّاً في المُستَند يَقرَؤُه قارِئ الشاشَة
                       ويُثقِل البايتات بِلا أَن يُرى. *@
                    @if (!string.IsNullOrEmpty(r.Description) && !cardsAreCompact)
                    {
                        <span>@r.Description</span>
                    }
                </div>
                <span class="acm-role-landing-card-cta" aria-hidden="true">
                    <AcIcon Name="chevron-left" Size="16" />
                </span>
            </a>
        }
    </div>

    @* ─── بابُ الزائِر: يَتَصَفَّحُ قَبلَ أَن يُسَجِّل (‏ADR-035، ‏2026-10-11) ───
       كانَت هذِه البَوّابَةُ رابِطَي دُخولٍ لا ثالِثَ لَهُما، والشَريطُ مَخفِيٌّ
       عَلى `/{slug}` — فَالزائِرُ لا يَرى بِضاعَةً قَبلَ التَسجيل، والاستِكشافُ
       بِلا بَوّابَةِ دُخولٍ أَصلاً. فَرابِطٌ واحِدٌ يَكفي، يُبنى مِن **جَذرِ
       المُستَأجِر** كَبِطاقاتِ الأَدوارِ فَلا يَحمِلُ دَوراً لَم يُختَر، وبِصَنفِ
       السَطرِ الَّذي تَحتَه فَلا قاعِدَةَ CSS جَديدَة. ولا مُحتَوى يُرسَمُ هُنا.
       **ولِلزائِرِ وَحدَه** (‏2026-10-13، مُراجَعَةُ الموجَةِ الثانِيَة): البَوّابَةُ تُرسَمُ أَيضاً لِمُسَجَّلٍ بِلا دَورٍ فَعّال
       (`TenantHome`: `!Auth.IsAuthenticated || activeRole is null`)، و«دونَ تَسجيل» كَذِبٌ عَلَيه — فَلا يُرسَمُ لَه.
       والفَراغانِ مَكتوبانِ صَراحَةً لِأَنّ Razor يُسقِطُ الفَراغَ المُجاوِرَ لِكُتلَةِ `@if` — فَصَفحَةُ الزائِرِ تَبقى بايتاً كَما كانَت. *@
    @if (!Auth.IsAuthenticated)
    {
        @((MarkupString)"\n\n    ")<div class="acm-role-landing-foot">
            <a href="@AuthSession.LinkFor(Slug, null, "explore")">@L.Markup("roles.landing.browse")</a>
        </div>
    }
    @((MarkupString)"\n\n    ")<div class="acm-role-landing-foot">
        <a href="@AuthSession.LinkFor(Slug, Role, $"login")">@L.Markup("roles.landing.have_account")</a>
    </div>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [Parameter] public ACommerce.Kit.Tenants.Tenant Tenant { get; set; } = default!;

    /// <summary>ثيم هذا المَتجَر. مُهَيَّأ إلى قاعِدَة المَنصَّة، فَلَو
    /// لَم تَجرِ القِراءَة بَعد (أَو تَعَذَّرَت) صُيِّرَت الصَفحَة
    /// بِالشَكل الافتِراضيّ — لا بِاستِثناء ولا بِفَراغ.</summary>
    ACommerce.Kit.Theme.EffectiveTheme theme = ACommerce.Kit.Theme.ThemeCatalog.Default;

    bool cardsAreCompact =>
        theme.VariantIs(ACommerce.Kit.Theme.ThemeVariantCatalog.PortalRoleCards, "compact");

    protected override async Task OnParametersSetAsync()
        => theme = await Themes.EffectiveAsync(Slug);
}
