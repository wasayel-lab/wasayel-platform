@inject IHttpContextAccessor HttpCtx
@inject AuthSession AuthSession
@inject ITenantContext Tenant
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantRoleService Roles
@inject ACommerce.Templates.Customer.Marketplace.Services.Queries.AccountQueries Accounts
@inject L L
@using ACommerce.Kit.Auth
@using ACommerce.Kit.Roles
@using ACommerce.Kit.Tenants
@using ACommerce.Templates.Customer.Marketplace.Gates

@*
    مُكَوِّن SSR يَلُفّ مُحتَوى الصَفحَة بِفَحص gates مُوَحَّد. يُسمَح بِـ
    auth أَو terms أَو permission كَ معلَمات boolean / string. عَلى فَشَل
    أَيّ gate يَعرِض UI مُلائِم (تَسجيل دُخول، قَبول شُروط، رَفض صَلاحِيَّة)
    بَدَلاً مِن مُحتَوى الصَفحَة.

    الاستِعمال:
        <GatedPage RequireAuth RequireTerms Permission="listing.create">
            <!-- مُحتَوى الصَفحَة -->
        </GatedPage>

    لا يَستَخدِم InteractiveServerRenderMode — كُلّ شَيء SSR. يَفترِض
    أَنّ الصَفحَة الحاوِيَة لَدَيها [Parameter] Slug و Role لِأَنّ كُلّ
    الصَفَحات تُسَجَّل عَلى /{slug} أَو /{slug}/r/{role}.
*@

@switch (_state)
{
    case GateState.Allowed:
        @ChildContent
        break;

    case GateState.NeedAuth:
        <AcEmptyState IconName="user"
                      Title="@(L["gate.auth.title"])"
                      Message="@L["gate.auth.message"]"
                      ActionLabel="@L["auth.action.login"]"
                      ActionHref="@_loginUrl" />
        break;

    case GateState.NeedTerms:
        <AcEmptyState IconName="info"
                      Title="@(L["gate.terms.title"])"
                      Message="@L["gate.terms.message"]"
                      ActionLabel="@L["gate.terms.action"]"
                      ActionHref="@_termsUrl" />
        break;

    case GateState.Forbidden:
        @* (‏2026-10-25، W8-7 — lens-dead-doors-3): ومَخرَجُ «اِختَر دَوراً آخَر» حينَ تَعرِضُ صَفحَةُ الأَدوارِ دَوراً يَحمِلُ الصَلاحِيَّة
           (‏`PermissionDoor.SwitchOpens`) — وإلّا فَلا رابِط: بابٌ لا يُفتَحُ لا يُرسَم (القاعِدَة ١٢). *@
        <AcEmptyState IconName="alert-circle"
                      Title="@(L["gate.forbidden.title"])"
                      Message="@_forbiddenMsg"
                      ActionLabel="@(_switchUrl is null ? null : L["gate.forbidden.switch_role"])"
                      ActionHref="@_switchUrl" />
        break;
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }

    /// <summary>تَوثيق إجباريّ.</summary>
    [Parameter] public bool RequireAuth { get; set; }

    /// <summary>قَبول الشُروط إجباريّ (يَفتَرِض RequireAuth أَيضاً).</summary>
    [Parameter] public bool RequireTerms { get; set; }

    /// <summary>صَلاحِيَّة دَور مَطلوبَة (مَثَلاً "listing.create"). فارِغ = لا فَحص.</summary>
    [Parameter] public string? Permission { get; set; }

    /// <summary>مِفتاحُ نَصِّ الرَفضِ في القامُوس — لِصَفحَةٍ تَقولُ ما لا يَفعَلُه الدَورُ بِلُغَتِها لا بِرَمزِ الصَلاحِيَّة. فارِغ = النَصُّ العامّ
    /// (‏<c>gate.forbidden.prefix</c> + الرَمز + <c>gate.forbidden.suffix</c>) كَما كان (‏2026-10-25، W8-7).</summary>
    [Parameter] public string? ForbiddenMessageKey { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    enum GateState { Allowed, NeedAuth, NeedTerms, Forbidden }
    GateState _state = GateState.Allowed;
    string _loginUrl = "";
    string _termsUrl = "";
    string _forbiddenMsg = "";
    string? _switchUrl;

    protected override async Task OnInitializedAsync()
    {
        if (HttpCtx.HttpContext is { } ctx && Tenant.IsResolved)
        {
            AuthSession.SetTenant(Tenant.Slug);
            AuthSession.Load(ctx, Tenant.Slug);
        }

        var currentPath = HttpCtx.HttpContext?.Request.Path.Value ?? "/";
        var returnUrl = Uri.EscapeDataString(currentPath);
        _loginUrl = AuthSession.LinkFor(Slug, Role, $"login?returnUrl={returnUrl}");
        _termsUrl = AuthSession.LinkFor(Slug, Role, $"terms?returnUrl={returnUrl}");

        if (RequireAuth && !AuthSession.IsAuthenticated)
        {
            _state = GateState.NeedAuth;
            return;
        }

        if (RequireTerms && AuthSession.UserId is { } uid)
        {
            if (!await Accounts.HasAcceptedCurrentTermsAsync(Slug, uid))
            {
                _state = GateState.NeedTerms; return;
            }
        }

        if (!string.IsNullOrEmpty(Permission) && AuthSession.UserId is { } uid2)
        {
            // ‏(‏2026-10-28، قَرارُ المالِك د42 «أ») كانَ `var tenant = await Tenants.FindAsync(Slug);` — الوَثيقَةُ المُخَزَّنَة، فَدَورٌ مُؤَلَّفٌ مُعتَمَدٌ
            // يَحمِلُ الصَلاحِيَّةَ يُرَدُّ هُنا (تَوصيفُه `973dcd0`). صارَ يَقرَأُ ما تَقرَؤُه بَقِيَّةُ الصَفَحات: المُستَأجِرُ مُجَسَّداً بِأَدوارِه المُؤَلَّفَة.
            var tenant = (await Roles.LoadAsync(Slug)).Tenant;
            if (tenant is { Roles.Count: > 0 })
            {
                // القِراءَةُ غَير مَشروطَة عَمداً — كَما كانَت حَرفاً.
                // ‏`Role ?? await …` كانَ سَيَتَخَطّى الاستِعلامَ مَتى
                // كانَ الدَورُ في المَسار، وذاكَ تَحسينُ عَدَدِ استِعلامات
                // لا نَقلُ مَوضِع. التَحسينُ لَه مَوجَتُه.
                var storedRole = await Accounts.ActiveRoleAsync(Slug, uid2);
                // (‏2026-10-25، W8-7 — lens-dead-doors-3): القَرارُ صارَ `PermissionDoor.Opens` — الدالَّةُ الَّتي يَسأَلُها كُلُّ رابِطٍ إلى صَفحَةٍ
                // مَحروسَةٍ بِهذا المُكَوِّن، فَلا يَنفَتِحُ رابِطٌ عَلى رَفض. وكانَ هُنا `Role ?? storedRole ?? ""` ثُمَّ `RolePermissions.Has`: الجَوابُ
                // نَفسُه لِكُلِّ مُدخَل (دَورُ مَسارٍ فارِغٌ لا يولَدُ مِن التَوجيه)، مَقيسٌ بِجَدوَلِ `CreateListingDoorTests`.
                if (!PermissionDoor.Opens(tenant.Roles, Role, storedRole, Permission))
                {
                    _state = GateState.Forbidden;
                    _forbiddenMsg = string.IsNullOrEmpty(ForbiddenMessageKey)
                        ? $"{L["gate.forbidden.prefix"]}{Permission}» — {L["gate.forbidden.suffix"]}"
                        : L[ForbiddenMessageKey];
                    if (PermissionDoor.SwitchOpens(tenant.Roles, Role, Permission))
                        _switchUrl = AuthSession.LinkFor(Slug, Role, "me/role");
                    return;
                }
            }
        }

        _state = GateState.Allowed;
    }
}
