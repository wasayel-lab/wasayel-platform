@*
    يَختار قالِب الصَفحَة الرَّئيسِيَّة بِناءً عَلى الدَور النَّشِط لِلمُستَخدِم.
    كُلّ قالِب يَعرِض welcome مُخَتَلِف + إجراءات سَريعَة مُلائِمَة، ثُمّ
    يَتبَعه المُحتَوى المُشتَرَك (الفِئات + المُمَيَّز + …) كَ ChildContent.

    لِلتَّأكيد: المَتاجِر بِلا أَدوار (Roles فارِغَة) لا تَرى هذا القالِب
    — تَنتَقِل مُباشَرَة إلى الـ ChildContent (سُلوك عَشير/إيجار القَديم).
*@

@if (Role is null)
{
    @ChildContent
}
else
{
    <section class="acm-role-hero acm-role-hero-@(RoleObj.Slug)">
        <div class="acm-role-hero-head">
            <span class="acm-role-hero-icon">
                <AcIcon Name="@ACommerce.Widgets.AcIconMap.Resolve(RoleObj.Icon, "user")" Size="24" />
            </span>
            <div>
                <h2 style="margin:0;font-size:18px;">@Greeting</h2>
                <span style="color:var(--ac-text-muted);font-size:13px;">@Subtitle</span>
            </div>
        </div>

        <div class="acm-role-hero-actions">
            @switch (RoleObj?.CatalogSlug)
            {
                case "rider":
                    <a class="ac-btn ac-btn-primary ac-btn-lg ac-btn-block"
                       href="@AuthSession.LinkFor(Slug, Role, $"create-listing")">
                        <AcIcon Name="plus" Size="18" /> @L.Markup("roles.hero.rider_new_trip")@((MarkupString)"\n                    ")
                    </a>
                    <a class="ac-btn ac-btn-ghost" href="@AuthSession.LinkFor(Slug, Role, $"me/listings")">
                        <AcIcon Name="package" Size="16" /> @L.Markup("roles.hero.rider_my_requests")@((MarkupString)"\n                    ")
                    </a>
                    break;

                case "driver":
                    <a class="ac-btn ac-btn-primary ac-btn-lg ac-btn-block"
                       href="@AuthSession.LinkFor(Slug, Role, $"explore")">
                        <AcIcon Name="search" Size="18" /> @L.Markup("roles.hero.driver_open_trips")@((MarkupString)"\n                    ")
                    </a>
                    <a class="ac-btn ac-btn-ghost" href="@AuthSession.LinkFor(Slug, Role, $"me/offers")">
                        <AcIcon Name="package" Size="16" /> @L.Markup("roles.hero.my_offers")@((MarkupString)"\n                    ")
                    </a>
                    <a class="ac-btn ac-btn-ghost" href="@AuthSession.LinkFor(Slug, Role, $"me/searches")">
                        <AcIcon Name="bell" Size="16" /> @L.Markup("roles.hero.alert_searches")@((MarkupString)"\n                    ")
                    </a>
                    break;

                case "vendor":
                case "host":
                    <a class="ac-btn ac-btn-primary ac-btn-lg ac-btn-block"
                       href="@AuthSession.LinkFor(Slug, Role, $"create-listing")">
                        <AcIcon Name="plus" Size="18" /> @L.Markup("roles.hero.new_listing")@((MarkupString)"\n                    ")
                    </a>
                    <a class="ac-btn ac-btn-ghost" href="@AuthSession.LinkFor(Slug, Role, $"me/listings")">
                        <AcIcon Name="package" Size="16" /> @L.Markup("roles.hero.my_listings")@((MarkupString)"\n                    ")
                    </a>
                    break;

                case "shipper":
                    <a class="ac-btn ac-btn-primary ac-btn-lg ac-btn-block"
                       href="@AuthSession.LinkFor(Slug, Role, $"explore")">
                        <AcIcon Name="search" Size="18" /> @L.Markup("roles.hero.open_shipments")@((MarkupString)"\n                    ")
                    </a>
                    <a class="ac-btn ac-btn-ghost" href="@AuthSession.LinkFor(Slug, Role, $"me/offers")">
                        <AcIcon Name="package" Size="16" /> @L.Markup("roles.hero.my_offers")@((MarkupString)"\n                    ")
                    </a>
                    break;

                case "tenant_admin":
                    <a class="ac-btn ac-btn-primary ac-btn-lg ac-btn-block"
                       href="@AuthSession.LinkFor(Slug, Role, $"manage")">
                        <AcIcon Name="settings" Size="18" /> @L.Markup("roles.hero.admin_panel")@((MarkupString)"\n                    ")
                    </a>
                    break;

                case "customer":
                default:
                    <a class="ac-btn ac-btn-primary ac-btn-lg ac-btn-block"
                       href="@AuthSession.LinkFor(Slug, Role, $"explore")">
                        <AcIcon Name="search" Size="18" /> @L.Markup("roles.hero.explore")@((MarkupString)"\n                    ")
                    </a>
                    break;
            }
        </div>
    </section>

    @ChildContent
}

@inject L L

@code {
    [Parameter] public string Slug { get; set; } = "";
    [Parameter] public string? Role { get; set; }
    [Parameter] public ACommerce.Kit.Roles.Role? RoleObj { get; set; }
    [Parameter] public string? UserName { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    string Greeting => RoleObj?.CatalogSlug switch
    {
        "rider"        => string.IsNullOrEmpty(UserName) ? L["roles.greeting.rider_plain"] : L.Format("roles.greeting.rider_named", UserName),
        "driver"       => string.IsNullOrEmpty(UserName) ? L["roles.greeting.driver_plain"] : L.Format("roles.greeting.named", UserName),
        "vendor"       => L["roles.greeting.vendor"],
        "host"         => L["roles.greeting.host"],
        "shipper"      => L["roles.greeting.shipper"],
        "tenant_admin" => L["roles.greeting.admin"],
        _              => string.IsNullOrEmpty(UserName) ? L["roles.greeting.default_plain"] : L.Format("roles.greeting.default_named", UserName)
    };

    string Subtitle => RoleObj?.CatalogSlug switch
    {
        "rider"        => L["roles.subtitle.rider"],
        "driver"       => L["roles.subtitle.driver"],
        "vendor"       => L["roles.subtitle.vendor"],
        "host"         => L["roles.subtitle.host"],
        "shipper"      => L["roles.subtitle.shipper"],
        "tenant_admin" => L["roles.subtitle.admin"],
        _              => L["roles.subtitle.default"]
    };
}
