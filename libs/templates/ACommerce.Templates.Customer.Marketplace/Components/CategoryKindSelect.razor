@inject L L
@namespace ACommerce.Templates.Customer.Marketplace.Components
@using ACommerce.Templates.Customer.Marketplace.Services.Patterns

@*
    تَجميعُ الفِئَةِ اختِياراً مِن المَعجَمِ المُغلَقِ مَعَ أَثَرِ كُلِّ قيمَة (‏2026-10-29، قَرارُ المالِك د25 (٥)؛ ‏ADR-034 §٣‑٢ مُلحَق د25).
    كانَ حَقلَ نَصٍّ حُرٍّ بِقائِمَةِ اقتِراحاتٍ (`datalist`) فيها `leisure` الَّتي لا يَقبَلُها المُصادِق، ولا كَلِمَةَ عَن أَنّ `commercial`
    تَجعَلُ المَتجَرَ إيجاراً بِلا سَلَّة. والقيمَةُ تَبقى `.ac-cat-kind` فَيَقرَؤُها `admin-editors.js` كَما كان (`.value`).
    ثَلاثَةُ مُستَهلِكين قَبلَ الاستِخراج (القاعِدَة ١): مُحَرِّرُ الاستوديو، ومُحَرِّرُ الإدارَة، وصَفحَةُ الإنشاءِ الإدارِيَّة.
    وقيمَةٌ مُخَزَّنَةٌ خارِجَ المَعجَمِ تُرسَمُ مُختارَةً بِوَسمِها لا تُبَدَّلُ صامِتَة — والحِفظُ يَرُدُّها بِرَمزِه حَتّى يَختارَ صاحِبُها.
*@

<select class="ac-input ac-cat-kind" aria-label="@L["categories.kind.label"]">
    @foreach (var k in CategoryKinds.All)
    {
        <option value="@k" selected="@(k == Current)">@L[CategoryKinds.NameKey(k)] — @L[CategoryKinds.EffectKey(k)]</option>
    }
    @if (!CategoryKinds.IsKnown(Current))
    {
        <option value="@Current" selected>@Current — @L["categories.kind.outside"]</option>
    }
</select>

@code {
    /// <summary>التَجميعُ المُخَزَّن — و<c>null</c> لِصَفٍّ جَديد (يُختارُ «بِلا تَجميع»).</summary>
    [Parameter] public string? Value { get; set; }

    string Current => (Value ?? "").Trim().ToLowerInvariant();
}
