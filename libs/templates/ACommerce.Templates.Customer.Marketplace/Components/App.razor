@inject L L
@inject ITenantContext Tenant
@inject AuthSession Auth
@inject IHttpContextAccessor HttpCtx
@inject ACommerce.Templates.Customer.Marketplace.Services.TenantThemeService Themes
<!DOCTYPE html>
<html lang="@L.Lang" dir="@L.Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    @* ─── SEO — تَرويسَة ديناميكيَّة لِكُلّ مُستَأجِر ────────────────────
       العُنوان وَالوَصف وَالـ canonical وَبِطاقات المُشارَكَة كُلُّها مِن
       وَثيقَة المُستَأجِر الَّتي حَمَّلَها الـ middleware أَصلاً (صِفر
       استِعلام إضافيّ). صَفَحات المَنصَّة نَفسِها (الهُبوط/الاستوديو/
       الإدارَة) تَسقُط عَلى الافتِراضيّ.

       لِماذا هُنا وَلَيس بِـ <PageTitle>؟ تَحت SSR الثابِت يُصَيِّر
       HeadOutlet وَسم <title> ثانِياً في نَفس المُستَند، وَالمُتَصَفِّح
       (وَالزاحِف) يَعتَمِد الأَوَّل — فَعُنوان الصَفحَة يَجِب أَن يُكتَب
       مَرَّة واحِدَة، هُنا. *@
    @{
        var seoReq       = HttpCtx.HttpContext?.Request;
        var seoBase      = seoReq is null ? "" : $"{seoReq.Scheme}://{seoReq.Host}";
        var seoPath      = seoReq?.Path.Value ?? "/";
        var seoCanonical = seoBase.Length > 0 ? seoBase + seoPath : null;
        var seoSegments  = seoPath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);

        // الرَئيسيَّة = /{slug} أَو /{slug}/r/{role} — وَحدَها تَحمِل JSON-LD.
        var seoIsHome = Tenant.IsResolved &&
                        (seoSegments.Length == 1 ||
                         (seoSegments.Length == 3 && seoSegments[1] == "r"));

        ACommerce.Kit.Tenants.Tenant? seoTenant = Tenant.IsResolved
            ? new ACommerce.Kit.Tenants.Tenant
              {
                  Id         = Tenant.Slug,
                  Name       = Tenant.Name,
                  TagLine    = Tenant.TagLine,
                  City       = Tenant.City,
                  BrandColor = Tenant.BrandColor
              }
            : null;

        var seoTitle = seoTenant is null
            ? L["shell.seo.title"]
            : ACommerce.Kit.Tenants.SeoDocuments.HomeTitle(seoTenant);
        var seoDescription = seoTenant is null
            ? L["shell.seo.description"]
            : ACommerce.Kit.Tenants.SeoDocuments.HomeDescription(seoTenant);
        // صورَة المُشارَكَة نُقَطِيَّة دائِماً: أَكثَر المِنَصّات (واتساب،
        // فيسبوك، تويتر، لينكدإن) تَرفُض SVG في og:image فَتَعرِض الرابِط
        // بِلا صورَة أَصلاً. أَيقونَة الـ PWA تَبقى SVG حَيث تَنفَع.
        var seoImage = seoBase.Length == 0 ? null
            : seoTenant is not null
                ? $"{seoBase}/api/{Uri.EscapeDataString(Tenant.Slug)}/og.png"
                : $"{seoBase}/_content/ACommerce.Templates.Customer.Marketplace/brand/wasayel-app-icon.png";
        // الأَبعاد تُصَرَّح لِلبِطاقَة المُوَلَّدَة وَحدَها — وهي وَحدَها
        // المَعلومَة المَقاس. الشِعار الثابِت لِلمَنصَّة مُرَبَّع، فَلا
        // نَنسِب إلَيه 1200×630 كَذِباً.
        var seoImageSized = seoBase.Length > 0 && seoTenant is not null;
    }
    <title>@seoTitle</title>
    @if (!string.IsNullOrEmpty(seoDescription))
    {
        <meta name="description" content="@seoDescription" />
    }
    @if (seoCanonical is not null)
    {
        <link rel="canonical" href="@seoCanonical" />
    }
    @if (Tenant.IsResolved)
    {
        <meta name="theme-color" content="@Tenant.BrandColor" />
    }

    @* OpenGraph + Twitter — نَفس النُصوص، لا اختِراع. *@
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="@(L.IsArabic ? "ar_AR" : "en_US")" />
    <meta property="og:site_name" content="@(Tenant.IsResolved ? Tenant.Name : L["shell.seo.site_name"])" />
    <meta property="og:title" content="@seoTitle" />
    @if (!string.IsNullOrEmpty(seoDescription))
    {
        <meta property="og:description" content="@seoDescription" />
    }
    @if (seoCanonical is not null)
    {
        <meta property="og:url" content="@seoCanonical" />
    }
    @if (seoImage is not null)
    {
        <meta property="og:image" content="@seoImage" />
    }
    @if (seoImageSized)
    {
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="@ACommerce.Kit.Tenants.SocialCard.Width" />
        <meta property="og:image:height" content="@ACommerce.Kit.Tenants.SocialCard.Height" />
    }
    @* بِطاقَة عَريضَة حينَ تَكون الصورَة بِنِسبَة 1.91:1؛ وإلّا المُرَبَّعَة
       الصَغيرَة — الشِعار الثابِت لِلمَنصَّة لا يَملَأ البِطاقَة العَريضَة. *@
    <meta name="twitter:card" content="@(seoImageSized ? "summary_large_image" : "summary")" />
    <meta name="twitter:title" content="@seoTitle" />
    @if (!string.IsNullOrEmpty(seoDescription))
    {
        <meta name="twitter:description" content="@seoDescription" />
    }
    @if (seoImage is not null)
    {
        <meta name="twitter:image" content="@seoImage" />
    }

    @* JSON-LD (Organization + WebSite) لِلرَئيسيَّة فَقَط.
       MarkupString آمِنَة هُنا: النَصّ مُخرَج System.Text.Json بِالمُرَمِّز
       الافتِراضيّ الَّذي يَهرُب < و > و & إلى \uXXXX — فَلا يَستَطيع اِسم
       مَتجَر أَو شِعار أَن يُغلِق وَسم <script> أَو يَحقِن HTML.

       والوَسم كُلُّه يُبنى في C# لا هُنا: وَسم <script> مَكتوب في Razor
       يَحمِل تَعبيراً ديناميكيّاً يُصَيَّر عَبر شَجَرَة العَرض، فَيُمَرَّر
       type عَلى HtmlEncoder الافتِراضيّ فَيَخرُج
       "application/ld&#x2B;json" — سَليم لِمُحَلِّل مُطابِق لِلمُواصَفَة،
       غَير مَرئيّ لِكُلّ مُستَهلِك يُطابِق النَصّ حَرفِيّاً. *@
    @if (seoIsHome && seoTenant is not null && seoBase.Length > 0)
    {
        @((MarkupString)ACommerce.Kit.Tenants.SeoDocuments.BuildHomeJsonLdScript(seoTenant, seoBase))
    }

    @* خَطّ Cairo بِنَفس الأَوزان الَّتي يُحَمِّلها كُلّ مِن Ashare V3
       و Ejar V1: 400 (نَصّ)، 600 (مُتَوَسِّط)، 700 (عَريض). *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" />

    @* ─── رُموز التَّصميم — المُدخَلات قَبل الأَوراق ────────────────────
       كُتلَة <style> واحِدَة تَحمِل ‏:root بِكُلّ رُموز الثيم الفَعّال
       (الافتِراضيّ، أَو الافتِراضيّ وقَد غُلِّبَت عَلَيه وَثيقَة
       المُستَأجِر المُعتَمَدَة). أَوراق الأَنماط تَقرَؤُها بِـvar()‎.

       **ولِماذا قَبل الأَوراق لا بَعدَها**: مُتَغَيِّرات CSS تُحَلّ
       بِالكَسَل — فَتَرتيب تَصريحَة ‎--wsl-*‎ لا يُؤَثِّر عَلى
       ‎var(--wsl-*)‎ في أَيّ وَرَقَة. لكِنّ البَثّ بَعدَ الأَوراق كانَ
       سَيُغري بِكِتابَة ‎--ac-*‎ مِن هُنا، فَيَنتَزِع مِن branding.css
       مِلكِيَّةَ لَون المَتجَر. المَوضِع يَقول القَصد: هذه مُدخَلات، لا
       تَغليب.

       ومُعَرِّف الكُتلَة ‎wsl-theme‎ لَيسَ زينَة: بَوّابَة القَبول
       (scripts/compare-appearance.sh) تَنزِعُه بِاسمِه ثُمَّ تُقارِن
       الباقي بايتاً بِبايت. *@
    <style id="wsl-theme">@Theme.Css</style>

    <link rel="stylesheet" href="_content/ACommerce.Templates.Customer.Marketplace/css/widgets.css" />
    <link rel="stylesheet" href="_content/ACommerce.Templates.Customer.Marketplace/css/templates-shared.css" />
    <link rel="stylesheet" href="_content/ACommerce.Templates.Customer.Marketplace/css/templates-marketplace.css" />
    <link rel="stylesheet" href="_content/ACommerce.Templates.Customer.Marketplace/css/app.css" />
    <link rel="stylesheet" href="_content/ACommerce.Templates.Customer.Marketplace/css/site.css" />
    <link rel="stylesheet" href="_content/ACommerce.Templates.Customer.Marketplace/css/studio.css" />
    <link rel="stylesheet" href="_content/ACommerce.Kit.Maps.Web/maps.css" />

    @* branding.css لِكُلّ مُستَأجِر (مَنقولاً مِن Ashare.V3.Web/Ejar.Web).
       يُحَدِّد --ac-primary وألوان أُخرى — يُحَمَّل آخِراً لِيَفوز عَلى
       الافتراضي. لا يُرَكَّب إلّا بَعد أن يُحَلِّل الـ middleware الـ slug. *@
    @if (Tenant.IsResolved && (Tenant.Slug == "ashare" || Tenant.Slug == "ejar"))
    {
        <link rel="stylesheet" href="@($"/branding/{Tenant.Slug}.css")" />
    }

    @* طَبَقَة الرُّقِيّ البَصَريّ — تُحَمَّل آخِراً (بَعد branding) لِتَفوز على
       كُلّ شَيء في تَنسيق المُكَوِّنات، دونَ لَمس --ac-primary المَملوك لِكُلّ
       مَتجَر. تَرفَع كُلّ صَفحَة في كُلّ دَور. *@
    <link rel="stylesheet" href="_content/ACommerce.Templates.Customer.Marketplace/css/premium.css" />

    @* مُحَرِّرات الادمن المُهَيكَلَة — يَعمَل تَحت enhanced nav. defer لِيُحَمَّل
       بَعد blazor فَيَلتَقِط enhancedload. *@
    <script src="_content/ACommerce.Templates.Customer.Marketplace/admin-editors.js" defer></script>

    @* PWA: manifest + theme-color + iOS web-app meta.
       قاعِدَة: التَّثبيت "يَبدَأ" مِن داخِل تَطبيق دَور فِعليّ — لا مِن
       صَفحَة /login أَو /terms أَو /admin أَو الـ launcher الفارِغ
       (مَثَلاً /injez). هذا يَمنَع المُستَخدِم مِن تَثبيت "صَفحَة
       الدُخول" كَ PWA مُستَقِلّ. لِمَتاجِر بِلا أَدوار (ashare/ejar)
       نَسمَح بِالتَّثبيت مِن أَيّ صَفحَة-تَطبيق (غَير عابِرَة). *@
    @{
        var rawPath = HttpCtx.HttpContext?.Request.Path.Value ?? "";
        var roleForPwa = HttpCtx.HttpContext is { } pctx
            ? ACommerce.Templates.Customer.Marketplace.AuthSession.ExtractRoleFromPath(pctx.Request.Path)
            : null;

        // مَسارات عابِرَة: لا تُمَثِّل التَّطبيق نَفسه.
        var isTransient = rawPath.Contains("/login")
                       || rawPath.Contains("/verify")
                       || rawPath.Contains("/terms")
                       || rawPath.Contains("/logout")
                       || rawPath.Contains("/auth/")
                       || rawPath.StartsWith("/admin");

        // launcher: المَسار = "/{slug}" بِدون أَيّ شَيء بَعدَه. لِلمَتاجِر
        // ذات الأَدوار (إنجيز)، هذه الصَفحَة لِاختِيار الدَور لا لِلاستِخدام —
        // التَّثبيت يَجِب أَن يَكون مِن داخِل دَور.
        var pathSegments = rawPath.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        var isLauncher = pathSegments.Length == 1;

        // قاعِدَة الـ manifest:
        //  - عابِرَة → لا manifest (لا تَظهَر القابِليَّة لِلتَّثبيت)
        //  - URL فيه /r/{role}/ → manifest الدَور
        //  - بِلا /r/ و لَيس launcher → manifest الـ slug (لِمَتاجِر بِلا أَدوار)
        //  - launcher بِدون /r/ → لا manifest (نَنتَظِر دُخول الدَور)
        string? pwaPath = null;
        if (Tenant.IsResolved && !isTransient)
        {
            if (!string.IsNullOrEmpty(roleForPwa))
                pwaPath = $"/api/{Tenant.Slug}/r/{roleForPwa}";
            else if (!isLauncher)
                pwaPath = $"/api/{Tenant.Slug}";
        }
    }
    @if (pwaPath is not null)
    {
        <link rel="manifest" href="@($"{pwaPath}/manifest.json")" />
        <link rel="icon" type="image/svg+xml" href="@($"{pwaPath}/icon.svg")" />
        <link rel="apple-touch-icon" href="@($"{pwaPath}/icon.svg")" />
        @* theme-color يُكتَب مَرَّة واحِدَة في كُتلَة الـ SEO أَعلاه. *@
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="default" />
        <meta name="apple-mobile-web-app-title" content="@Tenant.Name" />
        <meta name="mobile-web-app-capable" content="yes" />
    }
    else
    {
        @* صَفَحات المَنصَّة نَفسها (الهُبوط / studio / admin) لا تَملِك
           tenant — تَستَخدِم أَيقونَة وَسايِل كَ favicon افتراضيّ. *@
        <link rel="icon" type="image/svg+xml"
              href="_content/ACommerce.Templates.Customer.Marketplace/brand/wasayel-app-icon.svg" />
        <link rel="apple-touch-icon"
              href="_content/ACommerce.Templates.Customer.Marketplace/brand/wasayel-app-icon.png" />
        <meta name="apple-mobile-web-app-title" content="@L["shell.seo.site_name"]" />
    }

    <HeadOutlet />
</head>
<body>
    @* Install pill — زِرّ صَغير عائِم في زاوِيَة الشاشَة. مَخفيّ
       افتراضيّاً، يَظهَره JS فَقَط لَو الـ PWA قابِلَة لِلتَثبيت
       (https/localhost + SW + manifest). *@
    @if (pwaPath is not null)
    {
        <div id="ac-install-banner" class="ac-pwa-pill" style="display:none;">
            <button type="button" onclick="acInstall()" class="ac-pwa-pill-cta"
                    aria-label="@L["pwa.pill.install_label"]">
                <span class="ac-pwa-pill-icon">⤓</span>
                <span class="ac-pwa-pill-text">@L.Markup("pwa.pill.install")</span>
            </button>
            <button type="button" onclick="acDismissInstall()" class="ac-pwa-pill-x"
                    aria-label="@L["common.action.close"]">✕</button>
        </div>
    }
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/ACommerce.Kit.Maps.Web/maps.js" defer></script>

    @* SignalR JS client مِن CDN — يَكفي لِلاتِّصال بِـ /realtime hub.
       تُحَمَّل عِندَ الحاجَة فَقَط (لَو مُستَخدِم مُتَّصِل) لِتَجَنُّب
       تَحميل إضافيّ لِلصَفَحات العامَّة. *@
    @{
        if (HttpCtx.HttpContext is { } ctx2 && Tenant.IsResolved)
        {
            Auth.SetTenant(Tenant.Slug);
            Auth.Load(ctx2, Tenant.Slug);
        }
    }
    @if (Auth.IsAuthenticated && !string.IsNullOrEmpty(Auth.Token))
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8.0.7/dist/browser/signalr.min.js"></script>
        <script>
            window.acRealtimeToken = '@Auth.Token';
            window.acRealtimeSlug  = '@Tenant.Slug';
        </script>
        <script src="_content/ACommerce.Templates.Customer.Marketplace/realtime-nav.js" defer></script>
    }
    <script>
        // مُمَرِّر تِلقائيّ لِأَسفَل thread الوَكيل بَعد كُلّ تَحديث.
        // يُستَدعَى مِن AgentChat عَبر IJSRuntime.InvokeVoidAsync.
        window.scrollAgentToBottom = function () {
            var el = document.getElementById('thread-bottom');
            if (el && el.scrollIntoView) el.scrollIntoView({ behavior: 'smooth', block: 'end' });
        };

        // تَقديم عَرض مَع التِقاط مَوقِع تِلقائيّ. السائِق يَكتُب السِعر
        // فَقَط، الـ JS يَملأ lat/lng ثُمّ يُرسِل الـ form.
        window.acSubmitOffer = function (btn) {
            var form = btn.closest('form');
            if (!form) return;
            btn.disabled = true;
            btn.textContent = '@L.Js("offers.submit.locating")';
            var send = function () { try { form.submit(); } catch (e) { /* ignore */ } };
            if (!navigator.geolocation) { send(); return; }
            navigator.geolocation.getCurrentPosition(
                function (p) {
                    form.querySelector('#offer_lat').value = p.coords.latitude.toFixed(6);
                    form.querySelector('#offer_lng').value = p.coords.longitude.toFixed(6);
                    send();
                },
                function () { send(); /* fallback: أَرسِل بِلا مَوقِع */ },
                { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 }
            );
        };

        // تَحديث live لِعَدّاد الرَسائِل وَالإشعارات في الـ nav.
        // SignalR push لَو مُتاح، مَع polling كُلّ ٦٠ث كَ احتِياط.
        (function () {
            var match = location.pathname.match(/^\/([^\/]+)/);
            if (!match) return;
            var slug = match[1];
            if (slug === 'admin' || slug === 'api') return;

            async function refresh() {
                try {
                    var r = await fetch('/api/' + slug + '/unread-counts',
                                        { credentials: 'same-origin' });
                    if (!r.ok) return;
                    var d = await r.json();
                    apply('messages',      d.messages);
                    apply('notifications', d.notifications);
                } catch (e) { /* ignore */ }
            }
            function apply(key, n) {
                var els = document.querySelectorAll('[data-badge-key="' + key + '"]');
                els.forEach(function (el) {
                    el.textContent = n > 99 ? '99+' : String(n);
                    el.style.display = n > 0 ? '' : 'none';
                });
            }

            refresh();
            window.addEventListener('focus', refresh);

            // SignalR — لَو لِبَريريّ مُحَمَّلَة + token مَوجود.
            if (window.signalR && window.acRealtimeToken) {
                var conn = new signalR.HubConnectionBuilder()
                    .withUrl('/realtime?token=' + encodeURIComponent(window.acRealtimeToken))
                    .withAutomaticReconnect()
                    .build();
                conn.on('unread_changed', function () { refresh(); });
                // chat + notification channels مَوروثة مِن RealtimeHub (تَستَخدِم
                // نَفس الـ refresh لأَنّ الـ counts تَتَغَيَّر مَع كِليهِما).
                conn.on('notification', function () { refresh(); });
                conn.on('chat',         function () { refresh(); });
                conn.start().catch(function () {
                    // فَشَل الـ hub — نَرجِع لِـ polling احتِياط
                    setInterval(refresh, 30000);
                });
            } else {
                // بِلا SignalR — polling كُلّ ٣٠ ثا
                setInterval(refresh, 30000);
            }
        })();

        // ─── PWA — Service Worker registration + Web Push subscribe ──
        // الـ SW مُشتَرَك (واحِد) لكِنّ يُسَجَّل بِـ scope مُختَلِف لِكُلّ
        // تَطبيق فَرعيّ، فَالمُتَصَفِّح يُنشِئ instance مُنفَصِل لِكُلّ
        // /{slug}/r/{role}/. تَجاهَل مَسارات /admin و /api.
        (function () {
            if (!('serviceWorker' in navigator)) return;
            var path = location.pathname;
            if (path.startsWith('/admin') || path.startsWith('/api')) return;
            var seg = path.split('/').filter(Boolean);
            if (seg.length === 0) return;   // home page — no PWA
            var slug = seg[0];
            // اِبني scope: /{slug}/r/{role}/ أَو /{slug}/ لِـ legacy.
            var scope = '/' + slug + '/';
            if (seg.length >= 3 && seg[1] === 'r') {
                scope = '/' + slug + '/r/' + seg[2] + '/';
            }
            navigator.serviceWorker.register('/sw.js', { scope: scope })
                .then(function (reg) {
                    if ('PushManager' in window) subscribeToPush(reg);
                    // اِكتِشاف تَحديث: عِندَ ظُهور SW جَديد في install/installed
                    // و يَتَوَفَّر controller حاليّ، اعرِض banner تَحديث.
                    if (reg.waiting && navigator.serviceWorker.controller) {
                        showUpdateBanner(reg.waiting);
                    }
                    reg.addEventListener('updatefound', function () {
                        var nw = reg.installing;
                        if (!nw) return;
                        nw.addEventListener('statechange', function () {
                            if (nw.state === 'installed' && navigator.serviceWorker.controller) {
                                showUpdateBanner(nw);
                            }
                        });
                    });
                })
                .catch(function (e) { console.warn('SW register failed:', e); });

            // إعادَة تَحميل تِلقائيَّة عِندَ تَفعيل SW جَديد — تَضمَن أَنّ
            // كُلّ الـ tabs تَعمَل عَلى نَفس الإصدار بَعد التَّحديث.
            var refreshing = false;
            navigator.serviceWorker.addEventListener('controllerchange', function () {
                if (refreshing) return;
                refreshing = true;
                location.reload();
            });

            function showUpdateBanner(worker) {
                if (document.getElementById('ac-update-banner')) return;
                var b = document.createElement('div');
                b.id = 'ac-update-banner';
                b.className = 'ac-pwa-pill is-update';
                b.innerHTML =
                    '<button type="button" class="ac-pwa-pill-cta">' +
                    '  <span class="ac-pwa-pill-icon">↻</span>' +
                    '  <span class="ac-pwa-pill-text">@L.Js("pwa.update.ready")</span>' +
                    '</button>';
                b.style.top = 'calc(60px + env(safe-area-inset-top, 0px))';
                b.querySelector('.ac-pwa-pill-cta').addEventListener('click', function () {
                    worker.postMessage({ type: 'SKIP_WAITING' });
                });
                document.body.appendChild(b);
            }

            async function subscribeToPush(reg) {
                try {
                    // لا نَطلُب الإذن تِلقائيّاً — نَنتَظِر إيماءَة المُستَخدِم
                    // (window.acEnableNotifications()) عَلى زِرّ صَريح في الواجِهَة.
                    // هذا يَتَوافَق مَع تَوصِيَة Chrome (heuristic-quiet-prompts).
                    if (Notification.permission !== 'granted') return;
                    var key = window.acVapidPublicKey
                          || await (await fetch('/api/push/vapid-key')).text();
                    window.acVapidPublicKey = key;
                    var sub = await reg.pushManager.getSubscription();
                    if (!sub) {
                        sub = await reg.pushManager.subscribe({
                            userVisibleOnly: true,
                            applicationServerKey: urlBase64ToUint8Array(key)
                        });
                    }
                    await fetch('/api/' + slug + '/push/subscribe', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(sub.toJSON())
                    });
                } catch (e) { console.warn('Push subscribe failed:', e); }
            }

            // يَطلُب إذن الإشعارات صَراحَةً ثُمَّ يُعيد محاوَلَة الاشتِراك.
            // يُربَط بِزِرّ في الواجِهَة (مَثَلاً «فَعِّل الإشعارات»).
            window.acEnableNotifications = async function () {
                try {
                    var perm = await Notification.requestPermission();
                    if (perm !== 'granted') return false;
                    var reg = await navigator.serviceWorker.ready;
                    await subscribeToPush(reg);
                    return true;
                } catch (_) { return false; }
            };

            function urlBase64ToUint8Array(s) {
                var pad = '='.repeat((4 - s.length % 4) % 4);
                var b64 = (s + pad).replace(/-/g, '+').replace(/_/g, '/');
                var raw = atob(b64);
                var arr = new Uint8Array(raw.length);
                for (var i = 0; i < raw.length; i++) arr[i] = raw.charCodeAt(i);
                return arr;
            }
        })();

        // ─── Install prompt — نَمَط Ejar: زِرّ ظاهِر دائِماً + تَعليمات
        // بَديلَة. السَّبَب: Chrome قَد لا يُطلِق beforeinstallprompt حَتَّى
        // يَتَفاعَل المُستَخدِم لِبِضع ثَوانٍ، iOS لا تَدعَمه أَصلاً، و
        // المُستَخدِم لا يَنتَظِر بَنِراً قَد لا يَظهَر. الزِرّ يَفتَح dialog
        // تَعليمات بِحَسَب المُتَصَفِّح (Android/Chrome/iOS/Safari) إن لَم
        // يَكُن لَدَينا deferredPrompt مَخزون.
        (function () {
            var deferredPrompt = null;
            var ua = navigator.userAgent;
            var isIOS = /iPad|iPhone|iPod/.test(ua) && !window.MSStream;
            var isAndroid = /Android/.test(ua);
            var isChromiumBased = /Chrome|CriOS|Edg|EdgA/.test(ua);
            var isStandalone =
                window.matchMedia('(display-mode: standalone)').matches ||
                window.navigator.standalone === true;
            if (isStandalone) return;
            if (!('serviceWorker' in navigator)) return;

            // طَبَقَة JS مُماثِلَة لِفَحص الـ server: لا تَثبيت مِن صَفَحات
            // عابِرَة (login/verify/terms/logout/auth/admin) ولا مِن
            // launcher بِلا /r/. لَو السيرفر رَكَّب pwaPath = null لَن
            // يَكون عُنصُر #ac-install-banner مَوجوداً — هذا فَحص ثانوي
            // لِلسَلامَة.
            var p = location.pathname;
            var isTransient = /\/(login|verify|terms|logout|auth)(\/|$|\?)/.test(p)
                           || p.startsWith('/admin');
            if (isTransient) return;
            var segs = p.split('/').filter(Boolean);
            var hasRole = segs.length >= 3 && segs[1] === 'r';
            if (segs.length <= 1 && !hasRole) return;   // launcher أَو جَذر

            // Chrome لا يَعرِض «تَثبيت» إلّا عَلى https أَو localhost.
            var isLocalhost = /^(localhost|127\.|\[::1\])/.test(location.hostname)
                           || location.hostname.endsWith('.localhost');
            if (location.protocol !== 'https:' && !isLocalhost) {
                console.warn('[AC PWA] الصَفحَة عَلى', location.protocol,
                    '— Chrome لَن يَعرِض زِرّ التَّثبيت. اِنشُر عَلى https.');
                return;
            }

            // ─── حالَة التَّثبيت ─────────────────────────────────────────
            // مُفتاح فَريد لِكُلّ scope (rider لَه مَفتاح، driver مَفتاح
            // آخَر). نَحفَظ "مُثَبَّت" في localStorage عِندَ appinstalled،
            // وَنَفحَصه عِندَ تَحميل أَيّ صَفحَة لاحِقَة. لا API مُتَصَفِّح
            // تُخبِرنا "هَل PWA لِهذا الـ scope مُثَبَّتَة" — نُحاكيها بِالمُتَصَفِّح
            // المَحَلّيّ.
            var scopeKey = hasRole ? '/' + segs[0] + '/r/' + segs[2] + '/'
                                   : '/' + segs[0] + '/';
            var installedKey = 'ac.pwa.installed.' + scopeKey;
            function isInstalled() {
                try { return localStorage.getItem(installedKey) === '1'; }
                catch (_) { return false; }
            }
            // اِستَخدِم getInstalledRelatedApps إن مُتاحَة (Chrome/Android +
            // بَعض المُتَصَفِّحات الحَديثَة) لِتَأكيد إضافيّ.
            if ('getInstalledRelatedApps' in navigator) {
                navigator.getInstalledRelatedApps().then(function (apps) {
                    if (apps && apps.length > 0) {
                        try { localStorage.setItem(installedKey, '1'); } catch (_) {}
                        toggleInstalledMode(true);
                    }
                }).catch(function () {});
            }

            // اِخفاء لِأُسبوع بَعد الإغلاق اليَدَويّ.
            function dismissed() {
                try {
                    var t = parseInt(localStorage.getItem('ac.install.dismissed.' + scopeKey) || '0', 10);
                    return t > 0 && (Date.now() - t) < 7 * 24 * 60 * 60 * 1000;
                } catch (_) { return false; }
            }
            if (dismissed() && !isInstalled()) return;

            function showInstructions() {
                var body;
                if (isIOS) {
                    body = '<p><strong>@L.Js("pwa.ios.title")</strong></p>' +
                           '<ol style="padding-inline-start:18px;line-height:2;">' +
                           '<li>@L.Js("pwa.ios.step_share") <span style="font-size:18px;">⬆︎</span> @L.Js("pwa.ios.step_share_in")</li>' +
                           '<li>@L.Js("pwa.ios.step_add_home")</li>' +
                           '<li>@L.Js("pwa.ios.step_confirm")</li></ol>';
                } else if (isAndroid) {
                    body = '<p><strong>@L.Js("pwa.android.title")</strong></p>' +
                           '<ol style="padding-inline-start:18px;line-height:2;">' +
                           '<li>@L.Js("pwa.android.step_menu")</li>' +
                           '<li>@L.Js("pwa.android.step_install")</li></ol>' +
                           '<small style="color:#64748b;">@L.Js("pwa.android.retry_hint")</small>';
                } else if (isChromiumBased) {
                    body = '<p><strong>@L.Js("pwa.chromium.title")</strong></p>' +
                           '<ol style="padding-inline-start:18px;line-height:2;">' +
                           '<li>@L.Js("pwa.chromium.step_find") <span style="font-size:18px;">⊕</span> @L.Js("pwa.chromium.step_find_in")</li>' +
                           '<li>@L.Js("pwa.chromium.step_menu")</li></ol>' +
                           '<small style="color:#64748b;">@L.Js("pwa.chromium.retry_hint")</small>';
                } else {
                    body = '<p>@L.Js("pwa.unsupported.body")</p>';
                }
                var dlg = document.createElement('div');
                dlg.id = 'ac-install-dialog';
                dlg.style.cssText = 'position:fixed;inset:0;background:rgba(15,23,42,0.55);' +
                    'display:flex;align-items:center;justify-content:center;z-index:2147483647;padding:20px;';
                dlg.innerHTML = '<div style="background:#fff;border-radius:16px;padding:24px;' +
                    'max-width:440px;font-family:Cairo,sans-serif;color:#0f172a;direction:rtl;' +
                    'box-shadow:0 20px 50px rgba(0,0,0,0.3);">' +
                    '<h3 style="margin:0 0 12px;font-size:18px;">@L.Js("pwa.dialog.title")</h3>' + body +
                    '<button id="ac-install-dlg-close" style="margin-top:16px;padding:8px 16px;' +
                    'border:none;border-radius:8px;background:#1d4ed8;color:#fff;font-family:inherit;' +
                    'font-size:14px;cursor:pointer;">@L.Js("pwa.dialog.close")</button></div>';
                document.body.appendChild(dlg);
                dlg.addEventListener('click', function (e) {
                    if (e.target === dlg || e.target.id === 'ac-install-dlg-close') dlg.remove();
                });
            }

            window.acInstall = async function () {
                if (deferredPrompt) {
                    deferredPrompt.prompt();
                    try {
                        var res = await deferredPrompt.userChoice;
                        deferredPrompt = null;
                        if (res.outcome === 'accepted') {
                            try { localStorage.setItem(installedKey, '1'); } catch (_) {}
                            toggleInstalledMode(true);
                        }
                    } catch (_) { /* اِنسَحَب الـ prompt */ }
                } else {
                    showInstructions();
                }
            };
            window.acDismissInstall = function () {
                var w = document.getElementById('ac-install-banner');
                if (w) w.remove();
                try {
                    localStorage.setItem('ac.install.dismissed.' + scopeKey, String(Date.now()));
                } catch (_) {}
            };
            // زِرّ "افتَح في التَّطبيق" — نُحاوِل فَتح الـ scope. النِظام
            // يَلتَقِطها وَيَفتَحها في الـ PWA المُثَبَّتَة (handle_links=preferred).
            window.acOpenInApp = function () {
                window.open(scopeKey, '_blank');
            };

            // يُغَيِّر الـ pill بَين وَضعَي "تَثبيت" و "افتَح في التَّطبيق".
            function toggleInstalledMode(installed) {
                var w = document.getElementById('ac-install-banner');
                if (!w) return;
                var cta = w.querySelector('.ac-pwa-pill-cta');
                var iconSpan = w.querySelector('.ac-pwa-pill-icon');
                var textSpan = w.querySelector('.ac-pwa-pill-text');
                if (installed) {
                    if (iconSpan) iconSpan.textContent = '↗';
                    if (textSpan) textSpan.textContent = '@L.Js("pwa.pill.open_app")';
                    if (cta) cta.setAttribute('onclick', 'acOpenInApp()');
                    w.classList.add('is-installed');
                } else {
                    if (iconSpan) iconSpan.textContent = '⤓';
                    if (textSpan) textSpan.textContent = '@L.Js("pwa.pill.install")';
                    if (cta) cta.setAttribute('onclick', 'acInstall()');
                    w.classList.remove('is-installed');
                }
            }

            window.addEventListener('beforeinstallprompt', function (e) {
                e.preventDefault();
                deferredPrompt = e;
                // الـ event يُطلَق فَقَط إذا الـ PWA غَير مُثَبَّتَة — نُصَحِّح
                // لَو الـ localStorage يُشير لِغَير ذلِك.
                try { localStorage.removeItem(installedKey); } catch (_) {}
                toggleInstalledMode(false);
            });
            window.addEventListener('appinstalled', function () {
                try { localStorage.setItem(installedKey, '1'); } catch (_) {}
                deferredPrompt = null;
                toggleInstalledMode(true);
            });

            // اِعرِض الزِرّ فَوراً، ثُمَّ بَدِّل لِوَضع "مُثَبَّت" لَو
            // localStorage يَدُلّ عَلى ذلِك.
            function reveal() {
                var w = document.getElementById('ac-install-banner');
                if (!w) return;
                w.style.display = 'flex';
                if (isInstalled()) toggleInstalledMode(true);
            }
            if (document.readyState !== 'loading') reveal();
            else document.addEventListener('DOMContentLoaded', reveal);
        })();

        // تَأكيد وُصول السائِق — يَلتَقِط المَوقِع وَيُرسِل لِـ /trips/{id}/arrived
        // الخادِم يَفحَص قُربَه مِن نُقطَة الانطِلاق وَيُرفِض إن كانَ > 1 كم.
        window.acSubmitArrived = function (btn) {
            var form = btn.closest('form');
            if (!form || !navigator.geolocation) return;
            btn.disabled = true;
            btn.textContent = '@L.Js("trips.arrived.checking")';
            navigator.geolocation.getCurrentPosition(
                function (p) {
                    form.querySelector('#arrived_lat').value = p.coords.latitude.toFixed(6);
                    form.querySelector('#arrived_lng').value = p.coords.longitude.toFixed(6);
                    form.submit();
                },
                function () {
                    btn.disabled = false;
                    btn.textContent = '@L.Js("trips.arrived.need_location")';
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
            );
        };
    </script>
</body>
</html>

@code {
    /// <summary>
    /// <para><b>الثيم الفَعّال لِهذا الطَلَب</b> — الافتِراضيّ حَتَّى
    /// تُقرَأ وَثيقَة المُستَأجِر. الابتِداء بِالافتِراضيّ (لا بِـnull)
    /// يَعني أَنّ كُلّ مَسار فَشَل — سِياق بِلا مُستَأجِر، جَدوَل غَير
    /// مُنشَأ، خَلَل عابِر — يَبُثّ مَظهَر اليَوم حَرفاً بَدَل أَن يَبُثّ
    /// كُتلَة ناقِصَة أَو يَرمي في <c>&lt;head&gt;</c>.</para>
    /// </summary>
    ACommerce.Kit.Theme.EffectiveTheme Theme = ACommerce.Kit.Theme.ThemeCatalog.Default;

    protected override async Task OnInitializedAsync()
    {
        // سِياق المَنصَّة (الهُبوط/الاستوديو/الإدارَة) لا مُستَأجِر لَه —
        // ‏ForAsync يُجيب بِقاعِدَة المَنصَّة بِلا استِعلام أَصلاً.
        if (!Tenant.IsResolved) return;

        try
        {
            Theme = await Themes.EffectiveAsync(Tenant.Slug);
        }
        catch (Exception ex)
        {
            // الخِدمَة تَبتَلِع أَخطاءَها وتَسقُط لِلافتِراضيّ؛ هذا
            // الحِزام الثاني لِما لا تُمسِكُه (‏DI، إلغاء). صَفحَة بِلا
            // ثيم مُخَصَّص أَهوَن مِن صَفحَة بِـ500 في <head>.
            Console.Error.WriteLine(
                $"[theme] تَعَذَّرَ حَلّ ثيم «{Tenant.Slug}» — الافتِراضيّ: {ex.Message}");
        }
    }
}
