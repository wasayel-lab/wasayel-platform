@using ACommerce.Templates.Customer.Marketplace.Services.Incubator
@inject L L

@*
    عُنصُر إشعار «تَجاوُز حَدّ الباقَة» — يَظهَر في أَعلى صَفحات studio
    عِندَ ?upgrade=analyze|refine|build. يَعرِض الباقَة التالِيَة + الفائِدَة
    — إن كانَت تُباع (`Offer` أَدناه)؛ وإلّا العُنوانَ والرِسالَةَ وَحدَهُما.
*@

@if (!string.IsNullOrEmpty(Reason))
{
    <div class="st-card" style="background:#fff7ed;border:1px solid var(--st-warning);margin-bottom:16px;">
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
            <span style="font-size:32px;">⭐</span>
            <div style="flex:1;min-width:200px;">
                <strong style="font-size:15px;">@TitleFor(Reason)</strong>
                <p style="margin:4px 0 0;font-size:13px;color:var(--st-muted);line-height:1.7;">
                    @MessageFor(Reason)
                </p>
                @if (Offer is not null)
                {
                    <ul style="margin:8px 0 0;padding-inline-start:18px;font-size:13px;color:var(--st-ink-700);line-height:1.8;">
                        @foreach (var b in BenefitsFor(Offer))
                        {
                            <li>@b</li>
                        }
                    </ul>
                }
            </div>
            @if (Offer is not null)
            {
                <a class="st-btn st-btn-primary" href="/studio/billing">
                    @((MarkupString)"\n                    ")@L.Markup("upgrade.cta.to") @Offer.LabelAr (@((MarkupString)L.Format("upgrade.cta.per_month", Money.Format(Offer.MonthlyPriceSar))))
                </a>
            }
        </div>
    </div>
}

@code {
    /// <summary>"analyze" | "refine" | "build" | null.</summary>
    [Parameter] public string? Reason { get; set; }
    /// <summary>الباقَة الحالِيَّة (لِحِساب التالِيَة).</summary>
    [Parameter] public string CurrentTier { get; set; } = "spark";
    /// <summary>مَوعِدُ تَجَدُّدِ الحِصَّةِ مُنَسَّقاً بِساعَةِ الطَلَب (‏<c>Culture.FormatTime</c> في الصَفحَة) — مِن
    /// <see cref="StudioLimitNextStep.RenewsAt"/>؛ <c>null</c> فَلا جُملَةَ تَجَدُّد. (‏2026-10-29، قَرارُ المالِك د15.)</summary>
    [Parameter] public string? RenewsOn { get; set; }

    @* السُلَّمُ يُحسَبُ مِنَ الحُدودِ لا يُكتَبُ ثابِتاً — وإلّا عَرَضَ
       تَنازُلاً بِثَمَن يَومَ تُرفَعُ المَجّانِيَّة. الحُجَّةُ كامِلَةً
       على `TierCatalog.NextAbove`. *@
    TierLimits? Next => TierCatalog.NextAbove(CurrentTier);

    @* **ولا يُعرَضُ إلّا ما يُباع** (موجَزُ الفَجَوات P2-3 — مُراجَعَةُ تَيّارِ
       S11، الجَولَة ١، ‏2026-10-13): الأَوسَعُ الَّذي لا يُمنَحُ ذاتِيّاً لا
       تُرسَمُ لَه حُدودٌ ولا زِرٌّ بِسِعر. فَصَفحَةُ الباقاتِ لا تَرسُمُه
       (`Shown`) ولا تَبيعُه، وزِرٌّ إلَيها بِسِعرِه بابٌ لا يُفتَح (القاعِدَة
       ١٢). والسُؤالُ هُوَ `StudioTierPurchase.IsSelfGrantable` — الدالَّةُ
       نَفسُها الَّتي تَرسُمُ سِعرَ البِطاقَةِ وزِرَّها هُناك — لا شَرطٌ ثانٍ.
       فَتَصيرُ اللافِتَةُ لافِتَةَ «لا أَوسَع» بِحَرفِها: «بَلَغتَ حَدَّك»
       بِلا زِرِّ بَيع. ويَومَ يوجَدُ مَسارُ الدَفعِ الذاتِيّ
       (`SelfServiceCheckoutExists`) يَعودُ العَرضُ بِلا سَطرٍ آخَر. *@
    TierLimits? Offer => Next is { } n && StudioTierPurchase.IsSelfGrantable(n.Tier) ? n : null;

    @* الرَمزُ مِن `StudioUpgradeReason` لا نَصٌّ حَرفيّ: المَعجَمُ
       المُغلَقُ لَه تَعريفٌ واحِد، فَخَطَأُ إملاءٍ يَصير خَطَأَ
       تَرجَمَةٍ لا رِسالَةً تَصمُت. *@
    @* ‏(2026-10-29، قَرارُ المالِك د15 (+د46) «ب»): **«تَرقِيَة» لا تُقالُ حَيثُ لا دَرَجَةَ تُشتَرى** — والسُؤالُ هُوَ `Offer` نَفسُه الَّذي يَرسُمُ
       الزِرَّ والسِعر. فَبِلا عَرضٍ: عُنوانُ الميزَةِ ورِسالَةُ التَصديرِ «غَيرُ مَشمولَةٍ في باقَتِك»، ورِسالَةُ الحَدِّ تُتبَعُ بِخُطوَةٍ مُتاحَة — مَوعِدِ
       التَجَدُّدِ لِلتَحاليلِ والتَحسينات، وجُملَةِ التَواصُلِ لِكُلِّ حَدٍّ ما دامَ بَريدُ التَواصُلِ مَملوءاً (`StudioLimitNextStep`). ويَومَ يُباعُ دَرَجَةٌ
       تَعودُ صِياغَةُ «التَرقِيَة» وَحدَها بِلا سَطرٍ آخَر. *@
    string TitleFor(string reason) => reason switch
    {
        StudioUpgradeReason.Analyses => L["upgrade.title.analyze"],
        StudioUpgradeReason.Refines  => L["upgrade.title.refine"],
        StudioUpgradeReason.Stores   => L["upgrade.title.build"],
        _ => Offer is null ? L["upgrade.title.feature_not_included"] : L["upgrade.title.feature"]
    };

    string MessageFor(string reason)
    {
        var limit = reason switch
        {
            StudioUpgradeReason.Analyses => L["upgrade.msg.analyze"],
            StudioUpgradeReason.Refines  => L["upgrade.msg.refine"],
            StudioUpgradeReason.Stores   => L["upgrade.msg.build"],
            StudioUpgradeReason.Export   => Offer is null ? L["upgrade.msg.export_not_included"] : L["upgrade.msg.export"],
            _ => ""
        };
        if (Offer is not null || limit.Length == 0) return limit;
        var renews = reason is StudioUpgradeReason.Analyses or StudioUpgradeReason.Refines && RenewsOn is { Length: > 0 }
            ? L.Format(StudioLimitNextStep.RenewsOnKey, RenewsOn) : null;
        var contact = StudioLimitNextStep.Contact(k => L[k]);
        return string.Join(" ", new[] { limit, renews, contact }.Where(x => !string.IsNullOrEmpty(x)));
    }

    @* كُلُّ حَدٍّ مُنتَهٍ مُنذُ ‏2026-08-30، فَفَرعُ «بِلا حَدّ» صارَ
       شَرطاً لا يَصدُقُ أَبَداً — وحِراسَةُ مَعدومٍ أَسوَأُ مِن
       غِيابِها (نَفسُ حُكمِ `AllowCustomPattern`). التَفصيلُ ورَقمُ
       كُلِّ حَدٍّ في `StudioTier.cs`. *@
    IEnumerable<string> BenefitsFor(TierLimits t)
    {
        yield return L.Format("upgrade.benefit.analyses", t.AnalysesPerMonth);
        yield return L.Format("upgrade.benefit.refines", t.RefinesPerMonth);
        yield return L.Format("upgrade.benefit.stores", t.StoresMax);
        if (t.AllowExport)         yield return L["upgrade.benefit.export"];
        // «أَنماط مُخَصَّصَة» سُحِبَت — لا مَسار لَها. التَفصيل في StudioTier.cs.
    }
}
