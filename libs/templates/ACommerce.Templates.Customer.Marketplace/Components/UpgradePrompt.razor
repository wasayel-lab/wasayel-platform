@using ACommerce.Templates.Customer.Marketplace.Services.Incubator
@inject L L

@*
    عُنصُر إشعار «تَجاوُز حَدّ الباقَة» — يَظهَر في أَعلى صَفحات studio
    عِندَ ?upgrade=analyze|refine|build. يَعرِض الباقَة التالِيَة + الفائِدَة.
*@

@if (!string.IsNullOrEmpty(Reason))
{
    <div class="st-card" style="background:#fff7ed;border:1px solid var(--st-warning);margin-bottom:16px;">
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
            <span style="font-size:32px;">⭐</span>
            <div style="flex:1;min-width:200px;">
                <strong style="font-size:15px;">@TitleFor(Reason)</strong>
                <p style="margin:4px 0 0;font-size:13px;color:var(--st-muted);line-height:1.7;">
                    @MessageFor(Reason)
                </p>
                @if (Next is not null)
                {
                    <ul style="margin:8px 0 0;padding-inline-start:18px;font-size:13px;color:var(--st-ink-700);line-height:1.8;">
                        @foreach (var b in BenefitsFor(Next))
                        {
                            <li>@b</li>
                        }
                    </ul>
                }
            </div>
            @if (Next is not null)
            {
                <a class="st-btn st-btn-primary" href="/studio/billing">
                    @((MarkupString)"\n                    ")@L.Markup("upgrade.cta.to") @Next.LabelAr (@((MarkupString)L.Format("upgrade.cta.per_month", Money.Format(Next.MonthlyPriceSar))))
                </a>
            }
        </div>
    </div>
}

@code {
    /// <summary>"analyze" | "refine" | "build" | null.</summary>
    [Parameter] public string? Reason { get; set; }
    /// <summary>الباقَة الحالِيَّة (لِحِساب التالِيَة).</summary>
    [Parameter] public string CurrentTier { get; set; } = "spark";

    TierLimits? Next => CurrentTier switch
    {
        "spark"  => TierCatalog.For("lite"),
        "lite"   => TierCatalog.For("growth"),
        "growth" => TierCatalog.For("scale"),
        _ => null
    };

    string TitleFor(string reason) => reason switch
    {
        "analyze" => L["upgrade.title.analyze"],
        "refine"  => L["upgrade.title.refine"],
        "build"   => L["upgrade.title.build"],
        _ => L["upgrade.title.feature"]
    };

    string MessageFor(string reason) => reason switch
    {
        "analyze" => L["upgrade.msg.analyze"],
        "refine"  => L["upgrade.msg.refine"],
        "build"   => L["upgrade.msg.build"],
        _ => ""
    };

    IEnumerable<string> BenefitsFor(TierLimits t)
    {
        if (t.AnalysesPerMonth != int.MaxValue)
            yield return L.Format("upgrade.benefit.analyses", t.AnalysesPerMonth);
        else yield return L["upgrade.benefit.analyses_max"];
        if (t.RefinesPerMonth != int.MaxValue)
            yield return L.Format("upgrade.benefit.refines", t.RefinesPerMonth);
        else yield return L["upgrade.benefit.refines_max"];
        if (t.StoresMax != int.MaxValue)
            yield return L.Format("upgrade.benefit.stores", t.StoresMax);
        else yield return L["upgrade.benefit.stores_max"];
        if (t.AllowExport)         yield return L["upgrade.benefit.export"];
        // «أَنماط مُخَصَّصَة» سُحِبَت — لا مَسار لَها. التَفصيل في StudioTier.cs.
    }
}
