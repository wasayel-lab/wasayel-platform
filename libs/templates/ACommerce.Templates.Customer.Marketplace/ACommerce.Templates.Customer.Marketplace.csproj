<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <StaticWebAssetBasePath>_content/ACommerce.Templates.Customer.Marketplace</StaticWebAssetBasePath>
  </PropertyGroup>
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Marten" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="WebPush" />
    <PackageReference Include="ClosedXML" />
  </ItemGroup>

  <!-- بيانات السوق السعودي تُضمَّن كموارد لتُحقَن في prompt التحليل. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\saudi-market-context.json" />
    <EmbeddedResource Include="Data\saudi-competitors.json" />
    <EmbeddedResource Include="Data\saudi-cost-benchmarks.json" />
    <EmbeddedResource Include="Data\saudi-startup-failures.json" />
    <EmbeddedResource Include="Data\acommerce-capabilities.md" />
  </ItemGroup>

  <!-- قَوامِيس نُصوص الواجِهَة (‏docs/I18N.md). مَوارِد مُضَمَّنَة لا
       مُحتَوىً ثابِتاً: تُقرَأ في الخادِم، ولا يَجوز أَن يَتَعَلَّق
       وُجودُها بِنَسخِ مُخرَجات ولا بِمَسار قُرص. وإضافَة لُغَة =
       إسقاط مِلَفّ هُنا؛ الـ wildcard يَلتَقِطُه بِلا تَعديل. -->
  <ItemGroup>
    <EmbeddedResource Include="I18n\Locales\*.json" />
  </ItemGroup>

  <ItemGroup>

    <ProjectReference Include="..\..\widgets\ACommerce.Widgets\ACommerce.Widgets.csproj" />
    <ProjectReference Include="..\ACommerce.Templates.Shared\ACommerce.Templates.Shared.csproj" />

    <ProjectReference Include="..\..\core\ACommerce.Platform.Shared\ACommerce.Platform.Shared.csproj" />

    <ProjectReference Include="..\..\kits\Tenants\ACommerce.Kit.Tenants.Core\ACommerce.Kit.Tenants.Core.csproj" />
    <ProjectReference Include="..\..\kits\Listings\ACommerce.Kit.Listings.Core\ACommerce.Kit.Listings.Core.csproj" />
    <ProjectReference Include="..\..\kits\Auth\ACommerce.Kit.Auth.Core\ACommerce.Kit.Auth.Core.csproj" />
    <ProjectReference Include="..\..\kits\Auth\ACommerce.Kit.Auth.Server\ACommerce.Kit.Auth.Server.csproj" />
    <ProjectReference Include="..\..\kits\Chat\ACommerce.Kit.Chat.Core\ACommerce.Kit.Chat.Core.csproj" />
    <ProjectReference Include="..\..\kits\Notifications\ACommerce.Kit.Notifications.Core\ACommerce.Kit.Notifications.Core.csproj" />
    <ProjectReference Include="..\..\kits\Cart\ACommerce.Kit.Cart.Core\ACommerce.Kit.Cart.Core.csproj" />
    <ProjectReference Include="..\..\kits\Files\ACommerce.Kit.Files.Core\ACommerce.Kit.Files.Core.csproj" />
    <ProjectReference Include="..\..\kits\Favorites\ACommerce.Kit.Favorites.Core\ACommerce.Kit.Favorites.Core.csproj" />
    <ProjectReference Include="..\..\kits\Profiles\ACommerce.Kit.Profiles.Core\ACommerce.Kit.Profiles.Core.csproj" />
    <ProjectReference Include="..\..\kits\Subscriptions\ACommerce.Kit.Subscriptions.Core\ACommerce.Kit.Subscriptions.Core.csproj" />
    <ProjectReference Include="..\..\kits\Support\ACommerce.Kit.Support.Core\ACommerce.Kit.Support.Core.csproj" />
    <ProjectReference Include="..\..\kits\Realtime\ACommerce.Kit.Realtime.Client\ACommerce.Kit.Realtime.Client.csproj" />
    <ProjectReference Include="..\..\kits\Realtime\ACommerce.Kit.Realtime.Server\ACommerce.Kit.Realtime.Server.csproj" />
    <ProjectReference Include="..\..\kits\Maps\ACommerce.Kit.Maps.Web\ACommerce.Kit.Maps.Web.csproj" />
    <ProjectReference Include="..\..\kits\Offers\ACommerce.Kit.Offers.Core\ACommerce.Kit.Offers.Core.csproj" />
    <ProjectReference Include="..\..\kits\SavedSearches\ACommerce.Kit.SavedSearches.Core\ACommerce.Kit.SavedSearches.Core.csproj" />
    <ProjectReference Include="..\..\kits\Reviews\ACommerce.Kit.Reviews.Core\ACommerce.Kit.Reviews.Core.csproj" />
    <!-- ‏`Report` وَثيقَةُ مُستَأجِرٍ حَيَّة، ومُستَهلِكُها هُنا
         **مَوجودٌ وَقتَ التَشغيل** (القاعِدَة ١): سِجِلُّ التَخارُج
         يُصَنِّفُها ويُصَدِّرُها بِنَوعِها لا بِاسمِها — واسمٌ نَصّيٌّ
         كانَ يَسقُط صامِتاً عِندَ إعادَةِ تَسمِيَة. والعُدَّةُ ورَقَةٌ:
         ‏Marten وَحدَه، بِلا مَرجِعٍ آخَر. -->
    <ProjectReference Include="..\..\kits\Reports\ACommerce.Kit.Reports.Core\ACommerce.Kit.Reports.Core.csproj" />
    <ProjectReference Include="..\..\kits\Payments\ACommerce.Kit.Payments.Core\ACommerce.Kit.Payments.Core.csproj" />
    <!-- ‏PayPal — النُقطَةُ والشاشَتانِ تَحتاج أَنواعَه: رُؤوسُ التَوقيع،
         ومُعجَمُ الأَحداث، ودالَّةُ القَرارِ النَقِيَّة. وهذِه **لَيسَت
         SDK** بَل عَقدُ واجِهَةٍ مُوَثَّق، ولا حُزمَةَ خارِجِيَّةَ تُضاف
         (‏`Directory.Packages.props` بِلا تَغيير). ونِداءُ HTTP وَحدَه
         خَلفَ `PayPalGateway`. -->
    <ProjectReference Include="..\..\kits\Payments\ACommerce.Kit.Payments.Providers.PayPal\ACommerce.Kit.Payments.Providers.PayPal.csproj" />
    <!-- ‏Paddle — مُزَوِّدٌ ثانٍ **بِجِوارِ PayPal لا بَدَلاً مِنه**:
         ‏PayPal تَطلُب مِن الدافِعِ حِسابَ PayPal ولا تَعرِض بِطاقَة،
         وزَبائِنُ المالِكِ يَدفَعونَ بِبِطاقَةٍ بِلا مَحفَظَة. ونَفسُ
         حُجَّةِ جارَتِه أَعلاهُ حَرفاً: أَنواعٌ ودَوالُّ نَقِيَّةٌ لا
         SDK، وصِفرُ حُزمَةٍ خارِجِيَّةٍ تُضاف. -->
    <ProjectReference Include="..\..\kits\Payments\ACommerce.Kit.Payments.Providers.Paddle\ACommerce.Kit.Payments.Providers.Paddle.csproj" />
    <ProjectReference Include="..\..\kits\Theme\ACommerce.Kit.Theme.Core\ACommerce.Kit.Theme.Core.csproj" />
    <!-- المال يُنَسَّق مِن مَوضِع واحِد (‏`ACommerce.Kit.Culture.Money`)
         بَدَل رَمز عُملَة مَحبوس في قيَم القامُوس. والعُدَّة قائِمَة
         مُسَجَّلَة في `Program.cs` مُنذُ زَمَن؛ الجَديد أَنّ لَها
         مُستَهلِكاً. -->
    <ProjectReference Include="..\..\kits\Culture\ACommerce.Kit.Culture.Core\ACommerce.Kit.Culture.Core.csproj" />
    <!-- صَريح لا مُتَوارَث: جِسر نَمَط الصَفقَة إلى لُغَة التَدَفُّق
         يَستَخدِمُها مُباشَرَةً، فَلا يُترَك وُصولُها رَهناً بِمَرجِع
         عُدَّة أُخرى قَد يُنزَع. -->
    <ProjectReference Include="..\..\core\ACommerce.Platform.Flows\ACommerce.Platform.Flows.csproj" />
    <!-- كاتالوجُ تَعريفاتِ المُزَوِّدين ووَثيقَةُ الرَبط — يَستَهلِكُهُما
         `TenantProviderService` وشاشَةُ التَكامُلاتِ ونُقطَتا الرَبطِ
         والسَحب. -->
    <ProjectReference Include="..\..\core\ACommerce.Platform.Providers\ACommerce.Platform.Providers.csproj" />
    <ProjectReference Include="..\..\core\ACommerce.Platform.I18n\ACommerce.Platform.I18n.csproj" />
  </ItemGroup>
</Project>
