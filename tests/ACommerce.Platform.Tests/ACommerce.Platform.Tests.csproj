<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libs\templates\ACommerce.Templates.Customer.Marketplace\ACommerce.Templates.Customer.Marketplace.csproj" />
    <ProjectReference Include="..\..\libs\core\ACommerce.Platform.Flows\ACommerce.Platform.Flows.csproj" />
    <!-- كاتالوجُ تَعريفاتِ المُزَوِّدين — المُصادِقُ والقارِئُ يُقاسانِ
         هُنا: لِكُلّ رَمزِ خَرقٍ اختِبارٌ موجِبٌ وسالِب (القاعِدَة ٤). -->
    <ProjectReference Include="..\..\libs\core\ACommerce.Platform.Providers\ACommerce.Platform.Providers.csproj" />
    <!-- كاتالوجُ الالتِزاماتِ النِظامِيَّة — المُصادِقُ والقارِئُ
         والفاحِصُ يُقاسونَ هُنا: لِكُلِّ رَمزِ خَرقٍ اختِبارٌ موجِبٌ
         وسالِب (القاعِدَة ٤)، ومِجَسٌّ بِحَقنِ العَيبِ يَقيسُ الفاحِصَ
         نَفسَه. مَرجِعٌ صَريحٌ لا مُتَوارَث: القالِبُ يُحيلُه اليَومَ،
         واعتِمادُ الفَحصِ عَلى إحالَةِ غَيرِه يَجعَلُه رَهناً
         بِقَرارٍ في مَشروعٍ آخَر. -->
    <ProjectReference Include="..\..\libs\kits\Compliance\ACommerce.Kit.Compliance.Core\ACommerce.Kit.Compliance.Core.csproj" />
    <!-- Reports.Core لا يَصِل إلى القالِب — ومُقابَلَة وَصف التَدَفُّق
         بِتَعداد ReportStatus تَحتاجُه. مَرجِع اختِبار فَقَط. -->
    <ProjectReference Include="..\..\libs\kits\Reports\ACommerce.Kit.Reports.Core\ACommerce.Kit.Reports.Core.csproj" />
    <!-- بُرهان الرَبط (‏LiveOutboxTenantProofTests) يُقلِع مُضيفاً حَقيقيّاً
         بِنَفس تَركيب HostingExtensions — Marten + Wolverine + Wolverine.Http.
         مَرجِعٌ لِلبُرهان وَحدَه: بِدونِه تُقرَأ الدَعوى ولا تُقاس. -->
    <ProjectReference Include="..\..\libs\core\ACommerce.Platform.Hosting\ACommerce.Platform.Hosting.csproj" />
    <!-- حارِسُ قَنَوات الدُخول يَقرَأ **عَلامَةً** على القَناة نَفسِها،
         فَالبُرهانُ يَحتاج نَوعَ المُحاكي ونَوعَ المُزَوِّدِ الفِعليّ:
         سُقوطُ العَلامَةِ عَن مُحاكٍ يُسكِت الحارِس، وحَملُها على مُزَوِّدٍ
         فِعليّ يُغلِق الإنتاجَ على المَضبوط. مَرجِعُ اختِبارٍ فَقَط. -->
    <ProjectReference Include="..\..\libs\kits\Auth\ACommerce.Kit.Auth.Providers.MockEmail\ACommerce.Kit.Auth.Providers.MockEmail.csproj" />
    <ProjectReference Include="..\..\libs\kits\Auth\ACommerce.Kit.Auth.Providers.Smtp\ACommerce.Kit.Auth.Providers.Smtp.csproj" />
    <!-- قَناةُ البَريدِ عَبر HTTPS: الاختِبارُ يَلتَقِطُ طَلَبَها
         بِـ`HttpMessageHandler` وَهمِيّ، فَلا مِفتاحَ حَقيقيّاً ولا
         نِداءَ شَبَكَة. مَرجِعُ اختِبارٍ فَقَط. -->
    <ProjectReference Include="..\..\libs\kits\Auth\ACommerce.Kit.Auth.Providers.Brevo\ACommerce.Kit.Auth.Providers.Brevo.csproj" />
    <!-- مَخزَنُ الكائِنات: البُرهانُ يُقلِع مُستَمِعَ HTTP مَحَلِّيّاً
         ويُوَجِّه العَميلَ إلَيه، فَيُقاس أَنّ التَوقيعَ ‏SigV4 يُكتَب
         **مِن الحُزمَة** وأَنّ الدَلوَ والمِفتاحَ يَبلُغانِ الطَلَب —
         بِلا اعتِمادِ R2 ولا نِداءِ شَبَكَةٍ خارِجَ المُضيف. -->
    <ProjectReference Include="..\..\libs\kits\Files\ACommerce.Kit.Files.Providers.S3\ACommerce.Kit.Files.Providers.S3.csproj" />
    <!-- بَوّابَةُ الإصدار: نُقطَةُ هُوِيَّةِ البِناءِ تَقَعُ **خَلفَ**
         `UseVersionGate` في `Program.cs`، ورَأسُ `X-App-Version` قَديمٌ
         كانَ يَقلِبُ جَوابَها إلى ‏426. فَالبُرهانُ يَحتاج تَركيبَ
         الوَسيطِ نَفسِه لا مُحاكاتَه — يُقاسُ المَسارُ لا المُعالِجُ
         وَحدَه. مَرجِعُ اختِبارٍ فَقَط. -->
    <ProjectReference Include="..\..\libs\kits\Versions\ACommerce.Kit.Versions.Core\ACommerce.Kit.Versions.Core.csproj" />
  </ItemGroup>

</Project>
