<Project>
  <ItemGroup>
    <!-- Marten + Wolverine -->
    <PackageVersion Include="Marten" Version="9.22.5" />
    <PackageVersion Include="WolverineFx" Version="6.25.1" />
    <PackageVersion Include="WolverineFx.Http" Version="6.25.1" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.25.1" />

    <!-- ASP.NET runtime bits -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />

    <!-- Web Push (PWA notifications) -->
    <PackageVersion Include="WebPush" Version="1.0.13" />

    <!-- Cache + Realtime backplane -->
    <PackageVersion Include="StackExchange.Redis"                          Version="3.1.13" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.10" />

    <!-- Excel export (feasibility study) -->
    <PackageVersion Include="ClosedXML" Version="0.105.1" />

    <!-- JSON Schema validation (بَوّابَة مُصادَقَة أَدَوات الوَكيل) -->
    <PackageVersion Include="JsonSchema.Net" Version="9.4.0" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />

    <!-- Logging -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />

    <!-- Importer tool -->
    <PackageVersion Include="Microsoft.Extensions.Hosting"            Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Data.SqlClient"                Version="7.0.2" />
    <PackageVersion Include="Dapper"                                  Version="2.1.79" />
    <PackageVersion Include="System.CommandLine"                      Version="2.0.10" />
  </ItemGroup>
</Project>
